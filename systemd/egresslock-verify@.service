# Generated by the egresslock kit — do not edit.
# Oneshot policy verify for one account. Drift signal only; this
# unit never repairs policy. Wired by egresslock-setup --enable.

[Unit]
Description=Verify network policy for %i (drift signal, not auto-fix)

[Service]
Type=oneshot
User=%i
Group=%i
# Do NOT set XDG_RUNTIME_DIR here: %U/%h do not expand per-User= on
# some hosts. The kit entry scripts resolve it from the executing uid
# (rootless Podman needs the account's own runtime dir, kept alive by
# linger).
# Per-account unit.env (0600, account-owned) supplies EGRESSLOCK_CONF
# (required) and optionally EGRESSLOCK_PROFILE (named verify).
EnvironmentFile=-/home/%i/.config/egresslock/unit.env
# The ExecStart prefix is substituted at install/deb-build time.
ExecStart=__EGRESSLOCK_PREFIX__/egresslock-verify
