#!/usr/bin/env bash
#
# build-egl-base — build the shared example image localhost/egl-base:latest
# from the Containerfile NEXT TO THIS SCRIPT.
#
# This is an example-image helper, not a workload launcher: it never
# runs a container, never calls egresslock ensure/verify, and takes no
# profile. Not on PATH; invoke by full path or ./ from this directory.
#
# The helper also rebuilds when the image predates the kit's recorded
# security rebuild floor (beside this script) even if the base pin did
# not move; that refresh uses podman --no-cache. Age alone is a doctor
# warning only — it does not trigger a build here.
#
# Options:
#   -h, --help   print this help
#   --force      rebuild even when the image matches the deployed pin
#                (uses podman --no-cache)
#
# Defaults that are not parameter-changeable:
#   - image tag: localhost/egl-base:latest
#   - build context: the directory containing this script
#     (.deb /usr/share/egresslock/examples/egl-base, prefix
#     /opt/egresslock/examples/egl-base, or a checkout) — never the
#     caller's current directory
#   - no --format docker (the example image has no HEALTHCHECK)

set -euo pipefail

usage() { awk 'NR>1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"; }
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

force=0
if (( $# > 0 )); then
    if [[ "$1" == "--force" && $# -eq 1 ]]; then
        force=1
    else
        echo "Error: build-egl-base takes no arguments other than --force." >&2
        usage >&2
        exit 2
    fi
fi

IMAGE="localhost/egl-base:latest"
# CDPATH='' keeps a caller-exported CDPATH from redirecting this
# own-directory lookup (R-EGL-378-12): the context is always the
# directory containing this helper, never a foreign CDPATH hit.
dir="$(CDPATH='' cd -- "$(dirname "$0")" && pwd)"
[[ -f "$dir/Containerfile" ]] || {
    echo "Error: no Containerfile at $dir/Containerfile (the helper must sit next to the egl-base Containerfile)" >&2
    exit 1
}

if ! command -v podman >/dev/null 2>&1; then
    echo "Error: podman not found on PATH (required to build $IMAGE)" >&2
    exit 1
fi

pin="$(grep -oE 'sha256:[0-9a-f]{64}' "$dir/Containerfile" | head -1 || true)"
pin_short="${pin#sha256:}"; pin_short="${pin_short:0:12}"

# EGL-378 R-EGL-378-15: rootless podman re-enters the inherited CWD at
# startup as the account; from a directory the account cannot traverse
# (`sudo -u` from a 0700 home) the call dies with `cannot chdir to <dir>:
# Permission denied` before any work. Run podman from /, and keep the
# invocation-directory meaning of relative path-valued Podman settings
# (same list as the engine's rt_absolutize_podman_env).
podman_in_root() { # podman_in_root cmd [arg...] — run one podman command from /
    (
        local v val
        for v in CONTAINERS_CONF CONTAINERS_CONF_OVERRIDE \
                 CONTAINERS_REGISTRIES_CONF CONTAINERS_STORAGE_CONF \
                 CONTAINERS_HELPER_BINARY_DIR PODMAN_CONNECTIONS_CONF \
                 CONTAINER_SSHKEY REGISTRY_AUTH_FILE TMPDIR \
                 XDG_CONFIG_HOME XDG_DATA_HOME XDG_RUNTIME_DIR; do
            val="${!v:-}"
            [[ -n "$val" && "$val" != /* ]] || continue
            printf -v "$v" '%s/%s' "${PWD%/}" "$val"
            export "${v?}"
        done
        cd / || {
            echo "Error: cannot change directory to / before running the container runtime; no runtime command was run; check that / is accessible as this account: ls /; if that fails the host root is broken — repair it, then re-run (this is not a kit reinstall)" >&2
            exit 1
        }
        "$@"
    )
}

# EGL-487: security rebuild floor — one ISO date in a file beside the
# Containerfile, `#` comments allowed. Missing, unreadable or
# unparseable data yields no floor (never a guess).
security_floor_date() { # security_floor_date <floor-file> -> YYYY-MM-DD or empty
    local f="$1" line="" d=""
    [[ -f "$f" && -r "$f" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        if [[ "$line" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
            && [[ "$(date -u -d "$line" '+%Y-%m-%d' 2>/dev/null || true)" == "$line" ]]; then
            d="$line"
        fi
        break
    done < "$f"
    printf '%s\n' "$d"
}

state=missing
base=""
created=""
if podman_in_root podman image exists "$IMAGE" 2>/dev/null; then
    state=present
    ins=""
    if ins="$(podman_in_root podman image inspect --format '{{index .Config.Labels "org.opencontainers.image.base.digest"}} {{.Created}}' "$IMAGE" 2>/dev/null)"; then
        # Go template index of a missing key prints "<no value>" (with a
        # space inside); strip it before the split so the pre-label
        # branch fires (EGL-254, same predicate as the engine's probe).
        [[ "$ins" == "<no value>"* ]] && ins="${ins#"<no value>"}"
        if [[ "$ins" == *\ * ]]; then
            base="${ins%% *}"
            created="${ins#* }"
        else
            base="$ins"
        fi
    fi
fi

build=0
reason=""
below_floor=0
floor=""
built="${created:0:10}"
if [[ "$state" != present ]]; then
    build=1
    reason="missing"
elif [[ -z "$base" || -z "$pin" || "$base" != "$pin" ]]; then
    build=1
    if [[ -z "$base" ]]; then
        reason="unknown"
    else
        reason="stale"
    fi
fi
# EGL-487-D4: below the recorded security floor is a real refresh even
# when the base pin matches — --no-cache is what makes apt re-fetch the
# unpinned packages. R-EGL-487-2 F2: only an image whose build date is
# at or after the floor proves the floor is satisfied. A missing image,
# a pre-label image (no base label), a missing/unparseable .Created, or
# a below-floor date all get --no-cache — otherwise a surviving
# pre-floor apt layer would be reused and the rebuilt image would look
# fresh to the doctor. A moved pin needs no flag (the FROM digest
# invalidated the layers). Age stays doctor-only.
floor="$(security_floor_date "$dir/security-floor")"
if [[ -n "$floor" ]]; then
    if [[ "$state" != present || -z "$base" || -z "$pin" ]]; then
        build=1
        below_floor=1
    elif [[ "$base" == "$pin" ]] \
         && { [[ ! "$built" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
              || [[ "$built" < "$floor" ]]; }; then
        build=1
        below_floor=1
    fi
fi

if (( ! build && ! force )); then
    echo "already built from deployed pin ${pin_short} — use --force to rebuild"
    exit 0
fi

if (( below_floor && ! force )) && [[ "$built" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
    && [[ "$built" < "$floor" ]]; then
    echo "egl-base image: built ${built} predates the recorded rebuild floor ${floor} — rebuilding with --no-cache"
fi

if (( ! force )); then
    if [[ "$reason" == "missing" ]]; then
        echo "egl-base image: missing ($IMAGE)"
    elif [[ "$reason" == "stale" ]]; then
        img_short="${base#sha256:}"; img_short="${img_short:0:12}"
        echo "egl-base image: stale: base pin moved (image $img_short != deployed pin $pin_short)"
    else
        echo "egl-base image: stale: base unknown (pre-label image)"
    fi
fi

echo "Building $IMAGE FROM ${pin_short}"
extra=()
if (( force || below_floor )); then
    extra+=(--no-cache)
fi
if ! podman_in_root podman build -t "$IMAGE" "${extra[@]}" -f "$dir/Containerfile" "$dir"; then
    retry="$(printf '%q' "$dir/build-egl-base")"
    if (( force )); then
        retry="$retry --force"
    fi
    echo "Error: egl-base image build failed for $IMAGE (build output above); fix the cause and re-run: $retry" >&2
    exit 1
fi
echo "Done: $IMAGE"
