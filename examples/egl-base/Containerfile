# Shared example image for the quickstarts. The FROM line must stay
# byte-equal to gateway/Containerfile (tests/test-engine.sh D3.2).
# No build tools.
FROM docker.io/library/debian:13-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
# Base identity on the built artifact (the digest must equal the FROM
# above — the kit pin test fails on drift): build-egl-base reads it to
# flag a stale example image after this pin moves.
LABEL org.opencontainers.image.base.name="docker.io/library/debian:13-slim"
LABEL org.opencontainers.image.base.digest="sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2"
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        dnsutils \
        git \
        iputils-ping \
        ncat \
        openssh-client \
        rsync \
    && rm -rf /var/lib/apt/lists/*
