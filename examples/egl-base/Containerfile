# Shared example image for the quickstarts. The FROM line must stay
# byte-equal to gateway/Containerfile (tests/test-engine.sh D3.2).
# No build tools.
FROM docker.io/library/debian:13-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
# Base identity on the built artifact (the digest must equal the FROM
# above — the kit pin test fails on drift): build-egl-base reads it to
# flag a stale example image after this pin moves.
LABEL org.opencontainers.image.base.name="docker.io/library/debian:13-slim"
LABEL org.opencontainers.image.base.digest="sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad"
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        dnsutils \
        git \
        iputils-ping \
        ncat \
        openssh-client \
        rsync \
    && rm -rf /var/lib/apt/lists/*
