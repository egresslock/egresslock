# Agent container for the agentic-tool-opencode recipe.
#
# The profile's fail-closed policy applies at runtime, not build time;
# attach the container to the profile network per the recipe.
FROM docker.io/library/debian:13-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        coreutils \
        curl \
        git \
        wget \
        xz-utils \
        openssh-client \
        build-essential \
        jq \
        less \
        procps \
        python3 \
        python3-pip \
        python3-venv \
        ripgrep \
        tmux \
        vim \
        nodejs \
        npm \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g opencode-ai
WORKDIR /workspace