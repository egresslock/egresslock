#!/usr/bin/env bash
#
# egresslock-verify — periodic policy verification for one account.
# The instanced timer unit `egresslock-verify@<account>.service` runs
# this as the account.
#
# Hybrid verify modes:
#   - EGRESSLOCK_PROFILE set    -> verify exactly that profile (the
#                             engine reads <account-home>/.config/egresslock/
#                             <profile>.conf; a missing network FAILS:
#                             drift/teardown signal).
#   - EGRESSLOCK_PROFILE unset  -> bare `egresslock verify --ensured`:
#                             verify every profile whose anchor is
#                             running; none running exits 0 silently.
#                             The engine aggregates every *.conf in the
#                             account's fixed confdir
#                             (<passwd-home>/.config/egresslock).
#
# There is no conf-path wiring: the engine warns about a set
# EGRESSLOCK_CONF (retired selector; it is not read) and it is not
# required here. unit.env is the wiring witness the doctor checks; in
# named mode it carries EGRESSLOCK_PROFILE.
#
# Environment:
#   EGRESSLOCK_DIR     engine resolution: this var >
#                         /opt/egresslock > this script's directory.
#   EGRESSLOCK_PROFILE         optional profile name (named-verify mode).
#
# Options:
#   -h, --help            print this help
#
# Defaults that are not parameter-changeable:
#   - XDG_RUNTIME_DIR is forced to /run/user/$(id -u) (systemd %U does
#     not expand per-User=; rootless Podman needs the account's own
#     runtime dir, kept alive by linger)
#   - EGRESSLOCK_PROFILE unset -> verify --ensured, which exits 0 silently
#     when no anchors are running (silence = nothing ensured)

set -euo pipefail

usage() { awk 'NR>1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"; }
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

# ARC-16-D9.1 (amended): systemd's %U specifier does not expand per-User=
# (same failure class as %h), so the unit must NOT supply
# XDG_RUNTIME_DIR — resolve it here from the executing uid. Rootless
# Podman requires the account's own runtime dir (/run/user/<uid>, kept
# alive by linger). Assigned before export so an id -u failure cannot
# silently mask a void XDG_RUNTIME_DIR under set -eou pipefail (SC2155).
#
# EGL-176-D2: this resolution and the ARC-16-D4 engine-dir chain are
# deliberately duplicated in egresslock-start; the shareable surface is
# ~15 lines and the env-guard sets differ, so a shared sourced fragment
# was rejected (a new shipped file with packaging/install/test deltas).
# Keep the two copies in sync.
_euid="$(id -u)"
export XDG_RUNTIME_DIR="/run/user/$_euid"

if [[ -n "${EGRESSLOCK_DIR:-}" ]]; then
    kit_dir="$EGRESSLOCK_DIR"
elif [[ -x /opt/egresslock/egresslock ]]; then
    kit_dir=/opt/egresslock
else
    kit_dir="$(CDPATH='' cd -- "$(dirname "$0")" && pwd)"
fi
tool="$kit_dir/egresslock"

[[ -x "$tool" ]] || {
    echo "egresslock-verify: egresslock not found/executable: $tool" >&2
    exit 1
}

# ARC-26: same netns preflight as the engine, so the timer's
# drift-signal failure is not misread as policy drift when the cause is
# a broken shared netns (e.g. enforce-mode AppArmor pasta profile).
# EGL-78-D1/D3: bound the probe like the engine — a wedged
# `podman unshare --rootless-netns true` is a named failure after 5s,
# never an indefinite block. Skippable in the mock harness.
if [[ "${EGRESSLOCK_SKIP_NETNS_PROBE:-0}" != "1" ]]; then
    if ! command -v timeout >/dev/null 2>&1; then
        echo "egresslock-verify: timeout(1) (coreutils) is required for the netns probe but was not found in PATH" >&2
        exit 1
    fi
    # EGL-378-D4/D5: the probe runs from / for the same reason the
    # engine's runtime calls do (rootless podman re-enters the inherited
    # CWD as the account at startup); fail closed, named, before it runs.
    # R-EGL-378-8: podman reads path-valued settings at startup, so a
    # relative value must keep its invocation-directory meaning across
    # the cd — same list/idiom as the engine's rt_absolutize_podman_env.
    vprobe_env() {
        local v val
        for v in CONTAINERS_CONF CONTAINERS_CONF_OVERRIDE \
                 CONTAINERS_REGISTRIES_CONF CONTAINERS_STORAGE_CONF \
                 CONTAINERS_HELPER_BINARY_DIR PODMAN_CONNECTIONS_CONF \
                 CONTAINER_SSHKEY REGISTRY_AUTH_FILE TMPDIR \
                 XDG_CONFIG_HOME XDG_DATA_HOME XDG_RUNTIME_DIR; do
            val="${!v:-}"
            [[ -n "$val" && "$val" != /* ]] || continue
            printf -v "$v" '%s/%s' "${PWD%/}" "$val"
            export "${v?}"
        done
    }
    if ! ( cd / ) 2>/dev/null; then
        echo "egresslock-verify: cannot change directory to / before the netns probe; the probe was not run" >&2
        exit 1
    fi
    vprc=0
    vout="$( ( vprobe_env; cd / && timeout 5 podman unshare --rootless-netns true ) 2>&1)" || vprc=$?
    if (( vprc == 124 )); then
        echo "egresslock-verify: netns probe timed out after 5s (probe: 'timeout 5 podman unshare --rootless-netns true'); the rootless netns is not answering — check pasta/podman health before retrying" >&2
        exit 1
    elif (( vprc != 0 )); then
        # EGL-347-D1: same routing as the engine's netns_probe — report
        # podman's own error, then the doctor's AppArmor shape rule
        # (rc 126 / permission denied) with the `cannot chdir to`
        # exclusion, then the netns pointer. The disruptive
        # `systemctl restart user@` fallback is gone (session guidance
        # lives in the page).
        vmsg() { printf 'egresslock-verify: %s\n' "$*" >&2; }
        vmsg "Error: podman rootless-netns is broken for this user (probe:"
        vmsg "  'podman unshare --rootless-netns true', rc=$vprc):"
        if [[ -n "$vout" ]]; then
            while IFS= read -r vline; do
                vmsg "  $vline"
            done <<<"$vout"
        else
            vmsg "  (probe printed no output)"
        fi
        if { (( vprc == 126 )) || grep -qi 'permission denied' <<<"$vout"; } \
            && ! grep -qi 'cannot chdir to' <<<"$vout"; then
            vmsg "Check whether AppArmor is the cause:"
            vmsg "  sudo egresslock-setup apparmor check"
            vmsg "  If it reports \"podman label: labeled\" and"
            vmsg "  \"pasta amendment: required on this host\", run:"
            vmsg "  sudo egresslock-setup apparmor add"
            vmsg "  If it reports \"podman label: unlabeled\" or"
            vmsg "  \"pasta amendment: not required ...\", this is not AppArmor:"
            vmsg "  check the account session — see"
            vmsg "  docs/troubleshooting/pasta-apparmor"
            vmsg "  If it reports \"condition unknown\", see"
            vmsg "  docs/troubleshooting/pasta-apparmor (Diagnosis)"
            vmsg "Then re-run the probe. If it still fails, see"
            vmsg "docs/troubleshooting/pasta-apparmor"
        else
            vmsg "Check podman's output above; for shared-netns checks see"
            vmsg "docs/troubleshooting/netns-inspection"
        fi
        vmsg "Do NOT reinstall the kit — nothing is installed wrong."
        exit 1
    fi
fi

if [[ -n "${EGRESSLOCK_PROFILE:-}" ]]; then
    exec "$tool" verify "$EGRESSLOCK_PROFILE"
fi
# Sweep mode: bare --ensured; the engine aggregates the account confdir.
exec "$tool" verify --ensured
