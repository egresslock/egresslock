#!/usr/bin/env bash
#
# build-gateway — build the egresslock-gateway allowlist proxy image.
# Independent of the dev-base chain: debian:13-slim + distro squid.
#
# Supply chain: the base is pinned by digest in gateway/Containerfile
# (docker.io/library/debian:13-slim@sha256:...) so a rebuild cannot
# float to new base content; refresh the digest deliberately (new digest
# = new recorded review). The `squid` apt package stays UNPINNED on
# purpose so rebuilds take distro security updates.
#
# Options:
#   -h, --help   print this help
#
# Environment:
#   IMAGE   gateway image tag (default: localhost/egresslock-gateway:latest)
#
# Defaults that are not parameter-changeable:
#   - builds with --format docker: the OCI image format silently drops
#     HEALTHCHECK (an OCI format limitation)
#   - build context: the gateway/ directory NEXT TO THIS SCRIPT
#     (Containerfile, squid.conf, entrypoint) — the repo root, an
#     installed prefix, or a tarball tree, whatever the script is
#     deployed in — never the caller's current directory

set -euo pipefail

usage() { awk 'NR>1 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "$0"; }
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

IMAGE="${IMAGE:-localhost/egresslock-gateway:latest}"
# CDPATH='' keeps a caller-exported CDPATH from redirecting this
# engine-neighbor lookup (R-EGL-378-10): the context is always the
# gateway/ directory next to this script.
gw_dir="$(CDPATH='' cd -- "$(dirname "$0")" && pwd)/gateway"
[[ -f "$gw_dir/Containerfile" ]] || {
    echo "build-gateway: no Containerfile at $gw_dir/Containerfile" >&2
    echo "  (the gateway/ build context must sit next to this script)" >&2
    exit 1
}

# EGL-378 R-EGL-378-15: rootless podman re-enters the inherited CWD at
# startup as the account; from a directory the account cannot traverse
# (`sudo -u` from a 0700 home) the call dies with `cannot chdir to <dir>:
# Permission denied` before any work. Run podman from /, and keep the
# invocation-directory meaning of relative path-valued Podman settings
# (same list as the engine's rt_absolutize_podman_env).
podman_in_root() { # podman_in_root cmd [arg...] — run one podman command from /
    (
        local v val
        for v in CONTAINERS_CONF CONTAINERS_CONF_OVERRIDE \
                 CONTAINERS_REGISTRIES_CONF CONTAINERS_STORAGE_CONF \
                 CONTAINERS_HELPER_BINARY_DIR PODMAN_CONNECTIONS_CONF \
                 CONTAINER_SSHKEY REGISTRY_AUTH_FILE TMPDIR \
                 XDG_CONFIG_HOME XDG_DATA_HOME XDG_RUNTIME_DIR; do
            val="${!v:-}"
            [[ -n "$val" && "$val" != /* ]] || continue
            printf -v "$v" '%s/%s' "${PWD%/}" "$val"
            export "${v?}"
        done
        cd / || {
            echo "build-gateway: cannot change directory to / before running the container runtime; no runtime command was run" >&2
            exit 1
        }
        "$@"
    )
}

echo ">> Building ${IMAGE} FROM debian:13-slim"
# --format docker: HEALTHCHECK is not supported by the OCI image format
# and would be silently ignored (ARC-5).
podman_in_root podman build \
    --format docker \
    -t "${IMAGE}" \
    -f "$gw_dir/Containerfile" \
    "$gw_dir"

echo ">> Done: ${IMAGE}"