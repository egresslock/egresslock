marked `requires EGRESSLOCK_KIT_ALLOW_NON_ROOT=1` are ignored without
it: the production default applies, and the engine warns when it
ignores a set override.

  EGRESSLOCK_KIT_ALLOW_NON_ROOT=1
                          allow non-root runs of the harness hooks;
                          test mode is off by default — only exactly
                          1 turns it on, and any other value (e.g.
                          true) warns and leaves test mode off
  EGRESSLOCK_ANCHOR_IMAGE
                          anchor image (default: the digest-pinned
                          alpine fallback; no local image is preferred;
                          requires EGRESSLOCK_KIT_ALLOW_NON_ROOT=1)
  EGRESSLOCK_GW_IMAGE     gateway image (default:
                          localhost/egresslock-gateway:latest;
                          requires EGRESSLOCK_KIT_ALLOW_NON_ROOT=1)
  EGRESSLOCK_SKIP_NETNS_PROBE=1
                          skip the rootless network-namespace preflight
                          check
  EGRESSLOCK_USERNS_SYSCTL
                          `userns:` doctor row sysctl file (default:
                          the kernel's unprivileged-userns sysctl;
                          requires EGRESSLOCK_KIT_ALLOW_NON_ROOT=1)
EOF
            ;;
        *)
            # Callers validate the topic against COMMANDS + config/env
            # (and the hidden `env test` pair); this arm only bounds the
            # function (fail closed if a new topic is added without a
            # page).
            usage_error_help "unknown help topic '$1'."
            exit 2
            ;;
    esac
}

# Profile state (ARC-8): loaded from the strictly-validated config file
# by load_config. There are NO compiled-in profiles (ARC-20) — a profile
# subcommand without a config fails closed in main. The `declare -A`
# attributes matter: load_config's `=()` resets preserve them.
PROFILES=()
declare -A PROFILE_SUBNET=()
declare -A GW_IP=()
declare -A GW_PORT=()
# Per-profile allowlist source, from the config's `gateway` directive.
declare -A GW_ALLOWLIST=()
# Hosts that a profile may reach DIRECTLY (bypassing the proxy) must be
# excluded from proxy env vars, or proxy-honoring clients would send
# allowed traffic into the denying Squid ACL (ARC-6 finding).
declare -A PROFILE_NO_PROXY_EXTRA=()
# EGL-116-D1: per-profile Squid read_timeout override (seconds). Set by
# the conf's `read-timeout <seconds>` directive; defaulted to 900 (Squid
# stock, 15 minutes) at block close (cfg_block_end) for every profile. The generated
# squid.conf always emits the value explicitly — never silent stock
# inherit.
declare -A PROFILE_READ_TIMEOUT=()

TABLE="egresslock"
# ARC-14: site host defaults live in the CONF DATA, not the binary — the
# engine never assigns a site host or any fleet default. Conf host fields
# are literals (EGL-454); fleet variance is generated before `ensure`, so
# no environment lookup can leak a site name into a public conf.

# Config selection (EGL-325): there is exactly one config directory per
# account — <passwd-home>/.config/egresslock — and one conf per profile,
# named <profile>.conf. There is NO file selector (--config is a usage
# error, rc 2; EGRESSLOCK_CONF is retired — setting it warns and it is
# never read) and no config-directory option.
# ENGINE_CONF is the resolved file for the current invocation.
ENGINE_CONF=""
# ARC-37-D3: profile name -> conf file it was loaded from, so a
# cross-file duplicate error can name the earlier file exactly.
declare -A PROFILE_CONF=()

gw_name() { echo "egresslock-gateway-$1"; }

# EGL-393: the reserved name every generated gateway config answers with a
# 302 whose Location carries the deployed configuration's live-probe token.
# RFC 2606 reserves `.invalid`; the dest-only deny is the enforcement, so
# an allowlist entry for it can never be forwarded. One constant is shared
# by generation (the probe block), verify (the loopback GET), and
# `denied` (the log filter).
GW_LIVE_PROBE_DOMAIN=egresslock-probe.invalid

# EGL-123-D3: the kit's pinned gateway MAC, derived from conf identity
# (profile name + gateway IP) so the nft exemption compiles WITHOUT a
# running container (EGL-91: policy before gateway start). Material is
# exactly "profile|GW_IP": 02: (locally administered, unicast) + the
# first 5 digest bytes as lowercase colon-hex. Hermetic, not configured.
gw_mac() { # gw_mac <profile>
    local digest
    digest="$(printf '%s' "${1}|${GW_IP[$1]}" | sha256sum | cut -d' ' -f1)"
    echo "02:${digest:0:2}:${digest:2:2}:${digest:4:2}:${digest:6:2}:${digest:8:2}"
}

die() { echo "Error: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Runtime adapter (EGL-175): the seam between core policy semantics and
# the container runtime. Core never invokes podman directly — every podman
# invocation lives in an rt_* primitive below, called by the lifecycle
# wrappers (netns_nft, ensure_network, gw_start, cmd_doctor, ...). The
# grep-gate in tests/test-engine.sh (EGL-175-D12) enforces the boundary;
# the runtime-backend contract is the backend contract. Podman is the only
# backend (D2/D8); a second is future work against the contract.
# ---------------------------------------------------------------------------
# EGL-378 R-EGL-378-8: podman resolves these path-valued settings at
# startup against the inherited CWD (the invocation directory today).
# The runtime command itself runs from / after D1, so absolutize every
# non-empty relative value at $PWD first — the same file/directory keeps
# its invocation-directory meaning instead of becoming `/…` or missing.
# Empty values keep podman's defaults. Relative PATH entries remain
# unsupported (D6 accepted edge): command words are resolved by the
# child from /, not from the invocation directory.
rt_absolutize_podman_env() {
    local v val
    for v in CONTAINERS_CONF CONTAINERS_CONF_OVERRIDE \
             CONTAINERS_REGISTRIES_CONF CONTAINERS_STORAGE_CONF \
             CONTAINERS_HELPER_BINARY_DIR PODMAN_CONNECTIONS_CONF \
             CONTAINER_SSHKEY REGISTRY_AUTH_FILE TMPDIR \
             XDG_CONFIG_HOME XDG_DATA_HOME XDG_RUNTIME_DIR; do
        val="${!v:-}"
        [[ -n "$val" && "$val" != /* ]] || continue
        printf -v "$v" '%s/%s' "${PWD%/}" "$val"
        export "${v?}"
    done
}

# EGL-378-D1/D5: every runtime command runs from / in a throwaway
# subshell. Rootless podman re-enters the inherited CWD at startup as
# the account; a directory the account cannot traverse (`sudo -u` from a
# 0700 home) kills the call with `cannot chdir to <dir>: Permission
# denied`. The engine process itself never chdirs (EGL-305), so relative
# arguments it resolves keep the invocation-directory basis.
rt_in_root() { # rt_in_root cmd [arg...] — run one runtime command from /
    (
        rt_absolutize_podman_env
        cd / || {
            echo "Error: cannot change directory to / before running the container runtime; no runtime command was run" >&2
            exit 1
        }
        "$@"
    )
}

rt_unshare() { # rt_unshare [-t SECONDS] cmd [arg...] — run cmd in the rootless netns
    local t=""
    if [[ "${1:-}" == "-t" ]]; then
        t="$2"
        shift 2
    fi
    if [[ -n "$t" ]]; then
        rt_in_root timeout "$t" podman unshare --rootless-netns "$@"
    else
        rt_in_root podman unshare --rootless-netns "$@"
    fi
}

rt_image_exists() { # rt_image_exists <image> — rc 0 when the image exists locally
    rt_in_root podman image exists "$1"
}

rt_image_inspect() { # rt_image_inspect <image> <go-template> — EGL-206-D2a image-level inspect
    rt_in_root podman image inspect --format "$2" "$1"
