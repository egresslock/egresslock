#!/usr/bin/env bash
#
# egresslock — restricted egress for agent accounts.
#
# Help lives in code: `egresslock --help` (alias `egresslock help`)
# prints the one-page command summary; `egresslock help <command>` prints
# one command's page; `help config` / `help env` are the configuration
# and environment references.
#
# Each restricted profile is a dedicated bridge network with a fixed
# subnet plus a fail-closed nftables policy in the rootless Podman network
# namespace. All rootless bridge networks of this user share ONE rootless
# netns, so every policy rule is scoped with `ip saddr <subnet>` to never
# affect other networks.
#
# The rootless netns (and all nftables state in it) is destroyed when the
# last container stops, so policy is NEVER assumed to persist: `ensure`
# creates the network, starts an anchor container that keeps the netns
# alive, installs/refreshes the policy, and verifies it.

set -euo pipefail

# The user-facing command list — the single source feeding the summary
# index, the short-usage line, and `help` topic validation. A command
# added here also needs a CMD_INDEX line and a help_topic page.
COMMANDS=(ensure verify network proxy-env rules allowlist denied allow disallow allow-host disallow-host drop-unauthorized init list doctor build-gateway teardown)

# One summary-index line per command (keyed by command; order from
# COMMANDS). Every line is runnable as printed (next-action contract).
declare -A CMD_INDEX=(
    [ensure]='egresslock ensure [--replace-gateway] <profile>  network + anchor + policy + verify'
    [verify]='egresslock verify <profile>                      verify only (exit 1 = fail closed; --ensured checks every profile)'
    [network]='egresslock network <profile>                     print the Podman network name'
    [proxy-env]='egresslock proxy-env <profile> [token]           proxy env assignments (tokens: proxyip|proxyport|noproxy); --out[=<path>] writes the env file'
    [rules]='egresslock rules <profile>                       print the nftables policy'
    [allowlist]='egresslock allowlist <profile>                   print the allowlist file (raw)'
    [denied]='egresslock denied <profile> [--all] [--days N]   hosts the gateway denied (--all: raw; --days: window)'
    [allow]='egresslock allow <profile> <host...>             append allowlist entries + re-ensure'
    [disallow]='egresslock disallow <profile> <host...>          remove allowlist entries + re-ensure'
    [allow-host]='egresslock allow-host <profile> <host:port>      add a direct allow rule'
    [disallow-host]='egresslock disallow-host <profile> <host:port>   remove a direct allow rule (kills that rule'"'"'s flows)'
    [drop-unauthorized]='egresslock drop-unauthorized <profile> <port>     end leftover connections the policy no longer allows'
    [init]='egresslock init <name> [--subnet <cidr>]         write a starter conf pair'
    [list]='egresslock list                                  list profiles'
    [doctor]='egresslock doctor                                host environment probe'
    [build-gateway]='egresslock build-gateway [--force]               rebuild the gateway image'
    [teardown]='egresslock teardown [profile|all]                stop the anchor, remove network(s); --runtime = no-conf sweep'
)

in_commands() { # in_commands <name> — true when <name> is a user command
    local c
    for c in "${COMMANDS[@]}"; do
        [[ "$c" == "$1" ]] && return 0
    done
    return 1
}

usage() {
    # Concise summary: a one-page command index that points at
    # `egresslock help <command>` and the config / env topics. The name
    # is unchanged so error-path call sites keep using it.
    echo "Usage:"
    echo "  egresslock <command> [args...]"
    echo
    echo "egresslock — restricted egress for agent accounts."
    echo "Run 'egresslock help <command>' for one command's details, or"
    echo "'egresslock help config' / 'egresslock help env' for the"
    echo "configuration and environment reference."
    echo
    echo "Commands:"
    local c
    for c in "${COMMANDS[@]}"; do
        echo "  ${CMD_INDEX[$c]}"
    done
    echo "  egresslock --help / -h / help                    this list"
    echo "  egresslock --version                             kit stamp (or 'dev')"
}

# Short usage: the command index only (no topics/prose), for a bare
# invocation or an unknown-command argument-error. Lists the commands so
# a caller who typed the wrong thing sees what is available.
short_usage() {
    echo "usage: egresslock <command> [args...]"
    echo "commands: ${COMMANDS[*]}"
    echo "run 'egresslock help <command>' for one command's details"
}

# Per-command help: `egresslock help [<topic>]`. Config-free and
# root-safe by construction (the dispatcher routes this like
# --help/--version: no root guard, no conf loading, no resolution
# line). Topics: the commands above plus the reference topics
# `config` (profile configuration + the four-layer checks block)
# and `env` (the complete environment-overrides reference).
cmd_help() {
    if [[ $# -gt 1 ]]; then
        echo "Error: egresslock help takes at most one topic." >&2
        short_usage >&2
        exit 2
    fi
    local topic="${1:-}"
    if [[ -z "$topic" ]]; then
        usage
        return 0
    fi
    if in_commands "$topic" || [[ "$topic" == "config" || "$topic" == "env" ]]; then
        help_topic "$topic"
        return 0
    fi
    echo "Error: unknown help topic '$topic'." >&2
    short_usage >&2
    exit 2
}

# One here-doc per topic. Per-command pages follow one template
# (usage lead line, relocated prose, Arguments and flags, Example,
# Exit codes). All text is operator UI: no ticket/process IDs
# (EGL-59 class) on any surface.
help_topic() { # help_topic <topic>
    case "$1" in
        ensure)
            cat <<'EOF'
egresslock ensure [--replace-gateway] <profile>

Brings a profile to its enforced state: creates the Podman network,
starts the anchor container that keeps the rootless netns alive,
installs/refreshes the nftables policy, and verifies it. An
already-converged profile is non-disruptive: healthy containers are
kept, no session is severed.

Arguments and flags:
  <profile>               profile to converge (required)
  --replace-gateway       same as ensure, but replace the running
                          gateway even when it is healthy (sessions
                          drop until the new container answers). Both
                          flag positions are legal; a duplicate flag
                          is a usage error. A missing or
                          checkpoint-annotated target image is refused
                          before the old gateway container is removed —
                          earlier ensure steps (network / anchor / nft /
                          pins) are NOT undone; no rollback.

Example:
  egresslock ensure main

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        verify)
            cat <<'EOF'
egresslock verify <profile>

Verify only: checks that the profile's network, anchor container, and
nftables policy are in place and healthy. Exit 1 = fail closed —
do not start an agent against a profile that fails verify.

With --ensured (no profile argument) the check aggregates every
profile conf in the default config folder.

Arguments and flags:
  <profile>    profile to verify (required without --ensured)
  --ensured    bare aggregate check over every *.conf; takes no
               profile argument

Example:
  egresslock verify main

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        network)
            cat <<'EOF'
egresslock network <profile>

Print the profile's Podman network name.

Arguments and flags:
  <profile>    profile to look up (required)

Example:
  egresslock network main

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        proxy-env)
            cat <<'EOF'
egresslock proxy-env <profile> [token]

Print proxy environment assignments for the profile. Tokens select a
single value: proxyip | proxyport | noproxy.

With --out[=<path>] the assignments are written to a file (mode 0600;
default: the account runtime dir) and its path is printed instead.
An explicit --out=<path> is refused if its directory is
world-writable; a directory your group can also write to is accepted
for now, so shared group directories keep working — a future release
may tighten this. The runtime-dir default always qualifies.

Arguments and flags:
  <profile>            profile (required)
  token                proxyip | proxyport | noproxy
  --out[=<path>]       write the env file and print its path

Example:
  egresslock proxy-env main

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        rules)
            cat <<'EOF'
egresslock rules <profile>

Print the profile's nftables policy.

Arguments and flags:
  <profile>    profile (required)

Example:
  egresslock rules main

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        allowlist)
            cat <<'EOF'
egresslock allowlist <profile>

Print the profile's allowlist file (raw).

Arguments and flags:
  <profile>    profile (required)

Example:
  egresslock allowlist main

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        denied)
            cat <<'EOF'
egresslock denied <profile> [--all] [--days N]

Hosts the gateway denied in the log window. --all prints the raw log
(including allowlisted hosts); --days N limits the window (0 = full
log, default 14 days).

Arguments and flags:
  <profile>    profile (required)
  --all        raw log, including allowlisted hosts
  --days N     window in days (0 = full log; default 14)

Example:
  egresslock denied main

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        allow)
            cat <<'EOF'
egresslock allow <profile> <host...>

Append allowlist entries and re-ensure the profile.

Arguments and flags:
  <profile>    profile (required)
  <host...>    one or more hosts to allow

Example:
  egresslock allow main git.example.test

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        disallow)
            cat <<'EOF'
egresslock disallow <profile> <host...>

Remove allowlist entries and re-ensure the profile.

Arguments and flags:
  <profile>    profile (required)
  <host...>    one or more hosts to remove

Example:
  egresslock disallow main git.example.test

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        allow-host)
            cat <<'EOF'
egresslock allow-host <profile> <host:port>

Add a direct allow rule (host:port bypasses the proxy).

Arguments and flags:
  <profile>     profile (required)
  <host:port>   host and port to allow directly

Example:
  egresslock allow-host main db.example.test:5432

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        disallow-host)
            cat <<'EOF'
egresslock disallow-host <profile> <host:port>

Remove a direct allow rule. Removing the rule also ends the established
direct flows it allowed, including flows to addresses it used
before a DNS refresh changed them, except flows to a destination the
policy still allows on the same TCP port (a conntrack delete after the
atomic swap; ensure/refresh keep direct flows).

Arguments and flags:
  <profile>     profile (required)
  <host:port>   host and port to revoke

Example:
  egresslock disallow-host main db.example.test:5432

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        drop-unauthorized)
            cat <<'EOF'
egresslock drop-unauthorized <profile> <port>

End the leftover connections on a port that the profile's policy no
longer allows. This is the recovery step printed when a disallow-host
fails after removing the rule but before it can end the connections:
it reads the live firewall rules, ends the connections on <port> that
the policy no longer allows (including connections to addresses a
rule allowed before a DNS refresh changed them), keeps the
connections the policy still allows, and prints success only after a
fresh check finds none left. Safe to run again.

Arguments and flags:
  <profile>     profile (required)
  <port>        TCP port to check (1-65535)

Example:
  egresslock drop-unauthorized main 5432

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        init)
            cat <<'EOF'
egresslock init <name> [--subnet <cidr>]

Write a starter config pair (profile conf + rules conf).

Arguments and flags:
  <name>               profile name (required)
  --subnet <cidr>      network subnet for the starter conf

Example:
  egresslock init work --subnet 10.199.1.0/24

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        list)
            cat <<'EOF'
egresslock list

List the profiles configured for this account.

Example:
  egresslock list

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        doctor)
            cat <<'EOF'
egresslock doctor

Host environment probe: podman, netavark, nft, unprivileged userns
(+ advisory lines: backend, rootless netns, gateway image base).
Kit/apparmor checks live in egresslock-setup (see
'egresslock-setup --help').

Arguments and flags:
  (none — doctor takes no arguments)

Example:
  egresslock doctor

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        build-gateway)
            cat <<'EOF'
egresslock build-gateway [--force]

Rebuild the gateway image into this account's store from the engine's
neighbor gateway/ directory. No conf is loaded. --force rebuilds even
when the image matches the deployed pin.

Arguments and flags:
  --force    rebuild even when the image matches the deployed pin

Example:
  egresslock build-gateway

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        teardown)
            cat <<'EOF'
egresslock teardown [profile|all]

Stop the anchor container and remove the profile's network(s).
teardown all stays main.conf-only.

With --runtime the sweep needs NO conf: it removes kit containers
and networks of BOTH name generations plus our nft tables by name
scan (the recovery when the conf is already gone).

Arguments and flags:
  [profile|all]    profile to tear down, or all
  --runtime        no-conf sweep (ignores any conf)

Example:
  egresslock teardown main

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        config)
            cat <<'EOF'
Profile configuration

Profiles, rules, and gateways come from a strictly-validated
declarative config file. A config is REQUIRED: the engine has no
compiled-in profiles. One unix account has ONE config directory,
always <account-home>/.config/egresslock (the account home comes from
the passwd database, not the $HOME variable, so a different HOME
cannot move the config directory). Each profile lives in
<account-home>/.config/egresslock/<profile>.conf, and the file's
basename MUST equal the single `profile` it defines (one profile per
file). A profile subcommand without its file exits 2 with
`no profile config`. Bare `list` and bare `verify --ensured`
aggregate every *.conf there; bare `teardown all` stays
main.conf-only. `teardown --runtime` is the exception: it loads NO
conf at all and sweeps kit containers/networks of BOTH name
generations by name scan (the recovery when the conf is already
gone). Prints exactly ONE stderr resolution line on every
conf-resolving invocation (every time, TTY-independent): `using
config <path>` (named) or `using configs in <dir> (N profiles)`
(confdir aggregate). See examples/main.conf for a worked config
grammar example.

Which check answers which question — four commands, four layers:
  checks:
    egresslock doctor                      host env (podman/nft/userns)
    egresslock-setup doctor [--account]    kit/account wiring
    egresslock-setup apparmor check        pasta AppArmor patch
    egresslock verify <profile>            profile runtime (fail-closed)
EOF
            ;;
        env)
            cat <<'EOF'
Environment overrides (for testing):
  NFT_BIN                absolute path to nft (default: /usr/sbin/nft,
                          then $PATH)
  CONNTRACK_BIN          absolute path to conntrack (default:
                          /usr/sbin/conntrack, then $PATH) — required
                          by `disallow-host`'s revocation flush
  EGRESSLOCK_ANCHOR_IMAGE     anchor image (default: base image or alpine)
  EGRESSLOCK_GW_IMAGE         gateway image (default:
                          localhost/egresslock-gateway:latest)
  EGRESSLOCK_ALLOW_ROOT=1
                          allow running as root (NOT recommended — root's
                          Podman store/netns is not an account)
  EGRESSLOCK_SKIP_NETNS_PROBE=1
                          skip the rootless-netns preflight probe
                          (test harness only)
  EGRESSLOCK_GW_LOG_MAX_BYTES
                          gateway log rotation cap in bytes
                          (default 32 MiB; 0 = no cap)
  EGRESSLOCK_DENIED_MAX_BYTES
                          `denied` log-read cap in bytes — the newest
                          N bytes are read, partial first line dropped
                          (default 32 MiB; 0 = the full log)
  EGRESSLOCK_LOCK_WAIT   seconds to wait for the account lock before a
                          writer fails closed (default 30; `verify`
                          waits 5 and then proceeds without it;
                          0 = don't wait)
EOF
            ;;
        *)
            # Callers validate the topic against COMMANDS + config/env;
            # this arm only bounds the function (fail closed if a new
            # topic is added without a page).
            echo "Error: unknown help topic '$1'." >&2
            short_usage >&2
            exit 2
            ;;
    esac
}

# Profile state (ARC-8): loaded from the strictly-validated config file
# by load_config. There are NO compiled-in profiles (ARC-20) — a profile
# subcommand without a config fails closed in main. The `declare -A`
# attributes matter: load_config's `=()` resets preserve them.
PROFILES=()
declare -A PROFILE_SUBNET=()
declare -A GW_IP=()
declare -A GW_PORT=()
# Per-profile allowlist source, from the config's `gateway` directive.
declare -A GW_ALLOWLIST=()
# Hosts that a profile may reach DIRECTLY (bypassing the proxy) must be
# excluded from proxy env vars, or proxy-honoring clients would send
# allowed traffic into the denying Squid ACL (ARC-6 finding).
declare -A PROFILE_NO_PROXY_EXTRA=()
# EGL-116-D1: per-profile Squid read_timeout override (seconds). Set by
# the conf's `read-timeout <seconds>` directive; defaulted to 900 (Squid
# stock, 15 minutes) at block close (cfg_block_end) for every profile. The generated
# squid.conf always emits the value explicitly — never silent stock
# inherit.
declare -A PROFILE_READ_TIMEOUT=()

TABLE="egresslock"
# ARC-14: site host defaults live in the CONF DATA, not the binary — the
# engine never assigns the site host vars or any fleet default. A bare
# ${VAR} with no fallback and no explicit override fails closed in
# cfg_expand instead of leaking fleet names into a public conf; explicit
# env overrides of conf data keep working (ARC-8 data semantics).

# Config selection (EGL-325): there is exactly one config directory per
# account — <passwd-home>/.config/egresslock — and one conf per profile,
# named <profile>.conf. There is NO file selector (the old --config and
# EGRESSLOCK_CONF selectors are gone) and no config-directory option.
# ENGINE_CONF is the resolved file for the current invocation.
ENGINE_CONF=""
# ARC-37-D3: profile name -> conf file it was loaded from, so a
# cross-file duplicate error can name the earlier file exactly.
declare -A PROFILE_CONF=()

gw_name() { echo "egresslock-gateway-$1"; }
is_gateway_profile() { [[ -n "${GW_IP[$1]:-}" ]]; }

# EGL-123-D3: the kit's pinned gateway MAC, derived from conf identity
# (profile name + gateway IP) so the nft exemption compiles WITHOUT a
# running container (EGL-91: policy before gateway start). Material is
# exactly "profile|GW_IP": 02: (locally administered, unicast) + the
# first 5 digest bytes as lowercase colon-hex. Hermetic, not configured.
gw_mac() { # gw_mac <profile>
    local digest
    digest="$(printf '%s' "${1}|${GW_IP[$1]}" | sha256sum | cut -d' ' -f1)"
    echo "02:${digest:0:2}:${digest:2:2}:${digest:4:2}:${digest:6:2}:${digest:8:2}"
}

die() { echo "Error: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Runtime adapter (EGL-175): the seam between core policy semantics and
# the container runtime. Core never invokes podman directly — every podman
# invocation lives in an rt_* primitive below, called by the lifecycle
# wrappers (netns_nft, ensure_network, gw_start, cmd_doctor, ...). The
# grep-gate in tests/test-engine.sh (EGL-175-D12) enforces the boundary;
# internal_docs/RUNTIME_BACKEND_CONTRACT.md is the backend contract. Podman
# is the only backend (D2/D8); a second is future work against the contract.
# ---------------------------------------------------------------------------
rt_unshare() { # rt_unshare [-t SECONDS] cmd [arg...] — run cmd in the rootless netns
    local t=""
    if [[ "${1:-}" == "-t" ]]; then
        t="$2"
        shift 2
    fi
    if [[ -n "$t" ]]; then
        timeout "$t" podman unshare --rootless-netns "$@"
    else
        podman unshare --rootless-netns "$@"
    fi
}

rt_image_exists() { # rt_image_exists <image> — rc 0 when the image exists locally
    podman image exists "$1"
}

rt_image_inspect() { # rt_image_inspect <image> <go-template> — EGL-206-D2a image-level inspect
    podman image inspect --format "$2" "$1"
}

rt_image_pull() { # rt_image_pull <image> — pull a ref into the local store
    podman pull "$1"
}

rt_image_build() { # rt_image_build <image> <containerfile> <context> [extra podman-build flags...]
    # -t immediately after build: the EGL-38 flag-order assert
    # (tests/test-kit.sh) pins `build -t <tag> ... -f <Containerfile>`
    # through the `egresslock-setup build-gateway` alias; docker format
    # keeps one artifact shape (HEALTHCHECK stays inspectable). Optional
    # extra flags append verbatim (R-EGL-222-3 F1: `--no-cache`).
    local img="$1" cf="$2" ctx="$3"
    shift 3
    podman build -t "$img" --format docker -f "$cf" "$ctx" "$@"
}

rt_network_ls() { # rt_network_ls -> kit-network names ({{.Name}} singular, ARC-67-D1)
    podman network ls --format '{{.Name}}'
}

rt_network_inspect() { # rt_network_inspect <net> [go-template] -> JSON or one field
    if (( $# >= 2 )); then
        podman network inspect --format "$2" "$1"
    else
        podman network inspect "$1"
    fi
}

rt_network_create() { # rt_network_create <net> <subnet> <gateway>
    podman network create --subnet "$2" --gateway "$3" "$1"
}

rt_network_rm() { # rt_network_rm <net>
    podman network rm "$1"
}

rt_ps() { # rt_ps [all] — running container names, or every container
    if [[ "${1:-}" == "all" ]]; then
        podman ps -a --format '{{.Names}}'
    else
        podman ps --format '{{.Names}}'
    fi
}

rt_run() { # rt_run <name> [args...] — detached run; the caller owns the argv
    # EGL-227 D10: fd 9 is the account lock (acquire_engine_lock). A
    # detached container daemonizes a grandchild (conmon) that outlives
    # this process; bash does not close-on-exec fd 9, so an inheriting
    # grandchild would keep the flock after the engine exits (account
    # lockout). Close the lock fd in the child only — the parent keeps
    # holding it.
    podman run -d --name "$1" "${@:2}" 9>&-
}

rt_rm() { # rt_rm <name> — force-remove a container
    podman rm -f "$1"
}

rt_rm_retry() { # rt_rm_retry <name> — rm -f with bounded retries (EGL-97)
    local name="$1" i names
    for i in 1 2; do
        rt_rm "$name" >/dev/null 2>&1 && return 0
        # A failed rm -f of a conmon-wedged container leaves it stopped
        # or nearly so (podman <6 saves the state, then errors); a later
        # rm skips the conmon-dependent stop path and succeeds. Retry
        # while the name stays registered; an unreadable probe retries
        # too (fail closed). "Gone" from a successful probe is success.
        if names="$(rt_ps all 2>/dev/null)"; then
            grep -qx "$name" <<<"$names" || return 0
        fi
        sleep 0.5
    done
    rt_rm "$name" # final attempt; the caller owns the output and rc
}

rt_exec() { # rt_exec <container> cmd [arg...] — exec inside a container
    podman exec "$1" "${@:2}"
}

rt_cp() { # rt_cp <src> <dst> — copy into/out of a container
    podman cp "$1" "$2"
}

rt_restart() { # rt_restart <container> <grace-seconds>
    # EGL-227 D10: same guard as rt_run — `podman restart` is a
    # stop+start, and its fresh conmon must outlive the podman client and
    # the engine; an fd-9-inheriting conmon would hold the account lock
    # past engine exit on every apply.
    podman restart -t "$2" "$1" 9>&-
}

rt_inspect() { # rt_inspect <container> <go-template>
    podman inspect "$1" --format "$2"
}

rt_info() { # rt_info -> the runtime's host network backend (doctor row)
    podman info --format '{{.Host.NetworkBackend}}'
}

rt_version() { # rt_version -> the runtime's version line
    podman --version
}

rt_have_runtime() { # rt_have_runtime — rc 0 when the runtime binary is on PATH
    command -v podman >/dev/null 2>&1
}

rt_capabilities() { # rt_capabilities — backend capability flags, one per line (D6)
    cat <<'EOF'
stable-shared-netns
rootless
ns-join
inspect
EOF
}

#
# CIDR helpers (ARC-11-D3): unsigned-32 IPv4 math in pure bash, no
# external dependencies. cidr_parse validates and decomposes a CIDR;
# the result is stored in globals (CIDR_*) because bash cannot return
# multiple values.
#
# cidr_parse return codes (designed for `if ! cidr_parse` + case $rc):
#   0 ok | 1 syntax/not IPv4 | 2 prefixlen outside 8-29 | 3 host bits set
#
cidr_u32() { # "A.B.C.D" -> decimal u32 on stdout
    local IFS=. o1 o2 o3 o4
    read -r o1 o2 o3 o4 <<<"$1"
    echo $(( (o1 << 24) | (o2 << 16) | (o3 << 8) | o4 ))
}

cidr_ip() { # decimal u32 -> "A.B.C.D"
    echo "$(( ($1 >> 24) & 255 )).$(( ($1 >> 16) & 255 )).$(( ($1 >> 8) & 255 )).$(( $1 & 255 ))"
}

cidr_parse() { # cidr_parse <A.B.C.D/P>  (prefixlen 8-29, canonical network)
    local cidr="$1" addr plen u32 mask net
    [[ "$cidr" =~ ^([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})/([0-9]{1,2})$ ]] || return 1
    addr="${BASH_REMATCH[1]}"
    plen="${BASH_REMATCH[2]}"
    (( plen >= 8 && plen <= 29 )) || return 2
    cfg_is_ipv4 "$addr" || return 1
    u32="$(cidr_u32 "$addr")"
    mask=$(( 0xFFFFFFFF << (32 - plen) & 0xFFFFFFFF ))
    net=$(( u32 & mask ))
    # Canonical network address required: host bits set is a config error,
    # not a silent re-render (fail closed per ARC-11-D3).
    (( u32 == net )) || return 3
    CIDR_PLEN=$plen
    CIDR_NETWORK=$net
    CIDR_BCAST=$(( net | (0xFFFFFFFF >> plen & 0xFFFFFFFF) ))
    CIDR_FIRST=$(( net + 1 ))   # bridge gateway (DNS allow target)
    CIDR_LAST=$(( CIDR_BCAST - 1 ))  # anchor address
    return 0
}

# True if two parsed CIDRs share any address space (operands: the two
# FIRST/LAST usable ranges; callers keep the parsed values).
cidr_overlaps() { # cidr_overlaps <first1> <last1> <first2> <last2>
    (( $1 <= $4 && $3 <= $2 ))
}

#
# Relaxed parse for FOREIGN networks in the overlap scan (R-011-1
# finding 1): accepts any prefixlen 0-32, canonical or not, and yields
# the occupied range as CIDR_FIRST..CIDR_LAST. Configured profiles
# still go through the strict cidr_parse (8-29, canonical); the scan
# must not silently skip foreign subnets merely because the profile
# policy would reject them.
#
cidr_parse_any() { # cidr_parse_any <A.B.C.D/P>
    local cidr="$1" addr plen u32 mask net
    [[ "$cidr" =~ ^([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})/([0-9]{1,2})$ ]] || return 1
    addr="${BASH_REMATCH[1]}"
    plen="${BASH_REMATCH[2]}"
    (( plen <= 32 )) || return 1
    cfg_is_ipv4 "$addr" || return 1
    u32="$(cidr_u32 "$addr")"
    if (( plen == 0 )); then
        mask=0
    else
        mask=$(( 0xFFFFFFFF << (32 - plen) & 0xFFFFFFFF ))
    fi
    net=$(( u32 & mask ))
    CIDR_FIRST=$net
    CIDR_LAST=$(( net | (0xFFFFFFFF >> plen & 0xFFFFFFFF) ))
    return 0
}

is_profile() {
    local p
    for p in "${PROFILES[@]}"; do
        [[ "$p" == "$1" ]] && return 0
    done
    return 1
}

require_profile() {
    # require_profile <profile> [<command-name>]
    # The command name is used only to give a precise usage line when the
    # profile argument is missing (a missing profile is an argument error,
    # not an unknown-profile error).
    local cmdname="${2:-}"
    if [[ $# -lt 1 || -z "$1" ]]; then
        if [[ -n "$cmdname" ]]; then
            echo "Error: $cmdname requires a profile name." >&2
            echo "usage: egresslock $cmdname <profile>" >&2
        else
            echo "Error: a profile name is required." >&2
            echo "run 'egresslock help' for the command list" >&2
        fi
        exit 2
    fi
    is_profile "$1" || {
        echo "Error: unknown profile '$1' (known: ${PROFILES[*]})" >&2
        exit 2
    }
}

require_nonroot() {
    # ARC-25: fail closed when run as root — root's Podman store/netns is
    # a separate world from every account's. Accounts execute the engine;
    # root only distributes the kit (ARC-7-D5). Escape hatch for
    # intentional root use (not recommended). Shared by the dispatcher's
    # per-command-class arms (ensure…teardown, init, doctor).
    if [[ "${EGRESSLOCK_ALLOW_ROOT:-0}" != "1" && "$(id -u)" == "0" ]]; then
        echo "Error: egresslock must run as the account, not root — root's Podman store/netns is separate from every account's. Use 'sudo -iu <account> -- egresslock ...'." >&2
        exit 1
    fi
}

network_of() { echo "egresslock-$1"; }
anchor_of() { echo "egresslock-anchor-$1"; }
chain_of() { echo "p_${1//-/_}"; }

nft_bin() {
    if [[ -n "${NFT_BIN:-}" ]]; then
        # ARC-59-D1: a value that starts with '-' would read as a flag
        # in `podman unshare ... "$(nft_bin)"`. Empty stays the default.
        [[ "$NFT_BIN" == -* ]] && die "NFT_BIN value must not start with '-' (got '$NFT_BIN')"
        [[ -x "$NFT_BIN" ]] || die "NFT_BIN='$NFT_BIN' is not executable"
        echo "$NFT_BIN"
        return
    fi
    if command -v nft >/dev/null 2>&1; then
        command -v nft
    elif [[ -x /usr/sbin/nft ]]; then
        # /usr/sbin is often missing from a non-root PATH.
        echo /usr/sbin/nft
    else
        die "nftables not found; install it: sudo apt install nftables"
    fi
}

netns_nft() {
    local bin
    # Plain assignment so a die() inside nft_bin (ARC-59 env guard)
    # propagates under set -e instead of being swallowed by the
    # inline-command-substitution pattern (same footgun as the
    # gw_generate_config note).
    bin="$(nft_bin)"
    rt_unshare "$bin" "$@"
}

# EGL-139-D2: conntrack seam, parallel to netns_nft. Same privilege
# class as the engine's nft -f (the unshare grants CAP_NET_ADMIN in the
# netns's owning userns); no nat-table access needed (ctnetlink delete
# operates on entries). Resolution mirrors nft_bin exactly: CONNTRACK_BIN
# (same ARC-59 leading-'-' / executable guards), then PATH, then
# /usr/sbin/conntrack (often missing from a non-root PATH).
conntrack_bin() {
    if [[ -n "${CONNTRACK_BIN:-}" ]]; then
        # ARC-59-D1: a value that starts with '-' would read as a flag
        # in `podman unshare ... "$(conntrack_bin)"`. Empty stays the default.
        [[ "$CONNTRACK_BIN" == -* ]] && die "CONNTRACK_BIN value must not start with '-' (got '$CONNTRACK_BIN')"
        [[ -x "$CONNTRACK_BIN" ]] || die "CONNTRACK_BIN='$CONNTRACK_BIN' is not executable"
        echo "$CONNTRACK_BIN"
        return
    fi
    if command -v conntrack >/dev/null 2>&1; then
        command -v conntrack
    elif [[ -x /usr/sbin/conntrack ]]; then
        echo /usr/sbin/conntrack
    else
        die "conntrack not found; install it: sudo apt install conntrack"
    fi
}

netns_conntrack() {
    local bin
    # Plain assignment so a die() inside conntrack_bin (ARC-59 env guard)
    # propagates under set -e instead of being swallowed by the
    # inline-command-substitution pattern.
    bin="$(conntrack_bin)"
    rt_unshare "$bin" "$@"
}

# EGL-139-D2 step 2: fail-closed conntrack probe for `disallow-host`,
# run BEFORE the conf mutation (R9: a revocation that cannot prove flow
# severance aborts with nothing changed — no conf edit, no ruleset swap,
# no `removed:`). Named binary resolution plus a cheap in-netns ctnetlink
# probe (-C); a denied/unavailable ctnetlink fails closed here. Explicit
# rc: the caller runs this in a ||-condition where set -e is disabled.
conntrack_probe() {
    local bin out rc=0
    if ! bin="$(conntrack_bin)"; then
        # conntrack_bin already named the resolution failure (its die
        # degrades to a named stderr line + rc 1 in condition context).
        echo "  disallow-host must prove flow severance after the revocation; nothing was changed." >&2
        return 1
    fi
    # NOTE: capture the rc BEFORE any ! negation — inside a `if !`'s
    # then-branch, $? is the negated status (0), a named bash trap.
    if out="$(rt_unshare "$bin" -C 2>&1)"; then
        :
    else
        rc=$?
    fi
    if (( rc != 0 )); then
        echo "Error: conntrack probe failed in the rootless netns (rc=$rc): ${out:-<no output>}" >&2
        echo "  disallow-host must prove flow severance after the revocation; nothing was changed." >&2
        echo "  Install the tool and retry: sudo apt install conntrack" >&2
        return 1
    fi
    return 0
}

# ARC-26-D3: netns preflight. `podman unshare --rootless-netns true`
# hits the shared-netns EPERM: podman SIGTERMs the shared netns's pasta
# holder, and an enforce-mode AppArmor pasta profile denies it (ARC-27).
# Run once per invocation before any network/policy work, in the
# commands that touch the netns (ensure/verify/allow/teardown,
# ARC-26-D1). EGRESSLOCK_SKIP_NETNS_PROBE=1 skips it for the mock
# harness. EGL-78-D1: bounded 5s named failure, never an indefinite
# block; timeout(1) is required (EGL-78-D6) and its absence fails closed.
netns_probe() {
    [[ "${EGRESSLOCK_SKIP_NETNS_PROBE:-0}" == "1" ]] && return 0
    if ! command -v timeout >/dev/null 2>&1; then
        echo "Error: timeout(1) (coreutils) is required for the netns probe but was not found in PATH" >&2
        return 1
    fi
    local prc=0
    rt_unshare -t 5 true 2>/dev/null || prc=$?
    if (( prc == 0 )); then
        return 0
    fi
    if (( prc == 124 )); then
        # EGL-78-D1/D3: bounded probe — a hang is a named failure, not a wedge.
        echo "Error: netns probe timed out after 5s (probe: 'timeout 5 podman unshare --rootless-netns true'); the rootless netns is not answering — check pasta/podman health before retrying" >&2
        return 1
    fi
        # EGL-35 (EGL-33/D39-7 wording): the probe is ground truth; the
        # cause names the LABEL (any profile mode), never "confined
        # podman"; the shipped command leads. Deep diagnosis (aa-status,
        # parser reload, session restarts) lives in
        # docs/troubleshooting/pasta-apparmor.md, not here.
        echo "Error: podman rootless-netns is broken for this user (probe: 'podman unshare --rootless-netns true' -> 'kill network process: permission denied'). Podman is running under an AppArmor label (any profile mode) and the enforce-mode pasta profile denies the SIGTERM handoff:" >&2
        echo "  sudo egresslock-setup apparmor add      # apply the shipped rule (or apparmor check to inspect)" >&2
        echo "Then re-run the probe. If it still fails, see docs/troubleshooting/pasta-apparmor" >&2
        echo "Do NOT reinstall the kit — nothing is installed wrong." >&2
        return 1
}

anchor_image() {
    if [[ -n "${EGRESSLOCK_ANCHOR_IMAGE:-}" ]]; then
        # ARC-59-D1: a non-empty value that starts with '-' is a
        # flag-shaped token in the `podman run ... "$(anchor_image)"`.
        [[ "$EGRESSLOCK_ANCHOR_IMAGE" == -* ]] \
            && die "EGRESSLOCK_ANCHOR_IMAGE value must not start with '-' (got '$EGRESSLOCK_ANCHOR_IMAGE')"
        echo "$EGRESSLOCK_ANCHOR_IMAGE"
    elif rt_image_exists localhost/base:latest 2>/dev/null; then
        echo "localhost/base:latest"
    else
        # EGL-66-D2: the fallback is digest-pinned, same discipline as
        # gateway/Containerfile — never a floating third-party tag the
        # engine would pull on demand. Refresh deliberately: pull the
        # tag, confirm the new digest, update here, record it in the
        # ticket. The digest is the multi-arch OCI index digest.
        echo "docker.io/library/alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce"
    fi
}

DNS_SET_MAX=16

resolve_set() { # resolve_set <host> -> the host's IPv4 A set, space-joined
    # EGL-219-D8: rc 0 ALWAYS — empty output when there is no IPv4
    # address, so bare capture calls stay safe under set -euo pipefail;
    # the fail-closed emptiness checks live in resolved_dest and
    # ensure_resolve_pins.
    # Capture first: getent may get SIGPIPE from awk's early exit, and
    # pipefail would turn that into a spurious failure.
    local out
    out="$(getent ahostsv4 "$1" 2>/dev/null || true)"
    # EGL-219-D2: dedupe + deterministic LC_ALL=C sort — the set, not
    # the resolver's RFC-3484 order, is the pin (a resolver reorder is
    # not a change). getent emits one line per address (plus STREAM/
    # DGRAM/RAW repeats; sort -u collapses them).
    local -a addrs=()
    local a
    while IFS= read -r a; do
        [[ -n "$a" ]] && addrs+=("$a")
    done < <(awk '{print $1}' <<<"$out" | LC_ALL=C sort -u)
    if (( ${#addrs[@]} > DNS_SET_MAX )); then
        # D2: a >cap answer truncates with a NAMED stderr note — never
        # silent, never fatal (a host that works under first-A must not
        # start failing). stderr only, so captured stdout
        # (every call site captures) stays clean; D8 rider: the note
        # renders on every truncating call, verify/drift/cmd_rules
        # included, and never changes an exit code.
        echo "note: $1 resolves to ${#addrs[@]} addresses; pinning the first $DNS_SET_MAX (DNS_SET_MAX), sorted" >&2
        addrs=("${addrs[@]:0:DNS_SET_MAX}")
    fi
    echo "${addrs[*]}"
}

resolved_dest() { # resolved_dest <host> -> IPv4 address set (space-joined) for rule emission
    # ARC-12-D1: in verify-pin mode (expected-ruleset build), a missing
    # pin must NOT silently render an empty daddr; fail the verify.
    # Install path (pin mode off): EGL-219-D3 — the address SET from the
    # per-ensure cache (ensure_resolve_pins), with a live resolve_set
    # fallback for the only fresh-process policy_rules caller
    # (cmd_rules); die if unresolvable (fail-closed install unchanged).
    if [[ "$VERIFY_PIN_MODE" == 1 ]]; then
        local dip
        dip="$(resolve_pin "$1")"
        [[ -n "$dip" ]] || die "verify: no live pin for allow-host '$1' (chain/config mismatch)"
        echo "$dip"
    else
        local dip="${RESOLVED_SETS[$1]:-}"
        [[ -n "$dip" ]] || dip="$(resolve_set "$1")"
        [[ -n "$dip" ]] || die "cannot resolve $1"
        echo "$dip"
    fi
}

#
# ARC-11-D1/D2 overlap pre-check: fail `ensure` closed when the profile's
# subnet overlaps any OTHER Podman network this user can see. Scope is
# Podman-visible networks only (this user's rootless store): other
# accounts' netns and host/LAN routes are invisible by design (the
# existing single-rootless-user threat-model item; see `doctor`/docs for
# host-level checks). Runs on both the create path and the
# exists-and-matches path — a colliding network created later is still a
# fail-closed ensure.
#
ensure_no_overlap() {
    local profile="$1" net want name info sub
    net="$(network_of "$profile")"
    want="${PROFILE_SUBNET[$profile]}"
    cidr_parse "$want" || die "invalid subnet '$want' for profile '$profile'"
    local wfirst=$CIDR_FIRST wlast=$CIDR_LAST
    local names
    # ARC-67-D3: a failed list must disable the overlap pre-check
    # LOUDLY, never silently (the {{.Names}} template bug made this
    # scan vacuous on real hosts for its whole life).
    if ! names="$(podman_network_names 2>&1)"; then
        die "cannot list Podman networks; the subnet-overlap pre-check cannot run (fail closed): $names"
    fi
    for name in $names; do
        [[ "$name" == "$net" ]] && continue
        info="$(rt_network_inspect "$name" 2>/dev/null || true)"
        while IFS= read -r sub; do
            [[ -n "$sub" ]] || continue
            # Relaxed parse (any prefixlen): a foreign subnet the profile
            # policy would reject (e.g. a /30 inside the profile's /24)
            # is still a collision and must fail ensure, not be skipped.
            if cidr_parse_any "$sub" \
               && cidr_overlaps "$wfirst" "$wlast" "$CIDR_FIRST" "$CIDR_LAST"; then
                die "profile subnet ${want} overlaps existing Podman network '$name' (subnet ${sub}); overlapping routes in one rootless netns are never benign. Pick a different subnet in the profile config, or remove the colliding network if it is a leftover:
  podman network rm '$name'"
            fi
        done < <(grep -oE '"subnet": *"[^"]+"' <<<"$info" | sed -E 's/"subnet": *"([^"]+)"/\1/')
    done
}

ensure_network() {
    local profile="$1" net want info want_gw
    net="$(network_of "$profile")"
    want="${PROFILE_SUBNET[$profile]}"
    ensure_no_overlap "$profile"
    # Re-parse OUR subnet here: ensure_no_overlap parses foreign subnets
    # too, and the CIDR_* result globals are single-assignment scratch.
    cidr_parse "$want" || die "invalid subnet '$want' for profile '$profile'"
    want_gw="$(cidr_ip "$CIDR_FIRST")"
    if rt_network_inspect "$net" >/dev/null 2>&1; then
        # Reviews R-003-3/R-003-4: an existing network is only acceptable
        # when its configuration matches this profile's fixed IPv4-only
        # definition EXACTLY — one subnet (the fixed one), nothing else.
        # A second subnet would put part of the container traffic outside
        # the scoped policy rules. Fail closed with a remediation hint.
        local info
        info="$(rt_network_inspect "$net" 2>/dev/null || true)"
        # R-003-7 finding 4: the policy depends on the rootless BRIDGE
        # forward path; a same-name macvlan/ipvlan/plugin network with
        # the expected subnet would bypass it entirely.
        if ! grep -qE '"driver": *"bridge"' <<<"$info"; then
            die "network '$net' exists but is not a bridge network; restricted profiles require driver bridge. Remove and recreate it:
  podman network rm '$net' && egresslock ensure '$profile'"
        fi
        local subnet_count
        subnet_count="$(grep -cE '"subnet": *"' <<<"$info" || true)"
        if [[ "$subnet_count" != 1 ]]; then
            die "network '$net' exists with $subnet_count subnets; restricted
profiles require exactly one (${want}). Remove and recreate it:
  podman network rm '$net' && egresslock ensure '$profile'"
        fi
        if ! grep -qE "\"subnet\": *\"${want}\"" <<<"$info"; then
            die "network '$net' exists with a different subnet than the fixed
profile configuration (${want}). Remove and recreate it:
  podman network rm '$net' && egresslock ensure '$profile'
(or inspect it with: podman network inspect '$net')"
        fi
        # The policy rules assume the standard bridge gateway (the FIRST
        # usable address of the subnet, ARC-11-D3); a different gateway
        # would break the DNS allow.
        if ! grep -qE "\"gateway\": *\"${want_gw}\"" <<<"$info"; then
            die "network '$net' exists with an unexpected gateway (expected ${want_gw}); the policy rules assume it. Remove and recreate it:
  podman network rm '$net' && egresslock ensure '$profile'"
        fi
        if grep -qE '"ipv6_enabled": *(true|True)' <<<"$info"; then
            die "network '$net' exists with IPv6 enabled; restricted profiles
are IPv4-only. Remove and recreate it:
  podman network rm '$net' && egresslock ensure '$1'"
        fi
        return 0
    fi
    # Pass the gateway explicitly so Netavark cannot pick anything but
    # the first usable address the policy rules assume (ARC-11-D3).
    rt_network_create "$net" "$want" "$want_gw" >/dev/null
    echo "created network $net ($want)"
}

anchor_running() {
    # Capture ps output before grepping: 'grep -q' exits on the first
    # match and SIGPIPEs the writer, which pipefail reports as failure.
    local names
    names="$(rt_ps 2>/dev/null || true)"
    grep -qx "$1" <<<"$names"
}

# ARC-67-D1: real podman's `network ls` template field is {{.Name}}
# (singular) — {{.Names}} is the podman ps CONTAINER field and errors
# on network ls. One helper so the format string cannot drift; the
# failure policy is the caller's (ARC-67-D3): ensure dies (the ARC-11
# overlap check must not be silently disabled), init treats a broken
# list as "taken", teardown --runtime notes and continues.
podman_network_names() {
    rt_network_ls
}

# ---------------------------------------------------------------------------
# EGL-206 (CVE-2026-94603 / GHSA-2cvf-wqm6-wr9g): on affected Podman
# ranges (4.4.0–5.8.7, 6.x before 6.1.3) an image carrying the
# annotation `io.podman.annotations.checkpoint.runtime.name` is
# interpreted as a container checkpoint and `podman run` silently
# ignores --cap-drop=all and --security-opt=no-new-privileges. Podman
# ships no automatic rejection; the upstream workaround is refusing such
# images. Two fail-closed named guards: D2a refuses a checkpoint-
# annotated kit image before every kit-owned run; D2b asserts the LIVE
# hardening state at start and on verify, read from the container's PID
# 1 (`/proc/1/status` via rt_exec), not from `podman inspect` (which
# reports what was requested, not what was applied).

# D2a: image-level annotation oracle, run on the RESOLVED image about to
# `rt_run` (covers EGRESSLOCK_*_IMAGE and the unpinned
# `localhost/base:latest` anchor path). Empty/missing key = pass; any
# non-empty value = refuse.
# R-EGL-206-2 #1: a missing image does NOT fail at rt_run — `podman run`
# pulls it on demand. So: exist-check first; a missing ANCHOR image
# (mode "pull-missing") is pulled here before the inspect, keeping the
# refusal preventative on first-create; a failed pull dies named. The
# GATEWAY keeps the missing-image die: its image is locally built by
# `build-gateway`, never pulled, and ensure_gateway names that path.
refuse_checkpoint_image() { # refuse_checkpoint_image <image> <label> [pull-missing]
    local img="$1" label="$2" ann
    if ! rt_image_exists "$img" 2>/dev/null; then
        if [[ "${3:-}" != "pull-missing" ]]; then
            die "$label image '$img' is missing from the local store (checkpoint-annotation preflight, CVE-2026-94603, fail closed); provide a local image that is not checkpoint-annotated"
        fi
        rt_image_pull "$img" >/dev/null 2>&1 \
            || die "$label image '$img' is not in the local store and pulling it failed (checkpoint-annotation preflight, CVE-2026-94603, fail closed); pull it manually ('podman pull $img') and re-run ensure"
    fi
    if ! ann="$(rt_image_inspect "$img" '{{index .Annotations "io.podman.annotations.checkpoint.runtime.name"}}' 2>/dev/null)"; then
        die "$label image '$img' could not be inspected for the checkpoint annotation (CVE-2026-94603, fail closed); provide an image that is not checkpoint-annotated"
    fi
    [[ -z "$ann" ]] \
        || die "$label image '$img' carries the container-checkpoint annotation 'io.podman.annotations.checkpoint.runtime.name' — Podman can interpret it as a checkpoint and silently discard requested sandbox flags such as --cap-drop=all (CVE-2026-94603 / GHSA-2cvf-wqm6-wr9g); refusing to run it. Replace the image (upstream workaround: reject images carrying the checkpoint annotation)"
}

# D2b: live-hardening oracle. Reads PID 1's status in the container and
# reports one token: ok | caps:<CapEff> | nnp:<value> |
# unreadable:<why>. Parse CapEff only — CapBnd/CapPrm/CapInh stay
# non-zero under --cap-drop=all, so asserting them would fail every
# healthy start. PID 1 carries the launch-time property. Unreadable
# exec/parse is a named state, never a skip (map R1); override images
# must provide `cat`.
kit_caps_state() { # kit_caps_state <container>
    local st caps nnp
    if ! st="$(rt_exec "$1" cat /proc/1/status 2>/dev/null)" || [[ -z "$st" ]]; then
        echo "unreadable:podman exec cat /proc/1/status failed or returned no output"
        return 0
    fi
    caps="$(awk '/^CapEff:/{print $2; exit}' <<<"$st")"
    nnp="$(awk '/^NoNewPrivs:/{print $2; exit}' <<<"$st")"
    if [[ -z "$caps" || -z "$nnp" ]]; then
        echo "unreadable:CapEff/NoNewPrivs lines missing from /proc/1/status"
        return 0
    fi
    if [[ ! "$caps" =~ ^0+$ ]]; then
        echo "caps:$caps"
        return 0
    fi
    if [[ "$nnp" != "1" ]]; then
        echo "nnp:$nnp"
        return 0
    fi
    echo "ok"
}

# One named fail-closed message per state, shared by the ensure dies
# and the verify echoes (same words on both paths, map R1).
kit_caps_problem_msg() { # kit_caps_problem_msg <label> <container> <state>
    local label="$1" ctr="$2" st="$3"
    case "$st" in
        caps:*)
            echo "$label container '$ctr' CapEff is '${st#caps:}' (expected all-zero) — the launch-time --cap-drop=all did not take effect (CVE-2026-94603 flag-discard class); replace the container/image" ;;
        nnp:*)
            echo "$label container '$ctr' NoNewPrivs is '${st#nnp:}' (expected 1) — the launch-time --security-opt=no-new-privileges did not take effect (CVE-2026-94603 flag-discard class); replace the container/image" ;;
        *)
            echo "$label container '$ctr' hardening state unreadable (${st#unreadable:}) — failing closed (CVE-2026-94603); override images must provide 'cat' for the /proc/1/status read" ;;
    esac
}

# Start-path assertion (ensure_*): die named on any non-ok state.
# EGL-208: the assert runs after rt_run may have started a
# --restart=always container, so a bare die would leave a possibly-wrong
# hardening state alive — on the gateway, under the live policy's
# fixed-IP+MAC egress exemption (EGL-123-D3). Force-remove it (rm -f
# defeats the restart policy and frees name/IPAM) BEFORE dying. The
# verify verbs call kit_caps_problem_msg directly and stay read-only.
assert_kit_caps() { # assert_kit_caps <container> <label>
    local st problem rmerr
    st="$(kit_caps_state "$1")"
    [[ "$st" == "ok" ]] && return 0
    problem="$(kit_caps_problem_msg "$2" "$1" "$st")"
    # `if !` keeps set -e from exiting before the failure is named; the
    # capture keeps the runtime's removed-name echo out of the output.
    if ! rmerr="$(rt_rm "$1" 2>&1)"; then
        die "$problem; removal failed: $rmerr — container '$1' could not be removed and may still be running; remove it manually: 'podman rm -f $1'"
    fi
    die "$problem; removed container '$1' (rm -f)"
}

# EGL-217: family-wide ensure-failure cleanup — the EXIT-trap body armed
# by cmd_ensure. The wait-for-running/healthy dies and the no-die set -e
# exits (raw rt_run failure, rule-gen rc 1) sit before or outside
# assert_kit_caps and can leave this run's --restart=always container
# behind — on the gateway, running-but-unhealthy under the live policy's
# fixed-IP+MAC egress exemption. Ownership (Q5): remove ONLY containers
# this run started/replaced (R1) or restarted via the config apply (R2),
# never a pre-existing healthy pair on an unrelated failure (a full
# sweep would turn a failed refresh into an outage). Skip a name no
# longer registered (already removed, never created, or recycled by
# ensure_gateway) — this also suppresses EGL-208's double-removal
# report. set -e-safe (`if !`, `|| continue`), never die/exit, and never
# alters the failing rc.
ensure_cleanup() { # ensure_cleanup <rc> — EXIT-trap body; armed by cmd_ensure
    local rc="$1" names n rmerr
    # Belt behind the disarm: a success exit never cleans up.
    [[ "$rc" == 0 ]] && return 0
    [[ -n "$ENSURE_OWNED" ]] || return 0
    # Registered-container oracle: rt_ps all (podman ps -a) lists
    # registered-but-not-running containers too. A failed probe (wedged
    # runtime) attempts removal anyway — fail closed on an exempt
    # container; a "could not be removed" line for an absent name is the
    # honest side of that trade.
    if ! names="$(rt_ps all 2>/dev/null)"; then
        names="$ENSURE_OWNED"
    fi
    for n in $ENSURE_OWNED; do
        grep -qx "$n" <<<"$names" || continue
        if ! rmerr="$(rt_rm_retry "$n" 2>&1)"; then
            # EGL-318: a failed diagnostic write must not abort the
            # handler (belt behind ensure_exit_trap's set +e).
            echo "cleanup: removal failed: $rmerr — container '$n' could not be removed and may still be running; remove it manually: 'podman rm -f $n'" >&2 || true
        else
            # EGL-318: record BEFORE the write so a failed write cannot
            # lose the S1T evidence.
            ENSURE_REMOVED="${ENSURE_REMOVED:+$ENSURE_REMOVED }$n"
            echo "removed container '$n' (rm -f)" >&2 || true
        fi
    done
}

ensure_exit_trap() { # ensure_exit_trap <rc> — EXIT trap: cleanup, then the EGL-305 disclosure
    local rc="$1"
    set +e
    ensure_cleanup "$rc"
    disallow_host_failure_disclose "$rc"
    return 0
}

# EGL-305: disallow-host partial-failure recovery. Runs from the
# cmd_ensure EXIT trap (every failure form) and from cmd_disallow_host's
# trap while the delete is committed (EGL-305-D6). Acts only while a
# disallow-host mutation is in flight (DISALLOW_HOST_CTX armed) and only
# after the conf delete is committed (CONF_DELETED_COMMITTED=1; earlier
# failures stay silent). Never dies, never alters the pending rc, never
# prints `removed:`. Post-swap (ENSURE_POLICY_SWAPPED=1): the ruleset
# dropped the target accept but conntrack was not proven clean — disclose
# the partial state and print `drop-unauthorized`. Pre-swap: restore the
# deleted conf rule (S1) or, if that fails, name the partial state and
# the recovery commands (S2 + S2w warning). EGL-354: cmd_disallow_host
# keeps this trap armed through the final post-swap reconcile, so a
# reconcile failure (EGL-311 S1/S2, the S6 enumerate read, or a survivor
# witness) also prints the post-swap disclosure.
disallow_host_failure_disclose() { # disallow_host_failure_disclose <rc> — acts only in a disallow-host window
    local rc="$1"
    [[ -n "$DISALLOW_HOST_CTX" ]] || return 0
    # EGL-305-D6: with the pre-delete arm (the cmd_disallow_host EXIT
    # trap), a non-zero CONF_DELETED_COMMITTED means nothing was mutated
    # yet — the pre-mutation failures stay silent (leg L6).
    [[ "$CONF_DELETED_COMMITTED" == 1 ]] || return 0
    if (( ENSURE_POLICY_SWAPPED )); then
        echo "disallow-host: the revocation is only half done — the rule is out of the firewall, but the connections that were open were not ended — state: conf line removed, ruleset swapped, conntrack not proven clean; next action: end the leftover connections: egresslock drop-unauthorized $DISALLOW_HOST_CTX $DISALLOW_HOST_PORT (drops the connections on port $DISALLOW_HOST_PORT the policy no longer allows, keeps the connections the policy still allows, then checks none remain; safe to run again)" >&2
    elif conf_restore_allow_host "$DISALLOW_HOST_CONF" "$CONF_DELETED_LINE" "$CONF_DELETED_INDEX"; then
        echo "disallow-host: nothing was revoked — the reinstall failed before the policy was replaced and the rule was put back — state: rule restored, ruleset not replaced (the rule is back in the config; the revocation ended no connection) — next action: fix the underlying failure, then retry: egresslock disallow-host $DISALLOW_HOST_CTX $DISALLOW_HOST_HOST:$DISALLOW_HOST_PORT" >&2
        if [[ " $ENSURE_REMOVED " == *" $(anchor_of "$DISALLOW_HOST_CTX") "* ]]; then
            echo "disallow-host: note: the failed reinstall removed containers it had started for profile '$DISALLOW_HOST_CTX' — if the profile is not running now, start it again: egresslock ensure $DISALLOW_HOST_CTX" >&2 || true
        fi
    else
        echo "disallow-host: nothing was revoked — the reinstall failed before the policy was replaced, and the rule could not be put back — state: config line removed, ruleset not replaced (the revocation ended no connection) — next action: fix the underlying failure, then put the rule back and retry: egresslock allow-host $DISALLOW_HOST_CTX $DISALLOW_HOST_HOST:$DISALLOW_HOST_PORT, then egresslock disallow-host $DISALLOW_HOST_CTX $DISALLOW_HOST_HOST:$DISALLOW_HOST_PORT" >&2
        echo "disallow-host: warning: a plain 'egresslock ensure $DISALLOW_HOST_CTX' would drop allow-host $DISALLOW_HOST_HOST:$DISALLOW_HOST_PORT from the firewall without ending its open connections — restore the rule first (the allow-host command above)." >&2
    fi
    return 0
}

# Converged-predicate gate: a readable caps mismatch or an unreadable
# state must NOT be blessed by the converged short-circuit — it falls
# through to replacement (the EGL-123-D3 MAC-pin pattern), so a
# once-failed launch cannot be blessed by the next ensure.
gw_caps_ok() { # gw_caps_ok <gwname>
    [[ "$(kit_caps_state "$1")" == "ok" ]]
}

anchor_caps_ok() { # anchor_caps_ok <anchor-name>
    [[ "$(kit_caps_state "$1")" == "ok" ]]
}

ensure_anchor() {
    local profile="$1" anchor
    anchor="$(anchor_of "$profile")"
    # EGL-206-D2b: the converged short-circuit is caps-aware — a running
    # anchor whose live hardening is wrong or unreadable falls through
    # to replacement instead of being blessed (EGL-123-D3 MAC-pin
    # pattern).
    if anchor_running "$anchor" && anchor_caps_ok "$anchor"; then
        return 0
    fi
    # Stale stopped anchor from an interrupted run.
    rt_rm_retry "$anchor" >/dev/null 2>&1 || true
    # The anchor holds the rootless netns (bridge + policy) open. It runs
    # no services and only sleeps; --restart=always brings it back after
    # a crash or image-level restart. It gets the LAST usable host
    # address of the subnet (ARC-11-D3) so it can never collide with the
    # bridge gateway (first usable) or the gateway's static IP (ARC-5).
    local anchor_ip animg
    cidr_parse "${PROFILE_SUBNET[$profile]}" \
        || die "invalid subnet '${PROFILE_SUBNET[$profile]}'"
    anchor_ip="$(cidr_ip "$CIDR_LAST")"
    # EGL-66-D1: the anchor only sleeps, but it is kit-created and sits
    # on the profile L2 — run it with the same hardening pair as the
    # kit-built gateway (ARC-32-D5): no capabilities, no privilege gain.
    animg="$(anchor_image)"
    # EGL-206-D2a: refuse a checkpoint-annotated image before the run
    # (CVE-2026-94603). R-EGL-206-2 #1: a fresh account's first ensure
    # resolves the digest-pinned fallback before it is in the local
    # store — pull it here (the pull rt_run would do), then inspect,
    # so the refusal stays preventative on first-create.
    refuse_checkpoint_image "$animg" "anchor image" pull-missing
    # EGL-217 (M2, R1): this run owns the anchor it is about to start —
    # marked BEFORE the run so a failed rt_run that still registered the
    # name (ARC-5 partial storage) is cleaned up by the EXIT trap. The
    # converged short-circuit above returns before this marker: a reused
    # anchor is never owned.
    ensure_own "$anchor"
    rt_run "$anchor" \
        --network "$(network_of "$profile")" \
        --ip "$anchor_ip" \
        --cap-drop=all \
        --security-opt=no-new-privileges \
        --restart=always \
        "$animg" sleep 86400 >/dev/null
    # ARC-69-D3: announce only the create — a silent ensure_anchor was
    # indistinguishable from reuse; already-running return stays silent.
    echo "started anchor $anchor"
    # Give Podman a moment to report it as running before we rely on it.
    # EGL-206-D2b: wait-until-running, then assert live hardening on the
    # success path — never skipped by a return from inside the wait loop.
    local i
    for i in $(seq 1 20); do
        anchor_running "$anchor" && break
        sleep 0.5
    done
    anchor_running "$anchor" \
        || die "anchor container '$anchor' did not reach running state"
    assert_kit_caps "$anchor" "anchor"
}

#
# Emit the profile's canonical rule lines (no table/chain wrapper). Used
# both to generate the install file and to build the expected rule set for
# deep verification (review R-003-3).
#
# EGL-141-D1: the profile's bridge device name — the single live-resolved
# netns-topology token (a narrow, recorded amendment to "compiled from
# conf", EGL-91: all POLICY semantics stay conf-derived; the bridge is
# topology netavark owns and the conf cannot know). Resolved INSIDE the
# emit path so every refresh (R-003-7) carries the current name. The
# name is NOT stable across network recreation (`podman<N>` slot depends
# on creation order in the shared account netns, kit AND non-kit), so
# nothing may cache or derive it; a stale name matches nothing for the
# genuine bridge — verify fails closed with a named diff and ensure
# repairs (EGL-141-D1 consequence 3; R6 warm-ensure re-resolve stays
# byte-identical). Cross-checked against the rootless netns link list so
# an inspect/report mismatch fails the file builder by rc (EGL-120-D1
# pattern) — an empty `iifname ""` must never render.
profile_bridge_if() { # profile_bridge_if <profile> -> bridge device; rc 1 on any doubt
    local profile="$1" net ifc links
    net="$(network_of "$profile")"
    ifc="$(rt_network_inspect "$net" '{{.NetworkInterface}}' 2>/dev/null || true)"
    # Kernel ifnames: <= 15 bytes, no whitespace, no quotes, no leading
    # '-' (flag-shaped tokens, EGL-59-D1 class). Anything else (empty,
    # missing, multi-line) fails the emit.
    [[ "$ifc" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,14}$ ]] || {
        echo "Error: cannot resolve the bridge interface of $net (got '${ifc:-<empty>}'); ensure owns network creation — run: egresslock ensure $profile" >&2
        return 1
    }
    links="$(rt_unshare ip -br link 2>/dev/null || true)"
    if ! awk '{print $1}' <<<"$links" | grep -qx -- "$ifc"; then
        echo "Error: bridge interface '$ifc' of $net not confirmed in the rootless netns (ip -br link); fail closed" >&2
        return 1
    fi
    echo "$ifc"
}

#
# Rule generation entry point: the generic rule compiler for the loaded
# config (there is no legacy path — ARC-20).
#
policy_rules() {
    compiled_rules "$1"
}

# ARC-12-D1: when set (verify path), the compilers take allow-host
# daddrs from VERIFY_PINS (the live chain's pins) instead of
# resolve_set — DNS drift must not fail or die verify.
VERIFY_PIN_MODE=0

#
# ARC-12-D4: the profile's allow-host destinations as ordered
# "host:port" lines — the DNS-resolved (drift-checkable) destinations,
# as configured. The gateway IP and the bridge-gateway DNS allow are
# static/derived data, NOT drift candidates, and are excluded here.
#
profile_allow_hosts() {
    local profile="$1"
    local i kind pfx="${profile}|"
    for i in "${!ENGINE_KINDS[@]}"; do
        [[ "${ENGINE_KINDS[$i]}" == "$pfx"* ]] || continue
        kind="${ENGINE_KINDS[$i]#"$pfx"}"
        [[ "$kind" == "allow-host" ]] || continue
        echo "${ENGINE_ARGS[$i]}"
    done
}

#
# ARC-12-D4 (as amended by EGL-140-D1): build the EXPECTED ruleset with
# allow-host daddrs from the ENSURE-TIME PIN RECORD — not a fresh resolve
# (a DNS change must not make verify fail) and not the live chain (a
# tampered chain must not adopt its own daddrs). The structural zip
# against the live chain (count, port order) fails closed, and each live
# daddr is compared against the record: divergence = post-ensure chain
# edit -> named fail (EGL-140-D2). A missing/corrupt record on a profile
# with allow-hosts fails closed with the named re-ensure error, never a
# silent-green or lenient live-chain adoption; zero-allow-host profiles
# are exempt.
#
# The VERIFY_PINS array is consulted by a resolver shim: resolve_pin()
# replaces resolve_set in the expected-ruleset build only. verify fills
# it from read_pin_record (the confdir witness), never from the chain.
#
declare -A VERIFY_PINS=()
# EGL-178-D2: cmd_ensure's pre-refresh pin snapshot (ensure_snapshot_pins)
# crosses helper boundaries into ensure_announce_refreshed, so it lives at
# file scope like VERIFY_PINS. Distinct name on purpose: the verify-time
# fill of VERIFY_PINS (cmd_ensure's verify_policy call) must not clobber
# the ensure-time snapshot.
declare -A ENSURE_BEFORE_PINS=()

# EGL-219-D3: the per-run resolve cache — one resolve per ensure feeds
# the rule build, the pin record, and the announce, so the announced set
# equals the installed set (a second resolve could reorder a multi-A host
# and flap the pin). Filled by ensure_resolve_pins at the top of
# install_policy in parent scope (the build runs in-process), so it
# survives into write_pin_record and ensure_announce_refreshed. Lifetime
# is one command; resolved_dest falls back to resolve_set for cmd_rules.
declare -A RESOLVED_SETS=()

# EGL-305: disallow-host partial-failure recovery state. While a
# disallow-host mutation is in flight (armed in cmd_disallow_host after
# the conf rule is deleted, cleared on the success continuation), the
# cmd_ensure EXIT trap (ensure_exit_trap) reads these to restore the
# conf rule or disclose the partial state. ENSURE_POLICY_SWAPPED is the
# swap-boundary signal set inside install_policy immediately after the
# successful atomic -f (its only caller is cmd_ensure, which resets it
# at entry); CONF_DELETED_LINE/INDEX capture the deleted rule line and
# its 0-based original position for conf_restore_allow_host.
# CONF_DELETED_COMMITTED is the "the conf delete already happened"
# gate for the cmd_disallow_host EXIT trap: pre-mutation failures
# (nothing deleted yet) must stay disclosure-silent (EGL-305-D6).
DISALLOW_HOST_CTX=""
DISALLOW_HOST_HOST=""
DISALLOW_HOST_PORT=""
DISALLOW_HOST_PIN_IPS=""
# EGL-219-D11: member-phase disclosure state — cmd_disallow_host arms the
# phase for the post-ensure member flush loop and tracks the ordered
# unproven list; the EXIT trap reads both.
DISALLOW_HOST_MEMBER_PHASE=0
DISALLOW_HOST_UNPROVEN=()
DISALLOW_HOST_CONF=""
CONF_DELETED_LINE=""
CONF_DELETED_INDEX=0
CONF_DELETED_COMMITTED=0
ENSURE_POLICY_SWAPPED=0

ensure_resolve_pins() { # ensure_resolve_pins <profile> — fill RESOLVED_SETS; rc 1 named
    # Walk the profile's conf allow-hosts in order; cache miss → one
    # resolve_set call. An empty set fails the ensure closed NAMED with
    # the EGL-120-D1 hint (same message class as resolved_dest's
    # install-path belt) BEFORE any ruleset is built — the ruleset is
    # untouched, the ensure dies closed.
    local profile="$1" hp host cset
    while IFS= read -r hp; do
        [[ -n "$hp" ]] || continue
        host="${hp%:*}"
        [[ -n "${RESOLVED_SETS[$host]:-}" ]] && continue
        cset="$(resolve_set "$host")"
        RESOLVED_SETS[$host]="$cset"
        if [[ -z "$cset" ]]; then
            echo "Error: cannot resolve $host" >&2
            allow_host_resolve_hint "$profile" "$host" "${hp##*:}"
            return 1
        fi
    done < <(profile_allow_hosts "$profile")
    return 0
}

resolve_pin() { # resolve_pin <host> -> the pinned address set (space-joined); empty = no pin
    local key host="$1" port="${2:-}" k
    # Set semantics (EGL-219-D3): any port of a host was installed from
    # ONE resolve_set call, so look up by host regardless of port; the
    # value is the whole ensure-time address set.
    for k in "${!VERIFY_PINS[@]}"; do
        if [[ "${k%%|*}" == "$host" ]]; then
            echo "${VERIFY_PINS[$k]}"
            return 0
        fi
    done
    return 1
}

# EGL-140-D1: the ensure-time pin record — sibling of the resolved conf
# file (PROFILE_CONF carries the conf-resolution result). The suffix
# must NOT match the confdir aggregation glob (*.conf) — .pins never
# aggregates, never parses as a conf.
pin_record_path() { # pin_record_path <profile> -> <confdir>/<profile>.pins
    local conf="${PROFILE_CONF[$1]:-}"
    [[ -n "$conf" ]] || die "internal: no conf file recorded for profile '$1'"
    local dir
    dir="$(cd "$(dirname "$conf")" && pwd)"
    echo "$dir/$1.pins"
}

# EGL-140-D1 step 2: write the pin record from WHAT WAS JUST INSTALLED.
# The witness is the live chain's pin accepts right after the atomic
# install (the daddrs the compiler emitted — no second resolve, no DNS
# race). Conf order, `host|port <set>` per allow-host, <set> being the
# ordered address set the entry installed (EGL-219-D7: one line per conf
# entry). Zero-allow-host profiles have NO record; a stale one is
# removed. Atomic mktemp+mv beside the file: a SIGKILL leaves the old
# record or none, both fail closed at the next verify (EGL-91). A write
# failure fails the ensure closed.
write_pin_record() { # write_pin_record <profile>
    local profile="$1" rec
    rec="$(pin_record_path "$profile")"
    # Zero-allow-host profile: the record must not exist (exempt shape).
    if [[ -z "$(profile_allow_hosts "$profile")" ]]; then
        rm -f "$rec"
        return 0
    fi
    # Zip the just-installed chain's pin accepts against the conf order
    # (same parse verify_expected_rules uses, minus the record compare).
    local chain subnet
    chain="$(chain_of "$profile")"
    subnet="${PROFILE_SUBNET[$profile]}"
    local raw actual
    raw="$(netns_nft list chain inet "$TABLE" "$chain" 2>/dev/null || true)"
    actual="$(canonicalize <<<"$raw")" || die "cannot record the installed pins for profile '$profile' (the just-installed firewall rules could not be read back — fail closed)"
    local gw_ip="${GW_IP[$profile]:-}"
    local -a want_hosts=() want_ports=() got_ips=() got_ports=()
    local hp r ip port i
    while IFS= read -r hp; do
        [[ -n "$hp" ]] || continue
        want_hosts+=("${hp%:*}")
        want_ports+=("${hp##*:}")
    done < <(profile_allow_hosts "$profile")
    while IFS= read -r r; do
        local pin_re="^ip saddr ${subnet} iifname \"[^\"]+\" ip daddr ([0-9.]+) tcp dport ([0-9]+) counter accept\$"
        [[ "$r" =~ $pin_re ]] || continue
        ip="${BASH_REMATCH[1]}"
        port="${BASH_REMATCH[2]}"
        # Exclude the DNS-to-bridge rule and the static gateway hop.
        [[ "$ip" == "$gw_ip" ]] && continue
        got_ips+=("$ip")
        got_ports+=("$port")
    done <<<"$actual"
    # EGL-219-D1/D7: each conf entry installed |set| accepts — the
    # canonical set order from the per-ensure cache (the exact values
    # the compiler resolved and emitted). Missing cache = a build that
    # did not go through ensure_resolve_pins → named die, fail closed.
    # The cardinality check is Σ over conf ENTRIES of each entry's set
    # size vs the chain's accept count (NOT conf-entry count vs accepts).
    local expected_total=0 i j k
    local -a set_sizes=()
    for i in "${!want_ports[@]}"; do
        local cset="${RESOLVED_SETS[${want_hosts[$i]}]:-}"
        if [[ -z "$cset" ]]; then
            die "cannot record the installed pins for profile '$profile' (no resolved set cached for ${want_hosts[$i]} — fail closed)"
        fi
        local -a csize=()
        read -ra csize <<<"$cset"
        set_sizes+=("${#csize[@]}")
        expected_total=$(( expected_total + ${#csize[@]} ))
    done
    if (( expected_total != ${#got_ports[@]} )); then
        die "cannot record the installed pins for profile '$profile' (conf entries consume $expected_total pin accepts, chain has ${#got_ports[@]} — fail closed)"
    fi
    # Zip the conf order against the chain accepts in order: each
    # consumed accept must carry the conf entry's port and its set
    # member's daddr (positional — the emitter emitted them in exactly
    # this order). Any divergence is a structural anomaly: named die.
    local -a lines=()
    k=0
    for i in "${!want_ports[@]}"; do
        read -ra cset_members <<<"${RESOLVED_SETS[${want_hosts[$i]}]}"
        for j in "${!cset_members[@]}"; do
            if [[ "${got_ports[$k]}" != "${want_ports[$i]}" ]]; then
                die "cannot record the installed pins for profile '$profile' (chain accept $k dport ${got_ports[$k]}, conf entry ${want_hosts[$i]}:${want_ports[$i]} — fail closed)"
            fi
            if [[ "${got_ips[$k]}" != "${cset_members[$j]}" ]]; then
                die "cannot record the installed pins for profile '$profile' (chain accept $k daddr ${got_ips[$k]}, expected set member ${cset_members[$j]} for ${want_hosts[$i]}:${want_ports[$i]} — fail closed)"
            fi
            k=$(( k + 1 ))
        done
        # D7: the record line's value is the ordered (sorted) address
        # set, space-joined — old single-address readers are gone; an
        # old engine reading this record fails closed (corrupt), an
        # old single-address record still parses as a 1-element set.
        lines+=("${want_hosts[$i]}|${want_ports[$i]} ${RESOLVED_SETS[${want_hosts[$i]}]}")
    done
    local tmp
    tmp="$(mktemp "$rec.XXXXXX")" || die "cannot create temp next to $rec (pin record write, fail closed)"
    chmod 600 "$tmp" 2>/dev/null || true
    printf '%s\n' "${lines[@]}" > "$tmp"
    mv "$tmp" "$rec" || { rm -f "$tmp"; die "cannot write pin record $rec (fail closed)"; }
}

# EGL-140-D1 step 4 / D3: read the pin record into VERIFY_PINS. Fail
# closed named on a missing record (the 0.4.x upgrade shape: live chains
# but no witness — re-ensure, never a lenient live-chain adoption) and
# on a corrupt/incomplete/unexpected-content record (same class). The
# record must cover exactly the profile's conf allow-hosts: every conf
# pin covered, no stale extra entries.
read_pin_record() { # read_pin_record <profile> — fills VERIFY_PINS; rc 1 named
    local profile="$1" rec
    rec="$(pin_record_path "$profile")"
    if [[ ! -f "$rec" ]]; then
        echo "verify: pin record missing for profile '$profile' — re-run: egresslock ensure $profile" >&2
        return 1
    fi
    VERIFY_PINS=()
    local line key ipset
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" ]] || continue
        # EGL-219-D7: token-validating set regex — capture 3 is the
        # whole space-joined address set (a single address parses as a
        # 1-element set: old records stay valid, no migration).
        if [[ "$line" =~ ^([^|[:space:]]+)\|([0-9]+)[[:space:]]+([0-9.]+( [0-9.]+)*)$ ]]; then
            key="${BASH_REMATCH[1]}|${BASH_REMATCH[2]}"
            ipset="${BASH_REMATCH[3]}"
            # D7: duplicate key lines are LEGAL iff their set values
            # are identical (the conf grammar's allow-host rule is
            # "ordered, repeatable" and the ensure's own writer emits
            # its identical line twice; the reader collapses
            # identicals, first-wins). A DISAGREEING duplicate is a
            # named corrupt — stricter than silent last-wins, consistent
            # with EGL-140's fail-closed posture.
            if [[ -n "${VERIFY_PINS[$key]:-}" && "${VERIFY_PINS[$key]}" != "$ipset" ]]; then
                echo "verify: pin record corrupt for profile '$profile' ($rec, disagreeing duplicate key for ${key%%|*}:${key##*|}) — re-run: egresslock ensure $profile" >&2
                return 1
            fi
            # D7: a repeated address within one line is a non-canonical
            # set the engine never writes — named corrupt, fail closed.
            local uniq total
            uniq="$(awk '{for(i=1;i<=NF;i++) print $i}' <<<"$ipset" | LC_ALL=C sort -u | wc -l)"
            total="$(awk '{print NF}' <<<"$ipset")"
            if (( uniq != total )); then
                echo "verify: pin record corrupt for profile '$profile' ($rec, repeated address in line: '$line') — re-run: egresslock ensure $profile" >&2
                return 1
            fi
            VERIFY_PINS[$key]="$ipset"
        else
            echo "verify: pin record corrupt for profile '$profile' ($rec, line: '$line') — re-run: egresslock ensure $profile" >&2
            return 1
        fi
    done < "$rec"
    local hp
    while IFS= read -r hp; do
        [[ -n "$hp" ]] || continue
        if [[ -z "${VERIFY_PINS[${hp%:*}|${hp##*:}]:-}" ]]; then
            echo "verify: pin record corrupt for profile '$profile' (missing entry for $hp) — re-run: egresslock ensure $profile" >&2
            return 1
        fi
    done < <(profile_allow_hosts "$profile")
    for key in "${!VERIFY_PINS[@]}"; do
        local found=0
        while IFS= read -r hp; do
            [[ -n "$hp" ]] || continue
            [[ "${hp%:*}|${hp##*:}" == "$key" ]] && { found=1; break; }
        done < <(profile_allow_hosts "$profile")
        if (( found == 0 )); then
            echo "verify: pin record corrupt for profile '$profile' (stale entry for ${key%%|*}:${key##*|}) — re-run: egresslock ensure $profile" >&2
            return 1
        fi
    done
    return 0
}

# EGL-139-D2 step 3: the revoked pin's LIVE daddr set, captured BEFORE
# the conf mutation deletes the conf line (name pins carry no IP; the
# chain is the only trustworthy scope source). Positional zip of the
# conf's allow-host order against the live chain's pin accepts — the
# same pairing verify_expected_rules uses, without the record compare.
# EGL-219-D7/D9: the pin record is now an INPUT — it sizes each conf
# entry's slice (one entry installs |set| accepts). A missing/unreadable
# record, a corrupt line, a disagreeing duplicate key, or a missing key
# for any conf entry at/before the target is a named fail-closed die
# BEFORE the conf mutation (a quiet skip would remove the conf line,
# swap the ruleset, print removed:, and leave the revoked flow alive on
# the ct-established accept with no flush — an unproven severance claim
# against EGL-139-D2; remediation is the record's own re-run:
# egresslock ensure <profile>). The chain-absent read, a failed chain
# read, the total-count mismatch, an unmapped target, and every
# per-entry port/daddr divergence refuse named here — fail closed
# before the conf mutation (nothing changed; ensure, then retry) —
# never a silent empty skip (EGL-296).
live_pin_daddr() { # live_pin_daddr <profile> <host> <port> -> target entry's daddr set; refuses named on an unreadable/absent chain or chain/record disagreement (EGL-296)
    local profile="$1" host="$2" port="$3" chain subnet
    chain="$(chain_of "$profile")"
    subnet="${PROFILE_SUBNET[$profile]}"
    local raw actual raw_rc=0
    raw="$(netns_nft list chain inet "$TABLE" "$chain" 2>/dev/null)" || raw_rc=$?
    # EGL-296 F1 (ER-EGL-296-5): the read's own status is evidence — a
    # failed read (nonzero rc) is an unusable chain even when stdout
    # carries a listing, and a successful empty read is an absent chain;
    # both refuse named here, before anything is consumed from the read
    # (cmd_disallow_host's probe has already proven the netns reachable;
    # S1's "or they cannot be read" names both states). Nothing changed.
    (( raw_rc == 0 )) || die "disallow-host: profile '$profile' has no installed firewall rules, or they cannot be read — nothing was changed; re-run: egresslock ensure $profile, then retry: egresslock disallow-host $profile $host:$port"
    [[ -n "$raw" ]] || die "disallow-host: profile '$profile' has no installed firewall rules, or they cannot be read — nothing was changed; re-run: egresslock ensure $profile, then retry: egresslock disallow-host $profile $host:$port"
    actual="$(canonicalize <<<"$raw")"
    # EGL-219-D9: read the record fail-closed named (same line regex
    # as read_pin_record; duplicate keys collapse iff values identical).
    local rec
    rec="$(pin_record_path "$profile")"
    if [[ ! -f "$rec" ]]; then
        die "disallow-host: pin record unreadable for profile '$profile' (missing file) — re-run: egresslock ensure $profile"
    fi
    local -a rec_lines=()
    if ! mapfile -t rec_lines < "$rec" 2>/dev/null; then
        die "disallow-host: pin record unreadable for profile '$profile' (cannot read $rec) — re-run: egresslock ensure $profile"
    fi
    local -A rec_sets=()
    local line key ipset uniq total
    for line in "${rec_lines[@]}"; do
        [[ -n "$line" ]] || continue
        if [[ "$line" =~ ^([^|[:space:]]+)\|([0-9]+)[[:space:]]+([0-9.]+( [0-9.]+)*)$ ]]; then
            key="${BASH_REMATCH[1]}|${BASH_REMATCH[2]}"
            ipset="${BASH_REMATCH[3]}"
            if [[ -n "${rec_sets[$key]:-}" && "${rec_sets[$key]}" != "$ipset" ]]; then
                die "disallow-host: pin record unreadable for profile '$profile' (disagreeing duplicate key for ${key%%|*}:${key##*|}) — re-run: egresslock ensure $profile"
            fi
            # D12(c): repeated address within one line = corrupt
            # (read_pin_record parity).
            uniq="$(awk '{for(i=1;i<=NF;i++) print $i}' <<<"$ipset" | LC_ALL=C sort -u | wc -l)"
            total="$(awk '{print NF}' <<<"$ipset")"
            if (( uniq != total )); then
                die "disallow-host: pin record unreadable for profile '$profile' (repeated address in line: '$line') — re-run: egresslock ensure $profile"
            fi
            rec_sets[$key]="$ipset"
        else
            die "disallow-host: pin record unreadable for profile '$profile' (corrupt line: '$line') — re-run: egresslock ensure $profile"
        fi
    done
    local gw_ip="${GW_IP[$profile]:-}"
    local -a want_hosts=() want_ports=() got_ips=() got_ports=()
    local hp r ip p i
    while IFS= read -r hp; do
        [[ -n "$hp" ]] || continue
        want_hosts+=("${hp%:*}")
        want_ports+=("${hp##*:}")
    done < <(profile_allow_hosts "$profile")
    # D9/D12: coverage before any count/skip return — an empty record or a
    # missing key (target or predecessor) is a record failure, not a chain
    # count mismatch.
    for i in "${!want_ports[@]}"; do
        if [[ -z "${rec_sets[${want_hosts[$i]}|${want_ports[$i]}]:-}" ]]; then
            die "disallow-host: pin record unreadable for profile '$profile' (no entry for ${want_hosts[$i]}:${want_ports[$i]}) — re-run: egresslock ensure $profile"
        fi
    done
    while IFS= read -r r; do
        local pin_re="^ip saddr ${subnet} iifname \"[^\"]+\" ip daddr ([0-9.]+) tcp dport ([0-9]+) counter accept\$"
        [[ "$r" =~ $pin_re ]] || continue
        ip="${BASH_REMATCH[1]}"
        p="${BASH_REMATCH[2]}"
        [[ "$ip" == "$gw_ip" ]] && continue
        got_ips+=("$ip")
        got_ports+=("$p")
    done <<<"$actual"
    # Total-count mismatch (Σ record set sizes over conf entries vs the
    # live pin accepts): refuse named (EGL-296) — the chain cannot be
    # proven to agree with the record; nothing changes (ensure, retry).
    local want_total=0
    for i in "${!want_ports[@]}"; do
        local cset="${rec_sets[${want_hosts[$i]}|${want_ports[$i]}]:-}"
        local -a csize=()
        read -ra csize <<<"$cset"
        want_total=$(( want_total + ${#csize[@]} ))
    done
    (( want_total == ${#got_ports[@]} )) || die "disallow-host: the installed allow-host rules for profile '$profile' no longer match its pin record — expected $want_total, found ${#got_ports[@]} (allow-host rule count mismatch); nothing was changed; re-run: egresslock ensure $profile, then retry: egresslock disallow-host $profile $host:$port"
    # Positional zip sized from the record: walk the conf entries in
    # order; every entry consumed BEFORE the target — and the target
    # itself — must carry a record key (missing = named fail-closed
    # die, D9); a missing key AFTER the target is caught by the
    # total-count check above, or by the full-agreement zip below
    # when the chain is short in step with the record (EGL-296).
    # start = Σ set sizes of the entries before the target.
    local start=-1 target_n=0 running=0
    for i in "${!want_ports[@]}"; do
        local cset="${rec_sets[${want_hosts[$i]}|${want_ports[$i]}]:-}"
        if [[ "${want_hosts[$i]}" == "$host" && "${want_ports[$i]}" == "$port" ]]; then
            if [[ -z "$cset" ]]; then
                die "disallow-host: pin record unreadable for profile '$profile' (no entry for ${want_hosts[$i]}:${want_ports[$i]}) — re-run: egresslock ensure $profile"
            fi
            local -a tsize=()
            read -ra tsize <<<"$cset"
            start=$running
            target_n=${#tsize[@]}
            break
        fi
        if [[ -z "$cset" ]]; then
            die "disallow-host: pin record unreadable for profile '$profile' (no entry for ${want_hosts[$i]}:${want_ports[$i]}) — re-run: egresslock ensure $profile"
        fi
        local -a csize2=()
        read -ra csize2 <<<"$cset"
        running=$(( running + ${#csize2[@]} ))
    done
    (( start >= 0 )) || die "disallow-host: cannot find allow-host $host:$port in the installed rules for profile '$profile' — nothing was changed; re-run: egresslock ensure $profile, then retry: egresslock disallow-host $profile $host:$port"
    # EGL-296: the chain must agree with the record before any mutation —
    # every conf entry, in order, every member's port and daddr (the same
    # comparison verify_expected_rules makes; a drifted or tampered chain
    # must not steer the flush key). Any divergence refuses named here,
    # before the conf mutation (nothing changed; retry after ensure).
    local k=0 j
    for i in "${!want_ports[@]}"; do
        local cset3="${rec_sets[${want_hosts[$i]}|${want_ports[$i]}]:-}"
        if [[ -z "$cset3" ]]; then
            die "disallow-host: pin record unreadable for profile '$profile' (no entry for ${want_hosts[$i]}:${want_ports[$i]}) — re-run: egresslock ensure $profile"
        fi
        local -a members3=()
        read -ra members3 <<<"$cset3"
        for j in "${!members3[@]}"; do
            [[ "${want_ports[$i]}" == "${got_ports[$k]}" ]] || die "disallow-host: the installed allow-host rules for profile '$profile' are in a different order than the config — config expects ${want_hosts[$i]}:${want_ports[$i]}, the installed rule has port ${got_ports[$k]} (allow-host port order mismatch); nothing was changed; re-run: egresslock ensure $profile, then retry: egresslock disallow-host $profile $host:$port"
            [[ "${members3[$j]}" == "${got_ips[$k]}" ]] || die "disallow-host: a pinned address for ${want_hosts[$i]}:${want_ports[$i]} no longer matches the installed rule in profile '$profile' — pin record: $cset3, installed rule: ${got_ips[$k]} (allow-host pin daddr mismatch); nothing was changed; re-run: egresslock ensure $profile, then retry: egresslock disallow-host $profile $host:$port"
            k=$(( k + 1 ))
        done
    done
    local -a out=()
    for (( i = 0; i < target_n; i++ )); do
        out+=("${got_ips[$(( start + i ))]}")
    done
    echo "${out[*]}"
    return 0
}

# EGL-139-D2 steps 5-6: scoped conntrack delete of the revoked pin's
# entries AFTER the atomic nft swap (a pre-swap flush lets in-flight
# packets re-mint the entry under the still-matching pin rule, R-003-7),
# then the post-assert that no entry remains — every observed state is a
# survivor (EGL-297-D1/D5). The -D rc is advisory; the post-assert is the
# completion gate, and a survivor dies loudly with the state disclosed,
# never a green rc with a live revoked flow (R2/R9). An observed entry
# means its packet already left under the revoked accept and a reply can
# complete the flow; only entries the dump cannot see remain the
# unconfirmed window (X20d). EGL-231-D1: the reader is a scoped ctnetlink
# `$bin -L`, not /proc/net/nf_conntrack (absent in a rootless netns).
# EGL-313-D1: discovery and delete share one scope — original-tuple rows
# sourced inside this profile's subnet, minus the gateway source; a
# sibling profile's authorized entry for the same daddr:dport is never
# touched (EGL-139-D2's gateway-leg side effect no longer occurs).
conntrack_flush_and_assert() { # conntrack_flush_and_assert <profile> <daddr> <dport>
    local profile="$1" dip="$2" dport="$3" out bin rrow rstate rsrc rdst rsp rdp s_u32
    local subnet gw_ip rc survivor
    subnet="${PROFILE_SUBNET[$profile]}"
    # EGL-313: the profile's subnet is the scope of this revocation — only
    # the revoked rule's own workload flows (its `ip saddr ${subnet}`
    # match, minus the gateway source) are deleted or witnessed; a
    # sibling profile's independently authorized entry for the same
    # daddr:dport is never touched (the reconcile's candidate predicate,
    # paired). The subnet was validated by cmd_ensure before any flush;
    # the parse is defense-in-depth.
    cidr_parse "$subnet" || die "invalid subnet '$subnet'"
    # EGL-168-D2: resolve the bin once so the post-swap failure dies can
    # hand the operator the exact scoped command with the RESOLVED path
    # (bare `conntrack` is often missing from a non-root PATH, which is
    # why conntrack_bin exists). Plain assignment: a die inside
    # conntrack_bin must propagate under set -e.
    bin="$(conntrack_bin)"
    # EGL-313 (a): enumerate the tuple's original-direction rows BEFORE
    # any delete. Every nonzero read rc is unreadable = fail closed named
    # (EGL-231-R2), with nothing to undo.
    rc=0
    out="$(netns_conntrack -L -p tcp --dport "$dport" -d "$dip" 2>&1)" || rc=$?
    if (( rc != 0 )); then
        die "cannot read the rootless netns conntrack table (rc=$rc): ${out:-<no output>}; state: conf line removed, ruleset swapped, ct unproven; next action: podman unshare --rootless-netns $bin -L -p tcp --dport $dport -d $dip"
    fi
    # EGL-313 (b): delete each in-scope row by its exact original tuple —
    # original src inside this profile's subnet and not the gateway
    # source (never flush unscoped). The -D rc stays advisory (EGL-231-D2:
    # "0 flow entries have been deleted" is the normal no-live-flow case;
    # the banner match is delimited, R-EGL-231-3) — any other nonzero is
    # the named warn. Rows outside the scope (another profile, the
    # gateway leg, foreign sources) are never deleted; each in-scope
    # delete is scoped further to its own daddr+dport.
    gw_ip="${GW_IP[$profile]:-}"
    while IFS= read -r rrow; do
        [[ "$rrow" =~ ^tcp[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+[A-Z_0-9]+[[:space:]]+src=([0-9.]+)[[:space:]]+dst=([0-9.]+)[[:space:]]+sport=([0-9]+)[[:space:]]+dport=([0-9]+) ]] || continue
        rsrc="${BASH_REMATCH[1]}"; rdst="${BASH_REMATCH[2]}"; rsp="${BASH_REMATCH[3]}"; rdp="${BASH_REMATCH[4]}"
        [[ "$rdst" == "$dip" && "$rdp" == "$dport" ]] || continue
        s_u32="$(cidr_u32 "$rsrc")"
        (( s_u32 >= CIDR_NETWORK && s_u32 <= CIDR_BCAST )) || continue
        [[ -n "$gw_ip" && "$rsrc" == "$gw_ip" ]] && continue
        if ! out="$(netns_conntrack -D -p tcp -s "$rsrc" --sport "$rsp" -d "$dip" --dport "$dport" 2>&1)"; then
            [[ "$out" == *": 0 flow entries have been deleted." ]] || \
                echo "warn: conntrack delete for $dip:$dport failed: $(tail -1 <<<"$out")" >&2
        fi
    done <<<"$out"
    # EGL-313 (c) + EGL-231: the witness shares the scope — a scoped
    # read, in-scope rows only (the same subnet-minus-gateway
    # predicate). Every nonzero read rc stays unreadable = fail closed
    # named (EGL-231-R2: no text exception — a nonzero rc that happens
    # to carry a zero/any summary is a failed read, not an empty table).
    rc=0
    out="$(netns_conntrack -L -p tcp --dport "$dport" -d "$dip" 2>&1)" || rc=$?
    if (( rc != 0 )); then
        die "cannot read the rootless netns conntrack table (rc=$rc): ${out:-<no output>}; state: conf line removed, ruleset swapped, ct unproven; next action: podman unshare --rootless-netns $bin -L -p tcp --dport $dport -d $dip"
    fi
    # EGL-231-D1: -L dump lines carry no procfs `ipv4 2` prefix (they
    # start directly with the protocol), so the survivor match keys on
    # $1 == "tcp" (index-based, not field position — both directions on
    # one line stay safe).
    # EGL-297-D1/D5 (M1): the survivor match keys on $1 == "tcp" and
    # the tuple only — every observed entry is a survivor (no
    # reply-less exception; the header rationale above explains why an
    # observed entry can still complete).
    survivor=""
    while IFS= read -r rrow; do
        [[ -n "$rrow" ]] || continue
        [[ "$rrow" =~ ^tcp[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+([A-Z_0-9]+)[[:space:]]+src=([0-9.]+)[[:space:]]+dst=([0-9.]+)[[:space:]]+sport=([0-9]+)[[:space:]]+dport=([0-9]+) ]] || continue
        rstate="${BASH_REMATCH[1]}"
        rsrc="${BASH_REMATCH[2]}"; rdst="${BASH_REMATCH[3]}"; rsp="${BASH_REMATCH[4]}"; rdp="${BASH_REMATCH[5]}"
        s_u32="$(cidr_u32 "$rsrc")"
        (( s_u32 >= CIDR_NETWORK && s_u32 <= CIDR_BCAST )) || continue
        [[ -n "$gw_ip" && "$rsrc" == "$gw_ip" ]] && continue
        survivor="$rrow"; break
    done <<<"$out"
    if [[ -n "$survivor" ]]; then
        die "the revoked allow-host rule's flow to $dip:$dport still has a live conntrack entry: $survivor; state: conf line removed, ruleset swapped, conntrack entry persists (the revoked flow is not proven gone) — next action: end the leftover connections: egresslock drop-unauthorized $profile $dport (drops the connections on port $dport the policy no longer allows, keeps the connections the policy still allows, then checks none remain; safe to run again)"
    fi
    # EGL-312: the peer direction. An incoming packet can recreate
    # tracking with the reversed original direction (peer -> workload;
    # kernel loose-TCP pickup), the workload's replies then ride the base
    # established accept, and the original-direction pair above never
    # sees it (R-EGL-306-3 F2). Peer rows are admitted only when the
    # workload end (the row's original dst) is in THIS profile's subnet —
    # EGL-313's cross-profile discipline applied to the new pair; each is
    # deleted by its exact original tuple, so a sibling profile's row for
    # the same peer:port is never touched. R-EGL-312-2 F2: the survivor
    # die below names the same profile-scoped recovery command as the
    # forward-direction die (the verb reconciles the peer direction too).
    # EGL-313 merge: subnet/locals are bound once at the head (shared
    # `subnet`/`bin`/`out`/`rc` — no double-declare).
    rc=0
    out="$(netns_conntrack -L -p tcp --sport "$dport" -s "$dip" 2>&1)" || rc=$?
    if (( rc != 0 )); then
        die "cannot read the rootless netns conntrack table (rc=$rc): ${out:-<no output>}; state: conf line removed, ruleset swapped, ct unproven; next action: podman unshare --rootless-netns $bin -L -p tcp --sport $dport -s $dip"
    fi
    while IFS= read -r rrow; do
        [[ "$rrow" =~ ^tcp[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+[A-Z_0-9]+[[:space:]]+src=([0-9.]+)[[:space:]]+dst=([0-9.]+)[[:space:]]+sport=([0-9]+)[[:space:]]+dport=([0-9]+) ]] || continue
        rsrc="${BASH_REMATCH[1]}"; rdst="${BASH_REMATCH[2]}"; rsp="${BASH_REMATCH[3]}"; rdp="${BASH_REMATCH[4]}"
        [[ "$rsrc" == "$dip" && "$rsp" == "$dport" ]] || continue
        s_u32="$(cidr_u32 "$rdst")"
        (( s_u32 >= CIDR_NETWORK && s_u32 <= CIDR_BCAST )) || continue
        if ! out="$(netns_conntrack -D -p tcp -s "$rsrc" --sport "$rsp" -d "$rdst" --dport "$rdp" 2>&1)"; then
            [[ "$out" == *": 0 flow entries have been deleted." ]] || \
                echo "warn: conntrack delete for the peer's direction of $dip:$dport failed: $(tail -1 <<<"$out")" >&2
        fi
    done <<<"$out"
    rc=0
    out="$(netns_conntrack -L -p tcp --sport "$dport" -s "$dip" 2>&1)" || rc=$?
    if (( rc != 0 )); then
        die "cannot read the rootless netns conntrack table (rc=$rc): ${out:-<no output>}; state: conf line removed, ruleset swapped, ct unproven; next action: podman unshare --rootless-netns $bin -L -p tcp --sport $dport -s $dip"
    fi
    survivor=""
    while IFS= read -r rrow; do
        [[ -n "$rrow" ]] || continue
        [[ "$rrow" =~ ^tcp[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+([A-Z_0-9]+)[[:space:]]+src=([0-9.]+)[[:space:]]+dst=([0-9.]+)[[:space:]]+sport=([0-9]+)[[:space:]]+dport=([0-9]+) ]] || continue
        rstate="${BASH_REMATCH[1]}"
        rsrc="${BASH_REMATCH[2]}"; rdst="${BASH_REMATCH[3]}"; rsp="${BASH_REMATCH[4]}"; rdp="${BASH_REMATCH[5]}"
        [[ "$rsrc" == "$dip" && "$rsp" == "$dport" ]] || continue
        s_u32="$(cidr_u32 "$rdst")"
        (( s_u32 >= CIDR_NETWORK && s_u32 <= CIDR_BCAST )) || continue
        survivor="$rrow"; break
    done <<<"$out"
    if [[ -n "$survivor" ]]; then
        die "the revoked allow-host rule's flow from $dip:$dport still has a live conntrack entry (the peer's direction): $survivor; state: conf line removed, ruleset swapped, conntrack entry persists (the revoked flow is not proven gone) — next action: end the leftover connections: egresslock drop-unauthorized $profile $dport (drops the connections on port $dport the policy no longer allows, keeps the connections the policy still allows, then checks none remain; safe to run again)"
    fi
}

# EGL-307: the accepted-set walk in one place — the post-swap chain's
# daddr accepts for <port>, the two shapes EGL-141-D1 emits (pin/
# gateway-hop and DNS-to-bridge; REVOCATION_INVARIANT.md walk pairing).
# Reads canonical chain text on stdin, prints one daddr per line. A new
# accept shape in the emitter must join THIS walk (they stay paired).
chain_accepted_daddrs() { # chain_accepted_daddrs <profile> <port>; canonical text on stdin
    local profile="$1" port="$2" line
    local subnet="${PROFILE_SUBNET[$profile]}"
    local accepted_re="^ip saddr ${subnet} iifname \"[^\"]+\" ip daddr ([0-9.]+) tcp dport ([0-9]+) counter accept\$"
    local accepted_dns_re='^ip saddr '"${subnet}"' iifname "[^"]+" ip daddr ([0-9.]+) meta l4proto \{ tcp, udp \} th dport ([0-9]+) counter accept$'
    while IFS= read -r line; do
        if [[ "$line" =~ $accepted_re ]]; then
            if [[ "${BASH_REMATCH[2]}" == "$port" ]]; then
                echo "${BASH_REMATCH[1]}"
            fi
        elif [[ "$line" =~ $accepted_dns_re ]]; then
            if [[ "${BASH_REMATCH[2]}" == "$port" ]]; then
                echo "${BASH_REMATCH[1]}"
            fi
        fi
    done
    return 0
}

# EGL-307: the shared post-swap accepted read. As EGL-311: a nonzero read
# rc, an empty/header-only/garbled chain, or one missing the baseline
# established/related accept is unusable (no flush runs on an
# unestablished accepted set). Non-dying: rc 0 fills CT_ACCEPTED_LIST
# (one daddr per element); rc 1 (read failed) also exposes
# CT_ACCEPTED_RAW/CT_ACCEPTED_RC; rc 2 = unusable. The reconcile maps rc
# to its named dies; the member-leg guard flushes every member on any
# nonzero rc (doubt severs). Call WITHOUT command substitution so the
# globals reach the caller's frame (`$()` would drop them).
conntrack_accepted_set() { # conntrack_accepted_set <profile> <port> -> rc; fills CT_ACCEPTED_LIST/CT_ACCEPTED_RAW/CT_ACCEPTED_RC
    local profile="$1" port="$2" raw read_rc=0 canon canon_rc=0
    CT_ACCEPTED_RAW=""
    CT_ACCEPTED_RC=0
    CT_ACCEPTED_LIST=()
    raw="$(netns_nft list chain inet "$TABLE" "$(chain_of "$profile")" 2>&1)" || read_rc=$?
    CT_ACCEPTED_RAW="$raw"
    CT_ACCEPTED_RC="$read_rc"
    (( read_rc == 0 )) || return 1
    [[ -n "$raw" ]] || return 2
    canon="$(canonicalize <<<"$raw")" || canon_rc=$?
    (( canon_rc == 0 )) && [[ -n "$canon" ]] || return 2
    grep -q 'ct state established,related counter accept' <<<"$canon" || return 2
    mapfile -t CT_ACCEPTED_LIST < <(chain_accepted_daddrs "$profile" "$port" <<<"$canon")
    return 0
}

# EGL-295: the post-swap port reconcile — cmd_disallow_host calls this
# between the member flush loop and `removed:`. The member leg keyed only
# the revoked rule's current pin members; a name pin whose DNS refreshed
# re-pins the address and leaves the earlier address's established entry
# alive, its flow riding the base ct-state accept (X20a: rc 0 +
# `removed:` while the old-address stream delivered). Here the post-swap
# chain is re-read and the REVOKED PORT reconciled (D1a: the rule is
# host:port and its flows carry that dport — never wider): every
# workload-sourced entry whose daddr the chain no longer accepts is
# flushed via the EGL-313 source-scoped conntrack_flush_and_assert.
conntrack_reconcile_port() { # conntrack_reconcile_port <profile> <port> <pin_ips> [witness [retry_cmd]]
    local profile="$1" port="$2" pin_ips="$3" witness="${4:-0}" retry_cmd="${5:-}"
    local chain subnet
    chain="$(chain_of "$profile")"
    subnet="${PROFILE_SUBNET[$profile]}"
    local pass
    for pass in flush witness; do
        [[ "$pass" == flush || "$witness" == 1 ]] || continue
        # (1) the accepted set, from the post-swap LIVE chain (D1c — the
        # chain is the authority for what is accepted now, not the pin
        # record: a record carries current members only and a tampered
        # record must not steer a flush). The chain's daddr+dport accepts
        # have two shapes (EGL-141-D1): the pin/gateway-hop accepts and the
        # DNS-to-bridge accept; the established accept, the anti-spoof and
        # terminal drops, and the MAC exemption carry no daddr+dport pair
        # and contribute nothing. A NEW accept shape added to the chain
        # emitter must join this walk in lockstep
        # (internal_docs/REVOCATION_INVARIANT.md).
        # EGL-311: the post-swap chain read is a proof input, not a belt.
        # Capture its status and reject every nonzero rc BEFORE consuming
        # stdout (a failed read whose output happens to look complete must
        # never steer the flush). A successful read must also carry this
        # profile chain's baseline established/related accept — an empty or
        # header-only listing is an unusable policy, not "no accepts on this
        # port" (the latter is valid and still reconciles). On any of these
        # states, die named BEFORE the enumerate/flush: no flush runs on an
        # unestablished accepted set, and `removed:` stays unprinted (the
        # caller's success line is last).
        local bin nbin
        bin="$(conntrack_bin)"
        nbin="$(nft_bin)"
        # EGL-307: the read+gate+walk live in conntrack_accepted_set (shared
        # with the member-leg guard); the rc maps to the same named dies.
        # Plain call, no command substitution: CT_ACCEPTED_RC/CT_ACCEPTED_RAW
        # must reach this frame for the rc-1 die (EGL-307 finish fix).
        local acc_rc=0 line
        conntrack_accepted_set "$profile" "$port" || acc_rc=$?
        if (( acc_rc == 1 )); then
            die "cannot read the firewall rules for profile '$profile' after the rule was removed (rc=$CT_ACCEPTED_RC): ${CT_ACCEPTED_RAW:-<no output>}; state: conf line removed, ruleset swapped, conntrack unproven; next action: the rule is already out and the firewall already replaced, but any connection left on port $port cannot be checked against the removed rule while the rules are unreadable — inspect what is left: podman unshare --rootless-netns $nbin list chain inet $TABLE $chain; podman unshare --rootless-netns $bin -L -p tcp --dport $port; then delete a leftover by hand: podman unshare --rootless-netns $bin -D -p tcp --dport $port -d <destination>"
        fi
        if (( acc_rc == 2 )); then
            die "the firewall rules for profile '$profile' came back empty, incomplete, or unusable after the rule was removed; state: conf line removed, ruleset swapped, conntrack unproven; next action: the rule is already out and the firewall already replaced, but any connection left on port $port cannot be checked against the removed rule while the rules are unreadable — inspect what is left: podman unshare --rootless-netns $nbin list chain inet $TABLE $chain; podman unshare --rootless-netns $bin -L -p tcp --dport $port; then delete a leftover by hand: podman unshare --rootless-netns $bin -D -p tcp --dport $port -d <destination>"
        fi
        local -A accepted=()
        for line in "${CT_ACCEPTED_LIST[@]}"; do
            [[ -n "$line" ]] || continue
            accepted["$line"]=1
        done
        # (2) enumerate the port's conntrack entries. EGL-231-R2: every
        # nonzero `-L` rc is unreadable = fail closed named (S6 — the same
        # partial-state disclosure as the member read; the member leg may
        # already have run, disclosed below).
        local out rc=0
        out="$(netns_conntrack -L -p tcp --dport "$port" 2>&1)" || rc=$?
        if (( rc != 0 )); then
            die "cannot read the rootless netns conntrack table (rc=$rc): ${out:-<no output>}; state: conf line removed, ruleset swapped, conntrack unproven; next action: podman unshare --rootless-netns $bin -L -p tcp --dport $port"
        fi
        # EGL-312: the peer direction, same read discipline. Rows whose
        # original tuple is src=<peer> sport=$port — the reversed-orig
        # shape an incoming packet mints.
        local out_rev=""
        rc=0
        out_rev="$(netns_conntrack -L -p tcp --sport "$port" 2>&1)" || rc=$?
        if (( rc != 0 )); then
            die "cannot read the rootless netns conntrack table (rc=$rc): ${out_rev:-<no output>}; state: conf line removed, ruleset swapped, ct unproven; next action: podman unshare --rootless-netns $bin -L -p tcp --sport $port"
        fi
        # (3) candidate rows: parsed on the ORIGINAL tuple (the first
        # src=/dst= set, the fields -d/--dport select), state-agnostic
        # (D1i: `-D` deletes any state; the token class admits
        # digit-bearing `SYN_SENT2` — a dropped row bypasses both flush
        # and witness). A candidate is workload-sourced (src inside the
        # profile subnet, not the gateway source, D1b), its dst no longer
        # accepted on this port, and not an already-flushed member (D1g).
        # Unparseable subnet -> skip (never flush unscoped). First-seen
        # order, deduped.
        if ! cidr_parse "$subnet"; then
            if (( witness )); then
                die "cannot check the leftover connections on port $port for profile '$profile': the profile's subnet is unusable; state: conf line removed, ruleset swapped, conntrack unproven"
            fi
            return 0
        fi
        local gw_ip="${GW_IP[$profile]:-}"
        local row src dst s_u32
        local -A seen=() seen_rev=()
        local -a cands=()
        while IFS= read -r row; do
            [[ -n "$row" ]] || continue
            [[ "$row" =~ ^tcp[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+[A-Z_0-9]+[[:space:]]+src=([0-9.]+)[[:space:]]+dst=([0-9.]+) ]] || continue
            src="${BASH_REMATCH[1]}"
            dst="${BASH_REMATCH[2]}"
            if [[ -n "${seen[$dst]:-}" ]]; then continue; fi
            if [[ "${accepted[$dst]+yes}" ]]; then continue; fi
            if [[ " $pin_ips " == *" $dst "* ]]; then continue; fi
            if [[ -n "$gw_ip" && "$src" == "$gw_ip" ]]; then continue; fi
            s_u32="$(cidr_u32 "$src")"
            if (( s_u32 < CIDR_NETWORK || s_u32 > CIDR_BCAST )); then continue; fi
            seen[$dst]=1
            cands+=("$dst")
        done <<<"$out"
        # EGL-312: the reversed-orig admission — the mirrored candidate walk
        # onto the peer direction. src = the address the chain must still
        # accept on this port (the peer); dst in-subnet = the workload side
        # (the same workload-side restriction the flush helper's peer block
        # applies); the pin_ips skip is deliberately absent — a current
        # member is in accepted and is skipped there, and the member leg
        # already covers its reversed pair. Dedup is per orientation
        # (seen/seen_rev); a duplicate flush target across the two sets is
        # a tolerated no-op.
        while IFS= read -r row; do
            [[ -n "$row" ]] || continue
            [[ "$row" =~ ^tcp[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+[A-Z_0-9]+[[:space:]]+src=([0-9.]+)[[:space:]]+dst=([0-9.]+)[[:space:]]+sport=([0-9]+) ]] || continue
            src="${BASH_REMATCH[1]}"; dst="${BASH_REMATCH[2]}"
            [[ "${BASH_REMATCH[3]}" == "$port" ]] || continue
            if [[ -n "${seen_rev[$src]:-}" ]]; then continue; fi
            if [[ "${accepted[$src]+yes}" ]]; then continue; fi
            if [[ -n "$gw_ip" && "$src" == "$gw_ip" ]]; then continue; fi
            s_u32="$(cidr_u32 "$dst")"
            if (( s_u32 < CIDR_NETWORK || s_u32 > CIDR_BCAST )); then continue; fi
            seen_rev[$src]=1
            cands+=("$src")
        done <<<"$out_rev"
        if [[ "$pass" == witness ]]; then
            (( ${#cands[@]} == 0 )) || die "the connections on port $port to ${cands[*]} still have live conntrack entries and the policy does not allow them; state: conf line removed, ruleset swapped, some connections remain; next action: run the same command again (safe to repeat): $retry_cmd"
        else
            local dst
            for dst in "${cands[@]}"; do
                conntrack_flush_and_assert "$profile" "$dst" "$port"
            done
        fi
    done
    return 0
}

verify_expected_rules() { # prints expected ruleset; rc 1 on zip mismatch
    local profile="$1" chain subnet
    chain="$(chain_of "$profile")"
    subnet="${PROFILE_SUBNET[$profile]}"
    # Live chain, canonicalized exactly as the deep compare does.
    local raw actual
    raw="$(netns_nft list chain inet "$TABLE" "$chain" 2>/dev/null || true)"
    actual="$(canonicalize <<<"$raw")"

    # Zip config allow-hosts to live `ip daddr <ip> tcp dport <port>`
    # accepts (in order), excluding DNS (dport 53) and the gateway hop.
    local gw_ip="${GW_IP[$profile]:-}"
    local -a want_hosts=() want_ports=() got_ips=() got_ports=()
    local h line hip hport ip port
    while IFS= read -r hp; do
        [[ -n "$hp" ]] || continue
        want_hosts+=("${hp%:*}")
        want_ports+=("${hp##*:}")
    done < <(profile_allow_hosts "$profile")

    # EGL-140-D1: the daddr witness comes from the ensure-time pin
    # record, read BEFORE the structural checks (a missing/corrupt
    # record is its own named failure, D3). Zero-allow-host profiles are
    # exempt (no record, no failure).
    VERIFY_PINS=()
    if (( ${#want_ports[@]} > 0 )); then
        read_pin_record "$profile" || return 1
    fi

    while IFS= read -r r; do
        # EGL-141-D1: the pinned accept is iifname-scoped (any resolved
        # bridge name matches — the same live helper builds the expected
        # ruleset, so expected and actual agree; the regex only unbinds
        # the device token, it stays $-anchored and shape-strict).
        local pin_re="^ip saddr ${subnet} iifname \"[^\"]+\" ip daddr ([0-9.]+) tcp dport ([0-9]+) counter accept\$"
        [[ "$r" =~ $pin_re ]] || continue
        ip="${BASH_REMATCH[1]}"
        port="${BASH_REMATCH[2]}"
        # Exclude the DNS-to-bridge rule and the static gateway hop.
        [[ "$ip" == "$gw_ip" ]] && continue
        got_ips+=("$ip")
        got_ports+=("$port")
    done <<<"$actual"

    # EGL-219 §4: the count is Σ over conf ENTRIES of each entry's
    # record-set word count — a legal duplicate allow-host line emits its
    # set twice and must count twice (summing unique keys would fail on a
    # legal conf). The zip below consumes the accepts positionally: each
    # entry takes its set-size slice.
    local expected_total=0 i j k
    local -a rec_sets=()
    for i in "${!want_ports[@]}"; do
        local key="${want_hosts[$i]}|${want_ports[$i]}"
        local rec_set="${VERIFY_PINS[$key]:-}"
        if [[ -z "$rec_set" ]]; then
            echo "verify: pin record corrupt for profile '$profile' (no entry for ${want_hosts[$i]}:${want_ports[$i]}) — re-run: egresslock ensure $profile" >&2
            return 1
        fi
        local -a members=()
        read -ra members <<<"$rec_set"
        rec_sets+=("$rec_set")
        expected_total=$(( expected_total + ${#members[@]} ))
    done
    if (( expected_total != ${#got_ports[@]} )); then
        echo "verify: allow-host rule count mismatch for profile '$profile' (config: ${expected_total}, chain: ${#got_ports[@]})" >&2
        return 1
    fi
    k=0
    for i in "${!want_ports[@]}"; do
        local key="${want_hosts[$i]}|${want_ports[$i]}"
        local rec_set="${rec_sets[$i]}"
        local -a members=()
        read -ra members <<<"$rec_set"
        for j in "${!members[@]}"; do
            if [[ "${want_ports[$i]}" != "${got_ports[$k]}" ]]; then
                echo "verify: allow-host port order mismatch for profile '$profile' (config ${want_hosts[$i]}:${want_ports[$i]}, chain dport ${got_ports[$k]})" >&2
                return 1
            fi
            # EGL-140-D1 step 3 / EGL-219-D7: each live daddr must equal
            # the ensure-time record member in order — divergence is a
            # post-ensure chain edit (tamper, torn record), fail closed
            # named. The message keeps the pinned template: the record
            # value is the entry's whole set (space-joined), the chain
            # value is the first mismatching member; for a 1-element
            # set both renders are single addresses (byte-identical to
            # the pre-set messages).
            if [[ "${members[$j]}" != "${got_ips[$k]}" ]]; then
                echo "verify: allow-host pin daddr mismatch for ${want_hosts[$i]}:${want_ports[$i]} (record: $rec_set, chain: ${got_ips[$k]}) — re-run: egresslock ensure $profile" >&2
                return 1
            fi
            k=$(( k + 1 ))
        done
    done

    # Emit the expected ruleset with pins. The zip above has filled
    # VERIFY_PINS for every configured host; in VERIFY_PIN_MODE the
    # compilers resolve via resolve_pin (no DNS). Fill VERIFY_PINS in
    # the CALLER's scope: this function must NOT run inside $().
    VERIFY_PIN_MODE=1
    policy_rules "$profile"
    local rc=$?
    VERIFY_PIN_MODE=0
    return $rc
}

#
# ---------------------------------------------------------------------------
# ARC-8: data-driven profile configuration engine
# ---------------------------------------------------------------------------
#
# Config format (ARC-8-D1): line-based, one directive per line; '#' comments
# and blank lines ignored; every line matched against a strict grammar. The
# config is DATA, never sourced or eval'd; every interpolated value is
# regex-validated before it reaches nftables or Squid. Unparseable or
# contradictory content fails closed with exit 2, naming file, line, and
# the offending line.
#
#   profile <name> <cidr>              # starts a profile block (IPv4 /8-29)
#       rule allow-host <host>:<port>  # ordered, repeatable
#       rule gateway-only              # requires a `gateway` directive
#       gateway <ip> <port> <file>     # static gateway IP inside the subnet
#       no-proxy <host[,host...]>      # extra NO_PROXY entries
#       read-timeout <seconds>         # Squid read_timeout override (EGL-116;
#                                      # positive integer seconds, default 900)
#
# ARC-11: subnet = any IPv4 CIDR /8-29 (integer math); bridge gateway =
# first usable, anchor = last usable. `creds` was REMOVED (ARC-11-D4):
# credential injection is the consumer's decision, not engine grammar.
# Host fields may reference ${VAR} or ${VAR:-default} (parsed manually,
# never eval'd); shipped configs keep FORGEJO_HOST/OLLAMA_HOST overridable.
#

# A profile's config rules are stored in two flat global arrays (kind and
# argument per entry, profile-prefixed) — appended in config order and
# filtered by the compiler. Plain arrays keep the config data: no eval,
# no dynamic code, no dynamic variable names.
ENGINE_KINDS=()
ENGINE_ARGS=()

engine_rule_push() { # engine_rule_push <profile> <kind> <args>
    ENGINE_KINDS+=("$1|$2")
    ENGINE_ARGS+=("$3")
}

# Fail-closed config error: file:line, reason, offending text. Exit 2
# (usage-class error) so a broken config can never silently fall back.
config_error() {
    echo "Error: $ENGINE_CONF_NAME:$1: $2" >&2
    [[ $# -ge 3 ]] && echo "  offending line: $3" >&2
    exit 2
}

cfg_trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# Expand a ${VAR} / ${VAR:-default} reference (or pass literals through).
# Parsed with a regex, never eval'd. Unset without default is an error.
cfg_expand() {
    local v="$1"
    if [[ "$v" =~ ^\$\{([A-Za-z_][A-Za-z0-9_]*)(:-([^}]*))?\}$ ]]; then
        local val="${BASH_REMATCH[1]}"
        val="${!val-}"
        if [[ -z "$val" ]]; then
            [[ -n "${BASH_REMATCH[2]:-}" ]] || return 1
            val="${BASH_REMATCH[3]}"
        fi
        printf '%s' "$val"
        return 0
    fi
    printf '%s' "$v"
}

cfg_is_ipv4() {
    local o
    [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    for o in "${BASH_REMATCH[@]:1:4}"; do
        # Reject leading zeros: bash arithmetic would read '010' as
        # octal 8 (R-011-1 finding 3), silently re-aiming the config.
        [[ "$o" =~ ^0[0-9]+$ ]] && return 1
        (( o <= 255 )) || return 1
    done
    return 0
}

# Fresh-load reset of the config-derived state (EGL-181-D1), called by
# load_config only on a fresh load, never in append mode. `=()` preserves
# the `declare -A` attributes — do not rewrite as `unset`. ENGINE_KINDS /
# ENGINE_ARGS must reset too (R-038-1): allow-host/disallow-host reload
# the mutated conf in-process, and a stale accumulation would register
# every rule twice, corrupting the chain and silently passing verify.
cfg_reset_state() {
    PROFILES=()
    PROFILE_SUBNET=()
    GW_IP=()
    GW_PORT=()
    GW_ALLOWLIST=()
    PROFILE_NO_PROXY_EXTRA=()
    PROFILE_READ_TIMEOUT=()
    PROFILE_CONF=()
    ENGINE_KINDS=()
    ENGINE_ARGS=()
}

# Close out the current profile block (EGL-181-D1: file scope). cur /
# has_gw / has_gw_only / block_line / block_raw are the aggregator's
# locals via bash dynamic scope (EGL-181-D2); the gateway-only miss
# attributes to block_line, the OPENING line (R-008-1), never to n.
cfg_block_end() {
    [[ -n "$cur" ]] || return 0
    if [[ "$has_gw_only" == yes && "$has_gw" == no ]]; then
        config_error "$block_line" "profile '$cur' has 'rule gateway-only' but no 'gateway' directive" "$block_raw"
    fi
    # EGL-116-D1: default the per-profile read_timeout at block close
    # so every profile carries an explicit, greppable value (900 =
    # Squid stock, 15 minutes).
    PROFILE_READ_TIMEOUT[$cur]="${PROFILE_READ_TIMEOUT[$cur]:-900}"
    cur=""
}

# "profile <name> <subnet>" arm (EGL-181-D1). Enforces the
# one-profile-block-per-file rule (EGL-323): a second `profile` line
# fails closed, naming the already-open block and its opening line.
# Owns the name grammar, the cross-file dup check (is_profile +
# PROFILE_CONF), CIDR validation, and the parallel-array appends.
# Sets the aggregator's cur / has_gw / has_gw_only / block_line /
# block_raw via dynamic scope (EGL-181-D2); later block-close errors
# attribute to block_line, the opening line (R-008-1).
cfg_profile() {
    local name subnet rest canon rc
    [[ -z "$cur" ]] \
        || config_error "$n" "one profile per conf file: '$cur' is already defined at line $block_line; put each profile in its own conf file" "$raw"
    read -r _ name subnet rest <<<"$line"
    [[ -z "${rest:-}" ]] || config_error "$n" "unexpected trailing text after subnet" "$raw"
    # ARC-59-D1: profile names start alnum — a leading '-' would read as
    # a flag-like token in argv even though kit names are fixed-prefixed.
    [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
        || config_error "$n" "invalid profile name '$name' (expected [a-z0-9][a-z0-9-]*, must not start with '-')" "$raw"
    # ARC-37-D3: aggregation must not silently shadow a name
    # already loaded from an earlier file. config_error names
    # the CURRENT file (its prefix); PROFILE_CONF names the
    # earlier one so both are identified.
    is_profile "$name" \
        && config_error "$n" "duplicate profile name '$name' across configs (also in '${PROFILE_CONF[$name]:-<earlier file>}')" "$raw"
    # ARC-11-D3: any IPv4 prefixlen 8-29, canonical network
    # address, integer CIDR math.
    rc=0
    cidr_parse "$subnet" || rc=$?
    case $rc in
        0) ;;
        2) config_error "$n" "invalid subnet '$subnet' (prefix length must be between 8 and 29)" "$raw" ;;
        3) config_error "$n" "invalid subnet '$subnet' (not the canonical network address; host bits must be zero)" "$raw" ;;
        *) config_error "$n" "invalid subnet '$subnet' (expected IPv4 CIDR like 192.0.2.0/24)" "$raw" ;;
    esac
    canon="$(cidr_ip "$CIDR_NETWORK")/$CIDR_PLEN"
    PROFILES+=("$name")
    PROFILE_SUBNET[$name]="$canon"
    PROFILE_CONF[$name]="$conf"
    has_gw=no; has_gw_only=no
    block_line=$n; block_raw="$raw"
    cur="$name"
}

# "creds ..." arm (EGL-181-D1): dedicated reject, never a generic
# unknown directive.
cfg_creds() {
    # ARC-11-D4: dedicated error, not a generic unknown directive — a
    # pre-ARC-11 config must be told exactly what changed, never silently
    # ignored. A deployed copy is fixed by re-running its deployment
    # script (e.g. copy_files.sh), not by hand-editing.
    config_error "$n" "the 'creds' directive was removed; update this config — delete the line, credential injection is the consumer's decision. If this file is a deployed copy, re-run your deployment script (e.g. copy_files.sh) instead of editing" "$raw"
}

# "rule <kind>" arm (EGL-181-D1): gateway-only flag, allow-host
# validation (port split, cfg_expand, ARC-59 grammar, EGL-147 trailing
# dot, ARC-32-D2 DNS caps), or the unknown-kind reject. One arm, one
# helper — allow-host is deliberately not sub-split (EGL-181-D1).
cfg_rule() {
    local rest host port val
    [[ -n "$cur" ]] || config_error "$n" "'rule' outside a profile block" "$raw"
    rest="${line#"rule "}"
    if [[ "$rest" == "gateway-only" ]]; then
        has_gw_only=yes
        engine_rule_push "$cur" gateway-only ""
    elif [[ "$rest" == "allow-host "* ]]; then
        read -r _ _ host rest <<<"$line"
        [[ -z "${rest:-}" ]] || config_error "$n" "unexpected trailing text" "$raw"
        [[ "$host" == *:* ]] \
            || config_error "$n" "allow-host needs <host>:<port>" "$raw"
        # Split at the last colon: host part, port part.
        port="${host##*:}"
        host="${host%:*}"
        if [[ ! "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
            config_error "$n" "invalid port '$port' (expected 1-65535)" "$raw"
        fi
        val="$(cfg_expand "$host")" \
            || config_error "$n" "environment variable in '$host' is unset and has no default" "$raw"
        # ARC-59-D1: host fields start alnum or '.' (dstdomain suffix) —
        # never '-'. '--help' / '-x' are flag-shaped tokens.
        [[ "$val" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
            || config_error "$n" "invalid host name '$val'" "$raw"
        # EGL-147-D2: a trailing-dot host is the same dead
        # shape as a trailing-dot allowlist entry (squid can
        # never match it) — the CLI must not mint a conf the
        # parser rejects (ARC-32-D2 symmetry), so the parser
        # names it too.
        [[ "$val" == *. ]] \
            && config_error "$n" "host '$val' has a trailing dot — entries are bare names" "$raw"
        # ARC-32-D2: same DNS length caps as the allowlist
        # predicate (host <= 253, labels 1..63) — the conf
        # must not carry a token the gateway can never use.
        arc32_dns_len_ok "${val#.}" \
            || config_error "$n" "host '$val' exceeds DNS length limits (host <= 253 bytes, labels <= 63)" "$raw"
        engine_rule_push "$cur" allow-host "$val:$port"
    else
        config_error "$n" "unknown rule kind '$rest' (expected allow-host <host>:<port>, or gateway-only)" "$raw"
    fi
}

# "gateway <ip> <port> <path>" arm (EGL-181-D1): IP / subnet
# membership (ARC-11-D3 CIDR math) / port / ARC-58-D1 allowlist-path
# validation; sets has_gw=yes and the per-profile GW_* entries. Reads
# the aggregator's dir (conf directory) for relative allowlist paths
# via dynamic scope (EGL-181-D2).
cfg_gateway() {
    local ip port path rest
    [[ -n "$cur" ]] || config_error "$n" "'gateway' outside a profile block" "$raw"
    [[ "$has_gw" == no ]] || config_error "$n" "duplicate 'gateway' directive in profile '$cur'" "$raw"
    read -r _ ip port path rest <<<"$line"
    [[ -z "${rest:-}" ]] || config_error "$n" "unexpected trailing text" "$raw"
    cfg_is_ipv4 "$ip" || config_error "$n" "invalid gateway IP '$ip'" "$raw"
    # Membership + reserved-address exclusion via CIDR math
    # (ARC-11-D3): the static gateway IP must lie strictly
    # between the bridge gateway (first usable) and the anchor
    # (last usable) — never network, broadcast, or either
    # derived address.
    cidr_parse "${PROFILE_SUBNET[$cur]}" \
        || config_error "$n" "invalid profile subnet '${PROFILE_SUBNET[$cur]}'" "$raw"
    local ipu32
    ipu32="$(cidr_u32 "$ip")"
    if (( ipu32 <= CIDR_FIRST || ipu32 >= CIDR_LAST )); then
        config_error "$n" "gateway IP '$ip' is outside the usable range of profile subnet '${PROFILE_SUBNET[$cur]}' (must not be the network address, the bridge gateway, or the anchor address)" "$raw"
    fi
    if [[ ! "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
        config_error "$n" "invalid gateway port '$port' (expected 1-65535)" "$raw"
    fi
    [[ "$path" =~ [[:space:]] ]] \
        && config_error "$n" "allowlist path must not contain whitespace" "$raw"
    # ARC-58-D1: relative paths are confdir basenames. A
    # single component only — no '/', no '..' segment — so a
    # pasted '../other/secret' cannot resolve outside the
    # conf dir (confused deputy against sibling files).
    # Absolute paths are an explicit operator choice.
    if [[ "$path" == /* ]]; then
        GW_ALLOWLIST[$cur]="$path"
    elif [[ "$path" =~ ^[A-Za-z0-9._-]+$ && "$path" != ".." ]]; then
        GW_ALLOWLIST[$cur]="$dir/$path"
    else
        config_error "$n" "invalid allowlist path '$path' (relative paths must be a single basename like 'main-allowlist'; use an absolute path for elsewhere)" "$raw"
    fi
    GW_IP[$cur]="$ip"
    GW_PORT[$cur]="$port"
    has_gw=yes
}

# "no-proxy <list>" arm (EGL-181-D1): the comma-split stays inside
# this helper — local IFS=, and unset IFS must not leak to the
# aggregator (EGL-181-D2). Per-entry grammar: cfg_expand + ARC-59-D1 +
# EGL-147-D2 + ARC-32-D2 DNS caps.
cfg_no_proxy() {
    local val rest
    [[ -n "$cur" ]] || config_error "$n" "'no-proxy' outside a profile block" "$raw"
    [[ -z "${PROFILE_NO_PROXY_EXTRA[$cur]:-}" ]] \
        || config_error "$n" "duplicate 'no-proxy' directive in profile '$cur'" "$raw"
    read -r _ val rest <<<"$line"
    [[ -z "${rest:-}" ]] || config_error "$n" "unexpected trailing text" "$raw"
    local entry out="" expanded
    # Intentional comma-split of the no-proxy list; each
    # entry is validated against the host grammar below.
    local IFS=,
    for entry in $val; do
        entry="$(cfg_trim "$entry")"
        expanded="$(cfg_expand "$entry")" \
            || config_error "$n" "environment variable in '$entry' is unset and has no default" "$raw"
        # ARC-59-D1: NO_PROXY entries are host fields — start
        # alnum or '.', never '-'.
        [[ "$expanded" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
            || config_error "$n" "invalid NO_PROXY entry '$expanded'" "$raw"
        # EGL-147-D2: trailing-dot NO_PROXY entry — same
        # dead-or-surprising shape; named reject like
        # allow-host above.
        [[ "$expanded" == *. ]] \
            && config_error "$n" "host '$expanded' has a trailing dot — entries are bare names" "$raw"
        # ARC-32-D2: same DNS length caps as the allowlist
        # predicate (host <= 253, labels 1..63).
        arc32_dns_len_ok "${expanded#.}" \
            || config_error "$n" "NO_PROXY entry '$expanded' exceeds DNS length limits (host <= 253 bytes, labels <= 63)" "$raw"
        out="${out:+$out,}$expanded"
    done
    unset IFS
    [[ -n "$out" ]] || config_error "$n" "empty no-proxy list" "$raw"
    PROFILE_NO_PROXY_EXTRA[$cur]="$out"
}

# "read-timeout <seconds>" arm (EGL-181-D1): one per block; positive
# integer (EGL-116-D1, R-011-1 octal discipline).
cfg_read_timeout() {
    local val rest
    # EGL-116-D1: per-profile Squid read_timeout (seconds).
    # One per block; positive integer, >= 1, no suffixes, no
    # leading zeros (R-011-1 octal discipline) — anything
    # else fails closed like any unknown directive.
    [[ -n "$cur" ]] || config_error "$n" "'read-timeout' outside a profile block" "$raw"
    [[ -z "${PROFILE_READ_TIMEOUT[$cur]:-}" ]] \
        || config_error "$n" "duplicate 'read-timeout' directive in profile '$cur'" "$raw"
    read -r _ val rest <<<"$line"
    [[ -z "${rest:-}" ]] || config_error "$n" "unexpected trailing text after read-timeout" "$raw"
    [[ "$val" =~ ^[1-9][0-9]*$ ]] \
        || config_error "$n" "invalid read-timeout '$val' (expected a positive integer of seconds, >= 1; no suffixes)" "$raw"
    PROFILE_READ_TIMEOUT[$cur]="$val"
}

load_config() {
    local conf="$1" append="${2:-}"
    [[ -f "$conf" ]] || { echo "Error: config file not found: $conf" >&2; exit 2; }
    ENGINE_CONF_NAME="$conf"
    local dir
    dir="$(cd "$(dirname "$conf")" && pwd)"

    [[ "$append" != 1 ]] && cfg_reset_state

    # Loop-carried state stays in the aggregator; the per-directive
    # helpers above mutate it through bash dynamic scope (EGL-181-D2:
    # no namerefs, no subshell around load_config, config_error stays
    # exit 2 so ARC-38 temp-validate keeps failing closed).
    local raw line n=0 cur="" has_gw has_gw_only
    # EGL-323: one `profile` block per file — the in-file dup-name and
    # subnet-overlap scans retired with the multi-block grammar; the
    # cross-file dup check lives in cfg_profile, subnet overlap is
    # checked at ensure time (ensure_no_overlap).
    # R-008-1 finding 2: block-closing errors are attributed to the
    # profile line that opened the block, not the line where the close
    # was detected.
    local block_line=0 block_raw=""

    while IFS= read -r raw || [[ -n "$raw" ]]; do
        n=$((n+1))
        line="$(cfg_trim "${raw%%#*}")"
        [[ -z "$line" ]] && continue

        case "$line" in
            "profile "*)      cfg_profile ;;
            "creds "*)        cfg_creds ;;
            "rule "*)         cfg_rule ;;
            "gateway "*)      cfg_gateway ;;
            "no-proxy "*)     cfg_no_proxy ;;
            "read-timeout "*) cfg_read_timeout ;;
            *) config_error "$n" "unknown directive" "$raw" ;;
        esac
    done < "$conf"
    # EGL-181-D4: EOF cursor bump kept verbatim (the closer reports
    # block_line); a later ticket must name it before removal.
    n=$((n+1))
    cfg_block_end

    (( ${#PROFILES[@]} > 0 )) || config_error 0 "config defines no profiles"
}

# EGL-120-D1: remediation hint after an allow-host resolve failure on
# the ensure/install path — every time (ensure is not a paste-safe feed;
# a one-time note is missed on retry), stderr only. Verify-pin mode gets
# NO hint: it has its own `verify: no live pin ...` message.
allow_host_resolve_hint() { # allow_host_resolve_hint <profile> <host> <port>
    {
        echo "hint: allow-host pins must resolve on the HOST. For a same-host HTTP(S) service use: allow $1 ${2}:${3}"
        echo "hint: for a same-host non-HTTP service use: allow-host $1 169.254.1.2:${3}"
        echo "hint: this rule is already in the conf; remove it with: disallow-host $1 ${2}:${3}"
    } >&2
}

#
# Generic rule compiler. Emits, per profile, in order:
#   1. implicit established/related + DNS-to-gateway allows;
#   2. config rules in config order (allow-host resolved NOW, fail closed);
#   3. the terminal rule, derived — never configured: a scoped drop,
#      preceded by the gateway-source exemption when a gateway exists
#      (ARC-2-D4).
#
compiled_rules() {
    local profile="$1" subnet gateway bridge
    subnet="${PROFILE_SUBNET[$profile]}"
    # The DNS allow targets the bridge gateway = first usable address
    # (ARC-11-D3); integer CIDR math, any supported prefix.
    cidr_parse "$subnet" || die "invalid subnet '$subnet'"
    gateway="$(cidr_ip "$CIDR_FIRST")"
    # EGL-141-D1: the bridge device is live-resolved inside the emit
    # path (every refresh carries the current name). A resolution
    # failure must fail the BUILDER by rc (EGL-120-D1 pattern) — this
    # compiler runs inside a set -e-inert substitution in the install
    # file builder, so die() would only exit the subshell. Never emit
    # an empty iifname.
    bridge="$(profile_bridge_if "$profile")" || {
        echo "Error: policy emit aborted for profile '$profile' (bridge interface unresolved, fail closed)" >&2
        return 1
    }

    # EGL-141-D2: counted early anti-spoof drop, FIRST (drop is terminal
    # across base chains, ARC-52-D3). Out-of-bridge in-subnet-saddr
    # packets get a NAMED, counted spoof verdict, not an incidental
    # terminal hit; out-of-subnet sources (C-5/E-01) still ride the base
    # accept (EGL-145). The line starts with `iifname !=`; nft preserves
    # written order (EGL-141-D1), so canonicalize's keep-filter must keep
    # `^iifname` lines.
    echo "iifname != \"${bridge}\" ip saddr ${subnet} counter drop"
    # EGL-141-D1: every saddr-keyed ACCEPT is scoped to the profile's
    # own bridge. Emit `ip saddr` FIRST so the canonicalize keep-filter
    # sees the line, then `iifname` (the EGL-123-D2 pattern for
    # `ether saddr`; nft preserves written order, EGL-141-D1).
    echo "ip saddr ${subnet} iifname \"${bridge}\" ct state established,related counter accept"
    echo "ip saddr ${subnet} iifname \"${bridge}\" ip daddr ${gateway} meta l4proto { tcp, udp } th dport 53 counter accept"

    local i kind arg pfx="${profile}|"
    local hip hport dip
    for i in "${!ENGINE_KINDS[@]}"; do
        [[ "${ENGINE_KINDS[$i]}" == "$pfx"* ]] || continue
        kind="${ENGINE_KINDS[$i]#"$pfx"}"
        arg="${ENGINE_ARGS[$i]}"
        case "$kind" in
            allow-host)
                hip="${arg%:*}"; hport="${arg##*:}"
                # EGL-120-D1: capture-and-check. The substitution's die
                # ("cannot resolve") exits only the subshell, and this
                # compiler can run inside a set -e-inert assignment
                # substitution (install_policy's refresh-file builder) —
                # an unchecked failure there continued with an empty
                # daddr and emitted a malformed nft rule for nft to
                # reject. Catch the failure EXPLICITLY, hint, and
                # propagate by rc so no nft -f ever runs on a partial
                # file.
                if ! dip="$(resolved_dest "$hip")"; then
                    if [[ "$VERIFY_PIN_MODE" == 0 ]]; then
                        allow_host_resolve_hint "$profile" "$hip" "$hport"
                    fi
                    return 1
                fi
                # Belt: an empty IP with rc 0 (a die swallowed again)
                # must never render an empty daddr.
                [[ -n "$dip" ]] || die "cannot resolve $hip"
                # EGL-219-D1: the pin is the whole ensure-time A set
                # (any-of) — one accept per resolved address per port.
                # The set is the sorted cache/record value; the loop
                # order is the canonical order, so the chain, the pin
                # record, and the verify zip agree member-for-member.
                local member
                for member in $dip; do
                    echo "ip saddr ${subnet} iifname \"${bridge}\" ip daddr ${member} tcp dport ${hport} counter accept"
                done
                ;;
            gateway-only)
                # EGL-141-D1: the gateway-hop accept is saddr-keyed and
                # therefore iifname-scoped like every accept.
                echo "ip saddr ${subnet} iifname \"${bridge}\" ip daddr ${GW_IP[$profile]} tcp dport ${GW_PORT[$profile]} counter accept"
                ;;
        esac
    done

    if is_gateway_profile "$profile"; then
        # ARC-2-D4 + EGL-123-D2: the gateway's own egress is exempted
        # INSIDE this chain, then the terminal scoped drop. The exemption
        # keys on source IP *and* the kit-derived gateway MAC, so a
        # co-located sibling spoofing only the gateway IP falls through
        # to the drop. The MAC comes from conf identity (gw_mac), never a
        # live inspect (EGL-91). One line starting with `ip saddr` so
        # canonicalize's keep-filter sees it. EGL-141-D1 adds the bridge
        # scope (saddr+iifname+MAC); closures narrow, never widen (the
        # cross-bridge MAC+IP clone, X-5, is closed; the same-bridge
        # clone stays the EGL-142 residual).
        echo "ip saddr ${GW_IP[$profile]} iifname \"${bridge}\" ether saddr $(gw_mac "$profile") counter accept"
        echo "ip saddr ${subnet} counter drop"
    else
        # EGL-141-D1: the terminal drop stays saddr-keyed and
        # interface-UNscoped — with D2's anti-spoof first it remains
        # the in-bridge C-4 diagnostic; it must keep adjudicating an
        # out-of-bridge in-subnet packet if the anti-spoof rule were
        # absent.
        echo "ip saddr ${subnet} counter drop"
    fi
}

#
# Resolve a profile's allowlist source file: per-profile from the config
# (`gateway` directive), conf-relative unless absolute.
#
allowlist_src() {
    echo "${GW_ALLOWLIST[$1]}"
}

#
# EGL-106-D2: build ONE nft -f file for the whole policy install — the
# shared p_v6deny chain and the profile chain in a SINGLE transaction.
# nft applies a -f file as one atomic netlink batch, so observers never
# see "v6deny installed, profile chain missing" (the inter-transaction
# first-create window EGL-106 closes): they see the pre-install state
# or both chains complete. Existence probes are reads; `flush chain`
# is emitted ONLY for a chain the probe found — flush of a missing
# chain fails the batch (D1 fail-closed). Chain blocks: p_v6deny
# FIRST, profile chain LAST (R-003-7 intent: the profile content is
# the last chain block; with one -f there is no "last file" anymore).
# EGL-120-D1: a rule-generation failure deletes the temp and returns
# rc 1 with no file — no -f, no partial transaction, no second Error
# line (the resolve failure already reported itself).
#
# Four combinations fall out of the two probes:
#   p_v6deny missing + profile missing -> create both (first install)
#   p_v6deny exists + profile missing  -> flush v6deny, create-with-rules
#                                         profile (typical first create)
#   p_v6deny missing + profile exists  -> create v6deny, flush+re-add
#                                         profile
#   both exist                         -> flush+re-add both (warm
#                                         ensure / R-003-7 refresh)
#
policy_install_file() { # policy_install_file <profile> -> tmp path; rc 1 on rule-gen failure
    local profile="$1" chain
    chain="$(chain_of "$profile")"
    local v6_exists=no profile_exists=no
    if netns_nft list chain inet "$TABLE" p_v6deny >/dev/null 2>&1; then
        v6_exists=yes
    fi
    if netns_nft list chain inet "$TABLE" "$chain" >/dev/null 2>&1; then
        profile_exists=yes
    fi
    local tmp rules_rc=0
    tmp="$(mktemp /tmp/egresslock-policy.XXXXXX.nft)"
    {
        if [[ "$v6_exists" == yes ]]; then
            echo "flush chain inet ${TABLE} p_v6deny"
        fi
        if [[ "$profile_exists" == yes ]]; then
            echo "flush chain inet ${TABLE} ${chain}"
        fi
        echo "table inet ${TABLE} {"
        echo "    chain p_v6deny {"
        echo "        type filter hook forward priority -160; policy accept;"
        echo "        meta nfproto ipv6 counter drop"
        echo "    }"
        echo "    chain ${chain} {"
        echo "        type filter hook forward priority -150; policy accept;"
        # EGL-120-D1: a rule-generation failure (unresolvable allow-host)
        # must delete the temp file and fail the builder by rc — never
        # emit a partial file for nft to reject.
        policy_rules "$profile" || rules_rc=1
        echo "    }"
        echo "}"
    } > "$tmp"
    if (( rules_rc != 0 )); then
        rm -f "$tmp"
        return 1
    fi
    echo "$tmp"
}

install_policy() {
    local profile="$1" chain f
    chain="$(chain_of "$profile")"
    # EGL-219-D3: resolve every conf allow-host ONCE, into the per-run
    # cache, BEFORE the ruleset build — so one resolve feeds the rule
    # build, the pin record, and the announce. Parent scope (not a
    # subshell: policy_install_file runs the compiler in-process), so
    # the cache survives into write_pin_record and
    # ensure_announce_refreshed. An unresolvable host fails here with
    # the ruleset untouched (fail-closed install unchanged).
    ensure_resolve_pins "$profile" || return 1
    # EGL-106-D1: the whole install is ONE `netns_nft -f` transaction —
    # the shared p_v6deny chain (create-if-missing, else flush+re-add)
    # and the profile chain (create-with-rules, or flush+re-add) in the
    # same file. Two files left an inter-transaction window on first
    # create (v6deny landed, profile chain missing: a concurrent IPv4
    # forward rode Netavark's default accept); one atomic -f closes it
    # without touching the EGL-91-D4 ensure order. Additive re-emission
    # used to stack duplicate v6 deny rules; flush-if-exists self-heals
    # that inside the same transaction.
    f="$(policy_install_file "$profile")" || return 1
    # ARC-49 F1: explicit rm + die (no EXIT trap) — a failed -f leaves
    # no /tmp/egresslock-policy.* behind.
    if ! netns_nft -f "$f"; then
        rm -f "$f"
        die "nft policy install failed for profile '$profile' (fail closed)"
    fi
    # EGL-305: the atomic -f applied — the ruleset is swapped from here
    # on. Set IMMEDIATELY (before the post-swap rm -f below) so every
    # later failure reads swapped, not restore; the cmd_ensure EXIT trap
    # (ensure_exit_trap) consumes this flag. If the swap ever moves out
    # of install_policy, this set-site moves with it.
    ENSURE_POLICY_SWAPPED=1
    rm -f "$f"
    # Remove the deprecated separate exemption chain (pre-ARC-5-D4
    # layout). Safe at any time: the exemption lives in the class chain.
    if is_gateway_profile "$profile"; then
        netns_nft flush chain inet "$TABLE" p_gw_egress >/dev/null 2>&1 || true
        netns_nft delete chain inet "$TABLE" p_gw_egress >/dev/null 2>&1 || true
    fi
}

#
# Canonicalize an nft chain listing to its semantic content: strip
# counter packet/byte expansion (real nft prints 'counter packets N bytes
# N'), drop indentation, keep only rule lines, PRESERVING order. Expected
# and actual compare equal iff the ordered rules match; order matters, so
# no sorting (R-003-7 finding 2).
#
# EGL-98-D2: stale-unpolicied predicate. A profile is stale when its
# podman network OBJECT survives (on-disk) while its policy chain is
# absent from the shared rootless netns (volatile) — the post-reboot
# window, where a raw `podman run --network egresslock-<p>` re-plumbs
# netavark and recreates the netns with NO egresslock table. The chain
# is the scope, not the table: the table is shared (ARC-66-D4), so a
# sibling's re-ensure recreates it while this profile's chain is still
# missing. Teardown removes the network object and a never-ensured
# profile has none, so neither is stale (the ARC-16-D3 silent skip is
# preserved). Torn state (chain present, anchor dead — EGL-91/EGL-97)
# is NOT this predicate: callers keep the `verify: anchor … not running`
# line.
#
# Returns 0 = stale-unpolicied; 1 = not stale; 2 = hard probe failure
# (nft missing / netns not answering) — the named R9 failure is emitted
# here and callers never fold it into a silent success or skip.
profile_stale_unpolicied() { # profile_stale_unpolicied <profile>
    local profile="$1" out rc=0
    # (1) the on-disk half: the network object. Absent = never-ensured
    # or teardown'd = not stale (silent skip preserved).
    rt_network_inspect "$(network_of "$profile")" >/dev/null 2>&1 || return 1
    # (2) the volatile half: the profile chain. nft answers "No such
    # file or directory" when the chain is missing (fresh netns, no
    # table, or sibling-ensured-without-us); any other failure is a
    # hard probe failure — named, fail closed, never a skip (R9).
    if out="$(netns_nft list chain inet "$TABLE" "$(chain_of "$profile")" 2>&1)"; then
        return 1
    else
        rc=$?
    fi
    if [[ "$out" == *"No such file or directory"* ]]; then
        return 0
    fi
    echo "Error: cannot probe the nft policy for profile '$profile' in the rootless netns (rc=$rc): ${out:-<no output>}; check pasta/podman health — run: egresslock ensure $profile" >&2
    return 2
}

# EGL-178-D1: verify_policy step helpers (probe / read / compare).
# verify_policy stays the public entry point and the order document:
# network -> stale window -> anchor -> foreign hooks -> shared v6-deny
# chain -> profile chain. The a141 mismatch/tamper fixtures and the
# EGL-98 stale-unpolicied fixtures pin every named failure below.
verify_policy_preflight() { # EGL-178-D1: state probes, three named fails kept distinct
    local profile="$1" anchor
    rt_network_inspect "$(network_of "$profile")" >/dev/null 2>&1 \
        || { echo "verify: network $(network_of "$profile") missing — run: egresslock ensure $profile" >&2; return 1; }
    # EGL-98-D2: stale-unpolicied window. Name the real state and its
    # runnable next action (R9) instead of a true-but-unexplained
    # "anchor not running"; torn state keeps that anchor line. A hard
    # probe failure (rc 2) is already named by the helper; fail closed.
    local stale=0
    profile_stale_unpolicied "$profile" || stale=$?
    if (( stale == 2 )); then
        return 1
    fi
    if (( stale == 0 )); then
        echo "verify: network exists but policy does not — run: egresslock ensure $profile" >&2
        return 1
    fi
    anchor="$(anchor_of "$profile")"
    anchor_running "$anchor" \
        || { echo "verify: anchor $anchor not running" >&2; return 1; }

    # ARC-52-D3: verify sees only its own table, but nft accept is not
    # terminal across base chains — another table's forward-hook drop at
    # the same or earlier priority silently overrides this kit's accepts
    # (on-host: a leftover policy table killed all workload egress while
    # verify was green). Fail closed on foreign early hooks; never delete
    # anything here (ensure owns cleanup).
    verify_no_early_foreign_hooks || return 1
}

verify_v6deny_chain() { # EGL-178-D1: shared chain compare (profile arg kept for step-signature symmetry)
    # Shared unscoped IPv6 deny chain: exact ordered content.
    local v6 v6actual v6expected
    v6="$(netns_nft list chain inet "$TABLE" p_v6deny 2>/dev/null || true)"
    v6actual="$(canonicalize <<<"$v6")"
    v6expected="$(printf '%s\n' \
        'type filter hook forward priority -160; policy accept;' \
        'meta nfproto ipv6 counter drop')"
    if [[ "$v6actual" != "$v6expected" ]]; then
        echo "verify: shared v6-deny chain missing or does not match the expected policy" >&2
        diff <(echo "$v6expected") <(echo "$v6actual") >&2 || true
        return 1
    fi
}

verify_profile_chain() { # EGL-178-D1: profile chain compare; the ONLY verify-path caller of verify_expected_rules
    local profile="$1" chain
    chain="$(chain_of "$profile")"
    # Profile chain: hook, priority, and the exact ORDERED rule set.
    # ARC-12-D1 as amended by EGL-140-D1: allow-host daddrs in the
    # EXPECTED ruleset come from the ensure-time confdir pin record
    # (verify_expected_rules -> read_pin_record), so DNS drift is not a
    # verify failure and a tampered chain cannot adopt its own daddrs;
    # the zip's count/port checks still fail closed on structural
    # mismatch, and each live daddr is compared against the record
    # (divergence = post-ensure chain edit, named fail). resolve_set is
    # NOT called here.
    # NOTE: verify_expected_rules runs WITHOUT a command substitution
    # (no $() ) because it fills VERIFY_PINS for check_dns_drift; a
    # subshell would discard those assignments.
    local raw actual
    raw="$(netns_nft list chain inet "$TABLE" "$chain" 2>/dev/null || true)"
    actual="$(canonicalize <<<"$raw")"
    VERIFY_PINS=()
    # verify_expected_rules FILLS VERIFY_PINS (consumed by
    # check_dns_drift), so it must NOT run inside a $() subshell:
    # capture its output via a temp file instead.
    local pinfile
    pinfile="$(mktemp /tmp/egresslock-verify.XXXXXX)"
    local ok=1
    verify_expected_rules "$profile" > "$pinfile" || ok=0
    if (( ok == 0 )); then
        rm -f "$pinfile"
        echo "verify: policy chain $chain does not match the expected ruleset" >&2
        return 1
    fi
    { echo "type filter hook forward priority -150; policy accept;"
      cat "$pinfile"
    } > "$pinfile.new"
    mv "$pinfile.new" "$pinfile"
    local expected # EGL-178-D6: was an undeclared file-scope global; no consumer outside this compare
    expected="$(cat "$pinfile")"
    rm -f "$pinfile"
    if [[ "$actual" != "$expected" ]]; then
        echo "verify: policy chain $chain does not match the expected ruleset" >&2
        diff <(echo "$expected") <(echo "$actual") >&2 || true
        return 1
    fi
}

verify_policy() {
    # EGL-178-D1: aggregator. The step order here is the order document;
    # fail-closed rc mapping and every message string are unchanged.
    # Review R-003-3/R-003-7: verify the COMPLETE policy with semantic
    # ORDER preserved: the shared v6-deny chain (type, priority, policy,
    # exact rule order) and the profile chain (hook, priority, exact
    # ordered ruleset). nft first-match semantics mean a reordered
    # accept/drop is a different policy, so nothing is sorted.
    local profile="$1"
    verify_policy_preflight "$profile" || return 1
    verify_v6deny_chain "$profile" || return 1
    verify_profile_chain "$profile" || return 1
}

canonicalize() {
    # Normalize an nft chain listing to its semantic content, PRESERVING
    # rule order: real output indents rules (R-003-4: filter AFTER
    # de-indenting), expands counters, and renders priorities as named
    # aliases ('mangle' = -150; -160 renders as 'mangle - 10'). Order
    # matters (R-003-7 finding 2): first-match semantics mean a
    # reordered accept/drop changes the policy, so NO sorting here.
    # EGL-141-D2: the anti-spoof drop STARTS with `iifname !=`; nft
    # preserves written order (EGL-141-D1), so the keep-filter must keep
    # `^iifname` lines or the named spoof verdict vanishes from the
    # expected==actual compare. This is a new named line class, NOT a
    # reorder extension: scoped accepts still emit `ip saddr` first.
    # `^oifname` is deliberately NOT added (nothing emits it — never a
    # general loosening, EGL-48).
    sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//
        s/counter packets [0-9]+ bytes [0-9]+/counter/
        s/priority mangle - 10/priority -160/
        s/priority mangle;/priority -150;/' \
        | grep -E '^(type filter|ip saddr|meta nfproto|iifname)'
}

#
# ARC-52-D3: numeric value of an nft `priority <spec>` rendering, as
# `nft list ruleset` prints it — bare numbers ('-150'), named aliases
# ('filter' = 0, 'mangle' = -150, 'mangle - 10' = -160, plus the other
# standard names), or empty/unknown (return 1: the spec cannot be
# judged, so callers skip it instead of guessing).
#
nft_priority_value() {
    local spec="$1" base num=0
    spec="${spec#"${spec%%[![:space:]]*}"}"
    spec="${spec%"${spec##*[![:space:]]}"}"
    if [[ "$spec" =~ ^-?[0-9]+$ ]]; then
        echo "$spec"
        return 0
    fi
    base="$spec"
    if [[ "$spec" =~ ^([a-z]+)[[:space:]]+([+-])[[:space:]]*([0-9]+)$ ]]; then
        base="${BASH_REMATCH[1]}"
        if [[ "${BASH_REMATCH[2]}" == "-" ]]; then
            num=$(( -BASH_REMATCH[3] ))
        else
            num=$(( BASH_REMATCH[3] ))
        fi
    fi
    case "$base" in
        raw)      echo $(( -300 + num )) ;;
        mangle)   echo $(( -150 + num )) ;;
        dstnat)   echo $(( -100 + num )) ;;
        filter)   echo $(( num )) ;;
        srcnat)   echo $(( 100 + num )) ;;
        security) echo $(( 225 + num )) ;;
        *) return 1 ;;
    esac
}

#
# ARC-52-D3: fail closed on early foreign FORWARD hooks. nft accept is
# NOT terminal across base chains: a second forward-hook chain at the
# same or earlier priority terminal-drops everything the profile chain
# accepts (on-host: a stale policy table silently killed all workload
# egress while verify inspected only its own table). Fail when any OTHER
# table declares a `type filter hook forward` base chain at priority
# <= -150; the message names table and chain.
# Exempt (D3 check 3): later-priority hooks (Netavark's FORWARD at 0)
# and this kit's own table. An unreadable/unparseable listing degrades
# to no-op; the per-chain checks below still verify this kit's policy.
#
verify_no_early_foreign_hooks() {
    local ruleset hits rc=0
    ruleset="$(netns_nft list ruleset 2>/dev/null || true)"
    [[ -n "$ruleset" ]] || return 0
    # Emit one <family<TAB>table<TAB>chain<TAB>priority> per filter/forward
    # base chain found in any table of the ruleset.
    hits="$(awk '
        /^[[:space:]]*table[[:space:]]/ {
            fam=$2; tbl=$3; sub(/[[:space:]]*\{[[:space:]]*$/, "", tbl); next
        }
        /^[[:space:]]*chain[[:space:]]/ {
            ch=$2; sub(/[[:space:]]*\{[[:space:]]*$/, "", ch)
            inchain=1; infwd=0; prio=""; next
        }
        inchain && /type[[:space:]]+filter[[:space:]]+hook[[:space:]]+forward/ {
            infwd=1
            if (match($0, /priority[[:space:]]+[^;]+/)) {
                prio=substr($0, RSTART+8, RLENGTH-8)
                gsub(/[[:space:]]+/, " ", prio)
                sub(/^[[:space:]]+/, "", prio)
                sub(/[[:space:]]+$/, "", prio)
            }
            next
        }
        /^[[:space:]]*\}/ {
            if (inchain && infwd) print fam "\t" tbl "\t" ch "\t" prio
            inchain=0; next
        }
    ' <<<"$ruleset")"
    while IFS=$'\t' read -r fam tbl ch prio; do
        [[ -n "$fam" ]] || continue
        [[ "$fam" == inet && "$tbl" == "$TABLE" ]] && continue
        [[ -n "$prio" ]] || continue
        local val
        val="$(nft_priority_value "$prio")" || continue
        (( val > -150 )) && continue
        echo "verify: foreign forward-hook chain '${ch}' in table '${fam} ${tbl}' (priority ${prio}) runs at or before the profile chains (-150) — its drop would silently override this kit's accepts. Not managed by this kit: remove it or move it later in the hook." >&2
        rc=1
    done <<<"$hits"
    return "$rc"
}

gw_image() {
    if [[ -n "${EGRESSLOCK_GW_IMAGE:-}" ]]; then
        # ARC-59-D1: a non-empty value that starts with '-' is a
        # flag-shaped token in the `podman run ... "$(gw_image)"`.
        [[ "$EGRESSLOCK_GW_IMAGE" == -* ]] \
            && die "EGRESSLOCK_GW_IMAGE value must not start with '-' (got '$EGRESSLOCK_GW_IMAGE')"
        echo "$EGRESSLOCK_GW_IMAGE"
    else
        echo "localhost/egresslock-gateway:latest"
    fi
}

# EGL-226: image-state probe shared by cmd_doctor and cmd_build_gateway.
# Reads the first sha256 digest of <containerfile> as the deployed pin and
# the image's base-digest label + created stamp via the rt_* seam. Writes
# globals, never stdout; never call this (or gw_image) in a command
# substitution — a die() at the call site must propagate under set -e.
gw_probe_state() { # gw_probe_state <image> <containerfile>
    GW_PROBE_STATE=missing
    GW_PROBE_BASE=""; GW_PROBE_CREATED=""; GW_PROBE_PIN=""; GW_PROBE_INS=""
    if [[ -f "$2" ]]; then
        # `|| true`: a digest-less Containerfile is pin="" (EGL-222)
        GW_PROBE_PIN="$(grep -oE 'sha256:[0-9a-f]{64}' "$2" | head -1 || true)"
    fi
    rt_image_exists "$1" 2>/dev/null || return 0
    GW_PROBE_STATE=present
    local ins=""
    if ins="$(rt_image_inspect "$1" '{{index .Config.Labels "org.opencontainers.image.base.digest"}} {{.Created}}' 2>/dev/null)"; then
        # EGL-254: Go template index of a missing key prints the literal
        # "<no value>" — strip it before the split so the pre-label branch
        # fires (mirrors egresslock-setup's kit doctor and build-egl-base).
        [[ "$ins" == "<no value>"* ]] && ins="${ins#"<no value>"}"
        GW_PROBE_INS="$ins"
        if [[ "$ins" == *\ * ]]; then
            GW_PROBE_BASE="${ins%% *}"; GW_PROBE_CREATED="${ins#* }"
        else
            GW_PROBE_BASE="$ins"
        fi
    fi
}

#
# Squid dstdomain allowlist content generated from the repo source file.
# Lines: comment (#) and blank lines stripped; entries are host[:port] or
# leading-dot domain suffixes (passed through for Squid dstdomain).
#
#
# Parse and validate the repo allowlist into entries: "host" or
# "host:port" (ARC-2-D2 contract). Comments/blanks stripped, malformed
# lines fail closed. Prints one entry per line.
#
gw_allowlist_entries() {
    local profile="$1" src
    src="$(allowlist_src "$profile")"
    [[ -f "$src" ]] || die "allowlist file missing: $src (check the profile's 'gateway' directive)"
    local raw entry host port probe
    while IFS= read -r raw || [[ -n "$raw" ]]; do
        entry="${raw%%#*}"
        entry="$(tr -d '[:space:]' <<<"$entry")"
        [[ -z "$entry" ]] && continue
        # ARC-59-D1: host fields start alnum or '.' (dstdomain suffix) — a
        # leading '-' would read as a flag-like token.
        if [[ "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*:[0-9]+$ ]]; then
            host="${entry%:*}"
            port="${entry##*:}"
            if (( port < 1 || port > 65535 )); then
                die "invalid port in allowlist entry '$entry'"
            fi
            # EGL-147-D2: same trailing-dot reject as the CLI — a
            # hand-edited (or stale) dead line must fail ensure closed,
            # never deploy (the gateway can never match it; X-6 E7).
            if [[ "$host" == *. ]]; then
                die "allowlist entry '$entry' has a trailing dot — dstdomain entries are bare names; requests with trailing dots are normalized by the gateway"
            fi
            # ARC-51-D1: the allowlist is names only (squid dstdomain).
            # A literal IPv4 in the file is a fail-closed error, not a
            # skipped line — the operator must move it to allow-host.
            probe="${host#.}"
            if cfg_is_ipv4 "$probe"; then
                die "allowlist entry '$entry' is an IPv4 literal; literals belong on 'allow-host' (host:port), not the gateway allowlist"
            fi
            # ARC-32-D2: the file path inherits the DNS length caps —
            # fail closed here rather than persisting a line the
            # gateway can never use (ARC-48 U9).
            arc32_dns_len_ok "$probe" \
                || die "allowlist entry '$entry' exceeds DNS length limits (host <= 253 bytes, labels <= 63)"
            # 443 is the default HTTPS group; keep it there so an
            # explicit :443 does not create a redundant second group.
            if (( port == 443 )); then
                echo "$host"
            else
                echo "$host:$port"
            fi
        elif [[ "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
            # EGL-147-D2: trailing-dot bare entry — same reject shape
            # as the host:port branch above (fail closed on both).
            if [[ "$entry" == *. ]]; then
                die "allowlist entry '$entry' has a trailing dot — dstdomain entries are bare names; requests with trailing dots are normalized by the gateway"
            fi
            probe="${entry#.}"
            if cfg_is_ipv4 "$probe"; then
                die "allowlist entry '$entry' is an IPv4 literal; literals belong on 'allow-host' (host:port), not the gateway allowlist"
            fi
            # ARC-32-D2: the file path inherits the DNS length caps
            # (see the host:port branch above).
            arc32_dns_len_ok "$probe" \
                || die "allowlist entry '$entry' exceeds DNS length limits (host <= 253 bytes, labels <= 63)"
            echo "$entry"
        else
            die "invalid allowlist entry '$entry' (expected host or host:port)"
        fi
    done < "$src"
}

#
# Generate the complete Squid config for the gateway into $1; hostname
# groups' dstdomain files go in the same staging dir. Entries without a
# port are restricted to 443 (TLS); "host:port" entries get their own
# dstdomain group + port ACL. Every rule set ends in a terminal deny all.
#
gw_generate_config() {
    local profile="$1" out="$2" stage="$3"
    local entries host port p
    # EGL-100: explicit rc check — inside an `if !` condition context
    # the function body is exempt from set -e, so the substitution's
    # failure would otherwise be silently swallowed. The inner die
    # already named the cause (the missing file with the gateway-
    # directive hint, or the offending entry) — exit on it without
    # stacking a second, mislabelling line (R9).
    entries="$(gw_allowlist_entries "$profile")" || exit 1

    # Squid resolves allowlisted destinations itself. Bypass Aardvark
    # (its forwarding fails on some CDN CNAME chains; on-host:
    # api.openrouter.ai unresolvable while the apex worked) and use the
    # pasta DNS forwarder, which reaches the host resolver. Squid's own
    # queries are exempted in p_llm_cloud (EGL-123-D2 / EGL-141-D1).
    # R-005-5: validate the override — it is interpolated into the Squid
    # config, so reject anything that could inject directives.
    # ARC-56-D1: the sink consumes a LIST OF IPv4 ADDRESSES, so a charset
    # allowlist is not enough: single-space-separated non-whitespace
    # tokens only, then each token must pass cfg_is_ipv4.
    local gw_dns="${GW_DNS_NAMESERVERS:-169.254.1.1}"
    if [[ ! "$gw_dns" =~ ^[^[:space:]]+( [^[:space:]]+)*$ ]]; then
        die "GW_DNS_NAMESERVERS must be a single-space-separated list of IPv4 addresses"
    fi
    local -a gw_dns_tokens=() tok
    read -r -a gw_dns_tokens <<< "$gw_dns"
    for tok in "${gw_dns_tokens[@]}"; do
        cfg_is_ipv4 "$tok" || die "GW_DNS_NAMESERVERS entry '$tok' is not a valid IPv4 address"
    done
    gw_dns="${gw_dns_tokens[*]}"
    cat > "$out" <<EOF
# Generated by egresslock from $(allowlist_src "$profile") — do not edit.
http_port ${GW_PORT[$profile]}
# Explicit (never silent stock inherit): the idle origin-response timer
# that closes long silent non-streaming requests.
read_timeout ${PROFILE_READ_TIMEOUT[$profile]} seconds
pid_filename /tmp/squid.pid
dns_nameservers $gw_dns
shutdown_lifetime 2 seconds
coredump_dir /var/spool/squid
access_log stdio:/var/log/squid/access.log
cache_log /var/log/squid/cache.log
cache deny all

acl agent_class src ${PROFILE_SUBNET[$profile]}
EOF

    # Group 1: hosts without an explicit port -> default HTTPS port.
    local noport=0
    : > "$stage/allowlist.domains"
    while IFS= read -r entry; do
        # Empty entries (e.g. the heredoc newline from an EMPTY allowlist
        # file) must not mint a phantom no-port ACL group — that would
        # quietly turn a fail-closed empty allowlist into an allow rule.
        [[ -z "$entry" ]] && continue
        [[ "$entry" != *:* ]] || continue
        echo "$entry" >> "$stage/allowlist.domains"
        noport=1
    done <<<"$entries"
    if [[ "$noport" == 1 ]]; then
        {
            # EGL-146-D1: `-n` on EVERY generated dstdomain ACL — Squid
            # must not adopt rDNS for IP-literal CONNECTs (X-6 E8);
            # numeric hosts fail the name match outright.
            echo 'acl agent_allowlist dstdomain -n "/etc/squid/agent/allowlist.domains"'
            echo 'acl agent_port_443 port 443'
            echo 'http_access allow agent_class agent_allowlist agent_port_443'
        } >> "$out"
    fi

    # Group 2+: hosts with an explicit destination port.
    local seen=""
    while IFS= read -r entry; do
        [[ "$entry" == *:* ]] || continue
        port="${entry##*:}"
        [[ " $seen " == *" $port "* ]] && continue
        seen="$seen $port"
    done <<<"$entries"
    # Intentional word-split of the port set (space-joined ports extracted
    # from already-validated host:port entries — digits only).
    for p in $seen; do
        : > "$stage/allowlist.p$p"
        while IFS= read -r entry; do
            [[ "$entry" == *:* ]] || continue
            [[ "${entry##*:}" == "$p" ]] || continue
            echo "${entry%:*}" >> "$stage/allowlist.p$p"
        done <<<"$entries"
        {
            # EGL-146-D1: same `-n` flag as the no-port group (see
            # above); per-port groups must not diverge.
            echo "acl agent_allowlist_p$p dstdomain -n \"/etc/squid/agent/allowlist.p$p\""
            echo "acl agent_port_p$p port $p"
            echo "http_access allow agent_class agent_allowlist_p$p agent_port_p$p"
        } >> "$out"
    done

    echo "http_access deny all" >> "$out"
}

# EGL-114-D2: byte-identity compare between the generated candidate set
# and the deployed files inside a RUNNING gateway. rc 0 = converged (the
# caller skips cp/mv/restart), rc 1 = differs (the apply path).
# Fail-closed: an exec failure or missing live counterpart is a DIFFER,
# never a skip. The compared set is the candidate's own files —
# squid.conf plus every allowlist.* it references. Unreferenced live
# allowlist.* files are ignored (the image entrypoint creates
# allowlist.conf on boot; a literal extra-file compare could never
# converge and would restart a healthy gateway on every ensure).
gw_converged() { # gw_converged <gwname> <stage-dir> <candidate-squid.conf>
    local gwname="$1" stage="$2" candidate="$3" ref name
    # squid.conf: missing live file (bootstrap gateway) or exec error = differ.
    rt_exec "$gwname" cat /etc/squid/agent/squid.conf 2>/dev/null \
        | cmp -s - "$candidate" || return 1
    # Filename-complete over the referenced allowlist set: a missing or
    # differing live counterpart is a differ.
    while IFS= read -r ref; do
        [[ -n "$ref" ]] || continue
        name="${ref##*/}"
        rt_exec "$gwname" cat "/etc/squid/agent/$name" 2>/dev/null \
            | cmp -s - "$stage/$name" || return 1
    done < <(grep -oE '"/etc/squid/agent/allowlist\.[A-Za-z0-9._-]+"' "$candidate" | tr -d '"' | sort -u)
    return 0
}

#
# Apply the generated allowlist config to the running gateway: stage
# everything, validate the candidate with `squid -k check`, swap it in,
# and restart the container (a reconfigure would re-read the config path
# the process was started with, which may be the bootstrap config). Any
# failure leaves the previous config active and fails closed.
#
# EGL-114-D2: on a HEALTHY gateway (running + probe answers) whose
# deployed config set is byte-identical to the candidate, the whole
# apply is skipped — the stock path restarted Squid on every redundant
# ensure and severed proxied sessions on an already-converged profile.
# `install_policy` (atomic refresh + DNS-pin healing) already ran in the
# caller and is not affected by the skip.
#
GW_APPLY_SKIPPED=0
# EGL-217 (M2): ownership registry for the cmd_ensure EXIT-trap cleanup
# (ensure_cleanup). File-scope plain string — names never contain spaces
# and it is set-`u`-safe; cmd_ensure resets it and arms the trap. Marked
# by ensure_own at exactly three sites: ensure_anchor (before its run),
# ensure_gateway (after its replace rt_rm) and gw_apply_allowlist (before
# the config-apply restart, R2).
ENSURE_OWNED=""
# EGL-318: names this run's cleanup successfully removed (S1T consumes
# it; reset per ensure next to ENSURE_OWNED).
ENSURE_REMOVED=""
ensure_own() { # ensure_own <name> — unique-by-name ownership marker (EGL-217 M2)
    case " $ENSURE_OWNED " in
        *" $1 "*) ;;
        *) ENSURE_OWNED="$ENSURE_OWNED${ENSURE_OWNED:+ }$1" ;;
    esac
}
gw_apply_allowlist() {
    local profile="$1" gwname
    gwname="$(gw_name "$profile")"
    GW_APPLY_SKIPPED=0
    local stage
    stage="$(mktemp -d /tmp/egresslock-allowlist.XXXXXX)"
    local candidate="$stage/squid-gw.conf"
    chmod 755 "$stage"
    if ! gw_generate_config "$profile" "$candidate" "$stage"; then
        rm -rf "$stage"
        die "allowlist generation failed (fail closed)"
    fi
    chmod 644 "$candidate" "$stage"/allowlist.* 2>/dev/null || true

    # EGL-114-D2: health-check-before-replace gate. A gateway that is not
    # running or does not answer the probe takes the apply path (the
    # caller's ensure_gateway just replaced it, or it is crash recovery).
    # A just-created gateway has no deployed files, so the compare
    # differs and the first-create apply runs.
    if gw_healthy "$gwname" "${GW_PORT[$profile]}" \
        && gw_converged "$gwname" "$stage" "$candidate"; then
        rm -rf "$stage"
        GW_APPLY_SKIPPED=1
        return 0
    fi

    local f
    for f in "$stage"/allowlist.*; do
        [[ -f "$f" ]] || continue
        if ! rt_cp "$f" "${gwname}:/etc/squid/agent/$(basename "$f")"; then
            rm -rf "$stage"
            die "gateway allowlist staging failed (podman cp; fail closed)"
        fi
    done
    if ! rt_cp "$candidate" "${gwname}:/etc/squid/agent/check.conf"; then
        rm -rf "$stage"
        die "gateway config staging failed (podman cp; fail closed)"
    fi
    # -k parse validates the config WITHOUT a running instance or PID
    # file; -k check demands the instance PID file, which `squid -N`
    # does not reliably leave behind (ARC-5).
    if ! check_out="$(rt_exec "$gwname" squid -k parse -f /etc/squid/agent/check.conf 2>&1)"; then
        rt_exec "$gwname" rm -f /etc/squid/agent/check.conf >/dev/null 2>&1 || true
        rm -rf "$stage"
        die "gateway rejected the generated config (fail closed): $check_out"
    fi
    if ! rt_exec "$gwname" mv /etc/squid/agent/check.conf /etc/squid/agent/squid.conf; then
        rt_exec "$gwname" rm -f /etc/squid/agent/check.conf >/dev/null 2>&1 || true
        rm -rf "$stage"
        die "gateway config swap failed (fail closed)"
    fi
    rm -rf "$stage"
    # Activate: restart so the entrypoint picks the generated config via
    # its -f path; a `squid -k reconfigure` would re-read whatever config
    # the process was originally started with.
    # EGL-217 (M2, R2): the swap has committed the container to the new
    # config, so it is this run's broken state even when it pre-existed —
    # mark it before the restart so a failed restart/health-wait die
    # removes it. Earlier apply dies predate the marker on purpose: the
    # container is still healthy on its old config and must NOT be
    # removed.
    ensure_own "$gwname"
    rt_restart "$gwname" 5 >/dev/null
    local i port="${GW_PORT[$profile]}"
    for i in $(seq 1 120); do
        gw_running "$gwname" && gw_probe "$gwname" "$port" && return 0
        sleep 0.5
    done
    die "gateway did not come back healthy after config application (fail closed)"
}

gw_running() {
    local names
    names="$(rt_ps 2>/dev/null || true)"
    grep -qx "$1" <<<"$names"
}

gw_probe() {
    # Direct liveness probe: the proxy must answer a TCP connect on its
    # port. Not the image HEALTHCHECK state — absent for OCI-built
    # images (ARC-5) and therefore unreliable.
    local gwname="$1" port="$2"
    rt_exec "$gwname" bash -c "exec 3<>/dev/tcp/127.0.0.1/$port" >/dev/null 2>&1
}

gw_healthy() {
    gw_running "$1" && gw_probe "$1" "$2"
}

# ARC-32-D1: overlay log cap. squid.conf logs to
# `stdio:/var/log/squid/access.log` with no rotate, so a workload CONNECT
# flood (plus cache.log) grows the gateway overlay until it fills and
# `denied` OOMs on the read (ARC-42 caps the detect loop's time window,
# ARC-32-D1 its transfer; this caps the disk). Run on `verify` and on
# `ensure` once the gateway runs: access.log/cache.log over
# EGRESSLOCK_GW_LOG_MAX_BYTES (default 32 MiB; 0 = no cap) is rotated —
# mv aside, `squid -k rotate`, then drop the moved generation. One
# generation only; this is NOT the ARC-31 reset, and `denied` still never
# deletes or rotates the file.
gw_log_cap() { # gw_log_cap <profile>
    local profile="$1" gwname max log size
    gwname="$(gw_name "$profile")"
    max="${EGRESSLOCK_GW_LOG_MAX_BYTES:-33554432}"
    [[ "$max" =~ ^(0|[1-9][0-9]*)$ ]] || {
        echo "Error: EGRESSLOCK_GW_LOG_MAX_BYTES must be a non-negative integer (bytes; 0 = no cap)." >&2
        return 1
    }
    (( max == 0 )) && return 0
    gw_running "$gwname" || return 0
    for log in /var/log/squid/access.log /var/log/squid/cache.log; do
        size="$(rt_exec "$gwname" stat -c %s "$log" 2>/dev/null || true)"
        [[ "$size" =~ ^[0-9]+$ ]] || continue
        (( size <= max )) && continue
        echo "rotating: $log is $size bytes (over the ${max}-byte cap) on $gwname" >&2
        if ! rt_exec "$gwname" mv "$log" "$log.1"; then
            echo "warn: could not move $log aside on $gwname; skipping rotation" >&2
            continue
        fi
        if ! rt_exec "$gwname" squid -k rotate; then
            # Reopen failed: put the live file back so squid keeps
            # logging to the path it holds open. The oversize log stays
            # until the operator intervenes — this fails open for the
            # LOG (never for policy), the same trade `denied`'s rc-0
            # truncation makes.
            echo "warn: squid -k rotate failed on $gwname; restoring $log" >&2
            rt_exec "$gwname" mv "$log.1" "$log" >/dev/null 2>&1 || true
            continue
        fi
        rt_exec "$gwname" rm -f "$log.1" >/dev/null 2>&1 || true
    done
}

gw_start() {
    # A failed start (e.g. an IPAM conflict) leaves container storage
    # holding the name in real Podman (ARC-5): the name is registered
    # before the IP allocation fails. Always clear it so a retry can
    # reuse the name.
    local profile="$1" gwname net ip img
    gwname="$(gw_name "$profile")"
    net="$(network_of "$profile")"
    ip="${GW_IP[$profile]}"
    # Plain assignment so a die() inside gw_image (ARC-59 env guard)
    # propagates under set -e (command-substitution footgun).
    img="$(gw_image)"
    # EGL-206-D2a: refuse a checkpoint-annotated image before the run
    # (CVE-2026-94603). ensure_gateway's rt_image_exists check ran
    # first (exist-check THEN inspect THEN rt_run).
    refuse_checkpoint_image "$img" "gateway image"
    rt_rm_retry "$gwname" >/dev/null 2>&1 || true
    # EGL-123-D3: the gateway carries the kit-derived pinned MAC — the
    # same identity the compiled exemption is keyed on (saddr+MAC).
    rt_run "$gwname" \
        --network "$net" \
        --ip "$ip" \
        --mac-address "$(gw_mac "$profile")" \
        --restart=always \
        --cap-drop=all \
        --security-opt=no-new-privileges \
        "$img" >/dev/null
}

# EGL-123-D3: live MAC of a container on its class network (empty when
# inspect fails). Mirrors the IPAddress template used by verify_gateway.
gw_live_mac() { # gw_live_mac <gwname> <net>
    rt_inspect "$1" "{{(index .NetworkSettings.Networks \"$2\").MacAddress}}" 2>/dev/null || true
}

# EGL-123-D3: MAC identity check. A gateway whose live MAC differs from
# the kit-derived pin is identity drift, NOT a converged profile:
# ensure treats it as not-healthy (replace), verify fails closed.
gw_mac_ok() { # gw_mac_ok <profile> <gwname>
    local net live want
    net="$(network_of "$1")"
    live="$(gw_live_mac "$2" "$net")"
    want="$(gw_mac "$1")"
    [[ "$live" == "$want" ]]
}

ensure_gateway() {
    # EGL-223: arg2 = replace_gw (default 0). 1 forces the replace path
    # even when the converged predicate below is true (the operator asked
    # for it: `build-gateway` then `ensure --replace-gateway`). Plain
    # ensure (0) is byte-identical to before.
    local profile="$1" replace_gw="${2:-0}" gwname port img
    gwname="$(gw_name "$profile")"
    port="${GW_PORT[$profile]}"
    # EGL-123-D3: running + probe is not sufficient — the live MAC must
    # match the kit-derived pin. A mismatch is identity drift (e.g. a
    # pre-upgrade gateway with a random MAC): fall through to replace
    # (one-time on first ensure after upgrade; the pin is stable after).
    # EGL-206-D2b: the converged short-circuit is caps-aware (see
    # ensure_anchor) — a healthy-looking gateway with wrong or
    # unreadable live hardening falls through to replacement, never a
    # blessing.
    if (( replace_gw == 0 )) \
        && gw_running "$gwname" && gw_probe "$gwname" "$port" \
        && gw_mac_ok "$profile" "$gwname" && gw_caps_ok "$gwname"; then
        return 0
    fi
    # Plain assignment so a die() inside gw_image (ARC-59 env guard)
    # propagates under set -e (command-substitution footgun).
    img="$(gw_image)"
    # EGL-223-D3: on the flag path, preflight the target image BEFORE any
    # removal — a missing or checkpoint-annotated tag dies named with the
    # running gateway intact. The recovery path keeps rm-then-exists.
    if (( replace_gw )); then
        rt_image_exists "$img" 2>/dev/null \
            || die "gateway image $img not found; build it: egresslock build-gateway"
        refuse_checkpoint_image "$img" "gateway image"
        echo "gateway '$gwname' --replace-gateway — replacing the running container (profile sessions will drop)" >&2
    fi
    rt_rm_retry "$gwname" >/dev/null 2>&1 || true
    # EGL-217 (M2, R1): the old gateway is gone and any new one is this
    # run's — mark it for the EXIT-trap cleanup. A die at the
    # image-exists check below finds nothing registered to remove.
    ensure_own "$gwname"
    if (( replace_gw == 0 )); then
        rt_image_exists "$img" 2>/dev/null \
            || die "gateway image $img not found; build it: egresslock build-gateway"
    fi
    # The gateway joins the same class network with a FIXED ip so the
    # nftables rule and the proxy env vars stay stable.
    # EGL-223-D9 (S2): on gw_start failure, KEEP the anchor holder and
    # die named. Recycling the anchor (rt_rm + one retry) leaves no
    # netns holder, so the policy can disappear before the retry
    # (EGL-91/ARC-1). The fix is a full re-run of cmd_ensure (holder ->
    # policy -> gateway), never an in-function retry. Both paths.
    gw_start "$profile" \
        || die "gateway start failed (static IP ${GW_IP[$profile]} conflict?)"
    local i
    # 60s budget: container start + squid -z + port bind. EGL-206-D2b:
    # wait-until-healthy, then assert live hardening on the success
    # path — never skipped by a return from inside the wait loop.
    for i in $(seq 1 120); do
        gw_running "$gwname" && gw_probe "$gwname" "$port" && break
        sleep 0.5
    done
    gw_running "$gwname" && gw_probe "$gwname" "$port" \
        || die "gateway container '$gwname' did not become healthy (proxy not answering on $port)"
    assert_kit_caps "$gwname" "gateway"
}

verify_gateway() {
    local profile="$1" gwname net ip
    gwname="$(gw_name "$profile")"
    net="$(network_of "$profile")"
    ip="${GW_IP[$profile]}"
    gw_running "$gwname" \
        || { echo "verify: gateway $gwname not running" >&2; return 1; }
    # Gateway must be attached to the class network with its static IP.
    local nets
    nets="$(rt_inspect "$gwname" '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' 2>/dev/null || true)"
    grep -qw "$net" <<<"$nets" \
        || { echo "verify: gateway not attached to $net" >&2; return 1; }
    local cip
    cip="$(rt_inspect "$gwname" "{{(index .NetworkSettings.Networks \"$net\").IPAddress}}" 2>/dev/null || true)"
    [[ "$cip" == "$ip" ]] \
        || { echo "verify: gateway IP is '$cip', expected $ip" >&2; return 1; }
    # EGL-123-D3: the live MAC must equal the kit-derived pin — the
    # compiled exemption is keyed on saddr+MAC, so a drifted MAC means
    # the gateway's own egress would fall to the terminal drop. Timer
    # notices a drifted MAC through this check.
    local cmac
    cmac="$(gw_live_mac "$gwname" "$net")"
    [[ "$cmac" == "$(gw_mac "$profile")" ]] \
        || { echo "verify: gateway MAC is '${cmac}', expected '$(gw_mac "$profile")'" >&2; return 1; }
    # Config sanity: parse the deployed config. `-k parse` needs no
    # running-instance PID file (unlike `-k check`, ARC-5); liveness is
    # gw_probe's job. EGL-283: a nonzero rc is NOT proof of an invalid
    # config — a concurrent ensure restarting/replacing the container
    # fails the exec itself (podman rc 125/126/127). Only rc 1 against a
    # still-running container is a squid parse rejection; anything else
    # names the container/exec failure.
    local parse_rc=0 parse_out
    parse_out="$(rt_exec "$gwname" squid -k parse -f /etc/squid/agent/squid.conf 2>&1)" || parse_rc=$?
    if (( parse_rc != 0 )); then
        if (( parse_rc == 1 )) && gw_running "$gwname"; then
            echo "verify: gateway squid config invalid: $parse_out" >&2
        else
            echo "verify: gateway container '$gwname' not exec-able (rc=$parse_rc; stopped or mid-restart — e.g. a concurrent ensure); re-run: egresslock ensure $profile — detail: $parse_out" >&2
        fi
        return 1
    fi
    # EGL-206-D2b: the launch-time hardening pair must be LIVE, read
    # from the container's own PID 1 — not `podman inspect` HostConfig,
    # the unverified oracle this CVE invalidates. Same named-error
    # style as the IP/MAC checks above.
    local caps_state
    caps_state="$(kit_caps_state "$gwname")"
    [[ "$caps_state" == "ok" ]] \
        || { echo "verify: $(kit_caps_problem_msg "gateway" "$gwname" "$caps_state")" >&2; return 1; }
}

# EGL-178-D1: cmd_ensure step helpers. cmd_ensure stays the public entry
# point; the aggregator below is the order document (a91 pins anchor ->
# combined nft install -> gateway). ensure_snapshot_pins fills
# ENSURE_BEFORE_PINS (file-scope, D2); ensure_announce_refreshed consumes
# it. No new runtime calls: every step invokes existing wrappers only.
ensure_snapshot_pins() { # EGL-178-D1: pre-refresh pin snapshot for the announce step
    # ARC-12-D2: snapshot the pre-refresh allow-host pins so a DNS
    # change the refresh just healed is announced (refreshed: lines).
    # No chain yet (first ensure) = nothing to announce.
    ENSURE_BEFORE_PINS=()
    if netns_nft list chain inet "$TABLE" "$(chain_of "$1")" >/dev/null 2>&1; then
        VERIFY_PINS=()
        verify_expected_rules "$1" >/dev/null 2>&1 || true
        local k
        for k in "${!VERIFY_PINS[@]}"; do
            ENSURE_BEFORE_PINS[$k]="${VERIFY_PINS[$k]}"
        done
    fi
}

ensure_converge_gateway() { # EGL-178-D1: gateway start + allowlist + log rotation (gateway profiles only)
    # The policy is live (D4); now start the gateway — gateway profiles
    # only. The static IP was never at risk: the anchor pinned the LAST
    # usable address, not a dynamic one (ARC-5/ARC-11-D3).
    # EGL-223: arg2 is the --replace-gateway flag (0/1), threaded to
    # ensure_gateway. Sole caller: cmd_ensure (grep-pinned).
    if is_gateway_profile "$1"; then
        ensure_gateway "$1" "${2:-0}"
        gw_apply_allowlist "$1"
        # ARC-32-D1: the gateway is confirmed healthy here — rotate any
        # oversize overlay logs before the policy work continues.
        gw_log_cap "$1"
    fi
}

ensure_announce_refreshed() { # EGL-178-D1: healed-drift announcement, A-set per host
    # D2: announce healed drift, exactly ONE line per HOST (before is
    # keyed host|port, so dedupe by host). EGL-219-D3/D6: the announced
    # value is the INSTALLED set from the per-ensure cache — no second
    # resolve, which could reorder mid-ensure; announce only when the
    # effective set changed. D6: comma-joined, a 1-element set bare.
    if (( ${#ENSURE_BEFORE_PINS[@]} > 0 )); then
        local key host old now
        local -A announced=()
        for key in "${!ENSURE_BEFORE_PINS[@]}"; do
            host="${key%%|*}"
            [[ -n "${announced[$host]:-}" ]] && continue
            announced[$host]=1
            old="${ENSURE_BEFORE_PINS[$key]}"
            now="${RESOLVED_SETS[$host]:-}"
            if [[ -n "$now" && "$now" != "$old" ]]; then
                echo "refreshed: host $host ${old// /,} -> ${now// /,} (policy re-installed with the new address)"
            fi
        done
    fi
}

ensure_finalize() { # EGL-178-D1: gateway verification + ready lines (closing line included)
    if is_gateway_profile "$1"; then
        verify_gateway "$1" || die "gateway verification failed for profile '$1' (fail closed)"
        # EGL-114-D1: the skip path must not claim "allowlist applied" —
        # nothing was applied and nothing restarted.
        if [[ "${GW_APPLY_SKIPPED:-0}" == 1 ]]; then
            echo "gateway '$(gw_name "$1")' ready (already converged, not restarted)"
        else
            echo "gateway '$(gw_name "$1")' ready (allowlist applied, health verified)"
        fi
    fi
    echo "profile '$1' ready (network $(network_of "$1"), policy verified)"
}

cmd_ensure() {
    # EGL-217 (M1): arm the family-wide failure cleanup — the EXIT trap
    # removes only containers this run started/replaced/restarted, so no
    # --restart=always container is left behind. Disarm after
    # ensure_finalize protects the re-ensure callers' post-ensure steps
    # (a failure there must not touch a converged kit); a die inside
    # ensure_finalize still fires the trap.
    ENSURE_OWNED=""
    ENSURE_REMOVED=""
    ENSURE_POLICY_SWAPPED=0 # EGL-305: reset per ensure; set inside install_policy after the atomic -f
    trap 'ensure_exit_trap "$?"' EXIT
    # EGL-223-D2: optional --replace-gateway, both positions legal
    # (`ensure --replace-gateway <p>` and `ensure <p> --replace-gateway`).
    # One profile name; unknown flags are usage errors (rc 2). Plain
    # ensure parses identically to before: profile only.
    local replace_gw=0 profile=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --replace-gateway)
                # EGL-223-D8 / EGL-228-D1: a duplicate flag is an
                # argv-contract error (rc 2). argv_shape_check rejects
                # it before resolve/load, so a missing/malformed/
                # unreadable conf cannot mask this diagnostic. The
                # handler parser stays as the second filter.
                if (( replace_gw )); then
                    echo "Error: ensure takes --replace-gateway only once." >&2
                    echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                    exit 2
                fi
                replace_gw=1; shift ;;
            "")  # R-EGL-223-3 F2 fold: an empty-string argument is never a
                 # profile name — usage rc 2, same bar as pre-flag grammar
                 # (require_profile "${1:-}" rc 2).
                echo "Error: ensure takes one profile name." >&2
                echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                exit 2 ;;
            -*) echo "Error: ensure takes --replace-gateway only." >&2
                echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                exit 2 ;;
            *)  [[ -z "$profile" ]] || {
                    echo "Error: ensure takes one profile name." >&2
                    echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                    exit 2
                }
                profile="$1"; shift ;;
        esac
    done
    require_profile "${profile:-}" ensure
    # EGL-223-D2: the flag is gateway-only — a non-gateway profile has no
    # gateway container to replace, so the flag is a usage error (rc 2,
    # named) with no container touched.
    if (( replace_gw )) && ! is_gateway_profile "$profile"; then
        echo "Error: --replace-gateway requires a gateway profile (no gateway line in this conf)" >&2
        exit 2
    fi
    # EGL-178-D1: aggregator. The policy-verify die stays at aggregator
    # scope: a helper that returned rc instead of dying would invite a
    # swallowed verify failure (never claim success on an unverified
    # policy). One require_profile here (R-EGL-223-2 F1).
    netns_probe || exit 1
    ensure_network "$profile"
    # EGL-91-D4 (EGL-93, amends D1): the anchor is the rootless-netns
    # HOLDER — start it before any nft write. A pre-container
    # `podman unshare --rootless-netns nft` lands in a netns nothing
    # holds: pasta exits and the first `podman run` creates a FRESH netns
    # without those rules, so verification fails and the G-06 window is
    # open. The anchor takes the LAST usable host address (ARC-11-D3),
    # not dynamic IPAM, so ARC-5 gateway-first IPAM still holds. EGL-98:
    # the post-reboot shape is named by profile_stale_unpolicied.
    ensure_anchor "$profile"
    ensure_snapshot_pins "$profile"
    # EGL-91-D1/D2 (G-06/I-06): install the nft policy BEFORE the gateway
    # start. Until the profile chain exists, the bridge (and any
    # concurrent `podman run --network <profile>`) forwards under
    # Netavark's default accept during the up-to-60s health loop. Rules
    # come from PROFILE_SUBNET / GW_IP in the conf, not a live inspect,
    # so nft can go first; the saddr+MAC exemption (EGL-123-D2) is inert
    # until that identity speaks. First create is ONE create-with-rules
    # transaction; refreshes flush+re-add atomically.
    install_policy "$profile"
    # EGL-140-D1: the pin record is the second witness for the allow-host
    # daddr axis — written from WHAT WAS JUST INSTALLED (the live chain's
    # pin accepts), atomically beside the conf. A failed write fails the
    # ensure closed; zero-allow-host profiles remove any stale record.
    # The pre-refresh snapshot may read the PREVIOUS record (ARC-12-D2).
    write_pin_record "$profile"
    ensure_converge_gateway "$profile" "$replace_gw"
    verify_policy "$profile" || die "policy verification failed for profile '$profile' (fail closed)"
    ensure_announce_refreshed "$profile"
    ensure_finalize "$profile"
    trap - EXIT # EGL-217 (M1): disarm — a later failure owns no cleanup
}

#
# ARC-12: drift check. Called from cmd_verify ONLY, after policy (and
# gateway) verification succeeded. Warn-only: DNS drift is an operator
# signal, never an exit-code change (D1/D3). One line per drifted host
# (D5 first-A semantics; two ports of one host share a warn).
# EGL-140-D1/D2: the pinned source is the ensure-time pin record, so the
# warn compares record vs fresh resolve; chain-vs-record is the
# exit-code axis.
#
check_dns_drift() {
    local profile="$1" hp host pinned fresh
    local -A warned=()
    while IFS= read -r hp; do
        [[ -n "$hp" ]] || continue
        host="${hp%:*}"
        [[ -n "${warned[$host]:-}" ]] && continue
        # VERIFY_PINS keys are host|port; bash assoc lookup has no glob,
        # so scan (cheap: a handful of entries).
        local k pinned=""
        for k in "${!VERIFY_PINS[@]}"; do
            if [[ "${k%%|*}" == "$host" ]]; then
                pinned="${VERIFY_PINS[$k]}"
                break
            fi
        done
        [[ -n "$pinned" ]] || continue
        warned[$host]=1
        # EGL-219-D8: resolve_set is rc 0 always, so the bare capture
        # stays set -e-safe and an unresolvable host keeps the warn+
        # rc-0 contract (ARC-12-D1). D4: both sides are canonically
        # sorted+deduped+space-joined, so plain string equality IS set
        # equality — a resolver reorder is not drift.
        fresh="$(resolve_set "$host")"
        # D4: values rendered comma-joined; singletons byte-identical.
        if [[ -z "$fresh" ]]; then
            echo "drift: host $host no longer resolves; policy still pins ${pinned// /,} — re-run ensure to update" >&2
        elif [[ "$fresh" != "$pinned" ]]; then
            echo "drift: host $host resolved to ${fresh// /,} but the policy pins ${pinned// /,} — re-run ensure to update" >&2
        fi
    done < <(profile_allow_hosts "$profile")
}

cmd_verify() {
     require_profile "${1:-}" verify
     netns_probe || exit 1
     verify_policy "$1" || exit 1
    # EGL-206-D2b: anchor hardening on the plain verify verb too —
    # asserted only when the anchor is running (liveness semantics
    # unchanged); the gateway check is inside verify_gateway below.
    local anchor caps_state
    anchor="$(anchor_of "$1")"
    if anchor_running "$anchor"; then
        caps_state="$(kit_caps_state "$anchor")"
        [[ "$caps_state" == "ok" ]] \
            || { echo "verify: $(kit_caps_problem_msg "anchor" "$anchor" "$caps_state")" >&2; exit 1; }
    fi
    if is_gateway_profile "$1"; then
        verify_gateway "$1" || exit 1
        # ARC-32-D1: gateway confirmed up — rotate oversize overlay logs.
        gw_log_cap "$1"
        echo "profile '$1' policy and gateway verified"
    else
        echo "profile '$1' policy verified"
    fi
    # ARC-12-D1/D3: warn-only, never changes the exit code.
    check_dns_drift "$1"
}

# ARC-16-D3 (amended by EGL-98-D2): verify every profile that is
# ensured (its anchor is running); profiles without a live
# anchor are skipped as not installed — EXCEPT a conf profile whose
# network object survives while its policy chain is absent (the
# post-reboot window), which is a named failure. No ensured profiles and
# no stale leftovers: exit 0 silently; the timer signals drift for
# installed policy, not never-used profiles. Any verification failure
# exits 1 (the oneshot unit fails -> journal signal).
cmd_verify_ensured() {
     netns_probe || exit 1
     local p failed=0 anchor caps_state
    for p in "${PROFILES[@]}"; do
        if anchor_running "$(anchor_of "$p")"; then
            if ! verify_policy "$p"; then
                echo "verify: profile '$p' FAILED policy verification" >&2
                failed=1
                continue
            fi
            if is_gateway_profile "$p" && ! verify_gateway "$p"; then
                echo "verify: profile '$p' FAILED gateway verification" >&2
                failed=1
                continue
            fi
            # EGL-206-D2b: anchor hardening on the ensured sweep too —
            # the anchor is running in this branch (checked above).
            anchor="$(anchor_of "$p")"
            caps_state="$(kit_caps_state "$anchor")"
            if [[ "$caps_state" != "ok" ]]; then
                kit_caps_problem_msg "anchor" "$anchor" "$caps_state" >&2
                echo "verify: profile '$p' FAILED anchor hardening verification" >&2
                failed=1
                continue
            fi
            echo "profile '$p' verified (ensured)"
            check_dns_drift "$p"
            continue
        fi
        # EGL-98-D2 stale exception: anchor dead, but the network object
        # survives without its chain (post-reboot) — a named failure, the
        # sweep timer's only post-reboot drift signal, not the ARC-16-D3
        # skip. A hard probe failure is already named; both set failed=1.
        # Never-ensured/teardown'd profiles (no network object) skip.
        local stale=0
        profile_stale_unpolicied "$p" || stale=$?
        if (( stale == 2 )); then
            failed=1
            continue
        fi
        if (( stale == 0 )); then
            echo "verify: network exists but policy does not — run: egresslock ensure $p" >&2
            failed=1
            continue
        fi
    done
    return "$failed"
}

# ARC-44-D2: emit exactly one validated token on stdout, fail closed.
# $1 = value, $2 = kind (ipv4 | port | noproxy | netname). Conf
# validation is the first gate; this emission re-check is the belt for
# command-substitution consumers. Reject, never sanitize.
emit_token() {
    local v="$1" kind="$2"
    case "$kind" in
        ipv4)    cfg_is_ipv4 "$v" || die "internal: invalid gateway IP '$v'" ;;
        port)    if [[ ! "$v" =~ ^[0-9]+$ ]] || (( v < 1 || v > 65535 )); then
                     die "internal: invalid gateway port '$v'"
                 fi ;;
        noproxy) [[ "$v" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*(,\.?[A-Za-z0-9][A-Za-z0-9._-]*)*$ ]] \
                     || die "internal: invalid NO_PROXY value '$v'" ;;
        netname) [[ "$v" =~ ^egresslock-[a-z0-9-]+$ ]] \
                     || die "internal: invalid network name '$v'" ;;
        *) die "internal: unknown token kind '$kind'" ;;
    esac
    printf '%s\n' "$v"
}

no_proxy_value() {
    local np="localhost,127.0.0.1"
    [[ -n "${PROFILE_NO_PROXY_EXTRA[$1]:-}" ]] \
        && np="${np},${PROFILE_NO_PROXY_EXTRA[$1]}"
    # EGL-18-D3 (partial ARC-38-D4 overturn, IPv4 literals ONLY): a
    # literal has no Squid path (ARC-51-D1), so an HTTP client can honor
    # its nft pin only by bypassing the proxy. Union at emission: unique
    # IPv4 hosts from the profile's allow-host pins, conf order. Hostname
    # pins stay out (ARC-38-D4: same-name HTTP vs SSH is an operator
    # choice). `disallow-host` stays consistent — the union rebuilds.
    local e host
    while IFS= read -r e; do
        [[ -n "$e" ]] || continue
        host="${e%:*}"
        cfg_is_ipv4 "$host" || continue
        [[ ",$np," == *",${host},"* ]] && continue
        np="${np},${host}"
    done < <(profile_allow_hosts "$1")
    echo "$np"
}

proxy_env_assignments() { # proxy_env_assignments <profile> — the six NAME=value lines
    # Single printer for the assignment content so the stdout form and
    # the --out file form cannot drift (EGL-246-D4). Assumes the
    # profile's gateway variables are loaded; byte-identical to the
    # original six echoes (arc44 regression probe).
    local ip="${GW_IP[$1]}" port="${GW_PORT[$1]}"
    local proxy="http://${ip}:${port}"
    # EGL-246 R-EGL-246-3 F1: ONE checked printf emits all six
    # assignments, so no echo can fail after its predecessors landed
    # (errexit is disabled inside `if ! cmd`; a late failure must not
    # leave a truncated file behind as a false success — the bare
    # stdout path shares this producer and is equally atomic).
    local no_proxy
    no_proxy="$(no_proxy_value "$1")" || return 1
    # shellcheck disable=SC2059  # the format is a literal in this file
    printf 'HTTP_PROXY=%s\nHTTPS_PROXY=%s\nhttp_proxy=%s\nhttps_proxy=%s\nNO_PROXY=%s\nno_proxy=%s\n' \
        "$proxy" "$proxy" "$proxy" "$proxy" "$no_proxy" "$no_proxy"
}

cmd_proxy_env() {
    # Print proxy env assignments for a profile's agents (ARC-6-D3).
    # Profiles without a gateway print nothing.
    # ARC-44-D1: an optional machine token emits exactly one validated
    # value for command substitution: proxyip | proxyport | noproxy.
    # Unknown token / extra args exit 2 — never fall through to the
    # assignment form (that would inject NAME=value into $(...)).
    # EGL-246: `--out[=<path>]` writes the assignments atomically with
    # mode 0600 and prints the target path. Bare `--out` targets
    # ${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/egresslock-proxy-<profile>.env
    # (D2). An explicit path need not be in the runtime dir, but its
    # parent must exist, be a directory, and be owned and writable by the
    # invoking account (D11); world-writable is refused, group-writable
    # warns (D19/W1); any unusable shape fails closed rc 1, nothing
    # written (D3/D6). mktemp beside the target + mv, temp removed on
    # failure — no partial file (D4/D5).
    require_profile "${1:-}" proxy-env
    local profile="$1" token="${2:-}" out_path=""
    # EGL-246 R-EGL-246-3 F3: an argument's PRESENCE, not emptiness, is
    # the count. A quoted empty `""` is a real positional and falls to
    # the token ladder below (the named `unknown token` arm); any THIRD
    # argument is the at-most-one usage error (rc 2, pre-conf). Emptiness
    # checks alone let `--out=<path> ""` and `"" --out` slip through.
    if (( $# > 2 )); then
        echo "Error: proxy-env takes at most one argument (a token or an --out form)." >&2
        echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
        exit 2
    fi
    if [[ "$token" == "--out" && $# -ge 3 ]]; then
        echo "Error: --out takes no separate argument (use --out=<path>)." >&2
        echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
        exit 2
    fi
    # F3 continuation: a non-empty token plus any further argument
    # (present-but-empty included) is the at-most-one error — the
    # count, not the value, is the contract.
    if [[ -n "$token" && $# -ge 3 && "$token" != --out* ]]; then
        echo "Error: proxy-env takes at most one argument (a token or an --out form)." >&2
        echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
        exit 2
    fi
    if [[ -n "$token" ]]; then
        # EGL-246 R-EGL-246-3 F3: count-based second layer (the arm —
        # `$# -le 2`, not the `-z` value test, so any third argument,
        # empty or not, is the at-most-one usage error).
        case "$token" in
            proxyip|proxyport|noproxy)
                require_gateway_profile "$profile" proxy-env
                case "$token" in
                    proxyip)   emit_token "${GW_IP[$profile]}" ipv4 ;;
                    proxyport) emit_token "${GW_PORT[$profile]}" port ;;
                    *)         emit_token "$(no_proxy_value "$profile")" noproxy ;;
                esac
                return 0
                ;;
            --out)
                out_path="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/egresslock-proxy-${profile}.env"
                ;;
            --out=*)
                out_path="${token#--out=}"
                [[ -n "$out_path" ]] || {
                    echo "Error: --out= requires a path." >&2
                    echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
                    exit 2
                }
                ;;
            *)
                echo "Error: unknown proxy-env token '$token' (expected: proxyip, proxyport, noproxy)." >&2
                exit 2
                ;;
        esac
        proxy_env_write_out "$profile" "$out_path"
        return 0
    fi
    is_gateway_profile "$profile" || return 0
    proxy_env_assignments "$profile"
}

proxy_env_write_out() { # proxy_env_write_out <profile> <path> — 0600 atomic write, path on stdout
    local profile="$1" target="$2" raw_dir dir dir_mode
    require_gateway_profile "$profile" "proxy-env --out"
    # EGL-246-D11/D19 (operator Q4 refinement): a target with no `/`
    # component is relative to the cwd — its parent is `.`; a
    # root-level target's parent is `/`. All parent checks run on the
    # CANONICAL parent (`realpath -m`), so `./`, `..` and
    # symlinked-parent spellings cannot dodge them.
    if [[ "$target" == */* ]]; then raw_dir="${target%/*}"; else raw_dir="."; fi
    [[ -n "$raw_dir" ]] || raw_dir="/"
    dir="$(realpath -m -- "$raw_dir" 2>/dev/null)" \
        || die "proxy-env --out: cannot inspect target directory '$raw_dir' (fail closed)"
    if [[ ! -d "$dir" ]]; then
        die "proxy-env --out: target directory '$dir' is missing or not a directory (no implicit mkdir — fail closed)"
    fi
    [[ -O "$dir" && -w "$dir" ]] || {
        die "proxy-env --out: target directory '$dir' is not owned or writable by this account (fail closed)"
    }
    # EGL-246-D19 (operator Q4): refuse a world-writable parent (& 002,
    # the other-write bit): another user could replace the temp between
    # its creation and the rename. Group write (020) is accepted for
    # now (shared project trees) — the help/reference docs say so.
    dir_mode="$(stat -c %a -- "$dir" 2>/dev/null)" \
        || die "proxy-env --out: cannot inspect target directory '$dir' (fail closed)"
    if (( 0$dir_mode & 002 )); then
        die "proxy-env --out: target directory '$dir' is world-writable (pass a directory only this account or your group can write to — fail closed)"
    fi
    # EGL-246-W1 (operator 2026-10-14): group-write (020) is accepted
    # (shared project trees), but warn — a group member can replace
    # the env file and redirect the proxied traffic. stderr-only,
    # rc-neutral; the stdout path line is unaffected.
    if (( 0$dir_mode & 020 )); then
        echo "warn: target directory '$dir' is group-writable — a group member could replace the env file and redirect this container's proxied traffic; prefer a directory only you can write to (a future release may tighten this)" >&2
    fi
    if [[ -d "$target" ]]; then
        die "proxy-env --out: target '$target' is a directory (pass a file path)"
    fi
    # EGL-246 R-EGL-246-3 F2: re-verify the target's shape AFTER the
    # producer, immediately before the rename — a late symlink-to-dir
    # lets GNU mv move the temp INTO the directory (or a referent) and
    # still exit 0, a false success at the wrong path. Use a plain
    # rename(2) (`mv -T --`), never move-into-directory; check the late
    # symlink leg below. Mode lands on the temp BEFORE the rename.
    local tmp
    tmp="$(mktemp "$target.XXXXXX")" || die "proxy-env --out: cannot create temp beside '$target' (fail closed)"
    chmod 600 "$tmp" || { rm -f "$tmp"; die "proxy-env --out: cannot set 0600 on the temp beside '$target' (fail closed)"; }
    if ! proxy_env_assignments "$profile" > "$tmp"; then
        rm -f "$tmp"
        die "proxy-env --out: cannot write '$target' (fail closed)"
    fi
    # Late-arriving target shapes (scheduling changes between the
    # pre-write checks and the rename): a directory is never replaced
    # and a symlink is never followed — the temp is removed and the
    # write fails closed named (F2).
    if [[ -d "$target" ]]; then
        rm -f "$tmp"
        die "proxy-env --out: target '$target' is a directory (pass a file path)"
    fi
    if [[ -L "$target" ]]; then
        rm -f "$tmp"
        die "proxy-env --out: target '$target' is a symlink (pass a plain file path — fail closed)"
    fi
    if mv -T -- "$tmp" "$target"; then
        echo "$target"
    else
        rm -f "$tmp"
        die "proxy-env --out: cannot write '$target' (fail closed)"
    fi
}

cmd_network() {
    # ARC-44-D2: single-token output (network names are embedded in
    # command substitutions); extra args exit 2.
    require_profile "${1:-}" network
    [[ -z "${2:-}" ]] || {
        echo "Error: network takes no extra arguments." >&2
        echo "usage: egresslock network <profile>" >&2
        exit 2
    }
    emit_token "$(network_of "$1")" netname
}

cmd_rules() {
    # Print the policy rules for a profile (the same code path install
    # and verify use). Used by the golden equivalence tests (ARC-8) and
    # for debugging.
    require_profile "${1:-}" rules
    policy_rules "$1"
}

#
# ARC-7-D1 detect-and-allow workflow. Both commands operate on per-profile
# config data and are gateway-only.
#
require_engine() {
    [[ -n "$ENGINE_CONF" ]] || die "this command requires a loaded profile config"
}

require_gateway_profile() {
    is_gateway_profile "$1" || die "profile '$1' has no gateway; the '$2' command applies to gateway profiles"
}

denied_parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all)  all=1; shift ;;
            --days) [[ $# -ge 2 ]] || { echo "Error: --days requires a value." >&2; exit 2; }
                    days="$2"; shift 2 ;;
            *)      echo "Error: denied takes --all and/or --days N." >&2
                    echo "usage: egresslock denied <profile> [--all] [--days N]" >&2
                    exit 2 ;;
        esac
    done
    [[ "$days" =~ ^(0|[1-9][0-9]*)$ ]] || {
        echo "Error: --days must be a non-negative integer (0 = no time limit)." >&2
        exit 2
    }
    # ARC-32-D1 (EGL-252): byte cap for the streamed read. Validated
    # like --days: non-negative integer; 0 disables the cap (operator's
    # explicit choice — the default 32 MiB cap, equal to the rotation
    # default, is what protects the naive path). EGL-252: the read is
    # tail-biased — the newest bytes are the ones kept, so the cap
    # never hides the destinations the detect-and-allow loop needs.
    max_bytes="${EGRESSLOCK_DENIED_MAX_BYTES:-33554432}"
    [[ "$max_bytes" =~ ^(0|[1-9][0-9]*)$ ]] || {
        echo "Error: EGRESSLOCK_DENIED_MAX_BYTES must be a non-negative integer (bytes; 0 = uncapped)." >&2
        exit 2
    }
    # ARC-42-D1: window is epoch seconds; `now` from the host clock
    # (rootless Podman shares it; do not exec date in the gateway).
    local now
    now="$(date +%s)"
    cutoff=0
    (( days > 0 )) && cutoff=$(( now - days * 86400 ))
    # EGL-186-D2: with --days 0 the && above short-circuits false (rc 1);
    # the helper must return 0 on the success path or errexit kills the
    # aggregator before denied_collect runs.
    return 0
}

denied_collect() {
    # Squid native access.log fields: ts, elapsed, client,
    # code/HTTP_status, bytes, method, url — method=$6, url=$7. CONNECT
    # url is "host:port"; other methods carry an absolute URL. Dedupe by
    # emitted string, first-seen order (ARC-41-D1/D2); malformed URLs,
    # userinfo, and IPv6 literals are best-effort skips.
    # ARC-32-D1/EGL-252: one streaming pass; LC_ALL=C counts BYTES. The
    # read is TAIL-biased — the producer sizes the log (`stat -c %s`)
    # and, over max_bytes, reads the newest max_bytes + 1 (`tail -c`,
    # which seeks, so the host never buffers it). The +1 is a boundary
    # probe: an empty first record means the window starts on a line
    # boundary (kept); a non-empty one is a partial line and is dropped.
    # Within the cap (or stat fails — container down), cat the whole
    # file. --days applies to the bytes read. Candidates stream into the
    # ARC-57 emit filter; the trailing @ARC32META@ line carries
    # had_denied (ARC-42-D3), truncated, and bytes read (0 = container
    # down/empty). '@' is outside the allow charset, so no collision.
    local gwname size="" trunc_flag=0
    gwname="$(gw_name "$profile")"
    if (( max_bytes > 0 )); then
        size="$(rt_exec "$gwname" stat -c %s /var/log/squid/access.log 2>/dev/null || true)"
        if [[ "$size" =~ ^[0-9]+$ ]] && (( size > max_bytes )); then
            trunc_flag=1
        fi
    fi
    while IFS= read -r cand; do
        if [[ "$cand" == "@ARC32META@ "* ]]; then
            read -r had_denied truncated read_bytes _ <<<"${cand#'@ARC32META@ '}"
            continue
        fi
        [[ -n "$cand" ]] || continue
        # ARC-57-D1: the emit side is the filter. `denied` feeds the next
        # `allow`; a malformed log line must not print a string the allow
        # grammar rejects (a confusing exit-2 in the paste loop). Skip
        # silently — rc stays 0, no "invalid allowlist entry" stderr.
        # EGL-18-D1 widening: a well-formed IPv4 host[:port] is also
        # emitted (a real destination; hiding it left the EGL-17 shape
        # undiagnosable). The branch flips `ipv4_seen`, printing the
        # one-time denied_ipv4_note after the list.
        if allow_entry_ok "$cand"; then
            ok_entries+=("$cand")
        elif denied_entry_ok "$cand"; then
            ok_entries+=("$cand")
            ipv4_seen=1
        fi
    done < <(
        if (( trunc_flag == 1 )); then
            rt_exec "$gwname" tail -c "$(( max_bytes + 1 ))" /var/log/squid/access.log 2>/dev/null
        else
            rt_exec "$gwname" cat /var/log/squid/access.log 2>/dev/null
        fi |
        LC_ALL=C awk -v cutoff="$cutoff" -v truncated="$trunc_flag" '
            function emit(s) { if (!seen[s]++) print s }

            # EGL-252: the producer already bounded the read (tail -c on
            # a stat-derived size; cat when the file fits the cap), so
            # the parser no longer aborts mid-stream — it only drops the
            # partial first record a mid-line tail offset can produce
            # (the probe byte above makes an empty first record the
            # keep-path).
            {
                read += length($0) + 1
                if (NR == 1 && truncated == 1 && length($0)) next
            }

            # EGL-259: squid may log a client-close-race deny as
            # TCP_DENIED_ABORTED/403 (EGL-211 R-EGL-211-2).
            $4 ~ /^TCP_DENIED(_ABORTED)?\// {
                had = 1
                if (cutoff != 0 && $1+0 < cutoff) next
                if ($6 == "CONNECT") {
                    h = $7
                    sub(/:[0-9]+$/, "", h)
                    emit(h)
                    next
                }
                u = tolower($7)
                if (u !~ /^https?:\/\//) next
                rest = $7
                sub(/^https?:\/\//, "", rest)
                if (match(rest, /[/?#]/)) rest = substr(rest, 1, RSTART - 1)
                if (rest ~ /@/) next            # userinfo
                if (rest ~ /^\[/) next          # IPv6 literal
                host = rest
                port = (u ~ /^http:\/\//) ? "80" : "443"
                if (match(rest, /:[0-9]+$/)) {
                    host = substr(rest, 1, RSTART - 1)
                    port = substr(rest, RSTART + 1)
                }
                if (host == "") next
                if (port == "443") emit(host); else emit(host ":" port)
            }

            END { printf "@ARC32META@ %d %d %d\n", (had ? 1 : 0), (truncated == 1 ? 1 : 0), read + 0 }
        '
    )
}

denied_omit_covered() {
    # ARC-31 filter, port-aware (ARC-41-D3): omit an entry only when the
    # allowlist covers that host on that port. Bare host means the 443
    # no-port group; host:80 needs an explicit :80 entry (or a
    # leading-dot suffix on :80) — a 443 entry must NOT hide a :80
    # denial. R-031-1: leading-dot dstdomain suffixes cover the bare host
    # AND every subdomain, per port.
    local -A exact=() suf=()
    local e h port
    while IFS= read -r e; do
        [[ -n "$e" ]] || continue
        if [[ "$e" == *:* ]]; then
            h="${e%:*}"; port="${e##*:}"
        else
            h="$e"; port="443"
        fi
        if [[ "$h" == .* && "${#h}" -gt 1 ]]; then
            suf[$port]+=" ${h#.}"
        else
            exact[$port]+=" $h"
        fi
    done < <(gw_allowlist_entries "$profile")
    local d dhost dport hh ss covered
    while IFS= read -r d; do
        [[ -n "$d" ]] || continue
        if [[ "$d" == *:* ]]; then
            dhost="${d%:*}"; dport="${d##*:}"
        else
            dhost="$d"; dport="443"
        fi
        covered=0
        for hh in ${exact[$dport]:-}; do
            [[ "$hh" == "$dhost" ]] && { covered=1; break; }
        done
        if [[ "$covered" != 1 ]]; then
            for ss in ${suf[$dport]:-}; do
                [[ "$dhost" == "$ss" || "$dhost" == *".$ss" ]] && { covered=1; break; }
            done
        fi
        [[ "$covered" == 1 ]] && continue
        echo "$d"
    done <<<"$denied_entries"
}

cmd_denied() {
    # Print de-duplicated entries the profile's gateway DENIED (Squid
    # TCP_DENIED(_ABORTED) from the access log), most recent last, to
    # drive the detect-and-allow loop. ARC-41: CONNECT entries stay
    # hostname-only ('host'; :443 is the no-port group); plain-HTTP
    # entries become allow-grammar host[:port] (http -> :80, explicit
    # port preserved, :443 collapses) so `allow` consumes them verbatim.
    # ARC-42: a time window (default 14 days, --days N, 0 = full log)
    # applies to BOTH views on the host; the log is never truncated.
    # ARC-31: omit entries already covered ON THE SAME PORT; --all prints
    # the raw union. ARC-32-D1: stream into the parser, never slurp; cap
    # the read at EGRESSLOCK_DENIED_MAX_BYTES (default 32 MiB, 0 =
    # uncapped) so a flood cannot OOM. EGL-252: over the cap the read is
    # tail-biased (newest bytes, partial first line dropped) and a
    # stderr note names the remedy. `denied` never deletes or rotates.
    require_profile "${1:-}" denied
    require_engine
    require_gateway_profile "$1" denied
    local profile="$1"
    shift
    local all=0 days=14
    local max_bytes=0 cutoff=0
    denied_parse_args "$@"
    local -a ok_entries=()
    local cand had_denied=0 truncated=0 read_bytes=0 ipv4_seen=0
    denied_collect
    # ARC-32-D1: keep the ARC-42-era empty-log contract. bytes=0 means
    # the container was down or the log is empty — the same message for
    # both cases.
    (( read_bytes > 0 )) || { echo "no gateway log (container down or no denials yet)"; return 0; }
    if (( truncated == 1 )); then
        echo "note: only the newest ${max_bytes} bytes of the gateway log were read (EGRESSLOCK_DENIED_MAX_BYTES); older entries were not listed — set EGRESSLOCK_DENIED_MAX_BYTES=0 for the full log" >&2
    fi
    local denied_entries=""
    if (( ${#ok_entries[@]} > 0 )); then
        denied_entries="$(printf '%s\n' "${ok_entries[@]}")"
    fi
    if [[ -z "$denied_entries" ]]; then
        # ARC-42-D3: windowed parse produced nothing but the log HAS
        # denied lines — tell the operator the window is the reason
        # (the silent-empty trap from ARC-41). stdout stays empty.
        if [[ "$had_denied" == 1 && "$days" != 0 ]]; then
            echo "note: no denials in the last $days days (older entries exist; denied <profile> --days 0)" >&2
        fi
        return 0
    fi
    if [[ "$all" == 1 ]]; then
        echo "$denied_entries"
        if (( ipv4_seen == 1 )); then denied_ipv4_note; fi
        return 0
    fi
    denied_omit_covered
    # EGL-18-D1: the note fires when an IPv4 was EMITTED. An IPv4 can
    # never be covered by the ARC-31 filter below (the allowlist cannot
    # contain literals — ARC-51), so "in ok_entries" == "printed". An
    # explicit if, not `&&`, so the command's rc stays 0 when no IPv4
    # was seen (the function must not inherit a false arithmetic).
    if (( ipv4_seen == 1 )); then denied_ipv4_note; fi
}

cmd_allowlist() {
    # ARC-43/ARC-45: print the profile's gateway allowlist file raw
    # (same bytes as `cat -- "$src"`) so operators do not type the path.
    # Comments, blank lines, explicit :443, and a missing trailing
    # newline are preserved (D2) — this is the file view, `denied` is
    # the normalized/loop view. Gateway-only; missing file fails closed
    # (D3).
    require_profile "${1:-}" allowlist
    require_engine
    require_gateway_profile "$1" allowlist
    [[ -z "${2:-}" ]] || {
        echo "Error: allowlist takes no extra arguments." >&2
        echo "usage: egresslock allowlist <profile>" >&2
        exit 2
    }
    local src
    src="$(allowlist_src "$1")"
    [[ -f "$src" ]] || die "allowlist file missing: $src (check the profile's 'gateway' directive)"
    cat -- "$src"
}

# ARC-32-D2: DNS length bounds for a host token (the port is split off
# by callers, and a leading-dot suffix is stripped): full host <= 253
# bytes, each dot-separated label 1..63 (RFC 1035). Charset is enforced
# by the callers' grammars (ARC-50-D6); this is the size gate, so an
# oversize "hostname" is rejected here instead of persisting until
# `squid -k parse` fails at the next ensure (ARC-48 U9). A MID-NAME empty
# label ('a..b') fails the label rule; a TRAILING dot does NOT fail this
# split (the empty trailing label is dropped) — trailing-dot rejection
# lives in the host-field parsers (EGL-147-D2, ARC-32 finding 1).
arc32_dns_len_ok() { # arc32_dns_len_ok <host>
    local host="$1" label
    (( ${#host} <= 253 )) || return 1
    local IFS=.
    for label in $host; do
        (( ${#label} >= 1 && ${#label} <= 63 )) || return 1
    done
    return 0
}

# ARC-57-D1: silent shared predicate — the ONE grammar the allow path
# enforces (host/host:port, first char alnum or '.', port 1-65535, and
# ARC-51's IPv4-literal rejection). No stderr. Returns 0 valid, 1
# invalid. `validate_allow_entry` wraps it with the user-facing error
# for argv; `denied` calls it silently to skip emit (rc stays 0).
# ARC-32-D2: the DNS length caps live here too, so `allow`,
# `gw_allowlist_entries`, and the `denied` emit filter all inherit the
# one predicate.
# EGL-147-D2: a trailing dot on the HOST part is invalid — squid's
# matchDomainName compares from the string ends with no trailing-dot
# tolerance for the ENTRY, so `name.` can never match (X-6 E7); reject,
# do not normalize, do not warn. The check is on the
# host part BEFORE stripping a leading dot, so `.name.` is trailing-dot
# (rejected) while `.name` stays a valid suffix (ARC-31 / X-6 E4).
allow_entry_ok() { # allow_entry_ok <entry>
    local entry="$1"
    if [[ "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*:[0-9]+$ ]]; then
        local port="${entry##*:}"
        (( port >= 1 && port <= 65535 )) || return 1
    elif [[ ! "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        return 1
    fi
    local probe="${entry%:*}"
    [[ "$probe" == *. ]] && return 1
    probe="${probe#.}"
    cfg_is_ipv4 "$probe" && return 1
    arc32_dns_len_ok "$probe" || return 1
    return 0
}

# EGL-18-D1: the deny-log twin of allow_entry_ok — keep a candidate
# that is a valid allowlist entry (ARC-57-D1) OR a well-formed IPv4
# literal host[:port]. IPv4 stays OUT of the allow grammar (ARC-51-D1);
# hiding IPv4 403s made the EGL-17 incident undiagnosable. Injection
# payloads (`foo;rm`, backticks, leading-dash hosts) fail BOTH branches:
# the port check is numeric 1-65535 and the host check is `cfg_is_ipv4`.
# Silent — rc 0 emit, 1 skip.
denied_entry_ok() { # denied_entry_ok <candidate>
    allow_entry_ok "$1" && return 0
    local host="$1" port
    if [[ "$host" == *:* ]]; then
        port="${host##*:}"
        host="${host%:*}"
        [[ "$port" =~ ^[0-9]+$ ]] || return 1
        (( port >= 1 && port <= 65535 )) || return 1
    fi
    cfg_is_ipv4 "$host"
}

# EGL-18-D1: the ONE-TIME stderr note for a `denied` invocation that
# emitted at least one IPv4 (verbatim per the approved design; never
# on stdout — the destination list stays a paste-safe feed).
denied_ipv4_note() {
    echo "note: IPv4 destinations are not allowlist hostnames — use allow-host, not allow. Proxied clients 403 unless the IP is in NO_PROXY (proxy-env includes allow-host IPv4 pins; recreate the workload)." >&2
}

# ARC-46-D2: validate an allowlist entry's grammar; argument errors are
# usage-class (exit 2 via caller). Returns 0 valid, 1 invalid (message
# already printed). Grammar lives in allow_entry_ok (ARC-57-D1); this
# wrapper only turns the silent result into the specific argv error.
validate_allow_entry() { # validate_allow_entry <entry>
    local entry="$1"
    allow_entry_ok "$entry" && return 0
    # EGL-147-D2: the trailing-dot case is named BEFORE the IPv4 /
    # DNS-length branches so a trailing-dot IPv4-shaped token
    # (`1.2.3.4.`) is named for the shape the operator typed (it is
    # not a cfg_is_ipv4 hit with the trailing dot anyway).
    if [[ "${entry%:*}" == *. && "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*(:[0-9]+)?$ ]]; then
        echo "Error: allowlist entry '$entry' has a trailing dot — dstdomain entries are bare names; requests with trailing dots are normalized by the gateway" >&2
        return 1
    fi
    if [[ "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*:[0-9]+$ ]]; then
        local port="${entry##*:}"
        if (( port < 1 || port > 65535 )); then
            echo "Error: invalid port in entry '$entry'" >&2
        elif ! arc32_dns_len_ok "${entry%:*}"; then
            echo "Error: allowlist entry '$entry' exceeds DNS length limits (host <= 253 bytes, labels <= 63)" >&2
        else
            echo "Error: allowlist entry '$entry' is an IPv4 literal; literals belong on 'allow-host' (host:port), not the gateway allowlist" >&2
        fi
    elif [[ "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        local probe="${entry%:*}"
        probe="${probe#.}"
        if ! arc32_dns_len_ok "$probe"; then
            echo "Error: allowlist entry '$entry' exceeds DNS length limits (host <= 253 bytes, labels <= 63)" >&2
        else
            echo "Error: allowlist entry '$entry' is an IPv4 literal; literals belong on 'allow-host' (host:port), not the gateway allowlist" >&2
        fi
    else
        echo "Error: invalid allowlist entry '$entry' (expected host or host:port)" >&2
    fi
    return 1
}

# ARC-46-D1: one stderr line before a mutator's re-ensure so the ~3s
# gateway restart is not a silent gap. Stdout stays the data channel.
re_ensuring() { echo "re-ensuring profile '$1' ..." >&2; }

cmd_allow() {
    # Validate and append one or more host[:port] entries to the profile's
    # allowlist file, then ONE re-ensure (ARC-46-D2).
    require_profile "${1:-}" allow
    require_engine
    require_gateway_profile "$1" allow
    local profile="$1"
    shift
    [[ $# -ge 1 ]] || {
        echo "Error: allow requires a destination." >&2
        echo "usage: egresslock allow <profile> <host[:port]> [host[:port] ...]" >&2
        exit 2
    }
    local e
    for e in "$@"; do
        validate_allow_entry "$e" || exit 2
    done
    local src
    src="$(allowlist_src "$profile")"
    # R-007-1 finding 5: never silently create the allowlist file. A
    # typo'd gateway path in the config would fail ensure closed; `allow`
    # must not heal that by inventing the file.
    [[ -f "$src" ]] || die "allowlist file missing: $src (check the profile's 'gateway' directive)"
    # BUG-002: a file not ending in a newline (a starter shipped without
    # one, or a truncated file) would glue the first entry onto the last
    # line, silently dropping it (gw_allowlist_entries strips from the
    # first '#'); `allow` would report added but it would never apply.
    # Write ONE leading newline. This heals truncation but does NOT
    # un-glue an entry already fused to a comment line (BUG-002-D1).
    if [[ -s "$src" && -n "$(tail -c 1 "$src")" ]]; then
        printf '\n' >> "$src" || die "cannot write $src"
    fi
    for e in "$@"; do
        if grep -qxF "$e" "$src" 2>/dev/null; then
            echo "entry already present: $e"
        else
            printf '%s\n' "$e" >> "$src" || die "cannot write $src"
            echo "added: $e -> $src"
        fi
    done
    re_ensuring "$profile"
    cmd_ensure "$profile"
}

cmd_disallow() {
    # ARC-30/ARC-46-D2: remove one or more exact allowlist entries, then
    # ONE re-ensure. Exact `grep -xF` line match only. If ANY entry is
    # absent -> exit 1, allowlist unchanged, no ensure. Never creates the
    # allowlist file.
    require_profile "${1:-}" disallow
    require_engine
    require_gateway_profile "$1" disallow
    local profile="$1"
    shift
    [[ $# -ge 1 ]] || {
        echo "Error: disallow requires a destination." >&2
        echo "usage: egresslock disallow <profile> <host[:port]> [host[:port] ...]" >&2
        exit 2
    }
    local e
    for e in "$@"; do
        validate_allow_entry "$e" || exit 2
    done
    local src
    src="$(allowlist_src "$profile")"
    [[ -f "$src" ]] || die "allowlist file missing: $src (check the profile's 'gateway' directive)"
    for e in "$@"; do
        if ! grep -qxF "$e" "$src"; then
            echo "Error: entry not present: $e" >&2
            exit 1
        fi
    done
    # ARC-30-D2: atomic rewrite — same-dir temp + mv (no in-place sed -i).
    # R-030-1 finding 1: preserve the source's mode instead of forcing 600.
    local tmp keep=() line a skip
    tmp="$(mktemp "$src.XXXXXX")" || die "cannot create temp next to $src"
    chmod "$(stat -c %a "$src" 2>/dev/null || echo 600)" "$tmp" 2>/dev/null || true
    while IFS= read -r line || [[ -n "$line" ]]; do
        skip=0
        for a in "$@"; do
            [[ "$line" == "$a" ]] && { skip=1; break; }
        done
        [[ "$skip" == 0 ]] && keep+=("$line")
    done < "$src"
    if (( ${#keep[@]} > 0 )); then
        printf '%s\n' "${keep[@]}" > "$tmp"
    else
        : > "$tmp"
    fi
    mv "$tmp" "$src" || { rm -f "$tmp"; die "cannot rewrite $src"; }
    for e in "$@"; do echo "removed: $e -> $src"; done
    re_ensuring "$profile"
    cmd_ensure "$profile"
}

#
# ARC-38: allow-host / disallow-host — mutate the CONF (the direct
# `rule allow-host` line), the gateway allowlist commands' sibling for
# non-HTTP egress (git-over-SSH etc). Works on any profile that can take
# allow-host (gateway or not; ARC-38-D2).

# Same grammar the conf parser enforces for `rule allow-host`: host
# [A-Za-z0-9._-]*, port 1-65535, colon-required, first char alnum or '.'
# (ARC-59-D1). Sets HOST_ARG/PORT_ARG;
# argument errors are usage-class (exit 2).
validate_host_port() { # validate_host_port <host:port>
    local entry="$1"
    # ARC-59-D1: host part starts alnum or '.' — never '-'.
    if [[ ! "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*:[0-9]+$ ]]; then
        echo "Error: invalid allow-host entry '$entry' (expected host:port)" >&2
        exit 2
    fi
    HOST_ARG="${entry%:*}"
    PORT_ARG="${entry##*:}"
    # EGL-147-D2: a trailing-dot host in a pin is the same dead-or-
    # surprising shape as in the allowlist — name it (CLI twins the
    # conf parser; the conf must never mint what the CLI rejects).
    if [[ "$HOST_ARG" == *. ]]; then
        echo "Error: host '$HOST_ARG' has a trailing dot — entries are bare names" >&2
        exit 2
    fi
    if (( PORT_ARG < 1 || PORT_ARG > 65535 )); then
        echo "Error: invalid port in entry '$entry' (expected 1-65535)" >&2
        exit 2
    fi
    # ARC-32-D2: same DNS length caps as the conf parser — a CLI
    # allow-host/disallow-host must not mint a conf the parser then
    # rejects (that would fail closed at the next load).
    if ! arc32_dns_len_ok "${HOST_ARG#.}"; then
        echo "Error: host '$HOST_ARG' exceeds DNS length limits (host <= 253 bytes, labels <= 63)" >&2
        exit 2
    fi
}

# Escape regex metacharacters for a literal match inside [[ =~ ]].
# R-038-1 finding 2: $host is interpolated into a block-match pattern;
# without escaping, each '.' matches any char, so a near-collision
# host (gitXexample.test vs git.example.test) could falsely match —
# making allow-host a silent no-op or disallow-host delete the wrong
# line. Hosts are [A-Za-z0-9._-]* (start alnum or '.'), so only '.'
# and '-' need escaping.
host_re() { printf '%s' "${1//./\\.}"; }

# ARC-38-D3: write a same-dir temp, insert the rule as the LAST line of
# the NAMED profile's block (not EOF — a multi-block conf must not get
# the rule attached to the last block), validate the temp with
# load_config (fail closed -> delete temp, original untouched), then mv
# over the original and reload. Return 0 ok (rule written); 1 already
# present (nothing written).
conf_insert_allow_host() { # conf_insert_allow_host <conf> <profile> <host> <port>
    local conf="$1" profile="$2" host="$3" port="$4"
    local host_r host_port_r
    host_r="$(host_re "$host")"
    host_port_r="${host_r//-/\\-}:$port"
    local rule="    rule allow-host $host:$port"
    local line in_block=0 found_block=0 present=0
    local -a out=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*profile[[:space:]]+([a-z0-9][a-z0-9-]*)[[:space:]]+ ]]; then
            if [[ "$in_block" == 1 && "$found_block" == 1 && "$present" == 0 ]]; then
                out+=("$rule")
            fi
            in_block=0
            if [[ "${BASH_REMATCH[1]}" == "$profile" ]]; then
                in_block=1
                found_block=1
            fi
        elif [[ "$in_block" == 1 && "$line" =~ ^[[:space:]]*rule[[:space:]]+allow-host[[:space:]]+${host_port_r}[[:space:]]*$ ]]; then
            present=1
        fi
        out+=("$line")
    done < "$conf"
    if [[ "$in_block" == 1 && "$found_block" == 1 && "$present" == 0 ]]; then
        out+=("$rule")
    fi
    if [[ "$present" == 1 ]]; then
        return 1
    fi
    [[ "$found_block" == 1 ]] || die "internal: profile block '$profile' not found in $conf"
    local tmp
    tmp="$(mktemp "$conf.XXXXXX")" || die "cannot create temp next to $conf"
    chmod "$(stat -c %a "$conf" 2>/dev/null || echo 600)" "$tmp" 2>/dev/null || true
    printf '%s\n' "${out[@]}" > "$tmp"
    if ! ( load_config "$tmp" ) 2>/dev/null; then
        rm -f "$tmp"
        die "allow-host would produce an invalid config; nothing written"
    fi
    mv "$tmp" "$conf" || { rm -f "$tmp"; die "cannot rewrite $conf"; }
    load_config "$conf"
    return 0
}

# ARC-38-D2/D3: delete the exact `rule allow-host <host>:<port>` line
# (optional leading whitespace) inside the named block only. Same
# temp+validate+mv. Return 0 deleted; 1 not present (conf unchanged).
conf_delete_allow_host() { # conf_delete_allow_host <conf> <profile> <host> <port>
    local conf="$1" profile="$2" host="$3" port="$4"
    local host_r host_port_r
    host_r="$(host_re "$host")"
    host_port_r="${host_r//-/\\-}:$port"
    local line in_block=0 found=0
    local -a out=()
    # EGL-305: capture the FIRST deleted line and its 0-based original
    # position (out holds only kept lines, so ${#out[@]} counts those
    # before it) for conf_restore_allow_host. CONF_DELETED_COMMITTED
    # stays 0 until the rewrite is on disk: a failure before the mv must
    # leave the armed EXIT trap silent (EGL-305-D6 item 2).
    CONF_DELETED_LINE=""
    CONF_DELETED_INDEX=0
    CONF_DELETED_COMMITTED=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*profile[[:space:]]+([a-z0-9][a-z0-9-]*)[[:space:]]+ ]]; then
            in_block=0
            [[ "${BASH_REMATCH[1]}" == "$profile" ]] && in_block=1
        elif [[ "$in_block" == 1 && "$line" =~ ^[[:space:]]*rule[[:space:]]+allow-host[[:space:]]+${host_port_r}[[:space:]]*$ ]]; then
            found=1
            if [[ -z "$CONF_DELETED_LINE" ]]; then
                CONF_DELETED_LINE="$line"
                CONF_DELETED_INDEX=${#out[@]}
            fi
            continue
        fi
        out+=("$line")
    done < "$conf"
    [[ "$found" == 1 ]] || return 1
    local tmp
    tmp="$(mktemp "$conf.XXXXXX")" || die "cannot create temp next to $conf"
    chmod "$(stat -c %a "$conf" 2>/dev/null || echo 600)" "$tmp" 2>/dev/null || true
    printf '%s\n' "${out[@]}" > "$tmp"
    if ! ( load_config "$tmp" ) 2>/dev/null; then
        rm -f "$tmp"
        die "disallow-host would produce an invalid config; nothing written"
    fi
    mv "$tmp" "$conf" || { rm -f "$tmp"; die "cannot rewrite $conf"; }
    # EGL-305: the delete is committed — the cmd_disallow_host EXIT
    # trap now owns the window until cmd_ensure arms its own trap.
    CONF_DELETED_COMMITTED=1
    load_config "$conf"
    return 0
}

# EGL-305: re-insert the captured deleted allow-host line at its 0-based
# original position so the restored conf is byte-identical to its
# pre-command state (CONF_DELETED_INDEX = the count of kept lines before
# the deleted line; index 0 inserts at the top, index >= the current
# line count appends — the file-shorter fallback). Never dies (it runs
# from the ensure EXIT trap): every failure returns 1. Same conf-RMW
# temp+validate+mv pattern as conf_delete_allow_host, die-free.
conf_restore_allow_host() { # conf_restore_allow_host <conf> <line> <index> -> rc
    local conf="$1" line="$2" index="$3" tmp
    [[ -f "$conf" ]] || return 1
    tmp="$(mktemp "$conf.XXXXXX" 2>/dev/null)" || return 1
    chmod "$(stat -c %a "$conf" 2>/dev/null || echo 600)" "$tmp" 2>/dev/null || true
    awk -v want="$index" -v ins="$line" '
        { if (NR == want + 1) print ins; print }
        END { if (want >= NR) print ins }
    ' "$conf" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
    if ! ( load_config "$tmp" ) 2>/dev/null; then
        rm -f "$tmp"
        return 1
    fi
    mv "$tmp" "$conf" 2>/dev/null || { rm -f "$tmp"; return 1; }
    return 0
}

# EGL-139-D2: presence pre-check with the SAME block-scoped regex
# conf_delete_allow_host matches (no mutation). Keeps the absent-rule
# rejection (rc 1, "rule not present", no ensure) independent of the
# conntrack probe: absent rules keep the exact no-op semantics, present
# rules fail closed at the probe.
conf_has_allow_host() { # conf_has_allow_host <conf> <profile> <host> <port>
    local conf="$1" profile="$2" host="$3" port="$4"
    local host_r host_port_r
    host_r="$(host_re "$host")"
    host_port_r="${host_r//-/\\-}:$port"
    local line in_block=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*profile[[:space:]]+([a-z0-9][a-z0-9-]*)[[:space:]]+ ]]; then
            in_block=0
            [[ "${BASH_REMATCH[1]}" == "$profile" ]] && in_block=1
        elif [[ "$in_block" == 1 && "$line" =~ ^[[:space:]]*rule[[:space:]]+allow-host[[:space:]]+${host_port_r}[[:space:]]*$ ]]; then
            return 0
        fi
    done < "$conf"
    return 1
}

cmd_allow_host() {
    require_profile "${1:-}" allow-host
    require_engine
    local profile="$1" entry="${2:-}"
    [[ -n "$entry" ]] || {
        echo "Error: allow-host requires a destination." >&2
        echo "usage: egresslock allow-host <profile> <host:port>" >&2
        exit 2
    }
    if [[ $# -gt 2 ]]; then
        echo "Error: allow-host takes exactly one host:port." >&2
        echo "usage: egresslock allow-host <profile> <host:port>" >&2
        exit 2
    fi
    validate_host_port "$entry"
    local conf="$ENGINE_CONF"
    [[ -f "$conf" ]] || die "config file missing: $conf"
    if ! conf_insert_allow_host "$conf" "$profile" "$HOST_ARG" "$PORT_ARG"; then
        echo "entry already present: $HOST_ARG:$PORT_ARG"
    else
        echo "added: rule allow-host $HOST_ARG:$PORT_ARG -> $conf"
    fi
    # EGL-18-D2: mutation-time hint, IPv4 + gateway profile only. The
    # remaining footgun after the D3 NO_PROXY union is BAKED env: the
    # pin is in the conf and already in proxy-env output, but a running
    # workload started before the pin does not have it and will still
    # 403 through the proxy path. Hostname pins get no hint (ssh
    # ignores HTTP(S)_PROXY — the ARC-38 case); non-gateway profiles
    # have no proxy path at all. A duplicate (already present) still
    # hints: the operator may have missed the recreate.
    if is_gateway_profile "$profile" && cfg_is_ipv4 "$HOST_ARG"; then
        echo "note: IPv4 allow-host pins are included in proxy-env NO_PROXY; recreate running workloads to pick up the new env." >&2
    fi
    re_ensuring "$profile"
    cmd_ensure "$profile"
}

cmd_disallow_host() {
    require_profile "${1:-}" disallow-host
    require_engine
    local profile="$1" entry="${2:-}"
    [[ -n "$entry" ]] || {
        echo "Error: disallow-host requires a destination." >&2
        echo "usage: egresslock disallow-host <profile> <host:port>" >&2
        exit 2
    }
    if [[ $# -gt 2 ]]; then
        echo "Error: disallow-host takes exactly one host:port." >&2
        echo "usage: egresslock disallow-host <profile> <host:port>" >&2
        exit 2
    fi
    validate_host_port "$entry"
    local conf="$ENGINE_CONF"
    [[ -f "$conf" ]] || die "config file missing: $conf"
    # EGL-139-D2: the post-condition is provable flow severance, so the
    # whole mutation is gated fail-closed:
    #   1. absent rule -> the named no-op (rc 1, nothing touched);
    #   2. conntrack probe BEFORE the conf mutation — missing/failing
    #      tooling aborts with nothing changed (R9);
    #   3. the revoked pin's live daddr is captured from the chain
    #      BEFORE the conf line is gone.
    if ! conf_has_allow_host "$conf" "$profile" "$HOST_ARG" "$PORT_ARG"; then
        echo "Error: rule not present: allow-host $HOST_ARG:$PORT_ARG in profile '$profile'" >&2
        exit 1
    fi
    conntrack_probe || exit 1
    # EGL-219-D1/D9: the revoked pin's whole live daddr SET (the pin record
    # sizes the positional zip; an unreadable/missing record dies named
    # BEFORE the conf mutation).
    local pin_ips
    pin_ips="$(live_pin_daddr "$profile" "$HOST_ARG" "$PORT_ARG")"
    # EGL-296: live_pin_daddr already refuses when the chain disagrees
    # with the record, so the guard below is defense-in-depth (EGL-139-D2
    # step 3). EGL-295: the reconcile below reads the post-swap chain
    # directly, so it still severs the rule's earlier-address entries.
    # EGL-305: arm the partial-failure profile BEFORE the conf delete
    # (EGL-305-D6) plus this command's own EXIT trap — the
    # delete/reload/re_ensuring window is closed. The trap stays silent
    # until CONF_DELETED_COMMITTED=1 and then restores the rule or names
    # the partial state; cmd_ensure replaces the trap at entry. Only
    # shell statements between the arm and the delete.
    DISALLOW_HOST_CTX="$profile"
    DISALLOW_HOST_HOST="$HOST_ARG"
    DISALLOW_HOST_PORT="$PORT_ARG"
    DISALLOW_HOST_PIN_IPS="$pin_ips"
    DISALLOW_HOST_CONF="$conf"
    DISALLOW_HOST_MEMBER_PHASE=0
    trap 'disallow_host_failure_disclose "$?"' EXIT
    if ! conf_delete_allow_host "$conf" "$profile" "$HOST_ARG" "$PORT_ARG"; then
        echo "Error: rule not present: allow-host $HOST_ARG:$PORT_ARG in profile '$profile'" >&2
        exit 1
    fi
    re_ensuring "$profile"
    cmd_ensure "$profile"
    # EGL-219-D11: cmd_ensure disarmed its own trap success-only; re-arm
    # this command's trap for the member flush loop (the context stays
    # armed through it; cleared on the success continuation below).
    trap 'disallow_host_failure_disclose "$?"' EXIT
    # EGL-139-D2 steps 5-6: the atomic -f swap succeeded (cmd_ensure died
    # otherwise); NOW delete the revoked pin's conntrack entries and
    # prove no entry remains for the tuple. Kill-at-revocation (D1): the
    # `removed:` success line prints only after the post-condition holds
    # — never a green rc with a surviving entry (R2/R9).
    # EGL-219-D1: every pinned address of the revoked rule is flushed
    # (enumerate + exact-tuple delete + witness per member, the EGL-313
    # source scope); a single-address pin runs the loop once.
    # EGL-307: EXCEPT a member whose daddr:dport the post-swap chain
    # still accepts through another remaining grant (a sibling rule,
    # gateway-hop, or DNS-to-bridge accept on the same port) — that
    # member is skipped silently; on any unusable accepted-set read
    # every member is flushed (doubt severs; the EGL-139 backstop).
    if [[ -n "$pin_ips" ]]; then
        local pin_ip accepted_list acc_rc=0
        # EGL-307: a member the post-swap chain still accepts through
        # another grant is kept (the reconcile's accepted-set test); an
        # unusable read flushes every member — doubt severs (EGL-139),
        # and the reconcile's own read then dies named (EGL-311). Plain
        # call, no command substitution — same frame, same list.
        conntrack_accepted_set "$profile" "$PORT_ARG" || acc_rc=$?
        accepted_list=" ${CT_ACCEPTED_LIST[*]} "
        # EGL-219-D11: unproven = the members this revocation must flush.
        # EGL-307-kept members (still accepted through another remaining
        # grant) are not this rule's unproven severance — excluded up
        # front; each successful flush pops one (loop and list share order).
        DISALLOW_HOST_UNPROVEN=()
        for pin_ip in $pin_ips; do
            if (( acc_rc == 0 )) && [[ "$accepted_list" == *" $pin_ip "* ]]; then
                continue
            fi
            DISALLOW_HOST_UNPROVEN+=("$pin_ip")
        done
        DISALLOW_HOST_MEMBER_PHASE=1
        for pin_ip in $pin_ips; do
            if (( acc_rc == 0 )) && [[ "$accepted_list" == *" $pin_ip "* ]]; then
                continue
            fi
            conntrack_flush_and_assert "$profile" "$pin_ip" "$PORT_ARG"
            DISALLOW_HOST_UNPROVEN=("${DISALLOW_HOST_UNPROVEN[@]:1}")
        done
        DISALLOW_HOST_MEMBER_PHASE=0
    fi
    # EGL-295: the member loop keyed the rule's current pin members only; a
    # rotated name's earlier address keeps its established entry (its
    # flow rides the base ct-state accept, X20a). Post-swap port reconcile
    # (unconditional, including the empty-capture drifted path): flush
    # every workload-sourced entry on the port the post-swap chain no
    # longer accepts. EGL-307: the member leg applies the same
    # accepted-set test, so both legs agree. `removed:` stays last.
    conntrack_reconcile_port "$profile" "$PORT_ARG" "$pin_ips"
    # EGL-354: keep the recovery trap/context armed through the reconcile —
    # a failure inside it (EGL-311 S1/S2, the S6 enumerate read, or a
    # survivor witness) still owes the post-swap S3 disclosure.
    trap - EXIT
    DISALLOW_HOST_CTX="" # success continuation: every member proven or kept and the post-swap reconcile proved (EGL-307/EGL-354)
    echo "removed: rule allow-host $HOST_ARG:$PORT_ARG -> $conf"
}

# EGL-317 (ER-EGL-305-3 F1): operator recovery for a disallow-host that
# failed after the ruleset swap. Ends leftover connections on the revoked
# port that the live policy no longer allows — the success path's
# selection model, shared through conntrack_reconcile_port (earlier DNS
# addresses, accepted destinations, gateway-source rows, peer direction)
# — and prints the completion line only after a fresh witness pass finds
# no targeted residue. Safe to repeat; conntrack only; account-locked.
cmd_drop_unauthorized() {
    require_profile "${1:-}" drop-unauthorized
    require_engine
    local profile="$1" port="${2:-}"
    [[ -n "$port" ]] || {
        echo "Error: drop-unauthorized requires a port." >&2
        echo "usage: egresslock drop-unauthorized <profile> <port>" >&2
        exit 2
    }
    if [[ $# -gt 2 ]]; then
        echo "Error: drop-unauthorized takes exactly one port." >&2
        echo "usage: egresslock drop-unauthorized <profile> <port>" >&2
        exit 2
    fi
    if [[ ! "$port" =~ ^[0-9]+$ ]] || (( 10#$port < 1 || 10#$port > 65535 )); then
        echo "Error: invalid port '$port' (expected 1-65535)." >&2
        exit 2
    fi
    conntrack_reconcile_port "$profile" "$port" "" 1 "egresslock drop-unauthorized $profile $port"
    echo "drop-unauthorized: no leftover connection on port $port remains that profile '$profile' does not allow"
}

# ARC-35-D3: is a CIDR taken by (a) a `profile <name> <cidr>` line in a
# sibling *.conf in $dest or (b) a Podman network this user can see?
# Scans are tolerant (cidr_parse_any) so a foreign subnet that the
# profile policy would reject is still treated as a collision.
init_cidr_taken() { # init_cidr_taken <cidr> <dest>
    local cidr="$1" dest="$2" f line scidr name info sub
    cidr_parse "$cidr" || return 1
    local wfirst=$CIDR_FIRST wlast=$CIDR_LAST
    for f in "$dest"/*.conf; do
        [[ -f "$f" ]] || continue
        while IFS= read -r line; do
            if [[ "$line" =~ ^[[:space:]]*profile[[:space:]]+([a-z0-9][a-z0-9-]*)[[:space:]]+([0-9.]+/[0-9]+) ]]; then
                scidr="${BASH_REMATCH[2]}"
                if cidr_parse_any "$scidr" \
                   && cidr_overlaps "$wfirst" "$wlast" "$CIDR_FIRST" "$CIDR_LAST"; then
                    return 0
                fi
            fi
        done < "$f"
    done
    local names
    # ARC-67-D3: a list we cannot run is treated as TAKEN — never
    # "free" — so auto-pick / --subnet cannot claim an unchecked CIDR.
    if ! names="$(podman_network_names 2>/dev/null)"; then
        return 0
    fi
    for name in $names; do
        info="$(rt_network_inspect "$name" 2>/dev/null || true)"
        while IFS= read -r sub; do
            [[ -n "$sub" ]] || continue
            if cidr_parse_any "$sub" \
               && cidr_overlaps "$wfirst" "$wlast" "$CIDR_FIRST" "$CIDR_LAST"; then
                return 0
            fi
        done < <(grep -oE '"subnet": *"[^"]+"' <<<"$info" | sed -E 's/"subnet": *"([^"]+)"/\1/')
    done
    return 1
}

# ARC-35-D3: next free /24 in 10.199.0.0/16 (the example range), starting
# at 10.199.0.0/24, skipping any CIDR init_cidr_taken reports.
init_pick_subnet() { # init_pick_subnet <dest> -> cidr or non-zero
    local dest="$1" i cidr
    for (( i=0; i<=255; i++ )); do
        cidr="10.199.$i.0/24"
        if ! init_cidr_taken "$cidr" "$dest"; then
            echo "$cidr"
            return 0
        fi
    done
    return 1
}

# ARC-35: `init <name> [--subnet <cidr>]` — write a starter conf+allowlist
# pair for a NEW profile, as the account. NOT a load_config subcommand
# (it is a file-writer, not a profile operation). Subject to the ARC-25
# root guard (enforced in main). Never overwrites; never ensures.
cmd_init() {
    local name="" subnet="" arg
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --subnet) [[ $# -ge 2 ]] || { echo "Error: --subnet requires a CIDR." >&2; exit 2; }
                       subnet="$2"; shift 2 ;;
            --subnet=*) subnet="${1#--subnet=}"; shift ;;
            --*)       echo "Error: unknown init option '$1'." >&2; exit 2 ;;
            *)         if [[ -z "$name" ]]; then name="$1"; else
                           echo "Error: init takes one profile name." >&2; exit 2
                       fi
                       shift ;;
        esac
    done
    [[ -n "$name" ]] || {
        echo "Error: init requires a profile name." >&2
        echo "usage: egresslock init <name> [--subnet <cidr>]" >&2
        exit 2
    }
    [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || {
        echo "Error: invalid profile name '$name' (expected [a-z0-9][a-z0-9-]*, must not start with '-')." >&2
        exit 2
    }

    # Dest dir: the account confdir (EGL-325) — init is a writer and
    # works even when no config exists yet.
    local dest
    dest="$(confdir_default)" || exit 1
    mkdir -p "$dest" || die "cannot create $dest"
    local conf_path="$dest/$name.conf" al_path="$dest/$name-allowlist"
    if [[ -e "$conf_path" || -e "$al_path" ]]; then
        echo "Error: '$name' already exists ($conf_path or $al_path); init never overwrites." >&2
        echo "  to replace it, teardown + archive the pair first (see the policy reference's profile lifecycle)." >&2
        exit 1
    fi

    # Subnet: explicit --subnet (validated strict + overlap) or auto-pick.
    local cidr=""
    if [[ -n "$subnet" ]]; then
        cidr_parse "$subnet" || {
            echo "Error: invalid --subnet '$subnet' (expected IPv4 CIDR, prefixlen 8-29, canonical network address)." >&2
            exit 2
        }
        cidr="$subnet"
        if init_cidr_taken "$cidr" "$dest"; then
            echo "Error: --subnet $subnet overlaps an existing profile/network." >&2
            exit 1
        fi
    else
        cidr="$(init_pick_subnet "$dest")" || {
            echo "Error: no free /24 in 10.199.0.0/16; pass --subnet explicitly." >&2
            exit 1
        }
    fi

    cidr_parse "$cidr" || die "internal: picked subnet invalid"
    local gw
    gw="$(cidr_ip "$(( CIDR_FIRST + 1 ))")"   # .2 on a /24

    # Write under a restrictive umask so the pair is never observable as
    # 0644 before the chmod lands (R-035-1 note 3 follow-up); chmod 600
    # remains the authoritative mode.
    ( umask 077
      {
        echo "# $name.conf — starter for profile '$name' (egresslock init)."
        echo "# Fail-closed: empty allowlist, gateway-only."
        echo "# Grow with: egresslock allow $name <host[:port]>"
        echo "profile $name $cidr"
        echo "    rule gateway-only"
        echo "    gateway $gw 3128 $name-allowlist"
      } > "$conf_path"
      : > "$al_path" )
    chmod 600 "$conf_path" "$al_path" 2>/dev/null || true
    echo "init: wrote $conf_path"
    echo "init: wrote $al_path (empty allowlist — deny all)"
    echo "init: next: egresslock ensure $name"
}

cmd_list() {
    # ARC-11-D5: name, network, subnet. No creds= column — that was site
    # credential policy, not engine network state (removed ARC-11).
    # Headers keep bare `list` output self-describing.
    printf '%-14s %-22s %-16s\n' "NAME" "NETWORK" "SUBNET"
    local p
    for p in "${PROFILES[@]}"; do
        printf '%-14s %-22s %-16s\n' \
            "$p" "$(network_of "$p")" "${PROFILE_SUBNET[$p]}"
    done
}

# ARC-60-D1: `teardown --runtime` — the no-conf runtime sweep. The
# dispatcher skips resolution for this form. As the account, name-scan
# THIS store and remove kit-owned objects (ARC-68-D1: egresslock-only):
#   container: ^egresslock-(gateway|anchor)-[a-z0-9-]+$
#   network:   ^egresslock-[a-z0-9-]+$
# Never non-kit names or images. Containers first (so networks can go),
# then networks best-effort. Idempotent: nothing matching -> rc 0 and one
# `no kit runtime` line. The `inet egresslock` nft table goes too,
# best-effort (ARC-66-D4).
# Sweep 1 of cmd_teardown_runtime (EGL-182-D1): kit-named containers.
# Callers share the aggregator's `found` via dynamic scope; ARC-69-D1:
# `removed` only after a successful rm (closes the R-060-1 O2 blind
# echo); a failed rm is one honest note.
teardown_runtime_containers() {
    names="$(rt_ps all 2>/dev/null || true)"
    for name in $names; do
        [[ "$name" =~ ^egresslock-(gateway|anchor)-[a-z0-9-]+$ ]] || continue
        if rt_rm "$name" >/dev/null 2>&1; then
            echo "removed container $name"
            found=1
        else
            echo "note: could not remove container $name"
        fi
    done
    return 0
}

# Sweep 2 (EGL-182-D1): kit-named networks, best-effort — a failed list
# is one note and the sweep continues (nft tables still go);
# `no kit runtime` is NOT printed for a run that could not see the
# networks (sets the aggregator's `nets_ok=0`, ARC-67-D3).
teardown_runtime_networks() {
    if ! names="$(podman_network_names 2>/dev/null)"; then
        echo "note: could not list Podman networks; kit-named networks were NOT swept (remove them manually: podman network rm <name>)"
        nets_ok=0
    else
        for name in $names; do
            [[ "$name" =~ ^egresslock-[a-z0-9-]+$ ]] || continue
            # ARC-69-D1: same vocabulary as conf-scoped teardown — a
            # network that exists but won't rm is `kept (in use)`; the
            # count includes only real removals, never failed rms.
            if rt_network_rm "$name" >/dev/null 2>&1; then
                echo "removed network $name"
                found=1
            else
                echo "kept network $name (in use)"
            fi
        done
    fi
    return 0
}

# Sweep 3 (EGL-182-D1): ARC-66-D4 — the kit's nft table is kit POLICY in
# the shared rootless netns (filter hooks apply netns-wide, not just to
# kit bridges), so the sweep deletes it too — amends ARC-60-D1's
# hands-off rule. Best effort: a missing table or netns is a skip; a
# failing delete is one note and rc 0 — this is the recovery command.
# Never run from uninstall/postrm (ARC-7-D5).
teardown_runtime_nft() {
    local tbl="$TABLE"
    netns_nft list table inet "$tbl" >/dev/null 2>&1 || return 0
    if netns_nft delete table inet "$tbl" >/dev/null 2>&1; then
        echo "removed nft table inet $tbl"
        found=1
    else
        echo "note: could not delete nft table inet $tbl; remove it manually: podman unshare --rootless-netns nft delete table inet $tbl"
    fi
    return 0
}

cmd_teardown_runtime() {
    if [[ $# -gt 1 ]]; then
        echo "Error: teardown --runtime takes no other arguments." >&2
        echo "usage: egresslock teardown --runtime" >&2
        exit 2
    fi
    local names name found=0 nets_ok=1
    # ARC-69-D1 rides the container helper; sweep order is frozen:
    # containers -> networks -> nft -> summary. The `no kit runtime`
    # summary stays inline (ARC-67-D3: not printed when the network list
    # failed — that run saw an unknown state, so it would be a false
    # claim).
    teardown_runtime_containers
    teardown_runtime_networks
    teardown_runtime_nft
    if [[ "$found" == 0 ]]; then
        if [[ "$nets_ok" == 1 ]]; then
            echo "no kit runtime"
        fi
        return
    fi
}

cmd_teardown() {
    local target="${1:-}" p
    if [[ -z "$target" ]]; then
        # ARC-69-D4: bare teardown is a usage error naming every form,
        # not a require_profile "" misfire.
        echo "Error: teardown requires an argument." >&2
        echo "usage: egresslock teardown <profile> | egresslock teardown all | egresslock teardown --runtime" >&2
        exit 2
    fi
    # ARC-71-D1: `--runtime` dispatches BEFORE the netns probe. The
    # recovery sweep installs no policy; blocking it on a pasta EPERM
    # made it unusable exactly when uninstall needed it (dogfood host,
    # 2026-09-07). Amends ARC-26-D1: --runtime is not in the probe set.
    if [[ "$target" == "--runtime" ]]; then
        cmd_teardown_runtime "$@"
        return
    fi
    # ARC-71-D2: conf-scoped teardown keeps the probe — day-to-day
    # commands fail loud on a wedged netns with the ARC-26 guidance.
    netns_probe || exit 1
    local listed nets removed_total=0 nothing_total=1
    # ARC-69-D1: existence is checked BEFORE rm (membership in the
    # current listings), so repeat teardown reports the three real
    # states instead of guessing from rm's rc.
    listed="$(rt_ps all 2>/dev/null || true)"
    nets="$(podman_network_names 2>/dev/null || true)"
    case "$target" in
        all) set -- "${PROFILES[@]}" ;;
        *)   require_profile "$target" teardown; set -- "$target" ;;
    esac
    for p in "$@"; do
        teardown_profile_objects "$p" "$listed" "$nets"
        if (( TD_REMOVED )); then
            removed_total=1
        fi
        (( TD_NOTPRESENT )) || nothing_total=0
    done
    if (( nothing_total == 1 && removed_total == 0 )); then
        # ARC-69-D2: every object was already gone — no nft note (it
        # would be a lie: a no-op run proves nothing about the table).
        # EGL-325 A7: `all` is the main.conf-only form (D6) — it never
        # scans sibling confs, so the sentence must name that one profile
        # instead of claiming every profile is clean.
        if [[ "$target" == "all" ]]; then
            echo "nothing left for profile '${PROFILES[0]:-main}' (teardown all reads main.conf only)"
        else
            echo "nothing left for profile '$target'"
        fi
    else
        # ARC-69-D2: something was removed (or something is stuck, so
        # the table genuinely persists) — point at --runtime, which
        # deletes the table; pasta may keep it alive past this run.
        echo "note: nft table inet $TABLE is unchanged; 'egresslock teardown --runtime' deletes it"
    fi
}

# ARC-69-D1: per-profile object teardown, existence first (membership
# in the caller's listings) then rm; rm's rc decides removed vs kept.
# TD_REMOVED=1 when removed; TD_NOTPRESENT=1 when every object was gone.
teardown_profile_objects() { # <profile> <container-list> <network-list>
    local p="$1" listed="$2" nets="$3"
    local gwname aname netname
    TD_REMOVED=0
    TD_NOTPRESENT=1
    gwname="$(gw_name "$p")"
    aname="$(anchor_of "$p")"
    netname="$(network_of "$p")"
    if is_gateway_profile "$p"; then
        if has_runtime_name "$gwname" "$listed"; then
            if rt_rm "$gwname" >/dev/null 2>&1; then
                echo "removed gateway $gwname"
                TD_REMOVED=1
                TD_NOTPRESENT=0
            else
                echo "note: could not remove gateway $gwname"
                TD_NOTPRESENT=0
            fi
        else
            echo "not present gateway $gwname"
        fi
    fi
    if has_runtime_name "$aname" "$listed"; then
        if rt_rm "$aname" >/dev/null 2>&1; then
            echo "removed anchor $aname"
            TD_REMOVED=1
            TD_NOTPRESENT=0
        else
            echo "note: could not remove anchor $aname"
            TD_NOTPRESENT=0
        fi
    else
        echo "not present anchor $aname"
    fi
    if has_runtime_name "$netname" "$nets"; then
        if rt_network_rm "$netname" >/dev/null 2>&1; then
            echo "removed $netname"
            TD_REMOVED=1
            TD_NOTPRESENT=0
        else
            echo "kept $netname (in use)"
            TD_NOTPRESENT=0
        fi
    else
        echo "not present $netname"
    fi
}

# ARC-69-D1 helper: membership of $1 in the whitespace-separated list $2.
has_runtime_name() {
    local n
    for n in $2; do
        [[ "$n" == "$1" ]] && return 0
    done
    return 1
}

#
# EGL-325 config resolution. One unix account = one confdir, always
# <passwd-home>/.config/egresslock (never $HOME). Peek the profile
# argument before load_config ($1 = command, $2 = first arg after it).
#
#   named commands: $CONFDIR/<profile>.conf only (no main.conf fallback).
#   bare list: aggregate every $CONFDIR/*.conf (ARC-37-D3).
#   bare verify --ensured: same aggregate glob (a check, not a delete).
#   bare teardown all: main.conf only, never scans (ARC-37-D4).
#
# Every loaded file must be named after the profile it defines (EGL-323).
#
confdir_default() {
    local home
    home="$(getent passwd "$(id -u)" | cut -d: -f6)" || true
    [[ -n "$home" ]] \
        || die "cannot resolve the account home for the config directory (getent passwd $(id -u) returned nothing); refusing to guess a config directory"
    printf '%s\n' "$home/.config/egresslock"
}

conf_basename() { # conf_basename <path> -> basename without the .conf suffix
    local b="${1##*/}"
    printf '%s' "${b%.conf}"
}

conf_require_basename() { # conf_require_basename <conf> <defined-profile>
    local conf="$1" profile="$2" base
    base="$(conf_basename "$conf")"
    [[ "$base" == "$profile" ]] || {
        echo "Error: config name/profile mismatch: '$conf' defines profile '$profile' but the file must be named '$profile.conf' (one profile per file; basename = profile)" >&2
        exit 2
    }
}

# EGL-117-D1: resolution disclosure. Every conf-resolving invocation
# prints EXACTLY ONE stderr line naming the resolved config — every
# time, TTY-independent. Stdout contracts stay byte-stable.
disclose_resolution() { # disclose_resolution <mode> <path> <count>
    local mode="$1" path="$2" extra="${3:-}"
    case "$mode" in
        named)     echo "using config $path" >&2 ;;
        aggregate) echo "using configs in $path ($extra profiles)" >&2 ;;
        *) echo "internal: unknown resolution mode $mode" >&2; return 1 ;;
    esac
}

probe_named_conf() { # probe_named_conf <confdir> <profile>
    local confdir="$1" profile="$2"
    local candidate
    # EGL-325 n4: validate the profile token BEFORE it is joined to the
    # confdir. Without this, `network ../other/secret` built a candidate
    # outside the confdir and disclosed a readable `*.conf` there before
    # require_profile refused; a profile name is exactly the grammar the
    # loader accepts ([a-z0-9][a-z0-9-]*).
    [[ "$profile" =~ ^[a-z0-9][a-z0-9-]*$ ]] || {
        echo "Error: invalid profile name '$profile' (expected [a-z0-9][a-z0-9-]*, must not start with '-')." >&2
        exit 2
    }
    candidate="$confdir/$profile.conf"
    if [[ ! -f "$candidate" ]]; then
        echo "Error: no profile config: '$candidate' not found" >&2
        echo "Each profile lives in the account config directory as <profile>.conf (this account's config directory is '$confdir'). If you expected a config to be found, make sure you are running as the dedicated account (not root) and that the profile file is in place — 'egresslock init <name>' or 'egresslock-setup init --init-conf' creates them." >&2
        exit 2
    fi
    disclose_resolution named "$candidate"
    ENGINE_CONF="$candidate"
    load_config "$ENGINE_CONF"
    conf_require_basename "$ENGINE_CONF" "${PROFILES[0]}"
}

# ARC-37-D3/D4: load every CONFDIR/*.conf (non-recursive; not .bak/,
# not allowlists). Fail closed on a load_config failure, a profile name
# in two files, or a basename that is not the profile it defines. No
# *.conf -> exit 2. stderr: one 'using configs in <CONFDIR>' line.
aggregate_configs() { # aggregate_configs <confdir>
    local confdir="$1"
    local -a confs=()
    local f
    for f in "$confdir"/*.conf; do
        [[ -f "$f" ]] && confs+=("$f")
    done
    if (( ${#confs[@]} == 0 )); then
        echo "Error: no profile config: no *.conf in '$confdir'" >&2
        echo "Checked '$confdir' for *.conf (this account's config directory). If you expected a config to be found, make sure you are running as the dedicated account (not root) and that the profile file is in place — 'egresslock init <name>' or 'egresslock-setup init --init-conf' creates them." >&2
        exit 2
    fi
    # EGL-117-D1: disclose the aggregate scope (one line, every time).
    # N = the number of *.conf files the glob resolved (same glob as the
    # loads that follow; a load that fails aborts the command fail-closed).
    disclose_resolution aggregate "$confdir" "${#confs[@]}"
    local first=1 c idx
    for c in "${confs[@]}"; do
        if [[ "$first" == 1 ]]; then
            load_config "$c"
            first=0
        else
            load_config "$c" 1
        fi
        idx=$(( ${#PROFILES[@]} - 1 ))
        conf_require_basename "$c" "${PROFILES[$idx]}"
    done
}

# EGL-228-D2: conf-independent argv-shape check. Called after
# require_nonroot and before resolve/load so a usage rc 2 is stable
# whether the conf is missing, malformed, or unreadable. Handlers
# keep their parsers (this is an early filter). Conf-dependent
# checks (unknown profile, gateway-only, engine-required) stay in
# the handler after the load.
argv_shape_check() { # argv_shape_check <command> <args-after-command...>
    local cmd="${1:-}"; shift
    case "$cmd" in
        ensure)
            local replace_gw=0 profile=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --replace-gateway)
                        if (( replace_gw )); then
                            echo "Error: ensure takes --replace-gateway only once." >&2
                            echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                            exit 2
                        fi
                        replace_gw=1; shift ;;
                    "")
                        echo "Error: ensure takes one profile name." >&2
                        echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                        exit 2 ;;
                    -*) echo "Error: ensure takes --replace-gateway only." >&2
                        echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                        exit 2 ;;
                    *)  [[ -z "$profile" ]] || {
                            echo "Error: ensure takes one profile name." >&2
                            echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                            exit 2
                        }
                        profile="$1"; shift ;;
                esac
            done
            if [[ -z "$profile" ]]; then
                echo "Error: ensure requires a profile name." >&2
                echo "usage: egresslock ensure <profile>" >&2
                exit 2
            fi
            ;;
        verify)
            if [[ "${1:-}" == "--ensured" ]]; then
                [[ $# -eq 1 ]] || {
                    echo "Error: verify --ensured takes no profile argument." >&2
                    usage >&2
                    exit 2
                }
            else
                if [[ $# -lt 1 || -z "$1" ]]; then
                    echo "Error: verify requires a profile name." >&2
                    echo "usage: egresslock verify <profile>" >&2
                    exit 2
                fi
            fi
            ;;
        network)
            if [[ $# -lt 1 || -z "$1" ]]; then
                echo "Error: network requires a profile name." >&2
                echo "usage: egresslock network <profile>" >&2
                exit 2
            fi
            [[ -z "${2:-}" ]] || {
                echo "Error: network takes no extra arguments." >&2
                echo "usage: egresslock network <profile>" >&2
                exit 2
            }
            ;;
        proxy-env)
            if [[ $# -lt 1 || -z "$1" ]]; then
                echo "Error: proxy-env requires a profile name." >&2
                echo "usage: egresslock proxy-env <profile>" >&2
                exit 2
            fi
            # EGL-246 R-EGL-246-3 F3: count/presence checks, not
            # non-empty-value checks — a quoted empty argument `""` is
            # a real positional, so every shape here is judged by argc
            # alone and any extra argument (including `""`) exits 2
            # BEFORE any conf read. The specific `--out` space-form
            # error outranks the generic at-most-one error (D14's
            # shepherding message for the common mis-spelling).
            if [[ "${2:-}" == "--out" && $# -ge 3 ]]; then
                echo "Error: --out takes no separate argument (use --out=<path>)." >&2
                echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
                exit 2
            fi
            if (( $# > 2 )); then
                echo "Error: proxy-env takes at most one argument (a token or an --out form)." >&2
                echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
                exit 2
            fi
            if (( $# == 2 )); then
                case "$2" in
                    proxyip|proxyport|noproxy|--out) ;;
                    --out=*)
                        [[ -n "${2#--out=}" ]] || {
                            echo "Error: --out= requires a path." >&2
                            echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
                            exit 2
                        } ;;
                    *) echo "Error: unknown proxy-env token '$2' (expected: proxyip, proxyport, noproxy)." >&2; exit 2 ;;
                esac
            fi
            ;;
        rules)
            if [[ $# -lt 1 || -z "$1" ]]; then
                echo "Error: rules requires a profile name." >&2
                echo "usage: egresslock rules <profile>" >&2
                exit 2
            fi
            ;;
        allowlist)
            if [[ $# -lt 1 || -z "$1" ]]; then
                echo "Error: allowlist requires a profile name." >&2
                echo "usage: egresslock allowlist <profile>" >&2
                exit 2
            fi
            [[ -z "${2:-}" ]] || {
                echo "Error: allowlist takes no extra arguments." >&2
                echo "usage: egresslock allowlist <profile>" >&2
                exit 2
            }
            ;;
        denied)
            if [[ $# -lt 1 || -z "$1" ]]; then
                echo "Error: denied requires a profile name." >&2
                echo "usage: egresslock denied <profile>" >&2
                exit 2
            fi
            shift
            local days=14
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --all)  shift ;;
                    --days) [[ $# -ge 2 ]] || { echo "Error: --days requires a value." >&2; exit 2; }
                            days="$2"; shift 2 ;;
                    *)      echo "Error: denied takes --all and/or --days N." >&2
                            echo "usage: egresslock denied <profile> [--all] [--days N]" >&2
                            exit 2 ;;
                esac
            done
            [[ "$days" =~ ^(0|[1-9][0-9]*)$ ]] || {
                echo "Error: --days must be a non-negative integer (0 = no time limit)." >&2
                exit 2
            }
            ;;
        allow|disallow)
            if [[ $# -lt 1 || -z "$1" ]]; then
                echo "Error: $cmd requires a profile name." >&2
                echo "usage: egresslock $cmd <profile>" >&2
                exit 2
            fi
            shift
            [[ $# -ge 1 ]] || {
                echo "Error: $cmd requires a destination." >&2
                echo "usage: egresslock $cmd <profile> <host[:port]> [host[:port] ...]" >&2
                exit 2
            }
            local e
            for e in "$@"; do
                validate_allow_entry "$e" || exit 2
            done
            ;;
        allow-host|disallow-host)
            if [[ $# -lt 1 || -z "$1" ]]; then
                echo "Error: $cmd requires a profile name." >&2
                echo "usage: egresslock $cmd <profile>" >&2
                exit 2
            fi
            local entry="${2:-}"
            [[ -n "$entry" ]] || {
                echo "Error: $cmd requires a destination." >&2
                echo "usage: egresslock $cmd <profile> <host:port>" >&2
                exit 2
            }
            if [[ $# -gt 2 ]]; then
                echo "Error: $cmd takes exactly one host:port." >&2
                echo "usage: egresslock $cmd <profile> <host:port>" >&2
                exit 2
            fi
            validate_host_port "$entry"
            ;;
        drop-unauthorized)
            if [[ $# -lt 1 || -z "$1" ]]; then
                echo "Error: drop-unauthorized requires a profile name." >&2
                echo "usage: egresslock drop-unauthorized <profile> <port>" >&2
                exit 2
            fi
            if [[ -z "${2:-}" ]]; then
                echo "Error: drop-unauthorized requires a port." >&2
                echo "usage: egresslock drop-unauthorized <profile> <port>" >&2
                exit 2
            fi
            if [[ $# -gt 2 ]]; then
                echo "Error: drop-unauthorized takes exactly one port." >&2
                echo "usage: egresslock drop-unauthorized <profile> <port>" >&2
                exit 2
            fi
            if [[ ! "$2" =~ ^[0-9]+$ ]] || (( 10#$2 < 1 || 10#$2 > 65535 )); then
                echo "Error: invalid port '$2' (expected 1-65535)." >&2
                exit 2
            fi
            ;;
        teardown)
            if [[ -z "${1:-}" ]]; then
                echo "Error: teardown requires an argument." >&2
                echo "usage: egresslock teardown <profile> | egresslock teardown all | egresslock teardown --runtime" >&2
                exit 2
            fi
            if [[ "$1" == "--runtime" && $# -gt 1 ]]; then
                echo "Error: teardown --runtime takes no other arguments." >&2
                echo "usage: egresslock teardown --runtime" >&2
                exit 2
            fi
            ;;
        list) ;;
        *) ;;
    esac
}

resolve_conf_for() { # resolve_conf_for <command> <arg2>
    local cmd="${1:-}" arg2="${2:-}"
    local confdir
    confdir="$(confdir_default)"
    case "$cmd" in
        list)
            aggregate_configs "$confdir"
            ;;
        verify)
            if [[ "$arg2" == "--ensured" ]]; then
                aggregate_configs "$confdir"
            else
                probe_named_conf "$confdir" "$arg2"
            fi
            ;;
        teardown)
            if [[ "$arg2" == "all" ]]; then
                probe_named_conf "$confdir" "main"
            else
                probe_named_conf "$confdir" "$arg2"
            fi
            ;;
        *)
            probe_named_conf "$confdir" "$arg2"
            ;;
    esac
}

# EGL-227: account-wide advisory lock. One kernel flock per account makes
# the ensure/mutator/teardown critical section atomic (source read ->
# candidate generation -> apply -> restart/teardown), so an older ensure
# cannot copy a stale candidate over a newer mutation (EGL-223 S3) or race
# the gateway lifecycle (X-9). Identity is the ACCOUNT home from getent
# passwd — never $HOME, which an alternate environment could bypass
# (R-EGL-227-5 F1); not confdir either, because `teardown --runtime` is
# the conf-less recovery path and must serialize. Writers take it
# exclusive; verify takes it shared and degrades to lock-free rather than
# wedge the 15-minute timer. Kernel-released on death, so no stale-lock
# cleanup. Held on fd 9; rt_run/rt_restart close fd 9 in the child (D10).
engine_lock_path() {
    local home
    home="$(getent passwd "$(id -u)" | cut -d: -f6)" || true
    [[ -n "$home" ]] \
        || die "cannot resolve the account home for the account lock (getent passwd $(id -u) returned nothing); refusing to run unserialized"
    printf '%s\n' "$home/.local/state/egresslock/engine.lock"
}

acquire_engine_lock() { # acquire_engine_lock <command>
    local cmd="${1:-}" mode wait_s lockf holder
    case "$cmd" in
        ensure|allow|disallow|allow-host|disallow-host|drop-unauthorized|teardown|init)
            mode=write; wait_s="${EGRESSLOCK_LOCK_WAIT:-30}" ;;
        verify)
            mode=read; wait_s="${EGRESSLOCK_LOCK_WAIT:-5}" ;;
        *) return 0 ;;  # list/network/proxy-env/rules/allowlist/denied/doctor/build-gateway
    esac
    [[ "$wait_s" =~ ^[0-9]+$ ]] \
        || die "EGRESSLOCK_LOCK_WAIT must be a non-negative integer number of seconds (got '$wait_s')"
    command -v flock >/dev/null 2>&1 \
        || die "flock(1) (util-linux) is required to serialize egresslock commands and was not found in PATH; refusing to run unserialized"
    lockf="$(engine_lock_path)" || exit 1   # S1 already printed by the die
    ( umask 077; mkdir -p "$(dirname "$lockf")" ) \
        || die "cannot create the account lock directory $(dirname "$lockf") (fail closed)"
    exec 9>>"$lockf" || die "cannot open the account lock $lockf (fail closed)"
    if [[ "$mode" == read ]]; then
        # A writer in flight is not worth wedging the timer behind: on
        # timeout proceed lock-free (pre-EGL-227 behavior; EGL-283 keeps
        # the raced verify message honest).
        flock -s -w "$wait_s" 9 || { exec 9>&-; return 0; }
    else
        if ! flock -x -w "$wait_s" 9; then
            holder="$(tail -n 1 "$lockf" 2>/dev/null || true)"
            die "another egresslock command is running for this account (waited ${wait_s}s for the account lock; $lockf; holder: ${holder:-unknown}); re-run when it finishes"
        fi
        # EGL-227 D11: the exclusive holder owns the record — truncate it
        # so the diagnostics file stays one line per holder instead of
        # growing ~1.4 MB/year/account. Shared readers never truncate
        # (concurrent sharers); with O_APPEND (fd 9) the write below
        # lands at offset 0 of the fresh file.
        : > "$lockf" || die "cannot truncate the account lock record $lockf (fail closed)"
    fi
    printf 'pid=%s mode=%s started=%s\n' "$$" "$mode" "$(date -Is)" >&9
}

# --- EGL-45: engine doctor — host environment probe --------------------------
# ARC-4 piece 6 / EGL-10: runtime evidence for the version-compat question.
# Docs claim support only for what the host actually provides, never "any
# rootless Podman".
#
# NOT `egresslock-setup apparmor check` (pasta AppArmor) and NOT
# `egresslock-setup doctor` (kit/account install state) — see each
# binary's help. D45-3: no connectivity experiment — no policy install,
# networks, gateway, or curls, and no verdict beyond the required-tools
# rc.
#
# Output (D45-2): one `key: value` line per check on stdout (stable,
# greppable keys); errors/hints on stderr. A missing REQUIRED check ->
# rc 1; all required present -> rc 0 even when advisories fail.
cmd_doctor() {
    local rc=0
    local podman_ok=1 backend=""

    # Required: podman on PATH.
    if rt_have_runtime; then
        echo "podman: $(rt_version 2>/dev/null || echo 'present')"
    else
        echo "podman: MISSING"
        podman_ok=0
        rc=1
    fi

    # One podman info roundtrip feeds both the netavark fallback and the
    # bridge_driver advisory. Missing/failed podman info -> empty.
    if (( podman_ok )); then
        backend="$(rt_info 2>/dev/null || true)"
    fi

    # Required: netavark — on PATH, or the backend podman reports.
    if command -v netavark >/dev/null 2>&1; then
        echo "netavark: $(command -v netavark)"
    elif [[ -n "$backend" ]]; then
        echo "netavark: present (podman NetworkBackend: $backend)"
    else
        echo "netavark: MISSING"
        rc=1
    fi

    # Required: nft — NFT_BIN, then /usr/sbin/nft, then PATH (the engine's
    # own resolution order; resolved WITHOUT dying — a miss is a MISSING
    # line, not an abort).
    local nft_resolved=""
    if [[ -n "${NFT_BIN:-}" ]]; then
        nft_resolved="$NFT_BIN"
    elif command -v nft >/dev/null 2>&1; then
        nft_resolved="$(command -v nft)"
    elif [[ -x /usr/sbin/nft ]]; then
        nft_resolved=/usr/sbin/nft
    fi
    if [[ -n "$nft_resolved" && -e "$nft_resolved" ]]; then
        echo "nft: $("$nft_resolved" --version 2>/dev/null || echo "present ($nft_resolved)")"
    else
        echo "nft: MISSING"
        rc=1
    fi

    # Required: conntrack — CONNTRACK_BIN, then /usr/sbin/conntrack, then
    # PATH (the engine's own resolution order; EGL-139-D2: required by
    # disallow-host's revocation flush). Resolved WITHOUT dying — a miss
    # is a MISSING line, not an abort. Adjacent-layer row (EGL-139-D5):
    # the walked egresslock-setup doctor card does not change.
    local ct_resolved=""
    if [[ -n "${CONNTRACK_BIN:-}" ]]; then
        ct_resolved="$CONNTRACK_BIN"
    elif command -v conntrack >/dev/null 2>&1; then
        ct_resolved="$(command -v conntrack)"
    elif [[ -x /usr/sbin/conntrack ]]; then
        ct_resolved=/usr/sbin/conntrack
    fi
    if [[ -n "$ct_resolved" && -e "$ct_resolved" ]]; then
        echo "conntrack: $("$ct_resolved" --version 2>/dev/null || echo "present ($ct_resolved)")"
    else
        echo "conntrack: MISSING"
        rc=1
    fi

    # Required: unprivileged user namespaces (file is 1; kernels without
    # the sysctl always allow). EGRESSLOCK_USERNS_SYSCTL is a harness
    # override (tests pin the row to fixture files); unset = the real
    # kernel sysctl path.
    local userns_sysctl="${EGRESSLOCK_USERNS_SYSCTL:-/proc/sys/kernel/unprivileged_userns_clone}"
    if [[ -r $userns_sysctl ]]; then
        if [[ "$(cat "$userns_sysctl")" == "1" ]]; then
            echo "userns: enabled"
        else
            echo "userns: disabled"
            rc=1
        fi
    else
        echo "userns: enabled (kernel has no unprivileged_userns_clone gate)"
    fi

    # --- advisory lines: never affect the rc --------------------------------
    if command -v pasta >/dev/null 2>&1; then
        echo "network_backend: pasta"
    elif command -v slirp4netns >/dev/null 2>&1; then
        echo "network_backend: slirp"
    else
        echo "network_backend: unknown"
    fi

    if (( ! podman_ok )); then
        echo "rootless_netns: skipped (podman MISSING)"
    else
        local nerr="" nrc=0
        # EGL-78-D1/D3: bound the doctor's probe the same way the engine's
        # netns_probe is bounded. Advisory only — doctor's other rc policy
        # is unchanged.
        if ! command -v timeout >/dev/null 2>&1; then
            nerr="timeout(1) (coreutils) not found in PATH"
            nrc=1
        else
            nerr="$(rt_unshare -t 5 true 2>&1)" && nrc=0 || nrc=$?
        fi
        if (( nrc == 0 )); then
            echo "rootless_netns: ok"
        elif (( nrc == 124 )); then
            echo "rootless_netns: fail: probe timed out after 5s ('timeout 5 podman unshare --rootless-netns true'); the rootless netns is not answering"
            echo "Hint: run as the dedicated account; see docs/troubleshooting/netns-inspection.md." >&2
        else
            # D2 scopes the AppArmor pointer to the AppArmor-shaped
            # failure (rc 126 / permission denied); any other netns
            # failure gets a generic pointer instead — do not misroute
            # a non-AppArmor problem to apparmor check.
            echo "rootless_netns: fail:$(printf '%s' "$nerr" | head -1)"
            if (( nrc == 126 )) || grep -qi 'permission denied' <<<"$nerr"; then
                echo "Hint: run 'egresslock-setup apparmor check' for the pasta AppArmor slice." >&2
            else
                echo "Hint: run as the dedicated account; see docs/troubleshooting/netns-inspection.md." >&2
            fi
        fi
    fi

    if [[ "$backend" == "netavark" ]]; then
        echo "bridge_driver: bridge"
    else
        echo "bridge_driver: unknown"
    fi

    # EGL-226: account-side gateway-image advisory — the same base /
    # label / staleness peek the kit doctor prints
    # (egresslock-setup kit_check_gateway), conf-less and read-only. rc-neutral
    # like every line above.
    if (( ! podman_ok )); then
        echo "gateway image: skipped (podman MISSING)"
    else
        local dimg gw_base_short gw_pin_short gw_built
        dimg="$(gw_image)"
        gw_probe_state "$dimg" "$(dirname "${BASH_SOURCE[0]}")/gateway/Containerfile"
        gw_base_short="${GW_PROBE_BASE#sha256:}"; gw_base_short="${gw_base_short:0:12}"
        gw_pin_short="${GW_PROBE_PIN#sha256:}"; gw_pin_short="${gw_pin_short:0:12}"
        gw_built=""
        if [[ -n "$GW_PROBE_CREATED" ]]; then
            gw_built=", built ${GW_PROBE_CREATED:0:10}"
        fi
        if [[ "$GW_PROBE_STATE" == missing ]]; then
            echo "gateway image: missing ($dimg)"
            echo "  build it in the account shell: egresslock build-gateway (see \"The gateway image\" reference page)"
        elif [[ -n "$GW_PROBE_BASE" ]]; then
            echo "gateway image: present ($dimg) — base $gw_base_short${gw_built}"
            if [[ -n "$GW_PROBE_PIN" && "$GW_PROBE_BASE" != "$GW_PROBE_PIN" ]]; then
                echo "  stale: base pin moved (image base $gw_base_short != deployed pin $gw_pin_short) — rebuild in the account shell: egresslock build-gateway && egresslock ensure --replace-gateway <profile> per affected profile (see \"The gateway image\" reference page)"
            fi
        elif [[ -n "$GW_PROBE_INS" ]]; then
            echo "gateway image: present ($dimg) — base unknown (pre-label image)${gw_built}"
            echo "  stale: base unknown (pre-label image) — rebuild in the account shell: egresslock build-gateway && egresslock ensure --replace-gateway <profile> per affected profile (see \"The gateway image\" reference page)"
        else
            echo "gateway image: present ($dimg) — base unknown"
        fi
    fi

    exit "$rc"
}

# EGL-222: build-gateway — rebuild the gateway image into the invoking
# account's rootless store from the gateway/ context NEXT TO THE ENGINE
# (the BASH_SOURCE[0] precedent of --version; on a .deb host the wrapper
# execs the libdir copy, so the neighbor is the real engine's). Loads NO
# conf. Never a silent no-op (D2): a missing image, an empty base-digest
# label, or a label != the deployed pin all build; an equal pin prints
# one up-to-date line (rc 0); --force always builds (squid is unpinned,
# so a same-pin rebuild can take security updates).
cmd_build_gateway() {
    local force=0
    if (( $# > 0 )); then
        if [[ "$1" == "--force" && $# -eq 1 ]]; then
            force=1
        else
            echo "Error: build-gateway takes no arguments other than --force." >&2
            short_usage >&2
            exit 2
        fi
    fi

    # User-manager preflight (EGL-51-D1, D6): rootless podman needs the
    # account's systemd user manager (session or linger). Fail closed
    # when systemctl ANSWERS inactive; proceed when systemctl is ABSENT
    # (the engine carries no systemd dependency — cmd_doctor degrades
    # without it too; setup's un-guarded check would wrongly take the
    # inactive branch there).
    local uid lg
    uid="$(id -u)"
    if command -v systemctl >/dev/null 2>&1; then
        if ! systemctl is-active --quiet "user@${uid}.service" 2>/dev/null; then
            echo "egresslock: no systemd user manager for '$(id -un)' (user@${uid}.service inactive). As root: systemctl start user@${uid}.service" >&2
            lg="$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null || true)"
            [[ "$lg" == "yes" ]] || \
                echo "egresslock: ... and: loginctl enable-linger $(id -un)  (or re-run the account bundle setup with --enable)" >&2
            exit 1
        fi
    fi

    # Context: the engine's own neighbor gateway/.
    local gdir
    gdir="$(dirname "${BASH_SOURCE[0]}")/gateway"
    if [[ ! -f "$gdir/Containerfile" ]]; then
        echo "Error: no gateway build context at $gdir/Containerfile (the gateway/ directory must sit next to the engine)" >&2
        exit 1
    fi
    # Image + deployed pin via the shared probe (EGL-226): plain
    # assignment so the ARC-59 die() in gw_image propagates under set -e.
    local img pin_short
    img="$(gw_image)"
    gw_probe_state "$img" "$gdir/Containerfile"
    pin_short="${GW_PROBE_PIN#sha256:}"; pin_short="${pin_short:0:12}"
    local build=0
    if [[ "$GW_PROBE_STATE" != present || -z "$GW_PROBE_BASE" \
          || -z "$GW_PROBE_PIN" || "$GW_PROBE_BASE" != "$GW_PROBE_PIN" ]]; then
        build=1
    fi

    if (( ! build && ! force )); then
        # D2: never a silent no-op — one explicit up-to-date line.
        echo "already built from deployed pin ${pin_short} — use --force to rebuild"
        return 0
    fi

    # Build (D10 leading line; D8 primitive; D5 docker format, -t first).
    echo ">> Building $img FROM ${pin_short}"
    local -a extra_flags=()
    if (( force )); then
        # R-EGL-222-3 F1: a forced rebuild must not reuse cached layers —
        # the unchanged `RUN apt-get ... squid` instruction would
        # otherwise reuse its old layer, and the same-pin squid security
        # refresh that is --force's named purpose (D2) would never
        # happen. The pin-mismatch path needs no flag: the FROM digest
        # moved, which invalidates every layer after it on its own.
        extra_flags+=(--no-cache)
    fi
    if ! rt_image_build "$img" "$gdir/Containerfile" "$gdir" "${extra_flags[@]}"; then
        # R-EGL-222-7 (S-EGL-222-20261008-1): the printed retry must
        # reproduce THIS invocation — the actual engine executable (a
        # path-invoked engine need not have a PATH wrapper) and any
        # explicit EGRESSLOCK_GW_IMAGE (a one-shot assignment does not
        # persist). %q keeps every token shell-safe.
        local retry_cmd retry_engine
        retry_engine="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
        retry_cmd="$(printf '%q build-gateway' "$retry_engine")"
        if (( force )); then
            retry_cmd="$retry_cmd --force"
        fi
        if [[ -n "${EGRESSLOCK_GW_IMAGE:-}" ]]; then
            retry_cmd="$(printf 'EGRESSLOCK_GW_IMAGE=%q %s' "$EGRESSLOCK_GW_IMAGE" "$retry_cmd")"
        fi
        echo "Error: gateway image build failed for $img (build output above); fix the cause and re-run: $retry_cmd" >&2
        exit 1
    fi
}

# EGL-325: there is no config file selector. A profile's conf is always
# <passwd-home>/.config/egresslock/<profile>.conf; --config and
# EGRESSLOCK_CONF are not read. Reject --config explicitly (fail closed,
# rc 2) in ANY argv position, not only as the first token — the parsers
# silently ignored a trailing one, so stale scripts appeared to work.
# ARC-16-D5: --version prints the kit VERSION stamp (or 'dev').
# ARC-20-D1: profile subcommands REQUIRE a config — there are no
# compiled-in profiles; --help/-h/no-args and --version never touch
# profile state.
for _egl_arg in "$@"; do
    case "$_egl_arg" in
        --config|--config=*)
            echo "Error: --config has been removed (v0.9.0); a profile's config is always <account-home>/.config/egresslock/<profile>.conf (no file selector, no config-directory option)." >&2
            short_usage >&2
            exit 2
            ;;
    esac
done
if [[ "${1:-}" == "--version" ]]; then
    vfile="$(dirname "${BASH_SOURCE[0]}")/VERSION"
    if [[ -f "$vfile" ]]; then cat "$vfile"; else echo "dev"; fi
    exit 0
fi
case "${1:-}" in
    init)
        # ARC-35: init writes account-owned profile files; root would
        # write into root's home, so the ARC-25 root guard applies (but
        # init does NOT require a loadable config — it is a writer).
        require_nonroot
        acquire_engine_lock init
        ;;
    doctor)
        # EGL-45-D1: the host environment probe loads NO conf (same
        # class as --help/--version). ARC-25 root guard applies: probe
        # the ACCOUNT's store/netns, never root's.
        require_nonroot
        ;;
    build-gateway)
        # EGL-222: the gateway rebuild verb loads NO conf (same class
        # as doctor/--help/--version). ARC-25 root guard applies: build
        # into the ACCOUNT's rootless store, never root's.
        require_nonroot
        ;;
    *)
        # The profile-class commands: COMMANDS minus the exception arms
        # above. One list keeps this gate and the user-facing names from
        # drifting. Non-commands (bare, --help, unknowns) fall through.
        if in_commands "${1:-}"; then
            # ARC-25: fail closed when run as root — root's Podman store/
            # netns is a separate world from every account's. Accounts
            # execute the engine; root only distributes the kit (ARC-7-D5).
            # Escape hatch for intentional root use (not recommended).
            require_nonroot
            argv_shape_check "${1:-}" "${@:2}"
            acquire_engine_lock "${1:-}"
            if [[ "${1:-}" == "teardown" && "${2:-}" == "--runtime" ]]; then
                # ARC-60-D1: --runtime loads NO conf — it sweeps by name so it
                # works when the conf is already gone.
                :
            else
                # EGL-325/ARC-24/ARC-37: one account confdir. Named
                # commands load <profile>.conf; bare list and verify
                # --ensured aggregate CONFDIR/*.conf; bare teardown all
                # stays main.conf-only. EGL-223-D2/EGL-228-D1: in
                # `ensure --replace-gateway <profile>`, arg2 is the flag,
                # so feed the resolver arg3 (argv_shape_check already
                # rejected duplicate/unknown flags).
                _e223_arg2="${2:-}"
                if [[ "${1:-}" == "ensure" && "$_e223_arg2" == "--replace-gateway" ]]; then
                    _e223_arg2="${3:-}"
                fi
                resolve_conf_for "${1:-}" "$_e223_arg2"
            fi
        fi
        ;;
esac

case "${1:-}" in
    ensure)      shift; cmd_ensure "$@" ;;
    verify)      shift
                 if [[ "${1:-}" == "--ensured" ]]; then
                     shift
                     [[ $# -eq 0 ]] || { echo "Error: verify --ensured takes no profile argument." >&2; usage >&2; exit 2; }
                     cmd_verify_ensured
                 else
                     cmd_verify "$@"
                 fi ;;
    network)     shift; cmd_network "$@" ;;
    proxy-env)   shift; cmd_proxy_env "$@" ;;
    rules)       shift; cmd_rules "$@" ;;
    allowlist)   shift; cmd_allowlist "$@" ;;
    denied)      shift; cmd_denied "$@" ;;
    allow)       shift; cmd_allow "$@" ;;
    disallow)    shift; cmd_disallow "$@" ;;
    allow-host)  shift; cmd_allow_host "$@" ;;
    disallow-host) shift; cmd_disallow_host "$@" ;;
    drop-unauthorized) shift; cmd_drop_unauthorized "$@" ;;
    init)        shift; cmd_init "$@" ;;
    list)        cmd_list ;;
    doctor)      shift
                 # EGL-45-D1: no profile argument, no extra args.
                 [[ $# -eq 0 ]] || { echo "Error: doctor takes no arguments." >&2; short_usage >&2; exit 2; }
                 cmd_doctor ;;
    build-gateway) shift; cmd_build_gateway "$@" ;;
    teardown)    shift; cmd_teardown "$@" ;;
    help)        shift; cmd_help "$@" ;;
    -h|--help) usage ;;
    "")        short_usage ;;
    *)         echo "Error: unknown command '$1'." >&2; short_usage >&2; exit 2 ;;
esac
