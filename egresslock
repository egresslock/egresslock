#!/usr/bin/env bash
#
# egresslock — restricted egress for untrusted workloads.
#
# Help lives in code: `egresslock --help` (alias `egresslock help`)
# prints the one-page command summary; `egresslock help <command>` prints
# one command's page; `help config` / `help env` are the configuration
# and environment references.
#
# Each restricted profile is a dedicated bridge network with a fixed
# subnet plus a fail-closed nftables policy in the rootless Podman network
# namespace. All rootless bridge networks of this user share ONE rootless
# netns, so every policy rule is scoped with `ip saddr <subnet>` to never
# affect other networks.
#
# The rootless netns (and all nftables state in it) is destroyed when the
# last container stops, so policy is NEVER assumed to persist: `ensure`
# creates the network, starts an anchor container that keeps the netns
# alive, installs/refreshes the policy, and verifies it.

set -euo pipefail

# The user-facing command list — the single source feeding the summary
# index, the short-usage line, and `help` topic validation. A command
# added here also needs a CMD_INDEX line and a help_topic page.
COMMANDS=(ensure verify network proxy-env rules allowlist allowlist-direct denied allow disallow allow-direct disallow-direct allow-host disallow-host drop-unauthorized init list doctor build-gateway teardown)

# EGL-365-D9/EGL-310-D2: the direct-lane shortcut names, the compatibility
# aliases, and the allowlist-direct read shortcut are full dispatch
# citizens (root guard, argv shape, conf resolution; the mutation shortcuts
# also take the account lock) but are not advertised in the summary/usage.
# The primary surface is one verb per direction plus `--direct` (and
# `allowlist [--direct]`).
usage_hidden() { # usage_hidden <command>
    case "$1" in
        allow-direct|disallow-direct|allow-host|disallow-host|allowlist-direct) return 0 ;;
        *) return 1 ;;
    esac
}

# One summary-index line per command (keyed by command; order from
# COMMANDS). Every line is runnable as printed (next-action contract).
declare -A CMD_INDEX=(
    [ensure]='egresslock ensure [--replace-gateway] <profile>     apply the profile, then verify'
    [verify]='egresslock verify <profile>                         check a profile (--ensured: all)'
    [network]='egresslock network <profile>                        print the Podman network name'
    [proxy-env]='egresslock proxy-env <profile> [token]              proxy env vars (--out writes a file)'
    [rules]='egresslock rules <profile>                          print the nftables policy'
    [allowlist]='egresslock allowlist [--direct] <profile>           list the configured proxy or direct entries'
    [allowlist-direct]='egresslock allowlist-direct <profile>  shortcut for allowlist <profile> --direct'
    [denied]='egresslock denied <profile> [--all] [--days N]      show the hosts the gateway denied'
    [allow]='egresslock allow [--direct] <profile> <host...>     allow a destination; --direct skips proxy'
    [disallow]='egresslock disallow [--direct] <profile> <host...>  remove a destination from one path'
    [allow-direct]='egresslock allow-direct <profile> <host:port>   shortcut for allow <host:port> --direct'
    [disallow-direct]='egresslock disallow-direct <profile> <host:port>  shortcut for disallow <host:port> --direct'
    [allow-host]='egresslock allow-host <profile> <host:port>      compatibility alias for allow --direct'
    [disallow-host]='egresslock disallow-host <profile> <host:port>   compatibility alias for disallow --direct'
    [drop-unauthorized]='egresslock drop-unauthorized <profile> <port>       end connections the policy no longer allows'
    [init]='egresslock init <name> [--subnet <cidr>]            write a starter conf + allowlist'
    [list]='egresslock list                                     list the profiles for this account'
    [doctor]='egresslock doctor                                   probe the host environment'
    [build-gateway]='egresslock build-gateway [--force]                  rebuild the gateway image'
    [teardown]="egresslock teardown <profile|all|--runtime>         remove the profile's containers and network"
)

in_commands() { # in_commands <name> — true when <name> is a user command
    local c
    for c in "${COMMANDS[@]}"; do
        [[ "$c" == "$1" ]] && return 0
    done
    return 1
}

usage() {
    # Concise summary: a one-page command index that points at
    # `egresslock help <command>` and the config / env topics. The name
    # is unchanged so error-path call sites keep using it.
    echo "Usage:"
    echo "  egresslock <command> [args...]"
    echo
    echo "egresslock — restricted egress for untrusted workloads."
    echo "Run 'egresslock help <command>' for one command's details, or"
    echo "'egresslock help config' / 'egresslock help env' for the"
    echo "configuration and environment reference."
    echo
    echo "Commands:"
    local c
    for c in "${COMMANDS[@]}"; do
        usage_hidden "$c" && continue
        echo "  ${CMD_INDEX[$c]}"
    done
    echo "  egresslock --help / -h / help                       this list"
    echo "  egresslock --version                                kit stamp (or 'dev')"
}

# Short usage: the command index only (no topics/prose), for a bare
# invocation or an unknown-command/option argument-error. Lists the
# commands so a caller who typed the wrong thing sees what is available.
# The direct-lane shortcuts and compatibility aliases stay hidden
# (EGL-365-D9). The names wrap at 80 columns so the block stays readable
# on a standard terminal.
short_usage() {
    local c line=""
    echo "usage: egresslock <command> [args...]"
    echo "commands:"
    for c in "${COMMANDS[@]}"; do
        usage_hidden "$c" && continue
        if [[ -z "$line" ]]; then
            line="$c"
        elif (( ${#line} + 1 + ${#c} <= 78 )); then
            line="$line $c"
        else
            echo "  $line"
            line="$c"
        fi
    done
    [[ -z "$line" ]] || echo "  $line"
    echo "run 'egresslock help <command>' for one command's details"
}

usage_error_help() { # usage_error_help <cause>
    echo "Error: $1" >&2
    echo "usage: egresslock help [<command>|config|env]" >&2
    echo "run 'egresslock help' for the command list." >&2
}

usage_error_command() { # usage_error_command <cause> <usage line> <help topic>
    echo "Error: $1" >&2
    echo "usage: $2" >&2
    echo "run 'egresslock help $3' for details." >&2
}

# Per-command help: `egresslock help [<topic>]`. Config-free and
# root-safe by construction (the dispatcher routes this like
# --help/--version: no root guard, no conf loading, no resolution
# line). Topics: the commands above plus the reference topics
# `config` (profile configuration + the four-layer checks block)
# and `env` (the operator environment-overrides reference), plus the
# hidden `env test` pair (EGL-410: the test-harness hook census).
cmd_help() {
    # EGL-410: match the `env test` pair before the one-topic check, so
    # every other multi-token input keeps today's message.
    if [[ $# -eq 2 && "$1" == "env" && "$2" == "test" ]]; then
        help_topic "env test"
        return 0
    fi
    if [[ $# -gt 1 ]]; then
        usage_error_help "egresslock help takes at most one topic."
        exit 2
    fi
    local topic="${1:-}"
    if [[ -z "$topic" ]]; then
        usage
        return 0
    fi
    if in_commands "$topic" || [[ "$topic" == "config" || "$topic" == "env" ]]; then
        help_topic "$topic"
        return 0
    fi
    usage_error_help "unknown help topic '$topic'."
    exit 2
}

# One here-doc per topic. Per-command pages follow one template
# (usage lead line, relocated prose, Arguments and flags, Example,
# Exit codes). All text is operator UI: no ticket/process IDs
# (EGL-59 class) on any surface.
help_topic() { # help_topic <topic>
    case "$1" in
        ensure)
            cat <<'EOF'
egresslock ensure [--replace-gateway] <profile>

Bring a profile to its enforced state: create its Podman network,
start the anchor container that keeps the profile's network alive
between runs, start the gateway for a gateway profile, install or
refresh its firewall rules (nftables), and verify the result. An
already-converged profile is left running: healthy containers are
kept and no session is cut.

Arguments and flags:
  <profile>               profile to converge (required)
  --replace-gateway       same as ensure, but replace the running
                          gateway even when it is healthy (sessions
                          drop until the new container answers). Both
                          flag positions are legal; a duplicate flag
                          is a usage error. A missing or
                          checkpoint-annotated target image is refused
                          before the old gateway container is removed —
                          earlier ensure steps (network / anchor / nft /
                          pins) are NOT undone; no rollback.

Example:
  egresslock ensure main

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        verify)
            cat <<'EOF'
egresslock verify <profile>

Verify only: checks that the profile's network, anchor container, and
firewall rules are in place and healthy, plus the gateway container
for a gateway profile. Exit 1 = fail closed —
do not start a workload against a profile that fails verify.

With --ensured (no profile argument) the check aggregates every
profile conf in the default config folder.

Arguments and flags:
  <profile>    profile to verify (required without --ensured)
  --ensured    bare aggregate check over every *.conf; takes no
               profile argument

Example:
  egresslock verify main

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        network)
            cat <<'EOF'
egresslock network <profile>

Print the profile's Podman network name.

Arguments and flags:
  <profile>    profile to look up (required)

Example:
  egresslock network main

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        proxy-env)
            cat <<'EOF'
egresslock proxy-env <profile> [token]

Print proxy environment assignments for the profile. Tokens select a
single value: proxyip | proxyport | noproxy.

The recommended way to write the env file is the bare --out form:
it writes the assignments to a file (mode 0600; default: the account
runtime dir) and prints the real path of that file (directory
symlinks are resolved). Use --out=<path> only as a backup when you
need the file at a specific location; its directory must be writable
only by this account (a group- or world-writable directory is
refused). If you cannot make the directory private,
pass them to podman run with --env KEY=value.

Arguments and flags:
  <profile>            profile (required)
  token                proxyip | proxyport | noproxy
  --out[=<path>]       write the env file and print its path

Example:
  egresslock proxy-env main

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        rules)
            cat <<'EOF'
egresslock rules <profile>

Print the profile's firewall rules (nftables policy).

Arguments and flags:
  <profile>    profile (required)

Example:
  egresslock rules main

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error
EOF
            ;;
        allowlist)
            cat <<'EOF'
egresslock allowlist [--direct] <profile>

Print a profile's configured allowlist entries. With no flag, render
the proxy lane's entries from the profile's allowlist file: comments
and blank lines are stripped and each stored entry prints once, in
file order, under a header naming the lane, the entry count, the
source, and how the names are resolved. An empty file prints the
header with `0 proxy entries` and no rows. An invalid entry fails
closed and names the offending line. With --direct, list the
direct-lane entries configured in the profile conf (one host:port per
`rule allow-host` line, in conf order) under the same header shape —
a read-only view that does not resolve names or change anything.

Arguments and flags:
  <profile>    profile (required)
  --direct     list the configured direct-lane entries instead of the
               proxy-lane entries (before or after <profile>);
               shortcut: egresslock allowlist-direct <profile>

Examples:
  egresslock allowlist main
  egresslock allowlist main --direct

Exit codes:
  0  success
  1  fail closed (the message names the cause)
  2  usage error, or the profile conf cannot be loaded (the message
     names the cause)
EOF
            ;;
        allowlist-direct)
            cat <<'EOF'
egresslock allowlist-direct <profile>

Shortcut for `egresslock allowlist <profile> --direct`: list the
