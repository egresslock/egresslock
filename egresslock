#
# CIDR helpers (ARC-11-D3): unsigned-32 IPv4 math in pure bash, no
# external dependencies. cidr_parse validates and decomposes a CIDR;
# the result is stored in globals (CIDR_*) because bash cannot return
# multiple values.
#
# cidr_parse return codes (designed for `if ! cidr_parse` + case $rc):
#   0 ok | 1 syntax/not IPv4 | 2 prefixlen outside 8-29 | 3 host bits set
#
cidr_u32() { # "A.B.C.D" -> decimal u32 on stdout
    local IFS=. o1 o2 o3 o4
    read -r o1 o2 o3 o4 <<<"$1"
    echo $(( (o1 << 24) | (o2 << 16) | (o3 << 8) | o4 ))
}

cidr_ip() { # decimal u32 -> "A.B.C.D"
    echo "$(( ($1 >> 24) & 255 )).$(( ($1 >> 16) & 255 )).$(( ($1 >> 8) & 255 )).$(( $1 & 255 ))"
}

cidr_parse() { # cidr_parse <A.B.C.D/P>  (prefixlen 8-29, canonical network)
    local cidr="$1" addr plen u32 mask net
    [[ "$cidr" =~ ^([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})/([0-9]{1,2})$ ]] || return 1
    addr="${BASH_REMATCH[1]}"
    plen="${BASH_REMATCH[2]}"
    (( plen >= 8 && plen <= 29 )) || return 2
    cfg_is_ipv4 "$addr" || return 1
    u32="$(cidr_u32 "$addr")"
    mask=$(( 0xFFFFFFFF << (32 - plen) & 0xFFFFFFFF ))
    net=$(( u32 & mask ))
    # Canonical network address required: host bits set is a config error,
    # not a silent re-render (fail closed per ARC-11-D3).
    (( u32 == net )) || return 3
    CIDR_PLEN=$plen
    CIDR_NETWORK=$net
    CIDR_BCAST=$(( net | (0xFFFFFFFF >> plen & 0xFFFFFFFF) ))
    CIDR_FIRST=$(( net + 1 ))   # bridge gateway (DNS allow target)
    CIDR_LAST=$(( CIDR_BCAST - 1 ))  # anchor address
    return 0
}

# True if two parsed CIDRs share any address space (operands: the two
# FIRST/LAST usable ranges; callers keep the parsed values).
cidr_overlaps() { # cidr_overlaps <first1> <last1> <first2> <last2>
    (( $1 <= $4 && $3 <= $2 ))
}

#
# Relaxed parse for FOREIGN networks in the overlap scan (R-011-1
# finding 1): accepts any prefixlen 0-32, canonical or not, and yields
# the occupied range as CIDR_FIRST..CIDR_LAST. Configured profiles
# still go through the strict cidr_parse (8-29, canonical); the scan
# must not silently skip foreign subnets merely because the profile
# policy would reject them.
#
cidr_parse_any() { # cidr_parse_any <A.B.C.D/P>
    local cidr="$1" addr plen u32 mask net
    [[ "$cidr" =~ ^([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})/([0-9]{1,2})$ ]] || return 1
    addr="${BASH_REMATCH[1]}"
    plen="${BASH_REMATCH[2]}"
    (( plen <= 32 )) || return 1
    cfg_is_ipv4 "$addr" || return 1
    u32="$(cidr_u32 "$addr")"
    if (( plen == 0 )); then
        mask=0
    else
        mask=$(( 0xFFFFFFFF << (32 - plen) & 0xFFFFFFFF ))
    fi
    net=$(( u32 & mask ))
    CIDR_FIRST=$net
    CIDR_LAST=$(( net | (0xFFFFFFFF >> plen & 0xFFFFFFFF) ))
    return 0
}

is_profile() {
    local p
    for p in "${PROFILES[@]}"; do
        [[ "$p" == "$1" ]] && return 0
    done
    return 1
}

require_profile() {
    # require_profile <profile> [<command-name>]
    # The command name is used only to give a precise usage line when the
    # profile argument is missing (a missing profile is an argument error,
    # not an unknown-profile error).
    local cmdname="${2:-}"
    if [[ $# -lt 1 || -z "$1" ]]; then
        if [[ -n "$cmdname" ]]; then
            echo "Error: $cmdname requires a profile name." >&2
            echo "usage: egresslock $cmdname <profile>" >&2
        else
            echo "Error: a profile name is required." >&2
            echo "run 'egresslock help' for the command list" >&2
        fi
        exit 2
    fi
    is_profile "$1" || {
        echo "Error: unknown profile '$1' (known: ${PROFILES[*]})" >&2
        exit 2
    }
}

require_nonroot() {
    # ARC-25: fail closed when run as root — root's Podman store/netns is
    # a separate world from every account's. Accounts execute the engine;
    # root only distributes the kit (ARC-7-D5). Escape hatch for
    # intentional root use (not recommended). Shared by the dispatcher's
    # per-command-class arms (ensure…teardown, init, doctor).
    if [[ "${EGRESSLOCK_ALLOW_ROOT:-0}" != "1" && "$(id -u)" == "0" ]]; then
        echo "Error: egresslock must run as the account, not root — root's Podman store/netns is separate from every account's. Use 'sudo -iu <account> -- egresslock ...'." >&2
        exit 1
    fi
}

# EGL-346: account scope appended to the verify-surface `ensure` hints.
# The engine runs as the account (require_nonroot); the root escape hatch
# must never advertise root as a runner.
ensure_scope_suffix() {
    local acct
    if [[ "$(id -u 2>/dev/null || echo 0)" == "0" ]]; then
        printf ' (as the account)'
        return 0
    fi
    acct="$(id -un 2>/dev/null || true)"
    if [[ -z "$acct" ]]; then
        printf ' (as the account)'
    else
        printf ' (as %s)' "$acct"
    fi
}

network_of() { echo "egresslock-$1"; }
anchor_of() { echo "egresslock-anchor-$1"; }
chain_of() { echo "p_${1//-/_}"; }

nft_bin() {
    local bin
    if [[ -n "${NFT_BIN:-}" ]]; then
        # ARC-59-D1: a value that starts with '-' would read as a flag
        # in `podman unshare ... "$(nft_bin)"`. Empty stays the default.
        [[ "$NFT_BIN" == -* ]] && die "NFT_BIN value must not start with '-' (got '$NFT_BIN')"
        [[ -x "$NFT_BIN" ]] || die "NFT_BIN='$NFT_BIN' is not executable"
        bin="$NFT_BIN"
    elif command -v nft >/dev/null 2>&1; then
        bin="$(command -v nft)"
    elif [[ -x /usr/sbin/nft ]]; then
        # /usr/sbin is often missing from a non-root PATH.
        bin=/usr/sbin/nft
    else
        die "nftables not found; install it: sudo apt install nftables"
    fi
    # EGL-378-D6: the resolved binary is the command word of
    # `podman unshare …`, which now execs from / (D1). Absolutize at the
    # engine's recorded relative-path basis ($PWD) so a relative
    # NFT_BIN/PATH entry keeps its invocation-directory meaning.
    case "$bin" in
        /*) printf '%s\n' "$bin" ;;
        *) printf '%s\n' "$PWD/$bin" ;;
    esac
}

netns_nft() {
    local bin
    # Plain assignment so a die() inside nft_bin (ARC-59 env guard)
    # propagates under set -e instead of being swallowed by the
    # inline-command-substitution pattern (same footgun as the
    # gw_generate_config note).
    bin="$(nft_bin)"
    rt_unshare "$bin" "$@"
}

# EGL-139-D2: conntrack seam, parallel to netns_nft. Same privilege
# class as the engine's nft -f (the unshare grants CAP_NET_ADMIN in the
# netns's owning userns); no nat-table access needed (ctnetlink delete
# operates on entries). Resolution mirrors nft_bin exactly: CONNTRACK_BIN
# (same ARC-59 leading-'-' / executable guards), then PATH, then
# /usr/sbin/conntrack (often missing from a non-root PATH).
conntrack_bin() {
    local bin
    if [[ -n "${CONNTRACK_BIN:-}" ]]; then
        # ARC-59-D1: a value that starts with '-' would read as a flag
        # in `podman unshare ... "$(conntrack_bin)"`. Empty stays the default.
        [[ "$CONNTRACK_BIN" == -* ]] && die "CONNTRACK_BIN value must not start with '-' (got '$CONNTRACK_BIN')"
        [[ -x "$CONNTRACK_BIN" ]] || die "CONNTRACK_BIN='$CONNTRACK_BIN' is not executable"
        bin="$CONNTRACK_BIN"
    elif command -v conntrack >/dev/null 2>&1; then
        bin="$(command -v conntrack)"
    elif [[ -x /usr/sbin/conntrack ]]; then
        bin=/usr/sbin/conntrack
    else
        die "conntrack not found; install it: sudo apt install conntrack"
    fi
    # EGL-378-D6: same basis and reason as nft_bin above.
    case "$bin" in
        /*) printf '%s\n' "$bin" ;;
        *) printf '%s\n' "$PWD/$bin" ;;
    esac
}

netns_conntrack() {
    local bin
    # Plain assignment so a die() inside conntrack_bin (ARC-59 env guard)
    # propagates under set -e instead of being swallowed by the
    # inline-command-substitution pattern.
    bin="$(conntrack_bin)"
    rt_unshare "$bin" "$@"
}

# EGL-139-D2 step 2: fail-closed conntrack probe for `disallow-host`,
# run BEFORE the conf mutation (R9: a revocation that cannot prove flow
# severance aborts with nothing changed — no conf edit, no ruleset swap,
# no `removed:`). Named binary resolution plus a cheap in-netns ctnetlink
# probe (-C); a denied/unavailable ctnetlink fails closed here. Explicit
# rc: the caller runs this in a ||-condition where set -e is disabled.
conntrack_probe() {
    local bin out rc=0
    if ! bin="$(conntrack_bin)"; then
        # conntrack_bin already named the resolution failure (its die
        # degrades to a named stderr line + rc 1 in condition context).
        echo "  disallow --direct must prove flow severance after the revocation; nothing was changed." >&2
        return 1
    fi
    # NOTE: capture the rc BEFORE any ! negation — inside a `if !`'s
    # then-branch, $? is the negated status (0), a named bash trap.
    if out="$(rt_unshare "$bin" -C 2>&1)"; then
        :
    else
        rc=$?
    fi
    if (( rc != 0 )); then
        echo "Error: conntrack probe failed in the rootless netns (rc=$rc): ${out:-<no output>}" >&2
        echo "  disallow --direct must prove flow severance after the revocation; nothing was changed." >&2
        echo "  Install the tool and retry: sudo apt install conntrack" >&2
        return 1
    fi
    return 0
}

# EGL-347-D1: a failed probe reports podman's own error and routes by
# signature in a fixed order — the AppArmor shape rule (rc 126 /
# permission denied) with a `cannot chdir to` exclusion, then the netns
# pointer. The checker is the only AppArmor source; no branch asserts
# AppArmor absent, and a stray or manual inherited-CWD line is never
# routed to the checker. Message-only: the probe's behavior and rc are
# unchanged.
netns_probe_failure() { # netns_probe_failure <rc> <captured output>
    local prc="$1" pout="$2"
    echo "Error: podman rootless-netns is broken for this user (probe:" >&2
    echo "  'podman unshare --rootless-netns true', rc=$prc):" >&2
    if [[ -n "$pout" ]]; then
        printf '%s\n' "$pout" | sed 's/^/  /' >&2
    else
        echo "  (probe printed no output)" >&2
    fi
    if { (( prc == 126 )) || grep -qi 'permission denied' <<<"$pout"; } \
        && ! grep -qi 'cannot chdir to' <<<"$pout"; then
        # EGL-347-D1: the doctor's shape rule, one rule for all three
        # surfaces. The checker is the only AppArmor source; this branch
        # routes its whole tri-state (EGL-39 / D39-3).
        echo "Check whether AppArmor is the cause: sudo egresslock-setup apparmor check" >&2
        echo "  If it reports \"podman label: labeled\" and" >&2
        echo "  \"pasta amendment: required on this host\", run:" >&2
        echo "  sudo egresslock-setup apparmor add" >&2
        echo "  If it reports \"podman label: unlabeled\" or" >&2
        echo "  \"pasta amendment: not required ...\", this is not AppArmor:" >&2
        echo "  check the account session — see docs/troubleshooting/pasta-apparmor" >&2
        echo "  If it reports \"condition unknown\", see" >&2
        echo "  docs/troubleshooting/pasta-apparmor (Diagnosis)" >&2
        echo "Then re-run the probe. If it still fails, see" >&2
        echo "docs/troubleshooting/pasta-apparmor" >&2
    else
        # A `cannot chdir to` line is rc 126 and contains "permission
        # denied", but the probe never looked at AppArmor: no claim here.
        echo "Check podman's output above; for shared-netns checks see" >&2
        echo "docs/troubleshooting/netns-inspection" >&2
    fi
    echo "Do NOT reinstall the kit — nothing is installed wrong." >&2
}

# ARC-26-D3: netns preflight. `podman unshare --rootless-netns true`
# hits the shared-netns EPERM: podman SIGTERMs the shared netns's pasta
# holder, and an enforce-mode AppArmor pasta profile denies it (ARC-27).
# Run once per invocation before any network/policy work, in the
# commands that touch the netns (ensure/verify/allow/teardown,
# ARC-26-D1). EGRESSLOCK_SKIP_NETNS_PROBE=1 skips it for the mock
# harness. EGL-78-D1: bounded 5s named failure, never an indefinite
# block; timeout(1) is required (EGL-78-D6) and its absence fails closed.
netns_probe() {
    [[ "${EGRESSLOCK_SKIP_NETNS_PROBE:-0}" == "1" ]] && return 0
    if ! command -v timeout >/dev/null 2>&1; then
        echo "Error: timeout(1) (coreutils) is required for the netns probe but was not found in PATH" >&2
        return 1
    fi
    local prc=0 pout=""
    pout="$(rt_unshare -t 5 true 2>&1)" || prc=$?
    if (( prc == 0 )); then
        return 0
    fi
    if (( prc == 124 )); then
        # EGL-78-D1/D3: bounded probe — a hang is a named failure, not a wedge.
        echo "Error: netns probe timed out after 5s (probe: 'timeout 5 podman unshare --rootless-netns true'); the rootless netns is not answering — check pasta/podman health before retrying" >&2
        return 1
    fi
    netns_probe_failure "$prc" "$pout"
    return 1
}

# EGL-456-D1/D2: the image overrides are test-only hooks. This is the one
# exact predicate (EGL-382 D3 shape): an ignored hook behaves exactly like
# an unset one — production default, no warning, no rc change.
kit_test_mode() { [[ "${EGRESSLOCK_KIT_ALLOW_NON_ROOT:-0}" == 1 ]]; }

# EGL-491-D1/D2: a test-harness hook that is set without the test flag is
# discarded; say so once per name per invocation, on stderr only. The value
# is never echoed and rc/stdout stay unchanged. Call this at the discard
# branch — for the image helpers that is the direct call site, because
# gw_image()/anchor_image() run inside command substitutions and a seen-list
# updated in there would be lost with the subshell.
egl491_warned_hooks=""
egl491_warn_ignored_hook() { # egl491_warn_ignored_hook <name> [value]
    local _name="$1" _value="${2:-}"
    if [[ -z "$_value" ]] || kit_test_mode; then
        return 0
    fi
    case " $egl491_warned_hooks " in
        *" $_name "*) return 0 ;;
    esac
    egl491_warned_hooks+=" $_name"
    echo "Warning: $_name is set but ignored: it is a test-harness override and requires EGRESSLOCK_KIT_ALLOW_NON_ROOT=1; the production default applies." >&2
}

anchor_image() {
    if kit_test_mode && [[ -n "${EGRESSLOCK_ANCHOR_IMAGE:-}" ]]; then
        # ARC-59-D1: a non-empty value that starts with '-' is a
        # flag-shaped token in the `podman run ... "$(anchor_image)"`.
        [[ "$EGRESSLOCK_ANCHOR_IMAGE" == -* ]] \
            && die "EGRESSLOCK_ANCHOR_IMAGE value must not start with '-' (got '$EGRESSLOCK_ANCHOR_IMAGE')"
        echo "$EGRESSLOCK_ANCHOR_IMAGE"
    else
        # EGL-384: no local-image probe — an unpinned local tag must not
        # outrank the pinned fallback (nothing we ship builds such a tag;
        # EGRESSLOCK_ANCHOR_IMAGE is the explicit way to choose an
        # anchor).
        # EGL-66-D2: the fallback is digest-pinned, same discipline as
        # gateway/Containerfile — never a floating third-party tag the
        # engine would pull on demand. Refresh deliberately: pull the
        # tag, confirm the new digest, update here, record it in the
        # ticket. The digest is the multi-arch OCI index digest.
        echo "docker.io/library/alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce"
    fi
}

DNS_SET_MAX=16

resolve_set() { # resolve_set <host> -> the host's IPv4 A set, space-joined
    # EGL-219-D8: rc 0 ALWAYS — empty output when there is no IPv4
    # address, so bare capture calls stay safe under set -euo pipefail;
    # the fail-closed emptiness checks live in resolved_dest and
    # ensure_resolve_pins.
    # Capture first: getent may get SIGPIPE from awk's early exit, and
    # pipefail would turn that into a spurious failure.
    local out
    out="$(getent ahostsv4 "$1" 2>/dev/null || true)"
    # EGL-219-D2: dedupe + deterministic LC_ALL=C sort — the set, not
    # the resolver's RFC-3484 order, is the pin (a resolver reorder is
    # not a change). getent emits one line per address (plus STREAM/
    # DGRAM/RAW repeats; sort -u collapses them).
    local -a addrs=()
    local a
    while IFS= read -r a; do
        [[ -n "$a" ]] && addrs+=("$a")
    done < <(awk '{print $1}' <<<"$out" | LC_ALL=C sort -u)
    if (( ${#addrs[@]} > DNS_SET_MAX )); then
        # D2: a >cap answer truncates with a NAMED stderr note — never
        # silent, never fatal (a host that works under first-A must not
        # start failing). stderr only, so captured stdout
        # (every call site captures) stays clean; D8 rider: the note
        # renders on every truncating call, verify/drift/cmd_rules
        # included, and never changes an exit code.
        echo "note: $1 resolves to ${#addrs[@]} addresses; pinning the first $DNS_SET_MAX (DNS_SET_MAX), sorted" >&2
        addrs=("${addrs[@]:0:DNS_SET_MAX}")
    fi
    echo "${addrs[*]}"
}

resolved_dest() { # resolved_dest <host> -> IPv4 address set (space-joined) for rule emission
    # ARC-12-D1: in verify-pin mode (expected-ruleset build), a missing
    # pin must NOT silently render an empty daddr; fail the verify.
    # Install path (pin mode off): EGL-219-D3 — the address SET from the
    # per-ensure cache (ensure_resolve_pins), with a live resolve_set
    # fallback for the only fresh-process policy_rules caller
    # (cmd_rules); die if unresolvable (fail-closed install unchanged).
    if [[ "$VERIFY_PIN_MODE" == 1 ]]; then
        local dip
        dip="$(resolve_pin "$1")"
        [[ -n "$dip" ]] || die "verify: no live pin for direct rule '$1' (chain/config mismatch)"
        echo "$dip"
    else
        local dip="${RESOLVED_SETS[$1]:-}"
        [[ -n "$dip" ]] || dip="$(resolve_set "$1")"
        [[ -n "$dip" ]] || die "cannot resolve $1"
        echo "$dip"
    fi
}

#
# ARC-11-D1/D2 overlap pre-check: fail `ensure` closed when the profile's
# subnet overlaps any OTHER Podman network this user can see. Scope is
# Podman-visible networks only (this user's rootless store): other
# accounts' netns and host/LAN routes are invisible by design (the
# existing single-rootless-user threat-model item; see `doctor`/docs for
# host-level checks). Runs on both the create path and the
# exists-and-matches path — a colliding network created later is still a
# fail-closed ensure.
#
ensure_no_overlap() {
    local profile="$1" net want name info sub
    net="$(network_of "$profile")"
    want="${PROFILE_SUBNET[$profile]}"
    cidr_parse "$want" || die "invalid subnet '$want' for profile '$profile'"
    local wfirst=$CIDR_FIRST wlast=$CIDR_LAST
    local names
    # ARC-67-D3: a failed list must disable the overlap pre-check
    # LOUDLY, never silently (the {{.Names}} template bug made this
    # scan vacuous on real hosts for its whole life).
    if ! names="$(podman_network_names 2>&1)"; then
        die "cannot list Podman networks; the subnet-overlap pre-check cannot run (fail closed): $names"
    fi
    for name in $names; do
        [[ "$name" == "$net" ]] && continue
        info="$(rt_network_inspect "$name" 2>/dev/null || true)"
        while IFS= read -r sub; do
            [[ -n "$sub" ]] || continue
            # Relaxed parse (any prefixlen): a foreign subnet the profile
            # policy would reject (e.g. a /30 inside the profile's /24)
            # is still a collision and must fail ensure, not be skipped.
            if cidr_parse_any "$sub" \
               && cidr_overlaps "$wfirst" "$wlast" "$CIDR_FIRST" "$CIDR_LAST"; then
                die "profile subnet ${want} overlaps existing Podman network '$name' (subnet ${sub}); overlapping routes in one rootless netns are never benign. Pick a different subnet in the profile config, or remove the colliding network if it is a leftover:
  podman network rm '$name'"
            fi
        done < <(grep -oE '"subnet": *"[^"]+"' <<<"$info" | sed -E 's/"subnet": *"([^"]+)"/\1/')
    done
}

ensure_network() {
    local profile="$1" net want info want_gw
    net="$(network_of "$profile")"
    want="${PROFILE_SUBNET[$profile]}"
    ensure_no_overlap "$profile"
    # Re-parse OUR subnet here: ensure_no_overlap parses foreign subnets
    # too, and the CIDR_* result globals are single-assignment scratch.
    cidr_parse "$want" || die "invalid subnet '$want' for profile '$profile'"
    want_gw="$(cidr_ip "$CIDR_FIRST")"
    # EGL-515 D3: the existence probe and the config read are the same
    # back-to-back inspect in this window; one result answers both. A
    # failed read still means "no usable existing network" and falls
    # through to create, exactly as the old existence probe did.
    if info="$(rt_network_inspect "$net" 2>/dev/null)"; then
        # Reviews R-003-3/R-003-4: an existing network is only acceptable
        # when its configuration matches this profile's fixed IPv4-only
        # definition EXACTLY — one subnet (the fixed one), nothing else.
        # A second subnet would put part of the container traffic outside
        # the scoped policy rules. Fail closed with a remediation hint.
        # R-003-7 finding 4: the policy depends on the rootless BRIDGE
        # forward path; a same-name macvlan/ipvlan/plugin network with
        # the expected subnet would bypass it entirely.
        if ! grep -qE '"driver": *"bridge"' <<<"$info"; then
            die "network '$net' exists but is not a bridge network; restricted profiles require driver bridge. Remove and recreate it:
  podman network rm '$net' && egresslock ensure '$profile'"
        fi
        local subnet_count
        subnet_count="$(grep -cE '"subnet": *"' <<<"$info" || true)"
        if [[ "$subnet_count" != 1 ]]; then
            die "network '$net' exists with $subnet_count subnets; restricted
profiles require exactly one (${want}). Remove and recreate it:
  podman network rm '$net' && egresslock ensure '$profile'"
        fi
        if ! grep -qE "\"subnet\": *\"${want}\"" <<<"$info"; then
            die "network '$net' exists with a different subnet than the fixed
profile configuration (${want}). Remove and recreate it:
  podman network rm '$net' && egresslock ensure '$profile'
(or inspect it with: podman network inspect '$net')"
        fi
        # The policy rules assume the standard bridge gateway (the FIRST
        # usable address of the subnet, ARC-11-D3); a different gateway
        # would break the DNS allow.
        if ! grep -qE "\"gateway\": *\"${want_gw}\"" <<<"$info"; then
            die "network '$net' exists with an unexpected gateway (expected ${want_gw}); the policy rules assume it. Remove and recreate it:
  podman network rm '$net' && egresslock ensure '$profile'"
        fi
        if grep -qE '"ipv6_enabled": *(true|True)' <<<"$info"; then
            die "network '$net' exists with IPv6 enabled; restricted profiles
are IPv4-only. Remove and recreate it:
  podman network rm '$net' && egresslock ensure '$1'"
        fi
        return 0
    fi
    # Pass the gateway explicitly so Netavark cannot pick anything but
    # the first usable address the policy rules assume (ARC-11-D3).
    rt_network_create "$net" "$want" "$want_gw" >/dev/null
    echo "created network $net ($want)"
}

anchor_running() {
    # Capture ps output before grepping: 'grep -q' exits on the first
    # match and SIGPIPEs the writer, which pipefail reports as failure.
    local names
    names="$(rt_ps 2>/dev/null || true)"
    grep -qx "$1" <<<"$names"
}

# EGL-391-D3: the post-apply disclosure's own liveness observation.
# `anchor_running` keeps its engine-wide boolean contract (an rt_ps
# error is an empty list for the ensure/verify liveness checks); this
# helper keeps the third state so a failed container list never selects
# a "not running" string in the disclosure.
ensure_pin_holder_observe() { # ensure_pin_holder_observe <anchor> -> running|not-running|unknown
    local names
    if ! names="$(rt_ps 2>/dev/null)"; then
        echo unknown
    elif grep -qx "$1" <<<"$names"; then
        echo running
    else
        echo not-running
    fi
}

# ARC-67-D1: real podman's `network ls` template field is {{.Name}}
# (singular) — {{.Names}} is the podman ps CONTAINER field and errors
# on network ls. One helper so the format string cannot drift; the
# failure policy is the caller's (ARC-67-D3): ensure dies (the ARC-11
# overlap check must not be silently disabled), init dies with the same
# diagnosis (EGL-383), teardown --runtime notes and continues.
podman_network_names() {
    rt_network_ls
}

# ---------------------------------------------------------------------------
# EGL-206 (CVE-2026-94603 / GHSA-2cvf-wqm6-wr9g): on affected Podman
# ranges (4.4.0–5.8.7, 6.x before 6.1.3) an image carrying the
# annotation `io.podman.annotations.checkpoint.runtime.name` is
# interpreted as a container checkpoint and `podman run` silently
# ignores --cap-drop=all and --security-opt=no-new-privileges. Podman
# ships no automatic rejection; the upstream workaround is refusing such
# images. Two fail-closed named guards: D2a refuses a checkpoint-
# annotated kit image before every kit-owned run; D2b asserts the LIVE
# hardening state at start and on verify, read from the container's PID
# 1 (`/proc/1/status` via rt_exec), not from `podman inspect` (which
# reports what was requested, not what was applied).

# D2a: image-level annotation oracle, run on the RESOLVED image about to
# `rt_run` (covers the EGRESSLOCK_*_IMAGE overrides; the anchor fallback
# is digest-pinned). Empty/missing key = pass; any
# non-empty value = refuse.
# R-EGL-206-2 #1: a missing image does NOT fail at rt_run — `podman run`
# pulls it on demand. So: exist-check first; a missing ANCHOR image
# (mode "pull-missing") is pulled here before the inspect, keeping the
# refusal preventative on first-create; a failed pull dies named. The
# GATEWAY keeps the missing-image die: its image is locally built by
# `build-gateway`, never pulled, and ensure_gateway names that path.
refuse_checkpoint_image() { # refuse_checkpoint_image <image> <label> [pull-missing]
    local img="$1" label="$2" ann
    if ! rt_image_exists "$img" 2>/dev/null; then
        if [[ "${3:-}" != "pull-missing" ]]; then
            die "$label image '$img' is missing from the local store (checkpoint-annotation preflight, CVE-2026-94603, fail closed); provide a local image that is not checkpoint-annotated"
        fi
        rt_image_pull "$img" >/dev/null 2>&1 \
            || die "$label image '$img' is not in the local store and pulling it failed (checkpoint-annotation preflight, CVE-2026-94603, fail closed); pull it manually ('podman pull $img') and re-run ensure"
    fi
    if ! ann="$(rt_image_inspect "$img" '{{index .Annotations "io.podman.annotations.checkpoint.runtime.name"}}' 2>/dev/null)"; then
        die "$label image '$img' could not be inspected for the checkpoint annotation (CVE-2026-94603, fail closed); provide an image that is not checkpoint-annotated"
    fi
    [[ -z "$ann" ]] \
        || die "$label image '$img' carries the container-checkpoint annotation 'io.podman.annotations.checkpoint.runtime.name' — Podman can interpret it as a checkpoint and silently discard requested sandbox flags such as --cap-drop=all (CVE-2026-94603 / GHSA-2cvf-wqm6-wr9g); refusing to run it. Replace the image (upstream workaround: reject images carrying the checkpoint annotation)"
}

# D2b: live-hardening oracle. Reads PID 1's status in the container and
# reports one token: ok | caps:<CapEff> | nnp:<value> |
# unreadable:<why>. Parse CapEff only — CapBnd/CapPrm/CapInh stay
# non-zero under --cap-drop=all, so asserting them would fail every
# healthy start. PID 1 carries the launch-time property. Unreadable
# exec/parse is a named state, never a skip (map R1); override images
# must provide `cat`.
kit_caps_state() { # kit_caps_state <container>
    local st caps nnp
    if ! st="$(rt_exec "$1" cat /proc/1/status 2>/dev/null)" || [[ -z "$st" ]]; then
        echo "unreadable:podman exec cat /proc/1/status failed or returned no output"
        return 0
    fi
    caps="$(awk '/^CapEff:/{print $2; exit}' <<<"$st")"
    nnp="$(awk '/^NoNewPrivs:/{print $2; exit}' <<<"$st")"
    if [[ -z "$caps" || -z "$nnp" ]]; then
        echo "unreadable:CapEff/NoNewPrivs lines missing from /proc/1/status"
        return 0
    fi
    if [[ ! "$caps" =~ ^0+$ ]]; then
        echo "caps:$caps"
        return 0
    fi
    if [[ "$nnp" != "1" ]]; then
        echo "nnp:$nnp"
        return 0
    fi
    echo "ok"
}

# One named fail-closed message per state, shared by the ensure dies
# and the verify echoes (same words on both paths, map R1).
kit_caps_problem_msg() { # kit_caps_problem_msg <label> <container> <state>
    local label="$1" ctr="$2" st="$3"
    case "$st" in
        caps:*)
            echo "$label container '$ctr' CapEff is '${st#caps:}' (expected all-zero) — the launch-time --cap-drop=all did not take effect (CVE-2026-94603 flag-discard class); replace the container/image" ;;
        nnp:*)
            echo "$label container '$ctr' NoNewPrivs is '${st#nnp:}' (expected 1) — the launch-time --security-opt=no-new-privileges did not take effect (CVE-2026-94603 flag-discard class); replace the container/image" ;;
        *)
            echo "$label container '$ctr' hardening state unreadable (${st#unreadable:}) — failing closed (CVE-2026-94603); override images must provide 'cat' for the /proc/1/status read" ;;
    esac
}

# Start-path assertion (ensure_*): die named on any non-ok state.
# EGL-208: the assert runs after rt_run may have started a
# --restart=always container, so a bare die would leave a possibly-wrong
# hardening state alive — on the gateway, under the live policy's
# fixed-IP+MAC egress exemption (EGL-123-D3). Force-remove it (rm -f
# defeats the restart policy and frees name/IPAM) BEFORE dying. The
# verify verbs call kit_caps_problem_msg directly and stay read-only.
assert_kit_caps() { # assert_kit_caps <container> <label>
    local st problem rmerr
    st="$(kit_caps_state "$1")"
    [[ "$st" == "ok" ]] && return 0
    problem="$(kit_caps_problem_msg "$2" "$1" "$st")"
    # `if !` keeps set -e from exiting before the failure is named; the
    # capture keeps the runtime's removed-name echo out of the output.
    if ! rmerr="$(rt_rm "$1" 2>&1)"; then
        die "$problem; removal failed: $rmerr — container '$1' could not be removed and may still be running; remove it manually: 'podman rm -f $1'"
    fi
    die "$problem; removed container '$1' (rm -f)"
}

# EGL-217: family-wide ensure-failure cleanup — the EXIT-trap body armed
# by cmd_ensure. The wait-for-running/healthy dies and the no-die set -e
# exits (raw rt_run failure, rule-gen rc 1) sit before or outside
# assert_kit_caps and can leave this run's --restart=always container
# behind — on the gateway, running-but-unhealthy under the live policy's
# fixed-IP+MAC egress exemption. Ownership (Q5): remove ONLY containers
# this run started/replaced (R1) or restarted via the config apply (R2),
# never a pre-existing healthy pair on an unrelated failure (a full
# sweep would turn a failed refresh into an outage). Skip a name no
# longer registered (already removed, never created, or recycled by
# ensure_gateway) — this also suppresses EGL-208's double-removal
# report. set -e-safe (`if !`, `|| continue`), never die/exit, and never
# alters the failing rc.
ensure_cleanup() { # ensure_cleanup <rc> — EXIT-trap body; armed by cmd_ensure
    local rc="$1" names n rmerr
    # Belt behind the disarm: a success exit never cleans up.
    [[ "$rc" == 0 ]] && return 0
    [[ -n "$ENSURE_OWNED" ]] || return 0
    # EGL-460-D5: a failure in the direct-lane flush step (inside
    # cmd_ensure, after the nft swap and pin write) owns no container
    # rollback. The ensure trap is still needed for a later gateway
    # failure (D3), so keep it armed; only this step's window skips the
    # removal. Today's out-of-ensure flush failure was disclose-only and
    # the containers stayed — moving the kill must not delete the
    # this-run anchor after a successful swap.
    (( DISALLOW_HOST_FLUSH_STEP )) && return 0
    # Registered-container oracle: rt_ps all (podman ps -a) lists
    # registered-but-not-running containers too. A failed probe (wedged
    # runtime) attempts removal anyway — fail closed on an exempt
    # container; a "could not be removed" line for an absent name is the
    # honest side of that trade.
    if ! names="$(rt_ps all 2>/dev/null)"; then
        names="$ENSURE_OWNED"
    fi
    for n in $ENSURE_OWNED; do
        grep -qx "$n" <<<"$names" || continue
        if ! rmerr="$(rt_rm_retry "$n" 2>&1)"; then
            # EGL-318: a failed diagnostic write must not abort the
            # handler (belt behind ensure_exit_trap's set +e).
            echo "cleanup: removal failed: $rmerr — container '$n' could not be removed and may still be running; remove it manually: 'podman rm -f $n'" >&2 || true
        else
            # EGL-318: record BEFORE the write so a failed write cannot
            # lose the S1T evidence.
            ENSURE_REMOVED="${ENSURE_REMOVED:+$ENSURE_REMOVED }$n"
            echo "removed container '$n' (rm -f)" >&2 || true
        fi
    done
}

ensure_exit_trap() { # ensure_exit_trap <rc> — EXIT trap: cleanup, then the EGL-305/EGL-389/EGL-391 disclosures
    local rc="$1"
    set +e
    ensure_cleanup "$rc"
    disallow_host_failure_disclose "$rc"
    disallow_proxy_failure_disclose "$rc"
    # EGL-391: after the lane-specific recovery lines, disclose a
    # post-apply / pre-pin-completion failure state-true.
    ensure_pin_state_disclose "$rc"
    return 0
}

# EGL-391-D3: post-apply / pre-pin-completion disclosure. A successful
# nft -f is a past event, not proof the netns is still live; this run
# may have failed before the pin record was updated. Only a run that
# applied nft and did not commit the record qualifies (a pre-swap
# failure stays silent). Probe the holder container; only when it is
# running, one chain read classifies present / absent / read failed.
# Never dies, never alters the pending rc, never prints a next-action
# command inside a disallow lane (its own recovery instructions lead and
# a plain ensure there would contradict them).
ensure_pin_state_disclose() { # ensure_pin_state_disclose <rc> — cmd_ensure EXIT trap body
    local rc="$1" profile state anchor holder out line
    (( rc == 0 )) && return 0
    (( ENSURE_POLICY_SWAPPED )) || return 0
    (( ENSURE_PIN_COMMITTED )) && return 0
    profile="${ENSURE_PIN_PROFILE:-}"
    [[ -n "$profile" ]] || return 0
    anchor="$(anchor_of "$profile")"
    # EGL-391-D3: disclosure-local tri-state observer (EGL-389 shape).
    # `anchor_running` keeps its boolean liveness contract for
    # ensure/verify; a failed listing here must not select a
    # "not running" string.
    holder="$(ensure_pin_holder_observe "$anchor")"
    case "$holder" in
        unknown)
            state="firewall presence could not be read (holder container state unknown)" ;;
        not-running)
            state="firewall not proved live (holder container not running)" ;;
        *)
            if out="$(netns_nft list chain inet "$TABLE" "$(chain_of "$profile")" 2>&1)"; then
                state="firewall rules are present (holder container running)"
            elif [[ "$out" == *"No such file or directory"* ]]; then
                state="firewall chain absent (holder container running)"
            else
                state="firewall presence could not be read (holder container running)"
            fi ;;
    esac
    line="ensure: this run applied new firewall rules for profile '$profile' but did not update the pin record (the stored list of allowed addresses) — state: $state; the pin record may not match — note: a later \"egresslock verify $profile\" names a pin-record mismatch if the stored list differs, and can pass if the stored pins already match or the profile has no allow-hosts"
    if [[ -z "$DISALLOW_HOST_CTX" && -z "$DISALLOW_PROXY_CTX" ]]; then
        line+=" — next action: fix the underlying failure, then inspect and re-run: egresslock ensure $profile"
    fi
    echo "$line" >&2 || true
    return 0
}

# EGL-305: disallow-host partial-failure recovery. Runs from the
# cmd_ensure EXIT trap (every failure form) and from cmd_disallow_host's
# trap while the delete is committed (EGL-305-D6). Acts only while a
# disallow-host mutation is in flight (DISALLOW_HOST_CTX armed) and only
# after the conf delete is committed (CONF_DELETED_COMMITTED=1; earlier
# failures stay silent). Never dies, never alters the pending rc, never
# prints `removed:`. Post-swap (ENSURE_POLICY_SWAPPED=1): the ruleset
# dropped the target accept but conntrack was not proven clean — disclose
# the partial state and print `drop-unauthorized`. Pre-swap: restore the
# deleted conf rule (S1) or, if that fails, name the partial state and
# the recovery commands (S2 + S2w warning). EGL-354: cmd_disallow_host
# keeps this trap armed through the final post-swap reconcile, so a
# reconcile failure (EGL-311 S1/S2, the S6 enumerate read, or a survivor
# witness) also prints the post-swap disclosure.
disallow_host_failure_disclose() { # disallow_host_failure_disclose <rc> — acts only in a disallow-host window
    local rc="$1" gw_state gwname
    [[ -n "$DISALLOW_HOST_CTX" ]] || return 0
    # EGL-305-D6: with the pre-delete arm (the cmd_disallow_host EXIT
    # trap), a non-zero CONF_DELETED_COMMITTED means nothing was mutated
    # yet — the pre-mutation failures stay silent (leg L6). EGL-480-D2:
    # the pending-revocation record was written before the delete, so
    # the not-committed path unwinds it die-free and silently.
    if [[ "$CONF_DELETED_COMMITTED" != 1 ]]; then
        revoke_pending_unwind
        return 0
    fi
    if (( ENSURE_POLICY_SWAPPED )); then
        # EGL-460-D3: a failure after the conntrack proof (the flush step
        # proved gone the revoked flows this run could observe) owes the
        # kill-done disclosure — never the (f1-ii) "conntrack not proven
        # clean" state, which would tell the operator the kill failed.
        # R-EGL-460-3 F3 (maintainer 2026-11-05): the claim is scoped to
        # what this run could observe (the accepted EGL-332/EGL-348
        # unconfirmed-packet boundary is unchanged), and
        # drop-unauthorized is named as the safe, scoped recovery for a
        # flow believed to have survived rather than prohibited — the
        # accepted-set read happens before verify_policy, so a chain
        # that changed during the run can make the kill miss a flow.
        # R-EGL-460-3 F5: the gateway fact is this run's own
        # verification result, so a failure after verify_gateway does
        # not claim an unverified gateway.
        # R-EGL-460-6 F7: cleanup has already run in ensure_exit_trap
        # when this helper is called; when it removed the gateway this
        # run verified, say so instead of describing a container that is
        # no longer running. Only the gateway fact carries the cleanup
        # qualifier.
        if (( ENSURE_GATEWAY_VERIFIED )); then
            gwname="$(gw_name "$DISALLOW_HOST_CTX")"
            if [[ " $ENSURE_REMOVED " == *" $gwname "* ]]; then
                gw_state="gateway verified, then removed by this run's cleanup"
            else
                gw_state="gateway verified"
            fi
        else
            gw_state="gateway not verified"
        fi
        # EGL-460-D6: the disclosure ladder claims only what the run
        # proved. (f1-ii) = no early proof; A = early proof but policy
        # unverified; B = policy verified but confirmation incomplete;
        # confirmed = the post-verification confirmation returned clean.
        if (( DISALLOW_HOST_KILL_PROVEN )); then
            echo "disallow --direct: the rule is out of the firewall and this run ended the connections it could observe were no longer allowed — state: conf line removed, ruleset swapped, conntrack check clean for the connections this run could observe, $gw_state; next action: fix the failure above, then run: egresslock ensure $DISALLOW_HOST_CTX; if a connection the policy no longer allows is believed to have survived, end it after that ensure with: egresslock drop-unauthorized $DISALLOW_HOST_CTX $DISALLOW_HOST_PORT (drops the connections on port $DISALLOW_HOST_PORT the policy no longer allows, keeps the connections the policy still allows, then checks none remain; safe to run again)" >&2
        elif (( DISALLOW_HOST_POLICY_VERIFIED )); then
            echo "disallow --direct: the revocation is unconfirmed — the rule is out of the firewall and the policy is verified, but this run did not prove the connections it could observe were ended — state: conf line removed, ruleset swapped and policy verified, $gw_state; next action: fix the failure above, then run: egresslock ensure $DISALLOW_HOST_CTX; if a connection the policy no longer allows is believed to have survived, end it after that ensure with: egresslock drop-unauthorized $DISALLOW_HOST_CTX $DISALLOW_HOST_PORT (drops the connections on port $DISALLOW_HOST_PORT the policy no longer allows, keeps the connections the policy still allows, then checks none remain; safe to run again)" >&2
        elif (( DISALLOW_HOST_FLUSH_PROVEN )); then
            echo "disallow --direct: the revocation is unverified — the config line is removed and the firewall was swapped, but the policy was not verified, so the rule may still be in the firewall and the connections this run could observe are not proven ended — state: conf line removed, ruleset swapped but not verified, $gw_state; next action: fix the failure above, then run: egresslock ensure $DISALLOW_HOST_CTX; if a connection the policy no longer allows is believed to have survived, end it after that ensure with: egresslock drop-unauthorized $DISALLOW_HOST_CTX $DISALLOW_HOST_PORT (drops the connections on port $DISALLOW_HOST_PORT the policy no longer allows, keeps the connections the policy still allows, then checks none remain; safe to run again)" >&2
        else
            echo "disallow --direct: the revocation is only half done — the rule is out of the firewall, but the connections that were open were not ended — state: conf line removed, ruleset swapped, conntrack not proven clean; next action: end the leftover connections: egresslock drop-unauthorized $DISALLOW_HOST_CTX $DISALLOW_HOST_PORT (drops the connections on port $DISALLOW_HOST_PORT the policy no longer allows, keeps the connections the policy still allows, then checks none remain; safe to run again)" >&2
        fi
    elif conf_restore_allow_host "$DISALLOW_HOST_CONF"; then
        echo "disallow --direct: nothing was revoked — the reinstall failed before the policy was replaced and the rule was put back — state: rule restored, ruleset not replaced (the rule is back in the config; the revocation ended no connection) — next action: fix the underlying failure, then retry: egresslock disallow $DISALLOW_HOST_CTX $DISALLOW_HOST_HOST:$DISALLOW_HOST_PORT --direct" >&2
        # EGL-480-D2: the rule is back, so the revocation did not commit —
        # restore the record's prior line (or drop its entry); die-free.
        revoke_pending_unwind
        if [[ " $ENSURE_REMOVED " == *" $(anchor_of "$DISALLOW_HOST_CTX") "* ]]; then
            echo "disallow --direct: note: the failed reinstall removed containers it had started for profile '$DISALLOW_HOST_CTX' — if the profile is not running now, start it again: egresslock ensure $DISALLOW_HOST_CTX" >&2 || true
        fi
    else
        echo "disallow --direct: nothing was revoked — the reinstall failed before the policy was replaced, and the rule could not be put back — state: config line removed, ruleset not replaced (the revocation ended no connection) — next action: fix the underlying failure, then put the rule back and retry: egresslock allow $DISALLOW_HOST_CTX $DISALLOW_HOST_HOST:$DISALLOW_HOST_PORT --direct, then egresslock disallow $DISALLOW_HOST_CTX $DISALLOW_HOST_HOST:$DISALLOW_HOST_PORT --direct" >&2
        echo "disallow --direct: warning: a pending-revocation record is in place, so a plain 'egresslock ensure $DISALLOW_HOST_CTX' will finish the revocation (it removes the rule from the firewall and ends the connections the policy no longer allows). To abort instead, restore the rule first (the allow command above)." >&2
    fi
    # R-EGL-397-5 F4: the pre-delete copy has served its purpose (restored
    # or the S2 partial state is disclosed). Drop it; die-free.
    conf_deleted_preimage_cleanup
    return 0
}

# EGL-389: restore the proxy disallow source pre-image with one bounded
# retry. A same-directory rename puts the exact inode (hard link) or the
# exact symlink back — never a temp+rewrite, which would need space and
# could re-serialize the operator's file. The destination must be a leaf:
# restore succeeds only when the rename leaves a file or a symlink at
# $src. A directory (or any other non-file/non-symlink) at $src is a
# host-level failure — do not move the backup into it (R-EGL-389-2 F1);
# the backup is retained. Runs from the EXIT trap: die-free, rc only.
disallow_proxy_restore_source() { # disallow_proxy_restore_source <src> <backup> -> rc
    local src="$1" backup="$2" i
    [[ -e "$backup" || -L "$backup" ]] || return 1
    for i in 1 2; do
        if [[ -e "$src" && ! -f "$src" && ! -L "$src" ]]; then
            (( i == 1 )) && sleep 0.5
            continue
        fi
        # `-T` renames onto $src itself instead of treating it as a
        # directory to move into — a plain `mv -f` dereferences a
        # symlink-to-directory destination. Success is the post-state,
        # not `mv`'s exit status: the backup is this run's same-directory
        # hard link and the restore renames it, so once the backup is
        # gone and a file or symlink is at $src the pre-image is back —
        # even when the rename landed and then returned nonzero
        # (EGL-473). A failed mv that retains the backup leaves the
        # rewritten file at $src, which must not read as a restore.
        # `|| true` keeps the probe independent of the caller's errexit.
        mv -T -f "$backup" "$src" 2>/dev/null || true
        if [[ ! -e "$backup" && ! -L "$backup" ]] \
            && [[ -f "$src" || -L "$src" ]]; then
            return 0
        fi
        (( i == 1 )) && sleep 0.5
    done
    return 1
}

# EGL-389-D7: the disclosure's own liveness observation. gw_running keeps
# its engine-wide contract (an rt_ps error is an empty list for the health
# loops); this helper keeps the third state so a failed container list
# never selects a "not running" string in a failure disclosure.
disallow_proxy_gw_observe() { # disallow_proxy_gw_observe <gwname> -> running|not-running|unknown
    local names
    if ! names="$(rt_ps 2>/dev/null)"; then
        echo unknown
    elif grep -qx "$1" <<<"$names"; then
        echo running
    else
        echo not-running
    fi
}

# EGL-389-D7: registration oracle for the committed owned branch — S-P3n
# is chosen only when the name is provably not registered (the EGL-217
# cleanup skipped it). A failed list is unknown, never "absent".
disallow_proxy_gw_registered() { # disallow_proxy_gw_registered <gwname> -> registered|absent|unknown
    local names
    if ! names="$(rt_ps all 2>/dev/null)"; then
        echo unknown
    elif grep -qx "$1" <<<"$names"; then
        echo registered
    else
        echo absent
    fi
}

# EGL-389: proxy-lane disallow partial-failure recovery. Runs from the
# cmd_ensure EXIT trap (after ensure_cleanup, so ENSURE_REMOVED is
# populated) and from cmd_disallow's own trap for a failure between the
# rewrite and cmd_ensure. Acts only while a proxy mutation is in flight
# and only after the atomic rewrite landed; earlier failures stay silent.
# Pre-activation: restore the source pre-image by rename (one retry) and
# disclose that nothing was revoked. A restore failure leaves a healthy
# pre-existing gateway serving and names the split (S-P2 + S-P2w); an
# owned gateway that survived the failed cleanup (S-P2s running, or the
# state-unknown variant) also carries S-P2w — under EGL-394 a plain
# `ensure` would reload it and may leave established tunnels alive.
# committed: never restore, name the state and `ensure`. Branch
# predicates are state-true against ENSURE_OWNED/ENSURE_REMOVED and the
# D7 ternary observation (running / not running / unknown); a failed
# container list never selects a "not running" string. Every removal line
# names the container. Never dies, never alters rc, never prints
# `removed:`.
disallow_proxy_failure_disclose() { # disallow_proxy_failure_disclose <rc> — acts only in a disallow-proxy window
    local rc="$1"
    [[ -n "$DISALLOW_PROXY_CTX" ]] || return 0
    [[ "$DISALLOW_PROXY_COMMITTED" == 1 ]] || return 0
    local profile="$DISALLOW_PROXY_CTX" src="$DISALLOW_PROXY_SRC" backup="$DISALLOW_PROXY_BACKUP"
    local entries="${DISALLOW_PROXY_ENTRIES:-}" gwname anchor obs
    gwname="$(gw_name "$profile")"
    anchor="$(anchor_of "$profile")"
    obs="$(disallow_proxy_gw_observe "$gwname")"
    # EGL-394: every restore-failure state whose next action is a plain
    # `ensure` while a gateway may still be serving the removed entries
    # must carry the surviving-session disclosure: a plain ensure now
    # applies the removal by reloading, so established tunnels may stay.
    local sp2w="disallow: warning: a plain 'egresslock ensure $profile' will apply the removal from $src by reloading the running gateway — established proxied sessions to those destinations may keep running until they close; restore the entries first if that was not the intent. To drop those sessions (this drops every proxied session on the profile), run: egresslock ensure --replace-gateway $profile."
    if [[ "${GW_APPLY_UNKNOWN:-0}" == 1 ]]; then
        # EGL-395 S-P4: the rename outcome was not provable. Never claim
        # the old policy is still live and never claim the removal was
        # revoked. Proven container states stay distinct; every running
        # or indeterminate state uses one state-true variant, keyed on
        # the container-state observation, not on ENSURE_OWNED.
        local sp4="disallow: the reinstall could not confirm whether the new configuration was published — state: the requested entries are no longer in $src;"
        local sp4_next="next action: inspect the gateway, then either put the entries back and retry: egresslock allow $profile $entries; egresslock disallow $profile $entries, or keep the removal and apply it: egresslock ensure $profile — a plain ensure applies the removal by reloading the running gateway, so established proxied sessions to those destinations may keep running until they close; to drop those sessions (this drops every proxied session on the profile), run: egresslock ensure --replace-gateway $profile"
        if [[ " $ENSURE_REMOVED " == *" $gwname "* ]]; then
            echo "$sp4 gateway container '$gwname' was removed (it is not serving anything) — next action: inspect the gateway, then apply the current configuration: egresslock ensure $profile" >&2
        elif [[ "$obs" == not-running ]]; then
            echo "$sp4 gateway container not running — next action: inspect the gateway, then apply the current configuration: egresslock ensure $profile" >&2
        elif [[ "$obs" == unknown ]]; then
            echo "$sp4 the deployed configuration may or may not have been replaced; the gateway container state could not be determined; the previous configuration may still be active — $sp4_next" >&2
        else
            echo "$sp4 the deployed configuration may or may not have been replaced; the previous configuration may still be active — $sp4_next" >&2
        fi
    elif [[ "${GW_APPLY_COMMITTED:-0}" != 1 ]]; then
        if disallow_proxy_restore_source "$src" "$backup"; then
            if [[ " $ENSURE_REMOVED " == *" $gwname "* ]]; then
                echo "disallow: nothing was revoked — the reinstall failed before the new allowlist was applied and the allowlist was put back — state: allowlist restored; gateway container '$gwname' removed by the failed apply's cleanup (connections through it ended) — next action: fix the underlying failure, then retry: egresslock disallow $profile $entries" >&2
            elif [[ "$obs" == running ]]; then
                echo "disallow: nothing was revoked — the reinstall failed before the new allowlist was applied and the allowlist was put back — state: allowlist restored; gateway container running — next action: fix the underlying failure, then retry: egresslock disallow $profile $entries" >&2
            elif [[ "$obs" == unknown ]]; then
                echo "disallow: nothing was revoked — the reinstall failed before the new allowlist was applied and the allowlist was put back — state: allowlist restored; gateway container state could not be determined — next action: fix the underlying failure, then retry: egresslock disallow $profile $entries" >&2
            else
                echo "disallow: nothing was revoked — the reinstall failed before the new allowlist was applied and the allowlist was put back — state: allowlist restored; gateway container not running — next action: fix the underlying failure, then retry: egresslock disallow $profile $entries" >&2
            fi
        elif [[ " $ENSURE_REMOVED " == *" $gwname "* ]]; then
            echo "disallow: the reinstall failed before the new allowlist was applied, and the allowlist could not be put back after a retry — state: the requested entries are no longer in $src; gateway container '$gwname' removed by the failed apply's cleanup (it is not serving anything) — next action: fix the underlying failure, then apply the current configuration: egresslock ensure $profile" >&2
        elif [[ " $ENSURE_OWNED " == *" $gwname "* ]] && [[ "$obs" == running ]]; then
            echo "disallow: the reinstall failed before the new allowlist was applied, and the allowlist could not be put back after a retry — state: the requested entries are no longer in $src; gateway container '$gwname' still running (its removal failed) — next action: fix the underlying failure, then apply the current configuration: egresslock ensure $profile" >&2
            echo "$sp2w" >&2
        elif [[ " $ENSURE_OWNED " == *" $gwname "* ]] && [[ "$obs" == unknown ]]; then
            echo "disallow: the reinstall failed before the new allowlist was applied, and the allowlist could not be put back after a retry — state: the requested entries are no longer in $src; gateway container state could not be determined (its removal failed or was not confirmed; it may still be serving them) — next action: fix the underlying failure, then apply the current configuration: egresslock ensure $profile" >&2
            echo "$sp2w" >&2
        elif [[ "$obs" == not-running ]]; then
            echo "disallow: the reinstall failed before the new allowlist was applied, and the allowlist could not be put back after a retry — state: the requested entries are no longer in $src; gateway container not running — next action: fix the underlying failure, then apply the current configuration: egresslock ensure $profile" >&2
        elif [[ " $ENSURE_OWNED " != *" $gwname "* && "$obs" == running ]]; then
            echo "disallow: nothing was revoked — the reinstall failed before the new allowlist was applied, and the allowlist could not be put back after a retry — state: the requested entries are no longer in $src; this attempt did not restart or replace the running gateway, which still serves them — next action: fix the underlying failure, then either put the entries back and retry: egresslock allow $profile $entries; egresslock disallow $profile $entries, or keep the removal and apply it: egresslock ensure $profile" >&2
            echo "$sp2w" >&2
        else
            echo "disallow: nothing was revoked — the reinstall failed before the new allowlist was applied, and the allowlist could not be put back after a retry — state: the requested entries are no longer in $src; gateway container state could not be determined (it may still be serving them) — next action: fix the underlying failure, then either put the entries back and retry: egresslock allow $profile $entries; egresslock disallow $profile $entries, or keep the removal and apply it: egresslock ensure $profile" >&2
            echo "$sp2w" >&2
        fi
    elif [[ "${GW_APPLY_COMMITTED:-0}" == 1 && "${GW_APPLY_ACTIVE:-0}" != 1 ]]; then
        # EGL-395 S-P5: publication is committed but activation was not
        # proved. One state-true variant covers every running or
        # indeterminate container, whether it pre-existed or this run
        # started/replaced it; proven removed/not-running states keep
        # their existing strings. Selection follows the flags and the
        # container-state observation, never ENSURE_OWNED.
        if [[ " $ENSURE_REMOVED " == *" $gwname "* ]]; then
            echo "disallow: the new allowlist was written into the gateway's configuration, but the reinstall failed after that — state: the requested entries are no longer in $src; gateway container '$gwname' removed by the failed reinstall's cleanup (it is not serving anything) — next action: fix the underlying failure, then apply the current configuration: egresslock ensure $profile" >&2
        elif [[ "$obs" == not-running ]]; then
            echo "disallow: the new allowlist was written into the gateway's configuration, but the reinstall failed after that — state: the requested entries are no longer in $src; gateway container '$gwname' not running (its removal was not confirmed) — next action: fix the underlying failure, then apply the current configuration: egresslock ensure $profile" >&2
        elif [[ "$obs" == unknown ]]; then
            echo "disallow: the new allowlist was written into the gateway's configuration, but this run could not confirm the running gateway loaded it — state: the requested entries are no longer in $src; the gateway container state could not be determined; the previous configuration may still be active — next action: run: egresslock ensure $profile" >&2
            echo "disallow: warning: a plain 'egresslock ensure $profile' will apply the removal from $src by reloading the running gateway — established proxied sessions to those destinations may keep running until they close; restore the entries first if that was not the intent. To drop those sessions (this drops every proxied session on the profile), run: egresslock ensure --replace-gateway $profile." >&2
        else
            echo "disallow: the new allowlist was written into the gateway's configuration, but this run could not confirm the running gateway loaded it — state: the requested entries are no longer in $src; the previous configuration may still be active — next action: run: egresslock ensure $profile" >&2
            echo "disallow: warning: a plain 'egresslock ensure $profile' will apply the removal from $src by reloading the running gateway — established proxied sessions to those destinations may keep running until they close; restore the entries first if that was not the intent. To drop those sessions (this drops every proxied session on the profile), run: egresslock ensure --replace-gateway $profile." >&2
        fi
    elif [[ " $ENSURE_REMOVED " == *" $gwname "* ]]; then
        echo "disallow: the new allowlist was written into the gateway's configuration, but the reinstall failed after that — state: the requested entries are no longer in $src; gateway container '$gwname' removed by the failed reinstall's cleanup (it is not serving anything) — next action: fix the underlying failure, then apply the current configuration: egresslock ensure $profile" >&2
    elif [[ " $ENSURE_OWNED " == *" $gwname "* ]]; then
        if [[ "$obs" == not-running ]] && [[ "$(disallow_proxy_gw_registered "$gwname")" == absent ]]; then
            echo "disallow: the new allowlist was written into the gateway's configuration, but the reinstall failed after that — state: the requested entries are no longer in $src; gateway container '$gwname' not running (its removal was not confirmed) — next action: fix the underlying failure, then apply the current configuration: egresslock ensure $profile" >&2
        else
            echo "disallow: the new allowlist was written into the gateway's configuration, but the reinstall failed after that — state: the requested entries are no longer in $src; gateway container '$gwname' still running (its removal failed) — next action: fix the underlying failure, then remove the gateway by hand: podman rm -f $gwname; then apply the current configuration: egresslock ensure $profile" >&2
        fi
    else
        echo "disallow: the new allowlist was written into the gateway's configuration, but the reinstall failed after that — state: the requested entries are no longer in $src; the new allowlist is in the gateway's configuration — next action: fix the underlying failure, then apply the current configuration: egresslock ensure $profile" >&2
    fi
    if [[ " $ENSURE_REMOVED " == *" $anchor "* ]]; then
        echo "disallow: note: the failed reinstall removed containers it had started for profile '$profile' — if the profile is not running now, start it again: egresslock ensure $profile" >&2
    fi
    return 0
}

# Converged-predicate gate: a readable caps mismatch or an unreadable
# state must NOT be blessed by the converged short-circuit — it falls
# through to replacement (the EGL-123-D3 MAC-pin pattern), so a
# once-failed launch cannot be blessed by the next ensure.
gw_caps_ok() { # gw_caps_ok <gwname>
    [[ "$(kit_caps_state "$1")" == "ok" ]]
}

anchor_caps_ok() { # anchor_caps_ok <anchor-name>
    [[ "$(kit_caps_state "$1")" == "ok" ]]
}

ensure_anchor() {
    local profile="$1" anchor
    anchor="$(anchor_of "$profile")"
    # EGL-206-D2b: the converged short-circuit is caps-aware — a running
    # anchor whose live hardening is wrong or unreadable falls through
    # to replacement instead of being blessed (EGL-123-D3 MAC-pin
    # pattern).
    if anchor_running "$anchor" && anchor_caps_ok "$anchor"; then
        return 0
    fi
    # Stale stopped anchor from an interrupted run.
    rt_rm_retry "$anchor" >/dev/null 2>&1 || true
    # The anchor holds the rootless netns (bridge + policy) open. It runs
    # no services and only sleeps; --restart=always brings it back after
    # a crash or image-level restart. It gets the LAST usable host
    # address of the subnet (ARC-11-D3) so it can never collide with the
    # bridge gateway (first usable) or the gateway's static IP (ARC-5).
    local anchor_ip animg
    cidr_parse "${PROFILE_SUBNET[$profile]}" \
        || die "invalid subnet '${PROFILE_SUBNET[$profile]}'"
    anchor_ip="$(cidr_ip "$CIDR_LAST")"
    # EGL-66-D1: the anchor only sleeps, but it is kit-created and sits
    # on the profile L2 — run it with the same hardening pair as the
    # kit-built gateway (ARC-32-D5): no capabilities, no privilege gain.
    # EGL-491: warn here, not inside anchor_image() — the function runs in
    # a command-substitution subshell, where the once-per-name list is lost.
    egl491_warn_ignored_hook EGRESSLOCK_ANCHOR_IMAGE "${EGRESSLOCK_ANCHOR_IMAGE:-}"
    animg="$(anchor_image)"
    # EGL-206-D2a: refuse a checkpoint-annotated image before the run
    # (CVE-2026-94603). R-EGL-206-2 #1: a fresh account's first ensure
    # resolves the digest-pinned fallback before it is in the local
    # store — pull it here (the pull rt_run would do), then inspect,
    # so the refusal stays preventative on first-create.
    refuse_checkpoint_image "$animg" "anchor image" pull-missing
    # EGL-217 (M2, R1): this run owns the anchor it is about to start —
    # marked BEFORE the run so a failed rt_run that still registered the
    # name (ARC-5 partial storage) is cleaned up by the EXIT trap. The
    # converged short-circuit above returns before this marker: a reused
    # anchor is never owned.
    ensure_own "$anchor"
    rt_run "$anchor" \
        --network "$(network_of "$profile")" \
        --ip "$anchor_ip" \
        --cap-drop=all \
        --security-opt=no-new-privileges \
        --restart=always \
        "$animg" sleep 86400 >/dev/null
    # ARC-69-D3: announce only the create — a silent ensure_anchor was
    # indistinguishable from reuse; already-running return stays silent.
    echo "started anchor $anchor"
    # Give Podman a moment to report it as running before we rely on it.
    # EGL-206-D2b: wait-until-running, then assert live hardening on the
    # success path — never skipped by a return from inside the wait loop.
    local i
    for i in $(seq 1 20); do
        anchor_running "$anchor" && break
        sleep 0.5
    done
    anchor_running "$anchor" \
        || die "anchor container '$anchor' did not reach running state"
    assert_kit_caps "$anchor" "anchor"
}

#
# Emit the profile's canonical rule lines (no table/chain wrapper). Used
# both to generate the install file and to build the expected rule set for
# deep verification (review R-003-3).
#
# EGL-141-D1: the profile's bridge device name — the single live-resolved
# netns-topology token (a narrow, recorded amendment to "compiled from
# conf", EGL-91: all POLICY semantics stay conf-derived; the bridge is
# topology netavark owns and the conf cannot know). Resolved INSIDE the
# emit path so every refresh (R-003-7) carries the current name. The
# name is NOT stable across network recreation (`podman<N>` slot depends
# on creation order in the shared account netns, kit AND non-kit), so it
# may not be derived and never crosses a run boundary; a stale name
# matches nothing for the genuine bridge — verify fails closed with a
# named diff and ensure repairs (EGL-141-D1 consequence 3). Cross-checked
# against the rootless netns link list so an inspect/report mismatch
# fails the file builder by rc (EGL-120-D1 pattern) — an empty
# `iifname ""` must never render.
# EGL-515 D3 keeps exactly one run-scoped exception: the successfully
# resolved name is remembered for this process after both the inspect and
# the netns link check succeeded (topology does not change mid-run; a
# stale name still fails closed at first nft use). A failed lookup is
# never memoized, and there is no on-disk or cross-invocation state.
declare -A GW_BRIDGE_IF_CACHE=()
# Callers that must not fork (compiled_rules: a `$(...)` around this
# function would lose the cache write) capture the same value here.
PROFILE_BRIDGE_IF=""

profile_bridge_if() { # profile_bridge_if <profile> -> bridge device; rc 1 on any doubt
    local profile="$1" net ifc links
    net="$(network_of "$profile")"
    PROFILE_BRIDGE_IF=""
    if [[ -n "${GW_BRIDGE_IF_CACHE[$net]:-}" ]]; then
        PROFILE_BRIDGE_IF="${GW_BRIDGE_IF_CACHE[$net]}"
        echo "$PROFILE_BRIDGE_IF"
        return 0
    fi
    ifc="$(rt_network_inspect "$net" '{{.NetworkInterface}}' 2>/dev/null || true)"
    # Kernel ifnames: <= 15 bytes, no whitespace, no quotes, no leading
    # '-' (flag-shaped tokens, EGL-59-D1 class). Anything else (empty,
    # missing, multi-line) fails the emit.
    [[ "$ifc" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,14}$ ]] || {
        echo "Error: cannot resolve the bridge interface of $net (got '${ifc:-<empty>}'); ensure owns network creation — run: egresslock ensure $profile" >&2
        return 1
    }
    links="$(rt_unshare ip -br link 2>/dev/null || true)"
    # Match in one awk (no writer|grep -q pipeline): grep -q exits on the
    # first match and SIGPIPEs the writer, which `set -o pipefail` turns
    # into a spurious fail-closed. tests/run.sh runs the battery under
    # stdbuf line buffering, which makes that race reproducible.
    if ! awk -v want="$ifc" '$1 == want { found=1 } END { exit !found }' <<<"$links"; then
        echo "Error: bridge interface '$ifc' of $net not confirmed in the rootless netns (ip -br link); fail closed" >&2
        return 1
    fi
    GW_BRIDGE_IF_CACHE[$net]="$ifc"
    PROFILE_BRIDGE_IF="$ifc"
    echo "$ifc"
}

#
# Rule generation entry point: the generic rule compiler for the loaded
# config (there is no legacy path — ARC-20).
#
policy_rules() {
    compiled_rules "$1"
}

# ARC-12-D1: when set (verify path), the compilers take allow-host
# daddrs from VERIFY_PINS (the live chain's pins) instead of
# resolve_set — DNS drift must not fail or die verify.
VERIFY_PIN_MODE=0

#
# ARC-12-D4: the profile's allow-host destinations as ordered
# "host:port" lines — the configured entries, before resolution. The
# gateway IP and the bridge-gateway DNS allow are static/derived data,
# NOT drift candidates, and are excluded here.
#
profile_allow_hosts() {
    local profile="$1"
    local i kind pfx="${profile}|"
    for i in "${!ENGINE_KINDS[@]}"; do
        [[ "${ENGINE_KINDS[$i]}" == "$pfx"* ]] || continue
        kind="${ENGINE_KINDS[$i]#"$pfx"}"
        [[ "$kind" == "allow-host" ]] || continue
        echo "${ENGINE_ARGS[$i]}"
    done
}

#
# ARC-12-D4 (as amended by EGL-140-D1): build the EXPECTED ruleset with
# allow-host daddrs from the ENSURE-TIME PIN RECORD — not a fresh resolve
# (a DNS change must not make verify fail) and not the live chain (a
# tampered chain must not adopt its own daddrs). The structural zip
# against the live chain (count, port order) fails closed, and each live
# daddr is compared against the record: divergence = post-ensure chain
# edit -> named fail (EGL-140-D2). A missing/corrupt record on a profile
# with allow-hosts fails closed with the named re-ensure error, never a
# silent-green or lenient live-chain adoption; zero-allow-host profiles
# are exempt.
#
# The VERIFY_PINS array is consulted by a resolver shim: resolve_pin()
# replaces resolve_set in the expected-ruleset build only. verify fills
# it from read_pin_record (the confdir witness), never from the chain.
#
declare -A VERIFY_PINS=()
# EGL-460-D6: the canonical profile-chain listing verify_profile_chain
# compared and proved (set right after its read, before the compare).
# cmd_ensure's post-verification confirmation consumes THIS text for the
# accepted-set walk instead of taking a fresh chain read (a second read
# would be another unproved input and would move the post-swap ordinal
# pin). Reset per ensure; only consumed while the direct-disallow
# context is armed.
VERIFY_PROFILE_CHAIN_CANON=""
# EGL-178-D2: cmd_ensure's pre-refresh pin snapshot (ensure_snapshot_pins)
# crosses helper boundaries into ensure_announce_refreshed, so it lives at
# file scope like VERIFY_PINS. Distinct name on purpose: the verify-time
# fill of VERIFY_PINS (cmd_ensure's verify_policy call) must not clobber
# the ensure-time snapshot.
declare -A ENSURE_BEFORE_PINS=()

# EGL-219-D3: the per-run resolve cache — one resolve per ensure feeds
# the rule build, the pin record, and the announce, so the announced set
# equals the installed set (a second resolve could reorder a multi-A host
# and flap the pin). Filled by ensure_resolve_pins at the top of
# install_policy in parent scope (the build runs in-process), so it
# survives into write_pin_record and ensure_announce_refreshed. Lifetime
# is one command; resolved_dest falls back to resolve_set for cmd_rules.
declare -A RESOLVED_SETS=()

# EGL-305: disallow-host partial-failure recovery state. While a
# disallow-host mutation is in flight (armed in cmd_disallow_host after
# the conf rule is deleted, cleared on the success continuation), the
# cmd_ensure EXIT trap (ensure_exit_trap) reads these to restore the
# conf rule or disclose the partial state. ENSURE_POLICY_SWAPPED is the
# swap-boundary signal set inside install_policy immediately after the
# successful atomic -f (its only caller is cmd_ensure, which resets it
# at entry); CONF_DELETED_PREIMAGE_FILE names the complete pre-delete
# conf copy so conf_restore_allow_host can put back every line the
# (canonical-port) matcher removed — including equivalent leading-zero
# spellings (R-EGL-310-19 F2), not just the first. A FILE, not a shell
# string: a command-substitution capture cannot retain embedded NULs,
# so a pre-swap restore would silently truncate a valid conf
# (R-EGL-397-5 F4).
# CONF_DELETED_COMMITTED is the "the conf delete already happened"
# gate for the cmd_disallow_host EXIT trap: pre-mutation failures
# (nothing deleted yet) must stay disclosure-silent (EGL-305-D6).
DISALLOW_HOST_CTX=""
DISALLOW_HOST_HOST=""
DISALLOW_HOST_PORT=""
DISALLOW_HOST_CONF=""
# EGL-460: the revoked pin's live daddr set, captured by live_pin_daddr
# BEFORE the conf line is deleted. The flush step inside cmd_ensure runs
# after the swap (the revoked rule is already gone from the chain and the
# pin record was just rewritten), so it cannot recompute this scope.
DISALLOW_HOST_PIN_IPS=""
# EGL-460-D5: the direct-lane flush step's trap-window state. FLUSH_STEP
# is set only while disallow_flush_revoked_flows runs inside cmd_ensure;
# a failure there is disclose-only (ensure_cleanup skips). FLUSH_PROVEN
# is set only after the port reconcile (reconcile_port_live) returns
# clean, so the
# EXIT-trap disclosure can distinguish the new post-proof state (D3)
# from the existing "after swap, before conntrack proof" state (f1-ii).
# EGL-460-D6: the run's commit ladder for the D3 disclosure —
# FLUSH_PROVEN (early kill attempt) -> POLICY_VERIFIED (verify_policy
# returned 0) -> KILL_PROVEN (the post-verification confirmation
# returned clean). Only KILL_PROVEN may claim the kill or gate
# `removed:`.
DISALLOW_HOST_FLUSH_STEP=0
DISALLOW_HOST_FLUSH_PROVEN=0
DISALLOW_HOST_POLICY_VERIFIED=0
DISALLOW_HOST_KILL_PROVEN=0
# EGL-480-D2: the pending-revocation record write's unwind capture. WROTE
# is set only after the atomic write succeeded (the trap-window write
# precedes the conf delete); the prior line is retained byte-for-byte so
# the not-committed/S1 unwind restores it exactly (or drops the entry when
# there was none). The path/key are cached so the die-free unwind never
# has to call a dying path helper from EXIT-trap context.
REVOKE_PENDING_WROTE=0
REVOKE_PENDING_PATH=""
REVOKE_PENDING_KEY=""
REVOKE_PENDING_PRIOR_LINE=""
REVOKE_PENDING_PRIOR_FOUND=0
REVOKE_PENDING_LINES=()
CONF_DELETED_PREIMAGE_FILE=""
CONF_DELETED_COMMITTED=0
ENSURE_POLICY_SWAPPED=0
# EGL-391: the pin-record half of the ensure commit. ENSURE_PIN_PROFILE
# names the run's profile for the EXIT-trap disclosure; the committed
# flag is set only when write_pin_record returned 0 (including a
# zero-allow-host removal). A run that applied nft but exited before
# this flag got set is the disclosure window.
ENSURE_PIN_PROFILE=""
ENSURE_PIN_COMMITTED=0
# EGL-460-F5: the gateway-verification half of the ensure commit. Set
# only after verify_gateway returned 0 for this run, so the D3
# disclosure states the gateway fact the run actually reached: a
# failure after the verification (e.g. an interruption before the
# closing lines) must not claim an unverified gateway.
ENSURE_GATEWAY_VERIFIED=0
# EGL-391-D4: set by compiled_rules when one of its nft-input writes
# failed, so the install/verify callers can distinguish a write failure
# (S5/S9) from a rule-generation or pin-record failure. Reset by each
# compiled_rules run and by verify_profile_chain before the expected
# ruleset build.
POLICY_EMIT_FAILED=0

# EGL-389: proxy-lane disallow partial-failure recovery state. While a
# proxy disallow mutation is in flight (armed in cmd_disallow after the
# pre-image backup, cleared on the success continuation), the cmd_ensure
# EXIT trap reads these to restore the source allowlist or disclose the
# split. DISALLOW_PROXY_COMMITTED is the "the atomic rewrite already
# happened" gate: pre-rewrite failures stay disclosure-silent (the
# EGL-305-D6 shape). GW_APPLY_COMMITTED is the apply's commit boundary
# (set at the config swap or the converged skip) and gates whether the
# source may still be restored.
DISALLOW_PROXY_CTX=""
DISALLOW_PROXY_SRC=""
DISALLOW_PROXY_BACKUP=""
DISALLOW_PROXY_ENTRIES=""
DISALLOW_PROXY_COMMITTED=0

# EGL-392: proxy-lane allow private staging state. While a rewrite is
# being staged, ALLOW_STAGE_DIR names the verified owner-only 0700
# directory under the source parent; the EXIT/signal traps remove it and
# the success path clears the variable and the traps BEFORE cmd_ensure
# installs its own EXIT trap.
ALLOW_STAGE_DIR=""
# ALLOW_STAGE_COMMITTED flips at the successful rename so a late failure
# (e.g. an echo failure under `set -e` before the traps clear) describes
# the commit truthfully instead of claiming the source is unchanged.
ALLOW_STAGE_COMMITTED=0

# EGL-402: proxy-lane disallow private staging state. DISALLOW_STAGE_DIR
# names the verified owner-only 0700 directory beside the source while the
# replacement is built; the composed EXIT trap removes it (S3 on failure)
# and then runs the EGL-389 disclosure. The stage is removed before
# cmd_ensure installs its own EXIT trap, so that trap still owns the
# post-apply disclosure.
DISALLOW_STAGE_DIR=""

ensure_resolve_pins() { # ensure_resolve_pins <profile> — fill RESOLVED_SETS; rc 1 named
    # Walk the profile's conf allow-hosts in order; cache miss → one
    # resolve_set call. An empty set fails the ensure closed NAMED with
    # the EGL-120-D1 hint (same message class as resolved_dest's
    # install-path belt) BEFORE any ruleset is built — the ruleset is
    # untouched, the ensure dies closed.
    local profile="$1" hp host cset
    while IFS= read -r hp; do
        [[ -n "$hp" ]] || continue
        host="${hp%:*}"
        [[ -n "${RESOLVED_SETS[$host]:-}" ]] && continue
        cset="$(resolve_set "$host")"
        RESOLVED_SETS[$host]="$cset"
        if [[ -z "$cset" ]]; then
            echo "Error: cannot resolve $host" >&2
            allow_host_resolve_hint "$profile" "$host" "${hp##*:}"
            return 1
        fi
    done < <(profile_allow_hosts "$profile")
    return 0
}

resolve_pin() { # resolve_pin <host> -> the pinned address set (space-joined); empty = no pin
    local key host="$1" port="${2:-}" k
    # Set semantics (EGL-219-D3): any port of a host was installed from
    # ONE resolve_set call, so look up by host regardless of port; the
    # value is the whole ensure-time address set.
    for k in "${!VERIFY_PINS[@]}"; do
        if [[ "${k%%|*}" == "$host" ]]; then
            echo "${VERIFY_PINS[$k]}"
            return 0
        fi
    done
    return 1
}

# EGL-140-D1: the ensure-time pin record — sibling of the resolved conf
# file (PROFILE_CONF carries the conf-resolution result). The suffix
# must NOT match the confdir aggregation glob (*.conf) — .pins never
# aggregates, never parses as a conf.
pin_record_path() { # pin_record_path <profile> -> <confdir>/<profile>.pins
    local conf="${PROFILE_CONF[$1]:-}"
    [[ -n "$conf" ]] || die "internal: no conf file recorded for profile '$1'"
    local dir
    dir="$(cd "$(dirname "$conf")" && pwd)"
    echo "$dir/$1.pins"
}

# EGL-480-D2: the pending-revocation record — sibling of the pin record.
# The suffix must NOT match the confdir aggregation glob (*.conf); it is
# trusted-directory state with the pin record's mode/atomic-write shape.
# It names the scope a direct revocation captured before the conf delete:
# `host|port <addresses>`, one line per unfinished revocation, unioned
# per key (never drops a member).
revoke_pending_path() { # revoke_pending_path <profile> -> <confdir>/<profile>.revoke-pending
    local conf="${PROFILE_CONF[$1]:-}"
    [[ -n "$conf" ]] || die "internal: no conf file recorded for profile '$1'"
    local dir
    dir="$(cd "$(dirname "$conf")" && pwd)"
    echo "$dir/$1.revoke-pending"
}

# EGL-140-D1 step 2: write the pin record from WHAT WAS JUST INSTALLED.
# The witness is the live chain's pin accepts right after the atomic
# install (the daddrs the compiler emitted — no second resolve, no DNS
# race). Conf order, `host|port <set>` per allow-host, <set> being the
# ordered address set the entry installed (EGL-219-D7: one line per conf
# entry). Zero-allow-host profiles have NO record; a stale one is
# removed. Atomic mktemp+mv beside the file: a SIGKILL leaves the old
# record or none, both fail closed at the next verify (EGL-91). A write
# failure fails the ensure closed.
write_pin_record() { # write_pin_record <profile>
    local profile="$1" rec
    rec="$(pin_record_path "$profile")"
    # Zero-allow-host profile: the record must not exist (exempt shape).
    # EGL-391-D5: an unremovable stale record (e.g. a directory at the
    # path) is a warning, not an ensure failure — verify ignores the
    # record for a profile with no allow-hosts.
    if [[ -z "$(profile_allow_hosts "$profile")" ]]; then
        if ! rm -f "$rec" 2>/dev/null; then
            echo "warning: could not remove the stale pin record $rec after the policy changed to no allow-hosts; the policy and gateway are as installed, and verify does not use the pin record for a profile with no allow-hosts" >&2 || true
        fi
        ENSURE_PIN_COMMITTED=1
        return 0
    fi
    # Zip the just-installed chain's pin accepts against the conf order
    # (same parse verify_expected_rules uses, minus the record compare).
    local chain subnet
    chain="$(chain_of "$profile")"
    subnet="${PROFILE_SUBNET[$profile]}"
    local raw actual
    raw="$(netns_nft list chain inet "$TABLE" "$chain" 2>/dev/null || true)"
    actual="$(canonicalize <<<"$raw")" || die "cannot record the installed pins for profile '$profile' (the just-installed firewall rules could not be read back — fail closed)"
    local gw_ip="${GW_IP[$profile]:-}"
    local -a want_hosts=() want_ports=() got_ips=() got_ports=()
    local hp r ip port i
    while IFS= read -r hp; do
        [[ -n "$hp" ]] || continue
        want_hosts+=("${hp%:*}")
        want_ports+=("${hp##*:}")
    done < <(profile_allow_hosts "$profile")
    while IFS= read -r r; do
        local pin_re="^ip saddr ${subnet} iifname \"[^\"]+\" ip daddr ([0-9.]+) tcp dport ([0-9]+) counter accept\$"
        [[ "$r" =~ $pin_re ]] || continue
        ip="${BASH_REMATCH[1]}"
        port="${BASH_REMATCH[2]}"
        # Exclude the DNS-to-bridge rule and the static gateway hop.
        [[ "$ip" == "$gw_ip" ]] && continue
        got_ips+=("$ip")
        got_ports+=("$port")
    done <<<"$actual"
    # EGL-219-D1/D7: each conf entry installed |set| accepts — the
    # canonical set order from the per-ensure cache (the exact values
    # the compiler resolved and emitted). Missing cache = a build that
    # did not go through ensure_resolve_pins → named die, fail closed.
    # The cardinality check is Σ over conf ENTRIES of each entry's set
    # size vs the chain's accept count (NOT conf-entry count vs accepts).
    local expected_total=0 i j k
    local -a set_sizes=()
    for i in "${!want_ports[@]}"; do
        local cset="${RESOLVED_SETS[${want_hosts[$i]}]:-}"
        if [[ -z "$cset" ]]; then
            die "cannot record the installed pins for profile '$profile' (no resolved set cached for ${want_hosts[$i]} — fail closed)"
        fi
        local -a csize=()
        read -ra csize <<<"$cset"
        set_sizes+=("${#csize[@]}")
        expected_total=$(( expected_total + ${#csize[@]} ))
    done
    if (( expected_total != ${#got_ports[@]} )); then
        die "cannot record the installed pins for profile '$profile' (conf entries consume $expected_total pin accepts, chain has ${#got_ports[@]} — fail closed)"
    fi
    # Zip the conf order against the chain accepts in order: each
    # consumed accept must carry the conf entry's port and its set
    # member's daddr (positional — the emitter emitted them in exactly
    # this order). Any divergence is a structural anomaly: named die.
    local -a lines=()
    k=0
    for i in "${!want_ports[@]}"; do
        read -ra cset_members <<<"${RESOLVED_SETS[${want_hosts[$i]}]}"
        for j in "${!cset_members[@]}"; do
            if [[ "${got_ports[$k]}" != "${want_ports[$i]}" ]]; then
                die "cannot record the installed pins for profile '$profile' (chain accept $k dport ${got_ports[$k]}, conf entry ${want_hosts[$i]}:${want_ports[$i]} — fail closed)"
            fi
            if [[ "${got_ips[$k]}" != "${cset_members[$j]}" ]]; then
                die "cannot record the installed pins for profile '$profile' (chain accept $k daddr ${got_ips[$k]}, expected set member ${cset_members[$j]} for ${want_hosts[$i]}:${want_ports[$i]} — fail closed)"
            fi
            k=$(( k + 1 ))
        done
        # D7: the record line's value is the ordered (sorted) address
        # set, space-joined — old single-address readers are gone; an
        # old engine reading this record fails closed (corrupt), an
        # old single-address record still parses as a 1-element set.
        lines+=("${want_hosts[$i]}|${want_ports[$i]} ${RESOLVED_SETS[${want_hosts[$i]}]}")
    done
    local tmp
    tmp="$(mktemp "$rec.XXXXXX")" || die "cannot write the pin record $rec for profile '$profile': the stored list of allowed addresses was not updated by this run"
    chmod 600 "$tmp" 2>/dev/null || true
    if ! printf '%s\n' "${lines[@]}" > "$tmp"; then
        rm -f "$tmp" 2>/dev/null || true
        die "cannot write the pin record $rec for profile '$profile': the stored list of allowed addresses was not updated by this run"
    fi
    # EGL-391-D5: `-T` renames onto the leaf itself; a plain mv would
    # move the temp INTO a directory target and leave the record stale
    # with the temp silently absorbed.
    if ! mv -T -f "$tmp" "$rec" 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null || true
        die "cannot write the pin record $rec for profile '$profile': the stored list of allowed addresses was not updated by this run"
    fi
    ENSURE_PIN_COMMITTED=1
}

# EGL-391-D5: protect the pin-record commit target. The record is
# trusted-directory state; a directory or symlink at the path must be
# named BEFORE the firewall swap, not silently absorbed by mv. A
# zero-allow-host profile is exempt (verify ignores the record there;
# write_pin_record warns S7 instead of failing a healthy zero-pin
# ensure).
ensure_pin_target_check() { # ensure_pin_target_check <profile> — pre-swap, rc 0 or named die
    local profile="$1" rec tail
    [[ -n "$(profile_allow_hosts "$profile")" ]] || return 0
    rec="$(pin_record_path "$profile")"
    [[ -e "$rec" || -L "$rec" ]] || return 0
    # EGL-391-D6: in a direct/proxy disallow the lane's restore/conntrack
    # line is the next action; a plain `ensure` there would drop the
    # direct rule without ending its open connections. Same idiom as
    # S3's context suppression.
    tail="; move it aside and re-run: egresslock ensure $profile"
    if [[ -n "$DISALLOW_HOST_CTX" || -n "$DISALLOW_PROXY_CTX" ]]; then
        tail=""
    fi
    if [[ -L "$rec" ]]; then
        die "the pin record path $rec is a symbolic link; refusing to replace it (the firewall was not changed$tail)"
    fi
    [[ -f "$rec" ]] \
        || die "the pin record path $rec is not a regular file; refusing to replace it (the firewall was not changed$tail)"
}

# EGL-140-D1 step 4 / D3: read the pin record into VERIFY_PINS. Fail
# closed named on a missing record (the 0.4.x upgrade shape: live chains
# but no witness — re-ensure, never a lenient live-chain adoption) and
# on a corrupt/incomplete/unexpected-content record (same class). The
# record must cover exactly the profile's conf allow-hosts: every conf
# pin covered, no stale extra entries.
read_pin_record() { # read_pin_record <profile> — fills VERIFY_PINS; rc 1 named
    local profile="$1" rec
    rec="$(pin_record_path "$profile")"
    if [[ ! -f "$rec" ]]; then
        echo "verify: pin record missing for profile '$profile' — re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
        return 1
    fi
    VERIFY_PINS=()
    local line key ipset
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" ]] || continue
        # EGL-219-D7: token-validating set regex — capture 3 is the
        # whole space-joined address set (a single address parses as a
        # 1-element set: old records stay valid, no migration).
        if [[ "$line" =~ ^([^|[:space:]]+)\|([0-9]+)[[:space:]]+([0-9.]+( [0-9.]+)*)$ ]]; then
            key="${BASH_REMATCH[1]}|${BASH_REMATCH[2]}"
            ipset="${BASH_REMATCH[3]}"
            # D7: duplicate key lines are LEGAL iff their set values
            # are identical (the conf grammar's allow-host rule is
            # "ordered, repeatable" and the ensure's own writer emits
            # its identical line twice; the reader collapses
            # identicals, first-wins). A DISAGREEING duplicate is a
            # named corrupt — stricter than silent last-wins, consistent
            # with EGL-140's fail-closed posture.
            if [[ -n "${VERIFY_PINS[$key]:-}" && "${VERIFY_PINS[$key]}" != "$ipset" ]]; then
                echo "verify: pin record corrupt for profile '$profile' ($rec, disagreeing duplicate key for ${key%%|*}:${key##*|}) — re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
                return 1
            fi
            # D7: a repeated address within one line is a non-canonical
            # set the engine never writes — named corrupt, fail closed.
            local uniq total
            uniq="$(awk '{for(i=1;i<=NF;i++) print $i}' <<<"$ipset" | LC_ALL=C sort -u | wc -l)"
            total="$(awk '{print NF}' <<<"$ipset")"
            if (( uniq != total )); then
                echo "verify: pin record corrupt for profile '$profile' ($rec, repeated address in line: '$line') — re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
                return 1
            fi
            VERIFY_PINS[$key]="$ipset"
        else
            echo "verify: pin record corrupt for profile '$profile' ($rec, line: '$line') — re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
            return 1
        fi
    done < "$rec"
    local hp
    while IFS= read -r hp; do
        [[ -n "$hp" ]] || continue
        if [[ -z "${VERIFY_PINS[${hp%:*}|${hp##*:}]:-}" ]]; then
            echo "verify: pin record corrupt for profile '$profile' (missing entry for $hp) — re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
            return 1
        fi
    done < <(profile_allow_hosts "$profile")
    for key in "${!VERIFY_PINS[@]}"; do
        local found=0
        while IFS= read -r hp; do
            [[ -n "$hp" ]] || continue
            [[ "${hp%:*}|${hp##*:}" == "$key" ]] && { found=1; break; }
        done < <(profile_allow_hosts "$profile")
        if (( found == 0 )); then
            echo "verify: pin record corrupt for profile '$profile' (stale entry for ${key%%|*}:${key##*|}) — re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
            return 1
        fi
    done
    return 0
}

# EGL-480-D2: read/validate the pending-revocation record into
# REVOKE_PENDING_LINES. Missing and empty are ABSENT (a crashed clear
# leaves an empty file; it is not an unfinished revocation). A
# non-regular/symlink path, a failed read, a malformed line, a repeated
# address, or a disagreeing duplicate key is CORRUPT (fail closed).
# rc 0 present (REVOKE_PENDING_LINES filled), 1 absent, 2 corrupt.
# Duplicate identical key lines collapse first-wins (the pin-record D7
# reader's shape); the writer never emits them.
revoke_pending_scan() { # revoke_pending_scan <path> -> rc 0 present / 1 absent / 2 corrupt
    local path="$1" line key ipset uniq total
    REVOKE_PENDING_LINES=()
    if [[ ! -e "$path" && ! -L "$path" ]]; then
        return 1
    fi
    # A symlink is non-regular state: never read through it, never
    # replace its target (the pin-record D5 discipline).
    [[ -f "$path" && ! -L "$path" ]] || return 2
    local -a raw=()
    if ! mapfile -t raw < "$path" 2>/dev/null; then
        return 2
    fi
    local -A seen_sets=()
    for line in "${raw[@]}"; do
        [[ -n "$line" ]] || continue
        if [[ "$line" =~ ^([^|[:space:]]+)\|([0-9]+)[[:space:]]+([0-9.]+( [0-9.]+)*)$ ]]; then
            key="${BASH_REMATCH[1]}|${BASH_REMATCH[2]}"
            ipset="${BASH_REMATCH[3]}"
            if [[ -n "${seen_sets[$key]:-}" && "${seen_sets[$key]}" != "$ipset" ]]; then
                return 2
            fi
            uniq="$(awk '{for(i=1;i<=NF;i++) print $i}' <<<"$ipset" | LC_ALL=C sort -u | wc -l)"
            total="$(awk '{print NF}' <<<"$ipset")"
            (( uniq == total )) || return 2
            if [[ -z "${seen_sets[$key]:-}" ]]; then
                REVOKE_PENDING_LINES+=("$line")
                seen_sets[$key]="$ipset"
            fi
        else
            return 2
        fi
    done
    (( ${#REVOKE_PENDING_LINES[@]} > 0 )) || return 1
    return 0
}

# EGL-480-D5: the corrupt/unreadable record refusal (ensure/record-write
# context; die, rc 1, before any mutation). `verify` renders the same
# content under its own `verify:` line.
revoke_pending_die_corrupt() { # revoke_pending_die_corrupt <profile> <path>
    local profile="$1" path="$2"
    die "the pending-revocation record ($path) for profile '$profile' is unreadable or corrupt — refusing to continue (fail closed): a direct revocation may be unfinished; inspect the record, finish or rule out the listed revocations (egresslock drop-unauthorized $profile <port>), then fix or remove the record and retry: egresslock ensure $profile"
}

# EGL-480-D2: cmd_ensure entry check — after config load, immediately
# before install_policy. A corrupt/unreadable/non-regular record refuses
# the run named and fail-closed (a direct revocation may be unfinished);
# absent/empty records pass silently.
revoke_pending_check() { # revoke_pending_check <profile>
    local profile="$1" path scan_rc=0
    path="$(revoke_pending_path "$profile")"
    revoke_pending_scan "$path" || scan_rc=$?
    if (( scan_rc == 2 )); then
        revoke_pending_die_corrupt "$profile" "$path"
    fi
    return 0
}

# EGL-480-D2/D3: write the pending revocation BEFORE the conf delete,
# from the scope captured before the mutation. Same-key writes union:
# this capture's addresses first, then any prior members not already
# present (order-stable, never drops a member). The prior line is cached
# byte-for-byte for the die-free unwind. The atomic write (mktemp +
# mv -T, 0600) leaves the old record or none on a kill; the caller's
# DISALLOW_HOST_PIN_IPS becomes the union so the armed early flush and
# confirmation cover earlier members too. A write failure dies named
# before the delete (nothing was mutated).
revoke_pending_write() { # revoke_pending_write <profile> <host> <port> <ips>
    local profile="$1" host="$2" port="$3" ips="$4" path key line _ip prior="" prior_found=0
    path="$(revoke_pending_path "$profile")"
    key="$host|$port"
    [[ -n "$ips" ]] \
        || die "internal: cannot record the pending revocation for profile '$profile': the revoked rule's address set is empty"
    local scan_rc=0
    revoke_pending_scan "$path" || scan_rc=$?
    if (( scan_rc == 2 )); then
        # The existing record cannot be safely unioned/retained; refuse
        # before the delete with the record-write refusal (the next
        # ensure names the corrupt state itself).
        die "cannot record the pending revocation for profile '$profile' ($path): the rule $host:$port was not removed and the firewall was not changed — check the config directory, then retry: egresslock disallow $profile $host:$port --direct"
    fi
    local -A union_seen=()
    local -a union=()
    for _ip in $ips; do
        [[ -n "${union_seen[$_ip]:-}" ]] && continue
        union_seen[$_ip]=1
        union+=("$_ip")
    done
    local -a out=()
    if (( scan_rc == 0 )); then
        for line in "${REVOKE_PENDING_LINES[@]}"; do
            if [[ "${line%% *}" == "$key" ]]; then
                prior="$line"
                prior_found=1
                for _ip in ${line#* }; do
                    [[ -n "${union_seen[$_ip]:-}" ]] && continue
                    union_seen[$_ip]=1
                    union+=("$_ip")
                done
                out+=("$key ${union[*]}")
            else
                out+=("$line")
            fi
        done
    fi
    if (( prior_found == 0 )); then
        out+=("$key ${union[*]}")
    fi
    local tmp
    tmp="$(mktemp "$path.XXXXXX")" \
        || die "cannot record the pending revocation for profile '$profile' ($path): the rule $host:$port was not removed and the firewall was not changed — check the config directory, then retry: egresslock disallow $profile $host:$port --direct"
    chmod 600 "$tmp" 2>/dev/null || true
    if ! printf '%s\n' "${out[@]}" > "$tmp"; then
        rm -f "$tmp" 2>/dev/null || true
        die "cannot record the pending revocation for profile '$profile' ($path): the rule $host:$port was not removed and the firewall was not changed — check the config directory, then retry: egresslock disallow $profile $host:$port --direct"
    fi
    if ! mv -T -f "$tmp" "$path" 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null || true
        die "cannot record the pending revocation for profile '$profile' ($path): the rule $host:$port was not removed and the firewall was not changed — check the config directory, then retry: egresslock disallow $profile $host:$port --direct"
    fi
    REVOKE_PENDING_WROTE=1
    REVOKE_PENDING_PATH="$path"
    REVOKE_PENDING_KEY="$key"
    REVOKE_PENDING_PRIOR_LINE="$prior"
    REVOKE_PENDING_PRIOR_FOUND="$prior_found"
    DISALLOW_HOST_PIN_IPS="${union[*]}"
}

# EGL-480-D2: die-free unwind for the not-committed/S1 paths. Restore
# the pre-write line byte-for-byte (or drop the entry when the key had
# no prior line); remove the file when the last entry goes. Never dies,
# never prints, never alters the pending rc. A failed unwind leaves the
# record; the next ensure with the rule still present clears it via the
# accepted-set path. A corrupt record is left untouched (fail closed at
# the next ensure entry).
revoke_pending_unwind() { # revoke_pending_unwind — EXIT-trap context; die-free
    (( REVOKE_PENDING_WROTE )) || return 0
    local path="$REVOKE_PENDING_PATH" key="$REVOKE_PENDING_KEY" line tmp
    [[ -n "$path" && -n "$key" ]] || return 0
    local scan_rc=0
    revoke_pending_scan "$path" || scan_rc=$?
    (( scan_rc == 2 )) && return 0
    (( scan_rc == 0 )) || return 0
    local -a out=()
    local found=0
    for line in "${REVOKE_PENDING_LINES[@]}"; do
        if [[ "${line%% *}" == "$key" ]]; then
            found=1
            (( REVOKE_PENDING_PRIOR_FOUND )) && out+=("$REVOKE_PENDING_PRIOR_LINE")
        else
            out+=("$line")
        fi
    done
    if (( found == 0 )); then
        REVOKE_PENDING_WROTE=0
        return 0
    fi
    if (( ${#out[@]} == 0 )); then
        if rm -f -- "$path" 2>/dev/null; then
            REVOKE_PENDING_WROTE=0
        fi
        return 0
    fi
    tmp="$(mktemp "$path.XXXXXX" 2>/dev/null)" || return 0
    chmod 600 "$tmp" 2>/dev/null || true
    if ! printf '%s\n' "${out[@]}" > "$tmp" 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null || true
        return 0
    fi
    if ! mv -T -f "$tmp" "$path" 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null || true
        return 0
    fi
    REVOKE_PENDING_WROTE=0
    return 0
}

# EGL-480-D3/D5: clear one finished entry (atomic rewrite; remove the
# file when the last entry goes). Called only after a clean confirmation
# (or by the check that proves the accepted-set path kept the rule).
# A corrupt record or a failed rewrite dies named; the caller has
# already recorded the truthful ladder state, so the entry staying is
# safe (the next ensure retries it).
revoke_pending_clear_entry() { # revoke_pending_clear_entry <profile> <host> <port>
    local profile="$1" host="$2" port="$3" path key line
    path="$(revoke_pending_path "$profile")"
    key="$host|$port"
    local scan_rc=0
    revoke_pending_scan "$path" || scan_rc=$?
    (( scan_rc == 1 )) && return 0
    if (( scan_rc == 2 )); then
        revoke_pending_die_corrupt "$profile" "$path"
    fi
    local -a out=()
    local found=0
    for line in "${REVOKE_PENDING_LINES[@]}"; do
        if [[ "${line%% *}" == "$key" ]]; then
            found=1
            continue
        fi
        out+=("$line")
    done
    (( found )) || return 0
    local clear_fail="cannot clear the finished revocation from the pending-revocation record ($path) for profile '$profile': the connections were proven ended, but the record could not be updated — retry later: egresslock ensure $profile"
    if (( ${#out[@]} == 0 )); then
        rm -f -- "$path" 2>/dev/null || die "$clear_fail"
        return 0
    fi
    local tmp
    tmp="$(mktemp "$path.XXXXXX")" || die "$clear_fail"
    chmod 600 "$tmp" 2>/dev/null || true
    if ! printf '%s\n' "${out[@]}" > "$tmp"; then
        rm -f "$tmp" 2>/dev/null || true
        die "$clear_fail"
    fi
    if ! mv -T -f "$tmp" "$path" 2>/dev/null; then
        rm -f "$tmp" 2>/dev/null || true
        die "$clear_fail"
    fi
    return 0
}

# EGL-139-D2 step 3: the revoked pin's LIVE daddr set, captured BEFORE
# the conf mutation deletes the conf line (name pins carry no IP; the
# chain is the only trustworthy scope source). Positional zip of the
# conf's allow-host order against the live chain's pin accepts — the
# same pairing verify_expected_rules uses, without the record compare.
# EGL-219-D7/D9: the pin record is now an INPUT — it sizes each conf
# entry's slice (one entry installs |set| accepts). A missing/unreadable
# record, a corrupt line, a disagreeing duplicate key, or a missing key
# for any conf entry at/before the target is a named fail-closed die
# BEFORE the conf mutation (a quiet skip would remove the conf line,
# swap the ruleset, print removed:, and leave the revoked flow alive on
# the ct-established accept with no flush — an unproven severance claim
# against EGL-139-D2; remediation is the record's own re-run:
# egresslock ensure <profile>). The chain-absent read, a failed chain
# read, the total-count mismatch, an unmapped target, and every
# per-entry port/daddr divergence refuse named here — fail closed
# before the conf mutation (nothing changed; ensure, then retry) —
# never a silent empty skip (EGL-296).
live_pin_daddr() { # live_pin_daddr <profile> <host> <port> -> target entry's daddr set; refuses named on an unreadable/absent chain or chain/record disagreement (EGL-296)
    local profile="$1" host="$2" port="$3" chain subnet
    chain="$(chain_of "$profile")"
    subnet="${PROFILE_SUBNET[$profile]}"
    local raw actual raw_rc=0
    raw="$(netns_nft list chain inet "$TABLE" "$chain" 2>/dev/null)" || raw_rc=$?
    # EGL-296 F1 (ER-EGL-296-5): the read's own status is evidence — a
    # failed read (nonzero rc) is an unusable chain even when stdout
    # carries a listing, and a successful empty read is an absent chain;
    # both refuse named here, before anything is consumed from the read
    # (cmd_disallow_host's probe has already proven the netns reachable;
    # S1's "or they cannot be read" names both states). Nothing changed.
    (( raw_rc == 0 )) || die "disallow --direct: profile '$profile' has no installed firewall rules, or they cannot be read — nothing was changed; re-run: egresslock ensure $profile, then retry: egresslock disallow $profile $host:$port --direct"
    [[ -n "$raw" ]] || die "disallow --direct: profile '$profile' has no installed firewall rules, or they cannot be read — nothing was changed; re-run: egresslock ensure $profile, then retry: egresslock disallow $profile $host:$port --direct"
    actual="$(canonicalize <<<"$raw")"
    # EGL-219-D9: read the record fail-closed named (same line regex
    # as read_pin_record; duplicate keys collapse iff values identical).
    local rec
    rec="$(pin_record_path "$profile")"
    if [[ ! -f "$rec" ]]; then
        die "disallow --direct: pin record unreadable for profile '$profile' (missing file) — re-run: egresslock ensure $profile"
    fi
    local -a rec_lines=()
    if ! mapfile -t rec_lines < "$rec" 2>/dev/null; then
        die "disallow --direct: pin record unreadable for profile '$profile' (cannot read $rec) — re-run: egresslock ensure $profile"
    fi
    local -A rec_sets=()
    local line key ipset uniq total
    for line in "${rec_lines[@]}"; do
        [[ -n "$line" ]] || continue
        if [[ "$line" =~ ^([^|[:space:]]+)\|([0-9]+)[[:space:]]+([0-9.]+( [0-9.]+)*)$ ]]; then
            key="${BASH_REMATCH[1]}|${BASH_REMATCH[2]}"
            ipset="${BASH_REMATCH[3]}"
            if [[ -n "${rec_sets[$key]:-}" && "${rec_sets[$key]}" != "$ipset" ]]; then
                die "disallow --direct: pin record unreadable for profile '$profile' (disagreeing duplicate key for ${key%%|*}:${key##*|}) — re-run: egresslock ensure $profile"
            fi
            # D12(c): repeated address within one line = corrupt
            # (read_pin_record parity).
            uniq="$(awk '{for(i=1;i<=NF;i++) print $i}' <<<"$ipset" | LC_ALL=C sort -u | wc -l)"
            total="$(awk '{print NF}' <<<"$ipset")"
            if (( uniq != total )); then
                die "disallow --direct: pin record unreadable for profile '$profile' (repeated address in line: '$line') — re-run: egresslock ensure $profile"
            fi
            rec_sets[$key]="$ipset"
        else
            die "disallow --direct: pin record unreadable for profile '$profile' (corrupt line: '$line') — re-run: egresslock ensure $profile"
        fi
    done
    local gw_ip="${GW_IP[$profile]:-}"
    local -a want_hosts=() want_ports=() got_ips=() got_ports=()
    local hp r ip p i
    while IFS= read -r hp; do
        [[ -n "$hp" ]] || continue
        want_hosts+=("${hp%:*}")
        want_ports+=("${hp##*:}")
    done < <(profile_allow_hosts "$profile")
    # D9/D12: coverage before any count/skip return — an empty record or a
    # missing key (target or predecessor) is a record failure, not a chain
    # count mismatch.
    for i in "${!want_ports[@]}"; do
        if [[ -z "${rec_sets[${want_hosts[$i]}|${want_ports[$i]}]:-}" ]]; then
            die "disallow --direct: pin record unreadable for profile '$profile' (no entry for ${want_hosts[$i]}:${want_ports[$i]}) — re-run: egresslock ensure $profile"
        fi
    done
    while IFS= read -r r; do
        local pin_re="^ip saddr ${subnet} iifname \"[^\"]+\" ip daddr ([0-9.]+) tcp dport ([0-9]+) counter accept\$"
        [[ "$r" =~ $pin_re ]] || continue
        ip="${BASH_REMATCH[1]}"
        p="${BASH_REMATCH[2]}"
        [[ "$ip" == "$gw_ip" ]] && continue
        got_ips+=("$ip")
        got_ports+=("$p")
    done <<<"$actual"
    # Total-count mismatch (Σ record set sizes over conf entries vs the
    # live pin accepts): refuse named (EGL-296) — the chain cannot be
    # proven to agree with the record; nothing changes (ensure, retry).
    local want_total=0
    for i in "${!want_ports[@]}"; do
        local cset="${rec_sets[${want_hosts[$i]}|${want_ports[$i]}]:-}"
        local -a csize=()
        read -ra csize <<<"$cset"
        want_total=$(( want_total + ${#csize[@]} ))
    done
    (( want_total == ${#got_ports[@]} )) || die "disallow --direct: the installed direct rules for profile '$profile' no longer match its pin record — expected $want_total, found ${#got_ports[@]} (direct rule count mismatch); nothing was changed; re-run: egresslock ensure $profile, then retry: egresslock disallow $profile $host:$port --direct"
    # Positional zip sized from the record: walk the conf entries in
    # order; every entry consumed BEFORE the target — and the target
    # itself — must carry a record key (missing = named fail-closed
    # die, D9); a missing key AFTER the target is caught by the
    # total-count check above, or by the full-agreement zip below
    # when the chain is short in step with the record (EGL-296).
    # start = Σ set sizes of the entries before the target.
    local start=-1 target_n=0 running=0
    for i in "${!want_ports[@]}"; do
        local cset="${rec_sets[${want_hosts[$i]}|${want_ports[$i]}]:-}"
        if [[ "${want_hosts[$i]}" == "$host" && "${want_ports[$i]}" == "$port" ]]; then
            if [[ -z "$cset" ]]; then
                die "disallow --direct: pin record unreadable for profile '$profile' (no entry for ${want_hosts[$i]}:${want_ports[$i]}) — re-run: egresslock ensure $profile"
            fi
            local -a tsize=()
            read -ra tsize <<<"$cset"
            start=$running
            target_n=${#tsize[@]}
            break
        fi
        if [[ -z "$cset" ]]; then
            die "disallow --direct: pin record unreadable for profile '$profile' (no entry for ${want_hosts[$i]}:${want_ports[$i]}) — re-run: egresslock ensure $profile"
        fi
        local -a csize2=()
        read -ra csize2 <<<"$cset"
        running=$(( running + ${#csize2[@]} ))
    done
    (( start >= 0 )) || die "disallow --direct: cannot find direct rule $host:$port in the installed rules for profile '$profile' — nothing was changed; re-run: egresslock ensure $profile, then retry: egresslock disallow $profile $host:$port --direct"
    # EGL-296: the chain must agree with the record before any mutation —
    # every conf entry, in order, every member's port and daddr (the same
    # comparison verify_expected_rules makes; a drifted or tampered chain
    # must not steer the flush key). Any divergence refuses named here,
    # before the conf mutation (nothing changed; retry after ensure).
    local k=0 j
    for i in "${!want_ports[@]}"; do
        local cset3="${rec_sets[${want_hosts[$i]}|${want_ports[$i]}]:-}"
        if [[ -z "$cset3" ]]; then
            die "disallow --direct: pin record unreadable for profile '$profile' (no entry for ${want_hosts[$i]}:${want_ports[$i]}) — re-run: egresslock ensure $profile"
        fi
        local -a members3=()
        read -ra members3 <<<"$cset3"
        for j in "${!members3[@]}"; do
            [[ "${want_ports[$i]}" == "${got_ports[$k]}" ]] || die "disallow --direct: the installed direct rules for profile '$profile' are in a different order than the config — config expects ${want_hosts[$i]}:${want_ports[$i]}, the installed rule has port ${got_ports[$k]} (direct rule port order mismatch); nothing was changed; re-run: egresslock ensure $profile, then retry: egresslock disallow $profile $host:$port --direct"
            [[ "${members3[$j]}" == "${got_ips[$k]}" ]] || die "disallow --direct: a pinned address for ${want_hosts[$i]}:${want_ports[$i]} no longer matches the installed rule in profile '$profile' — pin record: $cset3, installed rule: ${got_ips[$k]} (direct pin daddr mismatch); nothing was changed; re-run: egresslock ensure $profile, then retry: egresslock disallow $profile $host:$port --direct"
            k=$(( k + 1 ))
        done
    done
    local -a out=()
    for (( i = 0; i < target_n; i++ )); do
        out+=("${got_ips[$(( start + i ))]}")
    done
    echo "${out[*]}"
    return 0
}

# EGL-139-D2 steps 5-6: scoped conntrack delete of the revoked pin's
# entries AFTER the atomic nft swap (a pre-swap flush lets in-flight
# packets re-mint the entry under the still-matching pin rule, R-003-7),
# then the post-assert that no entry remains — every observed state is a
# survivor (EGL-297-D1/D5). The -D rc is advisory; the post-assert is the
# completion gate, and a survivor dies loudly with the state disclosed,
# never a green rc with a live revoked flow (R2/R9). An observed entry
# means its packet already left under the revoked accept and a reply can
# complete the flow; only entries the dump cannot see remain the
# unconfirmed window (X20d). EGL-231-D1: the reader is a scoped ctnetlink
# `$bin -L`, not /proc/net/nf_conntrack (absent in a rootless netns).
# EGL-313-D1: discovery and delete share one scope — original-tuple rows
# sourced inside this profile's subnet, minus the gateway source; a
# sibling profile's authorized entry for the same daddr:dport is never
# touched (EGL-139-D2's gateway-leg side effect no longer occurs).
conntrack_flush_and_assert() { # conntrack_flush_and_assert <profile> <daddr> <dport>
    local profile="$1" dip="$2" dport="$3" out bin rrow rstate rsrc rdst rsp rdp s_u32
    local subnet gw_ip rc survivor
    subnet="${PROFILE_SUBNET[$profile]}"
    # EGL-313: the profile's subnet is the scope of this revocation — only
    # the revoked rule's own workload flows (its `ip saddr ${subnet}`
    # match, minus the gateway source) are deleted or witnessed; a
    # sibling profile's independently authorized entry for the same
    # daddr:dport is never touched (the reconcile's candidate predicate,
    # paired). The subnet was validated by cmd_ensure before any flush;
    # the parse is defense-in-depth.
    cidr_parse "$subnet" || die "invalid subnet '$subnet'"
    # EGL-168-D2: resolve the bin once so the post-swap failure dies can
    # hand the operator the exact scoped command with the RESOLVED path
    # (bare `conntrack` is often missing from a non-root PATH, which is
    # why conntrack_bin exists). Plain assignment: a die inside
    # conntrack_bin must propagate under set -e.
    bin="$(conntrack_bin)"
    # EGL-313 (a): enumerate the tuple's original-direction rows BEFORE
    # any delete. Every nonzero read rc is unreadable = fail closed named
    # (EGL-231-R2), with nothing to undo.
    rc=0
    out="$(netns_conntrack -L -p tcp --dport "$dport" -d "$dip" 2>&1)" || rc=$?
    if (( rc != 0 )); then
        die "cannot read the rootless netns conntrack table (rc=$rc): ${out:-<no output>}; state: conf line removed, ruleset swapped, ct unproven; next action: podman unshare --rootless-netns $bin -L -p tcp --dport $dport -d $dip"
    fi
    # EGL-313 (b): delete each in-scope row by its exact original tuple —
    # original src inside this profile's subnet and not the gateway
    # source (never flush unscoped). The -D rc stays advisory (EGL-231-D2:
    # "0 flow entries have been deleted" is the normal no-live-flow case;
    # the banner match is delimited, R-EGL-231-3) — any other nonzero is
    # the named warn. Rows outside the scope (another profile, the
    # gateway leg, foreign sources) are never deleted; each in-scope
    # delete is scoped further to its own daddr+dport.
    gw_ip="${GW_IP[$profile]:-}"
    while IFS= read -r rrow; do
        [[ "$rrow" =~ ^tcp[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+[A-Z_0-9]+[[:space:]]+src=([0-9.]+)[[:space:]]+dst=([0-9.]+)[[:space:]]+sport=([0-9]+)[[:space:]]+dport=([0-9]+) ]] || continue
        rsrc="${BASH_REMATCH[1]}"; rdst="${BASH_REMATCH[2]}"; rsp="${BASH_REMATCH[3]}"; rdp="${BASH_REMATCH[4]}"
        [[ "$rdst" == "$dip" && "$rdp" == "$dport" ]] || continue
        s_u32="$(cidr_u32 "$rsrc")"
        (( s_u32 >= CIDR_NETWORK && s_u32 <= CIDR_BCAST )) || continue
        [[ -n "$gw_ip" && "$rsrc" == "$gw_ip" ]] && continue
        if ! out="$(netns_conntrack -D -p tcp -s "$rsrc" --sport "$rsp" -d "$dip" --dport "$dport" 2>&1)"; then
            [[ "$out" == *": 0 flow entries have been deleted." ]] || \
                echo "warn: conntrack delete for $dip:$dport failed: $(tail -1 <<<"$out")" >&2
        fi
    done <<<"$out"
    # EGL-313 (c) + EGL-231: the witness shares the scope — a scoped
    # read, in-scope rows only (the same subnet-minus-gateway
    # predicate). Every nonzero read rc stays unreadable = fail closed
    # named (EGL-231-R2: no text exception — a nonzero rc that happens
    # to carry a zero/any summary is a failed read, not an empty table).
    rc=0
    out="$(netns_conntrack -L -p tcp --dport "$dport" -d "$dip" 2>&1)" || rc=$?
    if (( rc != 0 )); then
        die "cannot read the rootless netns conntrack table (rc=$rc): ${out:-<no output>}; state: conf line removed, ruleset swapped, ct unproven; next action: podman unshare --rootless-netns $bin -L -p tcp --dport $dport -d $dip"
    fi
    # EGL-231-D1: -L dump lines carry no procfs `ipv4 2` prefix (they
    # start directly with the protocol), so the survivor match keys on
    # $1 == "tcp" (index-based, not field position — both directions on
    # one line stay safe).
    # EGL-297-D1/D5 (M1): the survivor match keys on $1 == "tcp" and
    # the tuple only — every observed entry is a survivor (no
    # reply-less exception; the header rationale above explains why an
    # observed entry can still complete).
    survivor=""
    while IFS= read -r rrow; do
        [[ -n "$rrow" ]] || continue
        [[ "$rrow" =~ ^tcp[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+([A-Z_0-9]+)[[:space:]]+src=([0-9.]+)[[:space:]]+dst=([0-9.]+)[[:space:]]+sport=([0-9]+)[[:space:]]+dport=([0-9]+) ]] || continue
        rstate="${BASH_REMATCH[1]}"
        rsrc="${BASH_REMATCH[2]}"; rdst="${BASH_REMATCH[3]}"; rsp="${BASH_REMATCH[4]}"; rdp="${BASH_REMATCH[5]}"
        s_u32="$(cidr_u32 "$rsrc")"
        (( s_u32 >= CIDR_NETWORK && s_u32 <= CIDR_BCAST )) || continue
        [[ -n "$gw_ip" && "$rsrc" == "$gw_ip" ]] && continue
        survivor="$rrow"; break
    done <<<"$out"
    if [[ -n "$survivor" ]]; then
        die "the revoked direct rule's flow to $dip:$dport still has a live conntrack entry: $survivor; state: conf line removed, ruleset swapped, conntrack entry persists (the revoked flow is not proven gone) — next action: end the leftover connections: egresslock drop-unauthorized $profile $dport (drops the connections on port $dport the policy no longer allows, keeps the connections the policy still allows, then checks none remain; safe to run again)"
    fi
    # EGL-312: the peer direction. An incoming packet can recreate
    # tracking with the reversed original direction (peer -> workload;
    # kernel loose-TCP pickup), the workload's replies then ride the base
    # established accept, and the original-direction pair above never
    # sees it (R-EGL-306-3 F2). Peer rows are admitted only when the
    # workload end (the row's original dst) is in THIS profile's subnet —
    # EGL-313's cross-profile discipline applied to the new pair; each is
    # deleted by its exact original tuple, so a sibling profile's row for
    # the same peer:port is never touched. R-EGL-312-2 F2: the survivor
    # die below names the same profile-scoped recovery command as the
    # forward-direction die (the verb reconciles the peer direction too).
    # EGL-313 merge: subnet/locals are bound once at the head (shared
    # `subnet`/`bin`/`out`/`rc` — no double-declare).
    rc=0
    out="$(netns_conntrack -L -p tcp --sport "$dport" -s "$dip" 2>&1)" || rc=$?
    if (( rc != 0 )); then
        die "cannot read the rootless netns conntrack table (rc=$rc): ${out:-<no output>}; state: conf line removed, ruleset swapped, ct unproven; next action: podman unshare --rootless-netns $bin -L -p tcp --sport $dport -s $dip"
    fi
    while IFS= read -r rrow; do
        [[ "$rrow" =~ ^tcp[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+[A-Z_0-9]+[[:space:]]+src=([0-9.]+)[[:space:]]+dst=([0-9.]+)[[:space:]]+sport=([0-9]+)[[:space:]]+dport=([0-9]+) ]] || continue
        rsrc="${BASH_REMATCH[1]}"; rdst="${BASH_REMATCH[2]}"; rsp="${BASH_REMATCH[3]}"; rdp="${BASH_REMATCH[4]}"
        [[ "$rsrc" == "$dip" && "$rsp" == "$dport" ]] || continue
        s_u32="$(cidr_u32 "$rdst")"
        (( s_u32 >= CIDR_NETWORK && s_u32 <= CIDR_BCAST )) || continue
        if ! out="$(netns_conntrack -D -p tcp -s "$rsrc" --sport "$rsp" -d "$rdst" --dport "$rdp" 2>&1)"; then
            [[ "$out" == *": 0 flow entries have been deleted." ]] || \
                echo "warn: conntrack delete for the peer's direction of $dip:$dport failed: $(tail -1 <<<"$out")" >&2
        fi
    done <<<"$out"
    rc=0
    out="$(netns_conntrack -L -p tcp --sport "$dport" -s "$dip" 2>&1)" || rc=$?
    if (( rc != 0 )); then
        die "cannot read the rootless netns conntrack table (rc=$rc): ${out:-<no output>}; state: conf line removed, ruleset swapped, ct unproven; next action: podman unshare --rootless-netns $bin -L -p tcp --sport $dport -s $dip"
    fi
    survivor=""
    while IFS= read -r rrow; do
        [[ -n "$rrow" ]] || continue
        [[ "$rrow" =~ ^tcp[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+([A-Z_0-9]+)[[:space:]]+src=([0-9.]+)[[:space:]]+dst=([0-9.]+)[[:space:]]+sport=([0-9]+)[[:space:]]+dport=([0-9]+) ]] || continue
        rstate="${BASH_REMATCH[1]}"
        rsrc="${BASH_REMATCH[2]}"; rdst="${BASH_REMATCH[3]}"; rsp="${BASH_REMATCH[4]}"; rdp="${BASH_REMATCH[5]}"
        [[ "$rsrc" == "$dip" && "$rsp" == "$dport" ]] || continue
        s_u32="$(cidr_u32 "$rdst")"
        (( s_u32 >= CIDR_NETWORK && s_u32 <= CIDR_BCAST )) || continue
        survivor="$rrow"; break
    done <<<"$out"
    if [[ -n "$survivor" ]]; then
        die "the revoked direct rule's flow from $dip:$dport still has a live conntrack entry (the peer's direction): $survivor; state: conf line removed, ruleset swapped, conntrack entry persists (the revoked flow is not proven gone) — next action: end the leftover connections: egresslock drop-unauthorized $profile $dport (drops the connections on port $dport the policy no longer allows, keeps the connections the policy still allows, then checks none remain; safe to run again)"
    fi
}

# EGL-307: the accepted-set walk in one place — the post-swap chain's
# daddr accepts for <port>, the two shapes EGL-141-D1 emits (pin/
# gateway-hop and DNS-to-bridge; REVOCATION_INVARIANT.md walk pairing).
# Reads canonical chain text on stdin, prints one daddr per line. A new
# accept shape in the emitter must join THIS walk (they stay paired).
chain_accepted_daddrs() { # chain_accepted_daddrs <profile> <port>; canonical text on stdin
    local profile="$1" port="$2" line
    local subnet="${PROFILE_SUBNET[$profile]}"
    local accepted_re="^ip saddr ${subnet} iifname \"[^\"]+\" ip daddr ([0-9.]+) tcp dport ([0-9]+) counter accept\$"
    local accepted_dns_re='^ip saddr '"${subnet}"' iifname "[^"]+" ip daddr ([0-9.]+) meta l4proto \{ tcp, udp \} th dport ([0-9]+) counter accept$'
    while IFS= read -r line; do
        if [[ "$line" =~ $accepted_re ]]; then
            if [[ "${BASH_REMATCH[2]}" == "$port" ]]; then
                echo "${BASH_REMATCH[1]}"
            fi
        elif [[ "$line" =~ $accepted_dns_re ]]; then
            if [[ "${BASH_REMATCH[2]}" == "$port" ]]; then
                echo "${BASH_REMATCH[1]}"
            fi
        fi
    done
    return 0
}

# EGL-307: the shared post-swap accepted read. As EGL-311: a nonzero read
# rc, an empty/header-only/garbled chain, or one missing the baseline
# established/related accept is unusable (no flush runs on an
# unestablished accepted set). Non-dying: rc 0 fills CT_ACCEPTED_LIST
# (one daddr per element); rc 1 (read failed) also exposes
# CT_ACCEPTED_RAW/CT_ACCEPTED_RC; rc 2 = unusable. The reconcile maps rc
# to its named dies; the member-leg guard flushes every member on any
# nonzero rc (doubt severs). Call WITHOUT command substitution so the
# globals reach the caller's frame (`$()` would drop them).
conntrack_accepted_set() { # conntrack_accepted_set <profile> <port> -> rc; fills CT_ACCEPTED_LIST/CT_ACCEPTED_RAW/CT_ACCEPTED_RC
    local profile="$1" port="$2" raw read_rc=0 canon canon_rc=0
    CT_ACCEPTED_RAW=""
    CT_ACCEPTED_RC=0
    CT_ACCEPTED_LIST=()
    raw="$(netns_nft list chain inet "$TABLE" "$(chain_of "$profile")" 2>&1)" || read_rc=$?
    CT_ACCEPTED_RAW="$raw"
    CT_ACCEPTED_RC="$read_rc"
    (( read_rc == 0 )) || return 1
    [[ -n "$raw" ]] || return 2
    canon="$(canonicalize <<<"$raw")" || canon_rc=$?
    (( canon_rc == 0 )) && [[ -n "$canon" ]] || return 2
    grep -q 'ct state established,related counter accept' <<<"$canon" || return 2
    mapfile -t CT_ACCEPTED_LIST < <(chain_accepted_daddrs "$profile" "$port" <<<"$canon")
    return 0
}

# EGL-295: the post-swap port reconcile — cmd_disallow_host calls this
# between the member flush loop and `removed:`. The member leg keyed only
# the revoked rule's current pin members; a name pin whose DNS refreshed
# re-pins the address and leaves the earlier address's established entry
# alive, its flow riding the base ct-state accept (X20a: rc 0 +
# `removed:` while the old-address stream delivered). Here the post-swap
# chain is re-read and the REVOKED PORT reconciled (D1a: the rule is
# host:port and its flows carry that dport — never wider): every
# workload-sourced entry whose daddr the chain no longer accepts is
# flushed via the EGL-313 source-scoped conntrack_flush_and_assert.
conntrack_reconcile_port() { # conntrack_reconcile_port <profile> <port> <pin_ips> [witness [retry_cmd [basis]]]
    local profile="$1" port="$2" pin_ips="$3" witness="${4:-0}" retry_cmd="${5:-}" basis="${6:-}"
    local chain subnet
    chain="$(chain_of "$profile")"
    subnet="${PROFILE_SUBNET[$profile]}"
    local pass
    for pass in flush witness; do
        [[ "$pass" == flush || "$witness" == 1 ]] || continue
        # (1) the accepted set, from the post-swap LIVE chain (D1c — the
        # chain is the authority for what is accepted now, not the pin
        # record: a record carries current members only and a tampered
        # record must not steer a flush). The chain's daddr+dport accepts
        # have two shapes (EGL-141-D1): the pin/gateway-hop accepts and the
        # DNS-to-bridge accept; the established accept, the anti-spoof and
        # terminal drops, and the MAC exemption carry no daddr+dport pair
        # and contribute nothing. A NEW accept shape added to the chain
        # emitter must join this walk in lockstep (see the revocation
        # invariant: walk pairing).
        # EGL-311: the post-swap chain read is a proof input, not a belt.
        # Capture its status and reject every nonzero rc BEFORE consuming
        # stdout (a failed read whose output happens to look complete must
        # never steer the flush). A successful read must also carry this
        # profile chain's baseline established/related accept — an empty or
        # header-only listing is an unusable policy, not "no accepts on this
        # port" (the latter is valid and still reconciles). On any of these
        # states, die named BEFORE the enumerate/flush: no flush runs on an
        # unestablished accepted set, and `removed:` stays unprinted (the
        # caller's success line is last).
        local bin nbin
        bin="$(conntrack_bin)"
        nbin="$(nft_bin)"
        # EGL-307: the read+gate+walk live in conntrack_accepted_set (shared
        # with the member-leg guard); the rc maps to the same named dies.
        # Plain call, no command substitution: CT_ACCEPTED_RC/CT_ACCEPTED_RAW
        # must reach this frame for the rc-1 die (EGL-307 finish fix).
        # EGL-460-D6: when a basis is supplied (the canonical listing
        # verify_profile_chain already proved), derive the accepted map
        # from that text instead — no live chain read and none of the
        # read-failure dies. An empty basis admits no daddr (doubt
        # severs); the caller consumed the proved listing.
        local -A accepted=()
        local line
        if [[ -n "$basis" ]]; then
            while IFS= read -r line; do
                [[ -n "$line" ]] || continue
                accepted["$line"]=1
            done < <(chain_accepted_daddrs "$profile" "$port" <<<"$basis")
        else
            local acc_rc=0
            conntrack_accepted_set "$profile" "$port" || acc_rc=$?
            if (( acc_rc == 1 )); then
                die "cannot read the firewall rules for profile '$profile' after the rule was removed (rc=$CT_ACCEPTED_RC): ${CT_ACCEPTED_RAW:-<no output>}; state: conf line removed, ruleset swapped, conntrack unproven; next action: the rule is already out and the firewall already replaced, but any connection left on port $port cannot be checked against the removed rule while the rules are unreadable — inspect what is left: podman unshare --rootless-netns $nbin list chain inet $TABLE $chain; podman unshare --rootless-netns $bin -L -p tcp --dport $port; then delete a leftover by hand: podman unshare --rootless-netns $bin -D -p tcp --dport $port -d <destination>"
            fi
            if (( acc_rc == 2 )); then
                die "the firewall rules for profile '$profile' came back empty, incomplete, or unusable after the rule was removed; state: conf line removed, ruleset swapped, conntrack unproven; next action: the rule is already out and the firewall already replaced, but any connection left on port $port cannot be checked against the removed rule while the rules are unreadable — inspect what is left: podman unshare --rootless-netns $nbin list chain inet $TABLE $chain; podman unshare --rootless-netns $bin -L -p tcp --dport $port; then delete a leftover by hand: podman unshare --rootless-netns $bin -D -p tcp --dport $port -d <destination>"
            fi
            for line in "${CT_ACCEPTED_LIST[@]}"; do
                [[ -n "$line" ]] || continue
                accepted["$line"]=1
            done
        fi
        # (2) enumerate the port's conntrack entries. EGL-231-R2: every
        # nonzero `-L` rc is unreadable = fail closed named (S6 — the same
        # partial-state disclosure as the member read; the member leg may
        # already have run, disclosed below).
        local out rc=0
        out="$(netns_conntrack -L -p tcp --dport "$port" 2>&1)" || rc=$?
        if (( rc != 0 )); then
            die "cannot read the rootless netns conntrack table (rc=$rc): ${out:-<no output>}; state: conf line removed, ruleset swapped, conntrack unproven; next action: podman unshare --rootless-netns $bin -L -p tcp --dport $port"
        fi
        # EGL-312: the peer direction, same read discipline. Rows whose
        # original tuple is src=<peer> sport=$port — the reversed-orig
        # shape an incoming packet mints.
        local out_rev=""
        rc=0
        out_rev="$(netns_conntrack -L -p tcp --sport "$port" 2>&1)" || rc=$?
        if (( rc != 0 )); then
            die "cannot read the rootless netns conntrack table (rc=$rc): ${out_rev:-<no output>}; state: conf line removed, ruleset swapped, ct unproven; next action: podman unshare --rootless-netns $bin -L -p tcp --sport $port"
        fi
        # (3) candidate rows: parsed on the ORIGINAL tuple (the first
        # src=/dst= set, the fields -d/--dport select), state-agnostic
        # (D1i: `-D` deletes any state; the token class admits
        # digit-bearing `SYN_SENT2` — a dropped row bypasses both flush
        # and witness). A candidate is workload-sourced (src inside the
        # profile subnet, not the gateway source, D1b), its dst no longer
        # accepted on this port, and not an already-flushed member (D1g).
        # Unparseable subnet -> skip (never flush unscoped). First-seen
        # order, deduped.
        if ! cidr_parse "$subnet"; then
            if (( witness )); then
                die "cannot check the leftover connections on port $port for profile '$profile': the profile's subnet is unusable; state: conf line removed, ruleset swapped, conntrack unproven"
            fi
            return 0
        fi
        local gw_ip="${GW_IP[$profile]:-}"
        local row src dst s_u32
        local -A seen=() seen_rev=()
        local -a cands=()
        while IFS= read -r row; do
            [[ -n "$row" ]] || continue
            [[ "$row" =~ ^tcp[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+[A-Z_0-9]+[[:space:]]+src=([0-9.]+)[[:space:]]+dst=([0-9.]+) ]] || continue
            src="${BASH_REMATCH[1]}"
            dst="${BASH_REMATCH[2]}"
            if [[ -n "${seen[$dst]:-}" ]]; then continue; fi
            if [[ "${accepted[$dst]+yes}" ]]; then continue; fi
            if [[ " $pin_ips " == *" $dst "* ]]; then continue; fi
            if [[ -n "$gw_ip" && "$src" == "$gw_ip" ]]; then continue; fi
            s_u32="$(cidr_u32 "$src")"
            if (( s_u32 < CIDR_NETWORK || s_u32 > CIDR_BCAST )); then continue; fi
            seen[$dst]=1
            cands+=("$dst")
        done <<<"$out"
        # EGL-312: the reversed-orig admission — the mirrored candidate walk
        # onto the peer direction. src = the address the chain must still
        # accept on this port (the peer); dst in-subnet = the workload side
        # (the same workload-side restriction the flush helper's peer block
        # applies); the pin_ips skip is deliberately absent — a current
        # member is in accepted and is skipped there, and the member leg
        # already covers its reversed pair. Dedup is per orientation
        # (seen/seen_rev); a duplicate flush target across the two sets is
        # a tolerated no-op.
        while IFS= read -r row; do
            [[ -n "$row" ]] || continue
            [[ "$row" =~ ^tcp[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+[A-Z_0-9]+[[:space:]]+src=([0-9.]+)[[:space:]]+dst=([0-9.]+)[[:space:]]+sport=([0-9]+) ]] || continue
            src="${BASH_REMATCH[1]}"; dst="${BASH_REMATCH[2]}"
            [[ "${BASH_REMATCH[3]}" == "$port" ]] || continue
            if [[ -n "${seen_rev[$src]:-}" ]]; then continue; fi
            if [[ "${accepted[$src]+yes}" ]]; then continue; fi
            if [[ -n "$gw_ip" && "$src" == "$gw_ip" ]]; then continue; fi
            s_u32="$(cidr_u32 "$dst")"
            if (( s_u32 < CIDR_NETWORK || s_u32 > CIDR_BCAST )); then continue; fi
            seen_rev[$src]=1
            cands+=("$src")
        done <<<"$out_rev"
        if [[ "$pass" == witness ]]; then
            (( ${#cands[@]} == 0 )) || die "the connections on port $port to ${cands[*]} still have live conntrack entries and the policy does not allow them; state: conf line removed, ruleset swapped, some connections remain; next action: run the same command again (safe to repeat): $retry_cmd"
        else
            local dst
            for dst in "${cands[@]}"; do
                conntrack_flush_and_assert "$profile" "$dst" "$port"
            done
        fi
    done
    return 0
}

# EGL-502-D2: the reconcile basis, named at the call site. The raw
# function's optional arity (3 args = live post-swap read, 6 args =
# proved canonical listing) silently picks a basis when an argument is
# dropped or transposed; these two names are the only in-engine forms.
reconcile_port_live() { # reconcile_port_live <profile> <port> <pin_ips> [witness [retry_cmd]]
    conntrack_reconcile_port "$1" "$2" "$3" "${4:-0}" "${5:-}"
}

reconcile_port_proved() { # reconcile_port_proved <profile> <port> <pin_ips> — basis: the listing verify_profile_chain proved
    conntrack_reconcile_port "$1" "$2" "$3" 0 "" "$VERIFY_PROFILE_CHAIN_CANON"
}

verify_expected_rules() { # prints expected ruleset; rc 1 on zip mismatch
    local profile="$1" chain subnet
    chain="$(chain_of "$profile")"
    subnet="${PROFILE_SUBNET[$profile]}"
    # Live chain, canonicalized exactly as the deep compare does.
    local raw actual
    raw="$(netns_nft list chain inet "$TABLE" "$chain" 2>/dev/null || true)"
    actual="$(canonicalize <<<"$raw")"

    # Zip config allow-hosts to live `ip daddr <ip> tcp dport <port>`
    # accepts (in order), excluding DNS (dport 53) and the gateway hop.
    local gw_ip="${GW_IP[$profile]:-}"
    local -a want_hosts=() want_ports=() got_ips=() got_ports=()
    local h line hip hport ip port
    while IFS= read -r hp; do
        [[ -n "$hp" ]] || continue
        want_hosts+=("${hp%:*}")
        want_ports+=("${hp##*:}")
    done < <(profile_allow_hosts "$profile")

    # EGL-140-D1: the daddr witness comes from the ensure-time pin
    # record, read BEFORE the structural checks (a missing/corrupt
    # record is its own named failure, D3). Zero-allow-host profiles are
    # exempt (no record, no failure).
    VERIFY_PINS=()
    if (( ${#want_ports[@]} > 0 )); then
        read_pin_record "$profile" || return 1
    fi

    while IFS= read -r r; do
        # EGL-141-D1: the pinned accept is iifname-scoped (any resolved
        # bridge name matches — the same live helper builds the expected
        # ruleset, so expected and actual agree; the regex only unbinds
        # the device token, it stays $-anchored and shape-strict).
        local pin_re="^ip saddr ${subnet} iifname \"[^\"]+\" ip daddr ([0-9.]+) tcp dport ([0-9]+) counter accept\$"
        [[ "$r" =~ $pin_re ]] || continue
        ip="${BASH_REMATCH[1]}"
        port="${BASH_REMATCH[2]}"
        # Exclude the DNS-to-bridge rule and the static gateway hop.
        [[ "$ip" == "$gw_ip" ]] && continue
        got_ips+=("$ip")
        got_ports+=("$port")
    done <<<"$actual"

    # EGL-219 §4: the count is Σ over conf ENTRIES of each entry's
    # record-set word count — a legal duplicate allow-host line emits its
    # set twice and must count twice (summing unique keys would fail on a
    # legal conf). The zip below consumes the accepts positionally: each
    # entry takes its set-size slice.
    local expected_total=0 i j k
    local -a rec_sets=()
    for i in "${!want_ports[@]}"; do
        local key="${want_hosts[$i]}|${want_ports[$i]}"
        local rec_set="${VERIFY_PINS[$key]:-}"
        if [[ -z "$rec_set" ]]; then
            echo "verify: pin record corrupt for profile '$profile' (no entry for ${want_hosts[$i]}:${want_ports[$i]}) — re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
            return 1
        fi
        local -a members=()
        read -ra members <<<"$rec_set"
        rec_sets+=("$rec_set")
        expected_total=$(( expected_total + ${#members[@]} ))
    done
    if (( expected_total != ${#got_ports[@]} )); then
        echo "verify: direct rule count mismatch for profile '$profile' (config: ${expected_total}, chain: ${#got_ports[@]}) — re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
        return 1
    fi
    k=0
    for i in "${!want_ports[@]}"; do
        local key="${want_hosts[$i]}|${want_ports[$i]}"
        local rec_set="${rec_sets[$i]}"
        local -a members=()
        read -ra members <<<"$rec_set"
        for j in "${!members[@]}"; do
            if [[ "${want_ports[$i]}" != "${got_ports[$k]}" ]]; then
                echo "verify: direct rule port order mismatch for profile '$profile' (config ${want_hosts[$i]}:${want_ports[$i]}, chain dport ${got_ports[$k]}) — re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
                return 1
            fi
            # EGL-140-D1 step 3 / EGL-219-D7: each live daddr must equal
            # the ensure-time record member in order — divergence is a
            # post-ensure chain edit (tamper, torn record), fail closed
            # named. The message keeps the pinned template: the record
            # value is the entry's whole set (space-joined), the chain
            # value is the first mismatching member; for a 1-element
            # set both renders are single addresses (byte-identical to
            # the pre-set messages).
            if [[ "${members[$j]}" != "${got_ips[$k]}" ]]; then
                echo "verify: direct pin daddr mismatch for ${want_hosts[$i]}:${want_ports[$i]} (record: $rec_set, chain: ${got_ips[$k]}) — re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
                return 1
            fi
            k=$(( k + 1 ))
        done
    done

    # Emit the expected ruleset with pins. The zip above has filled
    # VERIFY_PINS for every configured host; in VERIFY_PIN_MODE the
    # compilers resolve via resolve_pin (no DNS). Fill VERIFY_PINS in
    # the CALLER's scope: this function must NOT run inside $().
    VERIFY_PIN_MODE=1
    policy_rules "$profile"
    local rc=$?
    VERIFY_PIN_MODE=0
    return $rc
}

#
# ---------------------------------------------------------------------------
# ARC-8: data-driven profile configuration engine
# ---------------------------------------------------------------------------
#
# Config format (ARC-8-D1): line-based, one directive per line; '#' comments
# and blank lines ignored; every line matched against a strict grammar. The
# config is DATA, never sourced or eval'd; every parsed value is
# regex-validated before it reaches nftables or Squid. Unparseable or
# contradictory content fails closed with exit 2, naming file, line, and
# the offending line.
#
#   profile <name> <cidr>              # starts a profile block (IPv4 /8-29)
#       rule allow-host <host>:<port>  # ordered, repeatable
#       rule gateway-only              # requires a `gateway` directive
#       gateway <ip> <port> <file>     # static gateway IP inside the subnet
#       no-proxy <host[,host...]>      # extra NO_PROXY entries
#       read-timeout <seconds>         # Squid read_timeout override (EGL-116;
#                                      # positive integer seconds, default 900)
#
# ARC-11: subnet = any IPv4 CIDR /8-29 (integer math); bridge gateway =
# first usable, anchor = last usable. `creds` was REMOVED (ARC-11-D4):
# credential injection is the consumer's decision, not engine grammar.
# EGL-454: host fields are literals. `${...}` is the removed interpolation
# feature, not hostname syntax, so it fails the load with a named error
# (cfg_host_literal); the engine never reads its environment to pick a
# destination.
#

# A profile's config rules are stored in two flat global arrays (kind and
# argument per entry, profile-prefixed) — appended in config order and
# filtered by the compiler. Plain arrays keep the config data: no eval,
# no dynamic code, no dynamic variable names.
ENGINE_KINDS=()
ENGINE_ARGS=()

engine_rule_push() { # engine_rule_push <profile> <kind> <args>
    ENGINE_KINDS+=("$1|$2")
    ENGINE_ARGS+=("$3")
}

# Fail-closed config error: file:line, reason, offending text. Exit 2
# (usage-class error) so a broken config can never silently fall back.
# Optional args after the offending line are remediation lines
# (EGL-366-D3): each prints as '  fix: <text>'. Embedded newlines are
# kept verbatim so a continuation can align under the fix text.
config_error() {
    echo "Error: $ENGINE_CONF_NAME:$1: $2" >&2
    [[ $# -ge 3 ]] && echo "  offending line: $3" >&2
    if (( $# > 3 )); then
        local fix
        shift 3
        for fix in "$@"; do
            printf '  fix: %s\n' "$fix" >&2
        done
    fi
    exit 2
}

cfg_trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# EGL-454-D2: host fields are literals. A leftover `${VAR}` /
# `${VAR:-default}` is the removed interpolation surface, not hostname
# syntax — name the feature so a stale templated conf is diagnosed instead
# of looking like a bad hostname. Never parses the name or honors a default.
cfg_host_literal() { # cfg_host_literal <field-value>
    [[ "$1" != *'${'* ]] \
        || config_error "$n" "env-var interpolation is not supported" "$raw" \
            'write the host as a literal name (no ${VAR}); generate site-specific confs outside egresslock'
}

# Overflow-safe decimal TCP port predicate (1-65535). Bash arithmetic
# wraps at 64 bits, so a 20-digit token such as 18446744073709551617
# wrapped to 1 and passed the old `(( port >= 1 && port <= 65535 ))`
# check (R-EGL-310-6 F3). Bound the digit count BEFORE any arithmetic.
# Leading zeros are stripped first so the established `:0443` spelling
# (the standard port, EGL-365) stays accepted; a token whose decimal
# value is out of range is rejected even when the old octal-tolerant
# arithmetic happened to accept it.
cfg_is_port() { # cfg_is_port <token>
    local p="$1" digits
    [[ "$p" =~ ^[0-9]+$ ]] || return 1
    digits="${p#"${p%%[!0]*}"}"
    (( ${#digits} >= 1 && ${#digits} <= 5 )) || return 1
    (( 10#$digits >= 1 && 10#$digits <= 65535 ))
}

# R-EGL-310-16 F2/F3: canonical decimal form of an accepted port spelling.
# nftables reads a leading-zero dport as OCTAL (`tcp dport 0443` installs
# port 291), while conntrack/nft listings print canonical decimal. The
# `:0443` spelling stays accepted, so every port token that can reach the
# compiler, a pin record, or a chain/conntrack comparison is normalized
# once here, at the parse/argument boundary.
cfg_port_canon() { # cfg_port_canon <valid-port-token> -> decimal token on stdout
    local p="$1" digits
    cfg_is_port "$p" || return 1
    digits="${p#"${p%%[!0]*}"}"
    printf '%s' "$digits"
}

cfg_is_ipv4() {
    local o
    [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    for o in "${BASH_REMATCH[@]:1:4}"; do
        # Reject leading zeros: bash arithmetic would read '010' as
        # octal 8 (R-011-1 finding 3), silently re-aiming the config.
        [[ "$o" =~ ^0[0-9]+$ ]] && return 1
        (( o <= 255 )) || return 1
    done
    return 0
}

# Fresh-load reset of the config-derived state (EGL-181-D1), called by
# load_config only on a fresh load, never in append mode. `=()` preserves
# the `declare -A` attributes — do not rewrite as `unset`. ENGINE_KINDS /
# ENGINE_ARGS must reset too (R-038-1): allow-host/disallow-host reload
# the mutated conf in-process, and a stale accumulation would register
# every rule twice, corrupting the chain and silently passing verify.
cfg_reset_state() {
    PROFILES=()
    PROFILE_SUBNET=()
    GW_IP=()
    GW_PORT=()
    GW_ALLOWLIST=()
    PROFILE_NO_PROXY_EXTRA=()
    PROFILE_READ_TIMEOUT=()
    PROFILE_CONF=()
    ENGINE_KINDS=()
    ENGINE_ARGS=()
}

# Close out the current profile block (EGL-181-D1: file scope). cur /
# has_gw / has_gw_only / block_line / block_raw are the aggregator's
# locals via bash dynamic scope (EGL-181-D2); the gateway-only miss
# attributes to block_line, the OPENING line (R-008-1), never to n.
cfg_block_end() {
    [[ -n "$cur" ]] || return 0
    # EGL-366-D3 (D1): every profile needs a `gateway` directive, so a
    # gateway-less (direct-only) profile is rejected at block close on
    # every load path (EOF here, per file in append mode). Global on
    # purpose: a rule-gated check would still load a rules-free
    # gateway-less profile whose proxy verbs are dead. Both this error
    # and the specific gateway-only miss below carry the same two
    # `fix:` lines (the coder recovery recipe), attributed to the
    # opening `profile` line.
    if [[ "$has_gw" == no ]]; then
        local gw hint_add hint_mk
        cidr_parse "${PROFILE_SUBNET[$cur]}" || true
        gw="$(cidr_ip "$(( CIDR_FIRST + 1 ))")"
        hint_add="add a gateway line to this conf, e.g.: gateway $gw 3128 $cur-allowlist
       ($gw is an example address — any unused address strictly between the bridge gateway (first usable) and the anchor (last usable) works; 'egresslock init' uses the subnet's second usable one on a fresh profile)"
        hint_mk="create ${dir:-.}/$cur-allowlist next to this conf (a new empty 0600 file allows no proxied destinations; if it already exists, review its entries first), then run: egresslock ensure $cur"
        if [[ "$has_gw_only" == yes ]]; then
            config_error "$block_line" "profile '$cur' has 'rule gateway-only' but no 'gateway' directive" "$block_raw" \
                "$hint_add" "$hint_mk"
        else
            config_error "$block_line" "profile '$cur' has no 'gateway' directive; every profile needs a gateway (a direct-only profile is not a supported mode)." "$block_raw" \
                "$hint_add" "$hint_mk"
        fi
    fi
    # EGL-116-D1: default the per-profile read_timeout at block close
    # so every profile carries an explicit, greppable value (900 =
    # Squid stock, 15 minutes).
    PROFILE_READ_TIMEOUT[$cur]="${PROFILE_READ_TIMEOUT[$cur]:-900}"
    cur=""
}

# "profile <name> <subnet>" arm (EGL-181-D1). Enforces the
# one-profile-block-per-file rule (EGL-323): a second `profile` line
# fails closed, naming the already-open block and its opening line.
# Owns the name grammar, the cross-file dup check (is_profile +
# PROFILE_CONF), CIDR validation, and the parallel-array appends.
# Sets the aggregator's cur / has_gw / has_gw_only / block_line /
# block_raw via dynamic scope (EGL-181-D2); later block-close errors
# attribute to block_line, the opening line (R-008-1).
cfg_profile() {
    local name subnet rest canon rc
    [[ -z "$cur" ]] \
        || config_error "$n" "one profile per conf file: '$cur' is already defined at line $block_line; put each profile in its own conf file" "$raw"
    read -r _ name subnet rest <<<"$line"
    [[ -z "${rest:-}" ]] || config_error "$n" "unexpected trailing text after subnet" "$raw"
    # ARC-59-D1: profile names start alnum — a leading '-' would read as
    # a flag-like token in argv even though kit names are fixed-prefixed.
    [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
        || config_error "$n" "invalid profile name '$name' (expected [a-z0-9][a-z0-9-]*, must not start with '-')" "$raw"
    # EGL-380: `all` is the teardown keyword, not a profile name. A conf
    # written by an earlier release fails closed here rather than making
    # `teardown all` reroute to main.conf.
    [[ "$name" != "all" ]] \
        || config_error "$n" "profile name 'all' is reserved ('teardown all' names the main profile); rename this profile and its conf file" "$raw"
    # ARC-37-D3: aggregation must not silently shadow a name
    # already loaded from an earlier file. config_error names
    # the CURRENT file (its prefix); PROFILE_CONF names the
    # earlier one so both are identified.
    is_profile "$name" \
        && config_error "$n" "duplicate profile name '$name' across configs (also in '${PROFILE_CONF[$name]:-<earlier file>}')" "$raw"
    # ARC-11-D3: any IPv4 prefixlen 8-29, canonical network
    # address, integer CIDR math.
    rc=0
    cidr_parse "$subnet" || rc=$?
    case $rc in
        0) ;;
        2) config_error "$n" "invalid subnet '$subnet' (prefix length must be between 8 and 29)" "$raw" ;;
        3) config_error "$n" "invalid subnet '$subnet' (not the canonical network address; host bits must be zero)" "$raw" ;;
        *) config_error "$n" "invalid subnet '$subnet' (expected IPv4 CIDR like 192.0.2.0/24)" "$raw" ;;
    esac
    canon="$(cidr_ip "$CIDR_NETWORK")/$CIDR_PLEN"
    PROFILES+=("$name")
    PROFILE_SUBNET[$name]="$canon"
    PROFILE_CONF[$name]="$conf"
    has_gw=no; has_gw_only=no
    block_line=$n; block_raw="$raw"
    cur="$name"
}

# "creds ..." arm (EGL-181-D1): dedicated reject, never a generic
# unknown directive.
cfg_creds() {
    # ARC-11-D4: dedicated error, not a generic unknown directive — a
    # pre-ARC-11 config must be told exactly what changed, never silently
    # ignored. A deployed copy is fixed by re-running its deployment
    # script (e.g. copy_files.sh), not by hand-editing.
    config_error "$n" "the 'creds' directive was removed; update this config — delete the line, credential injection is the consumer's decision. If this file is a deployed copy, re-run your deployment script (e.g. copy_files.sh) instead of editing" "$raw"
}

# "rule <kind>" arm (EGL-181-D1): gateway-only flag, allow-host
# validation (literal host, port split, ARC-59 grammar, EGL-147 trailing
# dot, ARC-32-D2 DNS caps), or the unknown-kind reject. One arm, one
# helper — allow-host is deliberately not sub-split (EGL-181-D1).
cfg_rule() {
    local rest host port val
    [[ -n "$cur" ]] || config_error "$n" "'rule' outside a profile block" "$raw"
    rest="${line#"rule "}"
    if [[ "$rest" == "gateway-only" ]]; then
        has_gw_only=yes
        engine_rule_push "$cur" gateway-only ""
    elif [[ "$rest" == "allow-host "* ]]; then
        read -r _ _ host rest <<<"$line"
        [[ -z "${rest:-}" ]] || config_error "$n" "unexpected trailing text" "$raw"
        cfg_host_literal "$host"
        [[ "$host" == *:* ]] \
            || config_error "$n" "allow-host needs <host>:<port>" "$raw"
        # Split at the last colon: host part, port part.
        port="${host##*:}"
        host="${host%:*}"
        if ! cfg_is_port "$port"; then
            config_error "$n" "invalid port '$port' (expected 1-65535)" "$raw"
        fi
        # R-EGL-310-16 F2: keep the accepted `:0443` spelling, but store
        # the decimal value so the compiler, pin record, and verify agree
        # (nft would read a leading-zero dport as octal).
        port="$(cfg_port_canon "$port")"
        val="$host"
        # ARC-59-D1: host fields start alnum or '.' (dstdomain suffix) —
        # never '-'. '--help' / '-x' are flag-shaped tokens.
        [[ "$val" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
            || config_error "$n" "invalid host name '$val'" "$raw"
        # EGL-147-D2: a trailing-dot host is the same dead
        # shape as a trailing-dot allowlist entry (squid can
        # never match it) — the CLI must not mint a conf the
        # parser rejects (ARC-32-D2 symmetry), so the parser
        # names it too.
        [[ "$val" == *. ]] \
            && config_error "$n" "host '$val' has a trailing dot — entries are bare names" "$raw"
        # ARC-32-D2: same DNS length caps as the allowlist
        # predicate (host <= 253, labels 1..63) — the conf
        # must not carry a token the gateway can never use.
        arc32_dns_len_ok "${val#.}" \
            || config_error "$n" "host '$val' exceeds DNS length limits (host <= 253 bytes, labels <= 63)" "$raw"
        engine_rule_push "$cur" allow-host "$val:$port"
    else
        config_error "$n" "unknown rule kind '$rest' (expected allow-host <host>:<port>, or gateway-only)" "$raw"
    fi
}

# "gateway <ip> <port> <path>" arm (EGL-181-D1): IP / subnet
# membership (ARC-11-D3 CIDR math) / port / EGL-381 allowlist-pair
# validation; sets has_gw=yes and the per-profile GW_* entries. Reads
# the aggregator's dir (conf directory) for the allowlist path via
# dynamic scope (EGL-181-D2).
cfg_gateway() {
    local ip port path rest
    [[ -n "$cur" ]] || config_error "$n" "'gateway' outside a profile block" "$raw"
    [[ "$has_gw" == no ]] || config_error "$n" "duplicate 'gateway' directive in profile '$cur'" "$raw"
    read -r _ ip port path rest <<<"$line"
    [[ -z "${rest:-}" ]] || config_error "$n" "unexpected trailing text" "$raw"
    cfg_is_ipv4 "$ip" || config_error "$n" "invalid gateway IP '$ip'" "$raw"
    # Membership + reserved-address exclusion via CIDR math
    # (ARC-11-D3): the static gateway IP must lie strictly
    # between the bridge gateway (first usable) and the anchor
    # (last usable) — never network, broadcast, or either
    # derived address.
    cidr_parse "${PROFILE_SUBNET[$cur]}" \
        || config_error "$n" "invalid profile subnet '${PROFILE_SUBNET[$cur]}'" "$raw"
    local ipu32
    ipu32="$(cidr_u32 "$ip")"
    if (( ipu32 <= CIDR_FIRST || ipu32 >= CIDR_LAST )); then
        config_error "$n" "gateway IP '$ip' is outside the usable range of profile subnet '${PROFILE_SUBNET[$cur]}' (must not be the network address, the bridge gateway, or the anchor address)" "$raw"
    fi
    if ! cfg_is_port "$port"; then
        config_error "$n" "invalid gateway port '$port' (expected 1-65535)" "$raw"
    fi
    # R-EGL-310-16 F2: same decimal normalization as allow-host — the
    # gateway-hop accept is emitted to nft with this token.
    port="$(cfg_port_canon "$port")"
    # EGL-381-D2: the allowlist is the conf's co-located sibling,
    # named exactly "<profile>-allowlist". One equality rule, so a
    # second profile's file cannot be named here (the silent
    # cross-wire) and an absolute path, a path component, or a
    # traversal segment fails the same named way. The IP and port
    # checks above stay first (D2 pin).
    [[ "$path" == "$cur-allowlist" ]] \
        || config_error "$n" "invalid gateway allowlist '$path' (expected '$cur-allowlist', the file next to this conf)" "$raw" \
            "name the allowlist '$cur-allowlist' (the file next to this conf)" \
            "before changing the line, compare '$dir/$cur-allowlist' with the named file: copy the entries you intend into '$cur-allowlist' (mode 0600) and merge into an existing file, never overwrite it blindly" \
            "if the named file belongs to another profile, sits outside this confdir, or is still used by another conf, keep it in place and copy its entries — do not move a shared or externally owned file"
    GW_ALLOWLIST[$cur]="$dir/$path"
    GW_IP[$cur]="$ip"
    GW_PORT[$cur]="$port"
    has_gw=yes
}

# "no-proxy <list>" arm (EGL-181-D1): the comma-split stays inside
# this helper — local IFS=, and unset IFS must not leak to the
# aggregator (EGL-181-D2). Per-entry grammar: literal host + ARC-59-D1 +
# EGL-147-D2 + ARC-32-D2 DNS caps.
cfg_no_proxy() {
    local val rest
    [[ -n "$cur" ]] || config_error "$n" "'no-proxy' outside a profile block" "$raw"
    [[ -z "${PROFILE_NO_PROXY_EXTRA[$cur]:-}" ]] \
        || config_error "$n" "duplicate 'no-proxy' directive in profile '$cur'" "$raw"
    read -r _ val rest <<<"$line"
    [[ -z "${rest:-}" ]] || config_error "$n" "unexpected trailing text" "$raw"
    # R-EGL-454-3 F1: check the WHOLE value before any splitting. The
    # comma-split below is an unquoted expansion, so a token such as
    # `[${X}]` could pathname-expand to a working-directory filename
    # before the per-entry check ever saw the `${` (and inherited
    # nullglob/failglob could silently drop or abort on it). Asking the
    # original value keeps the promise in D2: ANY `${` in a no-proxy
    # entry is the named refusal.
    cfg_host_literal "$val"
    local entry out=""
    # Intentional comma-split of the no-proxy list; each
    # entry is validated against the host grammar below. Disable
    # pathname expansion for the split (restored below): the split must
    # never turn conf text into filenames, regardless of inherited
    # shell options.
    local IFS=,
    local _noglob=0
    [[ $- == *f* ]] && _noglob=1
    (( _noglob )) || set -f
    for entry in $val; do
        entry="$(cfg_trim "$entry")"
        cfg_host_literal "$entry"
        # ARC-59-D1: NO_PROXY entries are host fields — start
        # alnum or '.', never '-'.
        [[ "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*$ ]] \
            || config_error "$n" "invalid NO_PROXY entry '$entry'" "$raw"
        # EGL-147-D2: trailing-dot NO_PROXY entry — same
        # dead-or-surprising shape; named reject like
        # allow-host above.
        [[ "$entry" == *. ]] \
            && config_error "$n" "host '$entry' has a trailing dot — entries are bare names" "$raw"
        # ARC-32-D2: same DNS length caps as the allowlist
        # predicate (host <= 253, labels 1..63).
        arc32_dns_len_ok "${entry#.}" \
            || config_error "$n" "NO_PROXY entry '$entry' exceeds DNS length limits (host <= 253 bytes, labels <= 63)" "$raw"
        out="${out:+$out,}$entry"
    done
    (( _noglob )) || set +f
    unset IFS
    [[ -n "$out" ]] || config_error "$n" "empty no-proxy list" "$raw"
    PROFILE_NO_PROXY_EXTRA[$cur]="$out"
}

# "read-timeout <seconds>" arm (EGL-181-D1): one per block; positive
# integer (EGL-116-D1, R-011-1 octal discipline).
cfg_read_timeout() {
    local val rest
    # EGL-116-D1: per-profile Squid read_timeout (seconds).
    # One per block; positive integer, >= 1, no suffixes, no
    # leading zeros (R-011-1 octal discipline) — anything
    # else fails closed like any unknown directive.
    [[ -n "$cur" ]] || config_error "$n" "'read-timeout' outside a profile block" "$raw"
    [[ -z "${PROFILE_READ_TIMEOUT[$cur]:-}" ]] \
        || config_error "$n" "duplicate 'read-timeout' directive in profile '$cur'" "$raw"
    read -r _ val rest <<<"$line"
    [[ -z "${rest:-}" ]] || config_error "$n" "unexpected trailing text after read-timeout" "$raw"
    [[ "$val" =~ ^[1-9][0-9]*$ ]] \
        || config_error "$n" "invalid read-timeout '$val' (expected a positive integer of seconds, >= 1; no suffixes)" "$raw"
    PROFILE_READ_TIMEOUT[$cur]="$val"
}

load_config() {
    local conf="$1" append="${2:-}"
    [[ -f "$conf" ]] || { echo "Error: config file not found: $conf" >&2; exit 2; }
    # EGL-310 (R-EGL-310-6 F2): an unreadable conf is a load failure like a
    # missing or malformed one. Before this check the shell's raw
    # redirection error ("<conf>: Permission denied") exited 1 with no
    # named cause, while the command help pages state that a conf-load
    # failure exits 2. Name the cause and keep the documented contract
    # (the loop below still fails closed if the file becomes unreadable
    # after this check).
    [[ -r "$conf" ]] || {
        echo "Error: config file cannot be read: $conf (check the file's permissions)" >&2
        exit 2
    }
    ENGINE_CONF_NAME="$conf"
    local dir
    dir="$(cd "$(dirname "$conf")" && pwd)"

    [[ "$append" != 1 ]] && cfg_reset_state

    # Loop-carried state stays in the aggregator; the per-directive
    # helpers above mutate it through bash dynamic scope (EGL-181-D2:
    # no namerefs, no subshell around load_config, config_error stays
    # exit 2 so ARC-38 temp-validate keeps failing closed).
    local raw line n=0 cur="" has_gw has_gw_only
    # EGL-323: one `profile` block per file — the in-file dup-name and
    # subnet-overlap scans retired with the multi-block grammar; the
    # cross-file dup check lives in cfg_profile, subnet overlap is
    # checked at ensure time (ensure_no_overlap).
    # R-008-1 finding 2: block-closing errors are attributed to the
    # profile line that opened the block, not the line where the close
    # was detected.
    local block_line=0 block_raw=""

    while IFS= read -r raw || [[ -n "$raw" ]]; do
        n=$((n+1))
        line="$(cfg_trim "${raw%%#*}")"
        [[ -z "$line" ]] && continue

        case "$line" in
            "profile "*)      cfg_profile ;;
            "creds "*)        cfg_creds ;;
            "rule "*)         cfg_rule ;;
            "gateway "*)      cfg_gateway ;;
            "no-proxy "*)     cfg_no_proxy ;;
            "read-timeout "*) cfg_read_timeout ;;
            *) config_error "$n" "unknown directive" "$raw" ;;
        esac
    done < "$conf"
    # EGL-181-D4: EOF cursor bump kept verbatim (the closer reports
    # block_line); a later ticket must name it before removal.
    n=$((n+1))
    cfg_block_end

    (( ${#PROFILES[@]} > 0 )) || config_error 0 "config defines no profiles"
}

# EGL-365-D14: resolve-failure recovery state — a missing, unreadable, or
# stale pin record is not proof of no installed rule (EGL-391's
# post-swap pin-write window leaves nft applied with no committed pin),
# and a present key is not proof that it matches the live chain. Returns
# one of:
#   never-installed — no pin-record key for this host:port, the chain was
#                     readable, and the chain carries no pin accept on
#                     this port (only the actual gateway hop — daddr ==
#                     GW_IP AND dport == GW_PORT — is not a pin);
#   installed       — a pin-record key exists AND the record matches the
#                     live chain exactly (the full proof `disallow
#                     --direct` requires, so the recommended revocation
#                     can actually run);
#   unknown         — anything else: a missing/unreadable/stale record, a
#                     live accept without a key, or an unreadable chain.
# Read-only: consumes the pin record and the same tcp-dport parse
# write_pin_record/live_pin_daddr use; never mutates anything.
direct_pin_state() { # direct_pin_state <profile> <host> <port>
    local profile="$1" host="$2" port="$3"
    [[ -n "${PROFILE_CONF[$profile]:-}" ]] || { echo unknown; return 0; }
    port="$(cfg_port_canon "$port" 2>/dev/null)" || { echo unknown; return 0; }
    local rec
    rec="$(pin_record_path "$profile")"
    local -A rec_sets=()
    local -a rec_lines=()
    local line key ipset uniq total
    if [[ -e "$rec" || -L "$rec" ]]; then
        # A record that exists but cannot be read whole (unreadable,
        # non-regular, corrupt, disagreeing duplicate, repeated address)
        # cannot prove the absence of a key — unknown, never "never
        # installed".
        [[ -L "$rec" ]] && { echo unknown; return 0; }
        [[ -f "$rec" && -r "$rec" ]] || { echo unknown; return 0; }
        if ! mapfile -t rec_lines < "$rec" 2>/dev/null; then
            echo unknown; return 0
        fi
        for line in "${rec_lines[@]}"; do
            [[ -n "$line" ]] || continue
            if [[ "$line" =~ ^([^|[:space:]]+)\|([0-9]+)[[:space:]]+([0-9.]+( [0-9.]+)*)$ ]]; then
                key="${BASH_REMATCH[1]}|${BASH_REMATCH[2]}"
                ipset="${BASH_REMATCH[3]}"
                if [[ -n "${rec_sets[$key]:-}" && "${rec_sets[$key]}" != "$ipset" ]]; then
                    echo unknown; return 0
                fi
                uniq="$(awk '{for(i=1;i<=NF;i++) print $i}' <<<"$ipset" | LC_ALL=C sort -u | wc -l)"
                total="$(awk '{print NF}' <<<"$ipset")"
                (( uniq == total )) || { echo unknown; return 0; }
                rec_sets[$key]="$ipset"
            else
                echo unknown; return 0
            fi
        done
    fi
    # The live pin accepts: the same parse as write_pin_record and
    # live_pin_daddr, with the gateway hop excluded. A chain that cannot
    # be read is unknown; an absent chain is also unreadable here (the
    # hint cannot prove anything about a firewall state it cannot see).
    local chain subnet raw raw_rc=0 actual
    chain="$(chain_of "$profile")"
    subnet="${PROFILE_SUBNET[$profile]}"
    raw="$(netns_nft list chain inet "$TABLE" "$chain" 2>/dev/null)" || raw_rc=$?
    if (( raw_rc != 0 )) || [[ -z "$raw" ]]; then
        echo unknown; return 0
    fi
    actual="$(canonicalize <<<"$raw")" || { echo unknown; return 0; }
    local -a got_ips=() got_ports=()
    local r ip p pin_re gw_ip="${GW_IP[$profile]:-}"
    pin_re="^ip saddr ${subnet} iifname \"[^\"]+\" ip daddr ([0-9.]+) tcp dport ([0-9]+) counter accept\$"
    while IFS= read -r r; do
        [[ "$r" =~ $pin_re ]] || continue
        ip="${BASH_REMATCH[1]}"
        p="${BASH_REMATCH[2]}"
        # R-EGL-365-18 F-A: exclude ONLY the actual gateway hop
        # (daddr == gw_ip AND dport == GW_PORT). The old daddr-only skip
        # also hid a real direct pin to a service hosted on the gateway,
        # so the never-installed proof claimed "no live flows" over a
        # live accept left by the post-swap pin-write window. Any other
        # gateway-IP accept counts as a pin accept (conservative: it
        # makes the state unknown).
        [[ "$ip" == "$gw_ip" && "$p" == "${GW_PORT[$profile]:-}" ]] && continue
        got_ips+=("$ip")
        got_ports+=("$p")
    done <<<"$actual"
    local key_present=0 target_key="${host}|${port}"
    [[ -n "${rec_sets[$target_key]:-}" ]] && key_present=1
    if (( ! key_present )); then
        # No record key and no live accept on this port: the rule was not
        # installed (a missing record is no key; a corrupt one returned
        # unknown above). Any accept on the port makes the state unknown.
        local port_accept=0
        for p in "${got_ports[@]}"; do
            [[ "$p" == "$port" ]] && { port_accept=1; break; }
        done
        if (( port_accept )); then echo unknown; else echo never-installed; fi
        return 0
    fi
    # A key is present. Recommend the direct revocation only when the
    # record proves it against the live chain exactly as `disallow
    # --direct` will demand: every conf entry covered, total accept count
    # equal, and every member's port and daddr in conf order.
    local -a want_hosts=() want_ports=()
    local hp
    while IFS= read -r hp; do
        [[ -n "$hp" ]] || continue
        want_hosts+=("${hp%:*}")
        want_ports+=("${hp##*:}")
    done < <(profile_allow_hosts "$profile")
    local want_total=0 found_target=0 i
    local -a sizes=()
    for i in "${!want_ports[@]}"; do
        local cset="${rec_sets[${want_hosts[$i]}|${want_ports[$i]}]:-}"
        [[ -n "$cset" ]] || { echo unknown; return 0; }
        local -a members=()
        read -ra members <<<"$cset"
        sizes+=("${#members[@]}")
        want_total=$(( want_total + ${#members[@]} ))
        if [[ "${want_hosts[$i]}" == "$host" && "${want_ports[$i]}" == "$port" ]]; then
            found_target=1
        fi
    done
    (( found_target )) || { echo unknown; return 0; }
    (( want_total == ${#got_ports[@]} )) || { echo unknown; return 0; }
    local k=0 j
    for i in "${!want_ports[@]}"; do
        local cset="${rec_sets[${want_hosts[$i]}|${want_ports[$i]}]:-}"
        local -a members=()
        read -ra members <<<"$cset"
        for j in "${!members[@]}"; do
            [[ "$k" -lt "${#got_ports[@]}" ]] || { echo unknown; return 0; }
            [[ "${want_ports[$i]}" == "${got_ports[$k]}" ]] || { echo unknown; return 0; }
            [[ "${members[$j]}" == "${got_ips[$k]}" ]] || { echo unknown; return 0; }
            k=$(( k + 1 ))
        done
    done
    (( k == want_total )) || { echo unknown; return 0; }
    echo installed
}

# EGL-365-D14/F-B (R-EGL-365-18): the direct-rule conf line EXACTLY as the
# operator's file spells it. The parsed host:port is canonical (a
# leading-zero port is normalized), so quoting the canonical form can name
# a line that is not in the file — a dead-end recovery on a documented
# hand-edit path. Re-read the block and return the stored directive text
# (leading indentation and a trailing comment dropped); rc 1 when no line
# matches (the caller then identifies the rule without quoting a literal).
conf_allow_host_raw_line() { # conf_allow_host_raw_line <conf> <profile> <host> <port>
    local conf="$1" profile="$2" host="$3" port="$4"
    local raw line in_block=0 hp rhost rport
    [[ -r "$conf" ]] || return 1
    while IFS= read -r raw || [[ -n "$raw" ]]; do
        line="$(cfg_trim "${raw%%#*}")"
        if [[ "$line" =~ ^profile[[:space:]]+([a-z0-9][a-z0-9-]*)[[:space:]]+ ]]; then
            in_block=0
            [[ "${BASH_REMATCH[1]}" == "$profile" ]] && in_block=1
            continue
        fi
        (( in_block )) || continue
        [[ "$line" =~ ^rule[[:space:]]+allow-host[[:space:]]+([^[:space:]]+)$ ]] || continue
        hp="${BASH_REMATCH[1]}"
        [[ "$hp" == *:* ]] || continue
        rport="${hp##*:}"; rhost="${hp%:*}"
        cfg_is_port "$rport" || continue
        rport="$(cfg_port_canon "$rport")" || continue
        if [[ "$rhost" == "$host" && "$rport" == "$port" ]]; then
            printf '%s' "$line"
            return 0
        fi
    done < "$conf"
    return 1
}

# EGL-120-D1 (EGL-365-D14 wording): remediation hint after a direct-pin
# resolve failure on the ensure/install path — every time (ensure is not
# a paste-safe feed; a one-time note is missed on retry), stderr only.
# Verify-pin mode gets NO hint: it has its own `verify: no live pin ...`
# message. Exactly one three-state branch (D14):
#   never-installed — safe to delete the conf line; alternatives print
#                     only after that instruction (`after that line is
#                     gone, ...`) and are runnable without re-reading it;
#                     the quoted line is the RAW stored spelling (F-B), so
#                     a hand-edited :0673 rule can be deleted;
#   installed       — the running firewall still allows it; the direct
#                     revocation is the only next action;
#   unknown         — never claim absent flows, never recommend a
#                     conf-only delete, never recommend a disallow that
#                     can fail; name the uncertainty and `verify`.
# Every printed next action uses the canonical direct form and a canonical
# decimal port.
allow_host_resolve_hint() { # allow_host_resolve_hint <profile> <host> <port>
    local profile="$1" host="$2" port="$3" conf state raw_line rule_ref
    conf="${ENGINE_CONF:-${PROFILE_CONF[$profile]:-}}"
    port="$(cfg_port_canon "$port" 2>/dev/null)" || true
    state="$(direct_pin_state "$profile" "$host" "$port")"
    case "$state" in
        never-installed)
            if raw_line="$(conf_allow_host_raw_line "$conf" "$profile" "$host" "$port")" && [[ -n "$raw_line" ]]; then
                rule_ref="delete the line '$raw_line' from $conf"
            else
                rule_ref="delete the 'rule allow-host' line for ${host}:${port} from $conf"
            fi
            echo "hint: this rule is in $conf but was not installed — no live flows were opened; $rule_ref"
            echo "hint: after that line is gone, for a same-host HTTP(S) service use: egresslock allow $profile ${host}:${port}"
            echo "hint: after that line is gone, for a same-host non-HTTP service use: egresslock allow $profile 169.254.1.2:${port} --direct"
            ;;
        installed)
            echo "hint: this rule was installed before the resolve failure; the running firewall still allows it — remove it and end its flows with: egresslock disallow $profile ${host}:${port} --direct"
            ;;
        *)
            echo "hint: the name did not resolve. Whether a firewall grant for this host:port is live is not proved."
            echo "hint: inspect: egresslock verify $profile"
            echo "hint: do not delete the conf line and re-ensure — that can drop a live grant without ending its flows. Do not run disallow --direct unless verify shows a matching pin record."
            ;;
    esac >&2
}

#
# Generic rule compiler. Emits, per profile, in order:
#   1. implicit established/related + DNS-to-gateway allows;
#   2. config rules in config order (allow-host resolved NOW, fail closed);
#   3. the terminal rule, derived — never configured: a scoped drop,
#      preceded by the gateway-source exemption when a gateway exists
#      (ARC-2-D4).
#
# EGL-391-D4: one nft-input write. A failed write (ENOSPC, a closed
# descriptor, a full /tmp) sets POLICY_EMIT_FAILED and returns nonzero;
# callers must propagate it. A later successful emission must never mask
# an earlier failed one (the group-status and last-command-status traps
# this ticket closes).
policy_emit() { # policy_emit <line> — one nft-input line to stdout
    printf '%s\n' "$1" || { POLICY_EMIT_FAILED=1; return 1; }
}

compiled_rules() {
    local profile="$1" subnet gateway bridge
    POLICY_EMIT_FAILED=0
    subnet="${PROFILE_SUBNET[$profile]}"
    # The DNS allow targets the bridge gateway = first usable address
    # (ARC-11-D3); integer CIDR math, any supported prefix.
    cidr_parse "$subnet" || die "invalid subnet '$subnet'"
    gateway="$(cidr_ip "$CIDR_FIRST")"
    # EGL-141-D1: the bridge device is live-resolved inside the emit
    # path; EGL-515 D3 remembers the successfully resolved name for this
    # run after the netns link check, so later refreshes reuse it. A
    # resolution failure must fail the BUILDER by rc (EGL-120-D1 pattern) — this
    # compiler runs inside a set -e-inert substitution in the install
    # file builder, so die() would only exit the subshell. Never emit
    # an empty iifname. Resolve WITHOUT `$()` here so the run-scoped
    # cache write lands in this shell; the value comes back through
    # PROFILE_BRIDGE_IF.
    profile_bridge_if "$profile" >/dev/null || {
        echo "Error: policy emit aborted for profile '$profile' (bridge interface unresolved, fail closed)" >&2
        return 1
    }
    bridge="$PROFILE_BRIDGE_IF"

    # EGL-141-D2: counted early anti-spoof drop, FIRST (drop is terminal
    # across base chains, ARC-52-D3). Out-of-bridge in-subnet-saddr
    # packets get a NAMED, counted spoof verdict, not an incidental
    # terminal hit; out-of-subnet sources (C-5/E-01) still ride the base
    # accept (EGL-145). The line starts with `iifname !=`; nft preserves
    # written order (EGL-141-D1), and EGL-481-D1's drop-only canonical
    # filter keeps every rule line, so the named spoof verdict is
    # compared.
    # EGL-391-D4: every emission is checked individually — a middle
    # failure must abort the build, never leave a valid-but-incomplete
    # candidate for nft.
    policy_emit "iifname != \"${bridge}\" ip saddr ${subnet} counter drop" || return 1
    # EGL-141-D1: every saddr-keyed ACCEPT is scoped to the profile's
    # own bridge. Emit `ip saddr` FIRST so the rule reads in the
    # familiar source-first order, then `iifname` (the EGL-123-D2
    # pattern for `ether saddr`; nft preserves written order,
    # EGL-141-D1). EGL-481-D1 compares every rule line, so no emitted
    # leading token needs a keep-list entry.
    policy_emit "ip saddr ${subnet} iifname \"${bridge}\" ct state established,related counter accept" || return 1
    policy_emit "ip saddr ${subnet} iifname \"${bridge}\" ip daddr ${gateway} meta l4proto { tcp, udp } th dport 53 counter accept" || return 1

    local i kind arg pfx="${profile}|"
    local hip hport dip
    for i in "${!ENGINE_KINDS[@]}"; do
        [[ "${ENGINE_KINDS[$i]}" == "$pfx"* ]] || continue
        kind="${ENGINE_KINDS[$i]#"$pfx"}"
        arg="${ENGINE_ARGS[$i]}"
        case "$kind" in
            allow-host)
                hip="${arg%:*}"; hport="${arg##*:}"
                # EGL-120-D1: capture-and-check. The substitution's die
                # ("cannot resolve") exits only the subshell, and this
                # compiler can run inside a set -e-inert assignment
                # substitution (install_policy's refresh-file builder) —
                # an unchecked failure there continued with an empty
                # daddr and emitted a malformed nft rule for nft to
                # reject. Catch the failure EXPLICITLY, hint, and
                # propagate by rc so no nft -f ever runs on a partial
                # file.
                if ! dip="$(resolved_dest "$hip")"; then
                    if [[ "$VERIFY_PIN_MODE" == 0 ]]; then
                        allow_host_resolve_hint "$profile" "$hip" "$hport"
                    fi
                    return 1
                fi
                # Belt: an empty IP with rc 0 (a die swallowed again)
                # must never render an empty daddr.
                [[ -n "$dip" ]] || die "cannot resolve $hip"
                # EGL-219-D1: the pin is the whole ensure-time A set
                # (any-of) — one accept per resolved address per port.
                # The set is the sorted cache/record value; the loop
                # order is the canonical order, so the chain, the pin
                # record, and the verify zip agree member-for-member.
                local member
                for member in $dip; do
                    policy_emit "ip saddr ${subnet} iifname \"${bridge}\" ip daddr ${member} tcp dport ${hport} counter accept" || return 1
                done
                ;;
            gateway-only)
                # EGL-141-D1: the gateway-hop accept is saddr-keyed and
                # therefore iifname-scoped like every accept.
                policy_emit "ip saddr ${subnet} iifname \"${bridge}\" ip daddr ${GW_IP[$profile]} tcp dport ${GW_PORT[$profile]} counter accept" || return 1
                ;;
        esac
    done

    # ARC-2-D4 + EGL-123-D2: the gateway's own egress is exempted
    # INSIDE this chain, then the terminal scoped drop. The exemption
    # keys on source IP *and* the kit-derived gateway MAC, so a
    # co-located sibling spoofing only the gateway IP falls through
    # to the drop. The MAC comes from conf identity (gw_mac), never a
    # live inspect (EGL-91). One line, like every other rule line
    # (EGL-481-D1's drop-only canonical filter keeps it). EGL-141-D1
    # adds the bridge
    # scope (saddr+iifname+MAC); closures narrow, never widen (the
    # cross-bridge MAC+IP clone, X-5, is closed; the same-bridge
    # clone stays the EGL-142 residual).
    policy_emit "ip saddr ${GW_IP[$profile]} iifname \"${bridge}\" ether saddr $(gw_mac "$profile") counter accept" || return 1
    # EGL-141-D1: the terminal drop stays saddr-keyed and
    # interface-UNscoped — with D2's anti-spoof first it remains
    # the in-bridge C-4 diagnostic; it must keep adjudicating an
    # out-of-bridge in-subnet packet if the anti-spoof rule were
    # absent.
    policy_emit "ip saddr ${subnet} counter drop" || return 1
}

#
# Resolve a profile's allowlist source file: the `<profile>-allowlist`
# sibling of the conf, as enforced by the `gateway` directive's parser
# (EGL-381-D2; GW_ALLOWLIST holds the resolved absolute path).
#
allowlist_src() {
    echo "${GW_ALLOWLIST[$1]}"
}

#
# EGL-106-D2: build ONE nft -f file for the whole policy install — the
# shared p_v6deny chain and the profile chain in a SINGLE transaction.
# nft applies a -f file as one atomic netlink batch, so observers never
# see "v6deny installed, profile chain missing" (the inter-transaction
# first-create window EGL-106 closes): they see the pre-install state
# or both chains complete. Existence probes are reads; `flush chain`
# is emitted ONLY for a chain the probe found — flush of a missing
# chain fails the batch (D1 fail-closed). Chain blocks: p_v6deny
# FIRST, profile chain LAST (R-003-7 intent: the profile content is
# the last chain block; with one -f there is no "last file" anymore).
# EGL-120-D1: a rule-generation failure deletes the temp and returns
# rc 1 with no file — no -f, no partial transaction, no second Error
# line (the resolve failure already reported itself).
#
# Four combinations fall out of the two probes:
#   p_v6deny missing + profile missing -> create both (first install)
#   p_v6deny exists + profile missing  -> flush v6deny, create-with-rules
#                                         profile (typical first create)
#   p_v6deny missing + profile exists  -> create v6deny, flush+re-add
#                                         profile
#   both exist                         -> flush+re-add both (warm
#                                         ensure / R-003-7 refresh)
#
policy_install_file() { # policy_install_file <profile> -> tmp path; rc 1 on rule-gen/write failure
    local profile="$1" chain
    chain="$(chain_of "$profile")"
    local v6_exists=no profile_exists=no
    if netns_nft list chain inet "$TABLE" p_v6deny >/dev/null 2>&1; then
        v6_exists=yes
    fi
    if netns_nft list chain inet "$TABLE" "$chain" >/dev/null 2>&1; then
        profile_exists=yes
    fi
    local tmp
    tmp="$(mktemp /tmp/egresslock-policy.XXXXXX.nft)" || {
        echo "Error: cannot create a temporary policy file in /tmp: the firewall is unchanged" >&2
        return 1
    }
    # EGL-391-D4: every nft-input write is checked individually. A
    # brace group's status is the LAST command's, so a middle failure
    # followed by a later successful echo used to return 0 and let
    # nft -f install a valid-but-weaker ruleset. grp_rc covers the
    # header/closing writes; POLICY_EMIT_FAILED covers compiled_rules'
    # emissions. Cleanup is best-effort and never masks the primary rc.
    local rules_rc=0 grp_rc=0
    POLICY_EMIT_FAILED=0
    if ! {
        if [[ "$v6_exists" == yes ]]; then
            policy_emit "flush chain inet ${TABLE} p_v6deny" || grp_rc=1
        fi
        if [[ "$profile_exists" == yes ]]; then
            policy_emit "flush chain inet ${TABLE} ${chain}" || grp_rc=1
        fi
        policy_emit "table inet ${TABLE} {" || grp_rc=1
        policy_emit "    chain p_v6deny {" || grp_rc=1
        policy_emit "        type filter hook forward priority -160; policy accept;" || grp_rc=1
        policy_emit "        meta nfproto ipv6 counter drop" || grp_rc=1
        policy_emit "    }" || grp_rc=1
        policy_emit "    chain ${chain} {" || grp_rc=1
        policy_emit "        type filter hook forward priority -150; policy accept;" || grp_rc=1
        # EGL-120-D1: a rule-generation failure (unresolvable allow-host)
        # must delete the temp file and fail the builder by rc — never
        # emit a partial file for nft to reject.
        policy_rules "$profile" || rules_rc=1
        policy_emit "    }" || grp_rc=1
        policy_emit "}" || grp_rc=1
    } > "$tmp"; then
        grp_rc=1
    fi
    if (( POLICY_EMIT_FAILED || grp_rc )); then
        rm -f "$tmp" 2>/dev/null || true
        echo "Error: cannot write the temporary policy file for profile '$profile' in /tmp: the firewall is unchanged" >&2
        return 1
    fi
    if (( rules_rc != 0 )); then
        rm -f "$tmp" 2>/dev/null || true
        return 1
    fi
    echo "$tmp"
}

install_policy() {
    local profile="$1" chain f
    chain="$(chain_of "$profile")"
    # EGL-219-D3: resolve every conf allow-host ONCE, into the per-run
    # cache, BEFORE the ruleset build — so one resolve feeds the rule
    # build, the pin record, and the announce. Parent scope (not a
    # subshell: policy_install_file runs the compiler in-process), so
    # the cache survives into write_pin_record and
    # ensure_announce_refreshed. An unresolvable host fails here with
    # the ruleset untouched (fail-closed install unchanged).
    ensure_resolve_pins "$profile" || return 1
    # EGL-106-D1: the whole install is ONE `netns_nft -f` transaction —
    # the shared p_v6deny chain (create-if-missing, else flush+re-add)
    # and the profile chain (create-with-rules, or flush+re-add) in the
    # same file. Two files left an inter-transaction window on first
    # create (v6deny landed, profile chain missing: a concurrent IPv4
    # forward rode Netavark's default accept); one atomic -f closes it
    # without touching the EGL-91-D4 ensure order. Additive re-emission
    # used to stack duplicate v6 deny rules; flush-if-exists self-heals
    # that inside the same transaction.
    f="$(policy_install_file "$profile")" || return 1
    # ARC-49 F1: explicit rm + die (no EXIT trap) — a failed -f leaves
    # no /tmp/egresslock-policy.* behind. EGL-391-D4: cleanup is
    # best-effort and must not mask the named install failure.
    if ! netns_nft -f "$f"; then
        rm -f "$f" 2>/dev/null || true
        die "nft policy install failed for profile '$profile' (fail closed)"
    fi
    # EGL-305: the atomic -f applied — the ruleset is swapped from here
    # on. Set IMMEDIATELY (before the post-swap rm -f below) so every
    # later failure reads swapped, not restore; the cmd_ensure EXIT trap
    # (ensure_exit_trap) consumes this flag. If the swap ever moves out
    # of install_policy, this set-site moves with it.
    ENSURE_POLICY_SWAPPED=1
    # EGL-391: the swap flag is set BEFORE this cleanup, so a failure
    # here is a post-apply failure the EXIT-trap disclosure (S3) covers.
    # stderr is dropped so the temp path is not printed; the named state
    # line is the operator surface.
    rm -f "$f" 2>/dev/null
    # Remove the deprecated separate exemption chain (pre-ARC-5-D4
    # layout). Safe at any time: the exemption lives in the class chain.
    netns_nft flush chain inet "$TABLE" p_gw_egress >/dev/null 2>&1 || true
    netns_nft delete chain inet "$TABLE" p_gw_egress >/dev/null 2>&1 || true
}

#
# Canonicalize an nft chain listing to its semantic content: strip
# counter packet/byte expansion (real nft prints 'counter packets N bytes
# N'), drop indentation, keep only rule lines, PRESERVING order. Expected
# and actual compare equal iff the ordered rules match; order matters, so
# no sorting (R-003-7 finding 2).
#
# EGL-98-D2: stale-unpolicied predicate. A profile is stale when its
# podman network OBJECT survives (on-disk) while its policy chain is
# absent from the shared rootless netns (volatile) — the post-reboot
# window, where a raw `podman run --network egresslock-<p>` re-plumbs
# netavark and recreates the netns with NO egresslock table. The chain
# is the scope, not the table: the table is shared (ARC-66-D4), so a
# sibling's re-ensure recreates it while this profile's chain is still
# missing. Teardown removes the network object and a never-ensured
# profile has none, so neither is stale (the ARC-16-D3 silent skip is
# preserved). Torn state (chain present, anchor dead — EGL-91/EGL-97)
# is NOT this predicate: callers keep the `verify: anchor … not running`
# line.
#
# Returns 0 = stale-unpolicied; 1 = not stale; 2 = hard probe failure
# (nft missing / netns not answering) — the named R9 failure is emitted
# here and callers never fold it into a silent success or skip.
profile_stale_unpolicied() { # profile_stale_unpolicied <profile> [network-known-present]
    local profile="$1" out rc=0
    # (1) the on-disk half: the network object. Absent = never-ensured
    # or teardown'd = not stale (silent skip preserved). EGL-515 D3: a
    # caller that just read the same network object in this window may
    # pass 1; no state changes between the two reads.
    if [[ "${2:-0}" != 1 ]]; then
        rt_network_inspect "$(network_of "$profile")" >/dev/null 2>&1 || return 1
    fi
    # (2) the volatile half: the profile chain. nft answers "No such
    # file or directory" when the chain is missing (fresh netns, no
    # table, or sibling-ensured-without-us); any other failure is a
    # hard probe failure — named, fail closed, never a skip (R9).
    if out="$(netns_nft list chain inet "$TABLE" "$(chain_of "$profile")" 2>&1)"; then
        return 1
    else
        rc=$?
    fi
    if [[ "$out" == *"No such file or directory"* ]]; then
        return 0
    fi
    echo "Error: cannot probe the nft policy for profile '$profile' in the rootless netns (rc=$rc): ${out:-<no output>}; check pasta/podman health — run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
    return 2
}

# EGL-178-D1: verify_policy step helpers (probe / read / compare).
# verify_policy stays the public entry point and the order document:
# network -> stale window -> anchor -> foreign hooks -> shared v6-deny
# chain -> profile chain. The a141 mismatch/tamper fixtures and the
# EGL-98 stale-unpolicied fixtures pin every named failure below.
verify_policy_preflight() { # EGL-178-D1: state probes, three named fails kept distinct
    local profile="$1" anchor
    rt_network_inspect "$(network_of "$profile")" >/dev/null 2>&1 \
        || { echo "verify: network $(network_of "$profile") missing — run: egresslock ensure $profile$(ensure_scope_suffix)" >&2; return 1; }
    # EGL-98-D2: stale-unpolicied window. Name the real state and its
    # runnable next action (R9) instead of a true-but-unexplained
    # "anchor not running"; torn state keeps that anchor line. A hard
    # probe failure (rc 2) is already named by the helper; fail closed.
    local stale=0
    # EGL-515 D3: the network object was just read above in this window.
    profile_stale_unpolicied "$profile" 1 || stale=$?
    if (( stale == 2 )); then
        return 1
    fi
    if (( stale == 0 )); then
        echo "verify: network exists but policy does not — run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
        return 1
    fi
    anchor="$(anchor_of "$profile")"
    anchor_running "$anchor" \
        || { echo "verify: anchor $anchor not running" >&2; return 1; }

    # ARC-52-D3: verify sees only its own table, but nft accept is not
    # terminal across base chains — another table's forward-hook drop at
    # the same or earlier priority silently overrides this kit's accepts
    # (on-host: a leftover policy table killed all workload egress while
    # verify was green). Fail closed on foreign early hooks; never delete
    # anything here (ensure owns cleanup).
    verify_no_early_foreign_hooks || return 1
}

verify_v6deny_chain() { # EGL-178-D1: shared chain compare (profile arg for the ensure hint)
    # Shared unscoped IPv6 deny chain: exact ordered content.
    local v6 v6actual v6expected
    v6="$(netns_nft list chain inet "$TABLE" p_v6deny 2>/dev/null || true)"
    v6actual="$(canonicalize <<<"$v6")"
    v6expected="$(printf '%s\n' \
        'type filter hook forward priority -160; policy accept;' \
        'meta nfproto ipv6 counter drop')"
    if [[ "$v6actual" != "$v6expected" ]]; then
        # EGL-131-D3: the first line names the true state and the runnable
        # fix; the raw diff stays as supporting detail. The v6 chain is
        # engine-defined (not conf-derived), so no conf-change case here.
        echo "verify: shared v6-deny chain missing or does not match the expected policy (the live chain is not what this engine would install now — often after an upgrade) — run: egresslock ensure $1$(ensure_scope_suffix)" >&2
        echo 'details: chain diff — "<" is the expected shared IPv6 deny chain, ">" is the live one' >&2
        diff <(echo "$v6expected") <(echo "$v6actual") >&2 || true
        return 1
    fi
}

verify_profile_chain() { # EGL-178-D1: profile chain compare; the ONLY verify-path caller of verify_expected_rules
    local profile="$1" chain
    chain="$(chain_of "$profile")"
    # Profile chain: hook, priority, and the exact ORDERED rule set.
    # ARC-12-D1 as amended by EGL-140-D1: allow-host daddrs in the
    # EXPECTED ruleset come from the ensure-time confdir pin record
    # (verify_expected_rules -> read_pin_record), so DNS drift is not a
    # verify failure and a tampered chain cannot adopt its own daddrs;
    # the zip's count/port checks still fail closed on structural
    # mismatch, and each live daddr is compared against the record
    # (divergence = post-ensure chain edit, named fail). resolve_set is
    # NOT called here.
    # NOTE: verify_expected_rules runs WITHOUT a command substitution
    # (no $() ) because it fills VERIFY_PINS for check_dns_drift; a
    # subshell would discard those assignments.
    local raw actual
    raw="$(netns_nft list chain inet "$TABLE" "$chain" 2>/dev/null || true)"
    actual="$(canonicalize <<<"$raw")"
    # EGL-460-D6: export the listing this run is about to prove (the
    # compare below). The direct-lane confirmation consumes it instead
    # of a fresh read.
    VERIFY_PROFILE_CHAIN_CANON="$actual"
    VERIFY_PINS=()
    # verify_expected_rules FILLS VERIFY_PINS (consumed by
    # check_dns_drift), so it must NOT run inside a $() subshell:
    # capture its output via a temp file instead.
    # EGL-391-D4: every /tmp write on this path is guarded; a failed
    # temp write is named S9 and never also reads as a chain mismatch.
    local pinfile
    pinfile="$(mktemp /tmp/egresslock-verify.XXXXXX)" || {
        echo "verify: cannot write the temporary expected-ruleset file in /tmp; the policy could not be checked (exit 1)" >&2
        return 1
    }
    local ok=1
    POLICY_EMIT_FAILED=0
    if ! verify_expected_rules "$profile" > "$pinfile"; then ok=0; fi
    if (( ok == 0 )); then
        rm -f "$pinfile" 2>/dev/null || true
        if (( POLICY_EMIT_FAILED )); then
            echo "verify: cannot write the temporary expected-ruleset file in /tmp; the policy could not be checked (exit 1)" >&2
            return 1
        fi
        # EGL-131-D2: verify_expected_rules already printed a named cause
        # (pin record missing/corrupt, direct pin/port/count mismatch);
        # the generic chain line is not stacked on top (one cause per
        # line — MESSAGE_RULES.md / OPERATOR_MESSAGES.md §5).
        return 1
    fi
    if ! printf '%s\n' "type filter hook forward priority -150; policy accept;" > "$pinfile.new"; then
        rm -f "$pinfile" "$pinfile.new" 2>/dev/null || true
        echo "verify: cannot write the temporary expected-ruleset file in /tmp; the policy could not be checked (exit 1)" >&2
        return 1
    fi
    # EGL-391-D4: the header write and the `cat` are checked separately.
    # A group would return only the last command's status, so a failed
    # header followed by a successful cat could compare (and verify) a
    # chain with no forward hook.
    if ! cat "$pinfile" >> "$pinfile.new"; then
        rm -f "$pinfile" "$pinfile.new" 2>/dev/null || true
        echo "verify: cannot write the temporary expected-ruleset file in /tmp; the policy could not be checked (exit 1)" >&2
        return 1
    fi
    if ! mv -f "$pinfile.new" "$pinfile" 2>/dev/null; then
        rm -f "$pinfile" "$pinfile.new" 2>/dev/null || true
        echo "verify: cannot write the temporary expected-ruleset file in /tmp; the policy could not be checked (exit 1)" >&2
        return 1
    fi
    local expected # EGL-178-D6: was an undeclared file-scope global; no consumer outside this compare
    if ! expected="$(cat "$pinfile")"; then
        rm -f "$pinfile" 2>/dev/null || true
        echo "verify: cannot write the temporary expected-ruleset file in /tmp; the policy could not be checked (exit 1)" >&2
        return 1
    fi
    rm -f "$pinfile" 2>/dev/null || true
    if [[ "$actual" != "$expected" ]]; then
        # EGL-131-D1: keep the searchable phrase byte-identical, then name
        # the true state and the runnable fix; the raw diff stays as
        # supporting detail under the `details:` line.
        echo "verify: policy chain $chain does not match the expected ruleset (the live chain is not what this engine would install now — often after an upgrade or a conf change) — run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
        echo 'details: ruleset diff — "<" is the expected ruleset, ">" is the live one' >&2
        diff <(echo "$expected") <(echo "$actual") >&2 || true
        return 1
    fi
}

# EGL-502-D3 (P2): the shared EGL-481 unexpected-chain enumeration — the
# expected set (the shared v6-deny chain plus every profile conf chain in
# <confdir>) and the table's chain-header walk, in one place so verify and
# ensure cannot drift (drift means verify names a chain ensure will not
# remove, or ensure deletes what verify tolerates). Non-dying: on a
# successful table read fills UNEXPECTED_CHAINS (live-only names, listing
# order) and returns 0; a failed read returns 2 (the revoke_pending_scan
# scanner shape). Consumers keep their own message and rc mapping.
unexpected_chains() { # unexpected_chains <confdir> -> rc 0 read / 2 failed read; fills UNEXPECTED_CHAINS
    local confdir="$1" conf line name
    local -A expected=()
    UNEXPECTED_CHAINS=()
    expected[p_v6deny]=1
    for conf in "$confdir"/*.conf; do
        [[ -f "$conf" ]] || continue
        expected["$(chain_of "$(conf_basename "$conf")")"]=1
    done
    local listing rc=0
    listing="$(netns_nft list table inet "$TABLE" 2>&1)" || rc=$?
    (( rc == 0 )) || return 2
    # Chain headers are whitespace-indented in both real nft output
    # (inside the `table inet ... {` wrapper) and the test mock; set,
    # map, comment, and rule lines are ignored here.
    while IFS= read -r line; do
        [[ "$line" =~ ^[[:space:]]*chain[[:space:]]+([^[:space:]{}]+) ]] || continue
        name="${BASH_REMATCH[1]}"
        [[ -n "${expected[$name]:-}" ]] && continue
        UNEXPECTED_CHAINS+=("$name")
    done <<<"$listing"
    return 0
}

verify_chain_set() { # EGL-481-D2: every live chain in the kit table must be expected
    # The content compares above see only the two known chains
    # (p_v6deny, the named profile's chain). A foreign chain — empty,
    # populated, or hooked — is a live writer the engine did not
    # install: fail on its PRESENCE alone (hook/content shape is the
    # fragile pattern this ticket removes; X-34's p_evil had its own
    # forward hook). Expected set: every profile config in the account
    # confdir, not just the verified one, so a sibling profile's chain
    # is never foreign under a named verify. No missing-chain check:
    # absence is the profile/v6-deny compares' and the EGL-98 stale
    # path's job, and demanding presence would falsely fail a conf
    # that was never ensured.
    local profile="$1" confdir name
    confdir="$(confdir_default)" || return 1
    # A failed table read is its own named fail-closed line, never a
    # drift claim: the check could not determine whether a foreign
    # chain exists. Reached only after both content compares passed,
    # so this is a read fault, not a missing table.
    local rc=0
    unexpected_chains "$confdir" || rc=$?
    if (( rc != 0 )); then
        echo "verify: cannot read the egresslock firewall table; the policy could not be checked (exit 1) — no drift result was determined; retry: egresslock verify $profile" >&2
        return 1
    fi
    if (( ${#UNEXPECTED_CHAINS[@]} > 0 )); then
        # One named line per chain (one cause per line). The flush and
        # delete remedies stay on THIS one printed line: the EGL-175
        # seam carves out the `podman unshare --rootless-netns nft
        # delete` substring, and a separate flush-only line would trip
        # it. Flush first: deleting a rule-bearing chain fails.
        for name in "${UNEXPECTED_CHAINS[@]}"; do
            echo "verify: unexpected chain '$name' in the egresslock firewall table (no profile config in $confdir defines it) — run: egresslock ensure $profile$(ensure_scope_suffix) to remove it, or remove it yourself: podman unshare --rootless-netns nft flush chain inet egresslock '$name' && podman unshare --rootless-netns nft delete chain inet egresslock '$name'" >&2
        done
        return 1
    fi
    return 0
}

ensure_remove_unexpected_chains() { # ensure_remove_unexpected_chains <profile>
    # EGL-481-D3 (2026-11-07 rework): verify stays read-only and still
    # fails on presence (timer red). ensure of any remaining profile
    # removes unexpected chains so a deleted conf's leftover does not
    # brick the rest of the kit. Each removal is named (not silent).
    # Failed removal is its own named line; the caller exits 1 without
    # stacking a generic die (verify_policy is not reached). A failed
    # table read is left for verify_policy's named not-drift line.
    local profile="$1" confdir name
    confdir="$(confdir_default)" || return 1
    local rc=0
    unexpected_chains "$confdir" || rc=$?
    (( rc == 0 )) || return 0
    local failed=0
    if (( ${#UNEXPECTED_CHAINS[@]} > 0 )); then
        for name in "${UNEXPECTED_CHAINS[@]}"; do
            if netns_nft flush chain inet "$TABLE" "$name" >/dev/null 2>&1 \
               && netns_nft delete chain inet "$TABLE" "$name" >/dev/null 2>&1; then
                echo "ensure: removed unexpected chain '$name' from the egresslock firewall table (no profile config in $confdir defines it)" >&2
            else
                echo "ensure: could not remove unexpected chain '$name' from the egresslock firewall table — remove it: podman unshare --rootless-netns nft flush chain inet egresslock '$name' && podman unshare --rootless-netns nft delete chain inet egresslock '$name'" >&2
                failed=1
            fi
        done
    fi
    (( failed == 0 ))
}

verify_policy() {
    # EGL-178-D1: aggregator. The step order here is the order document;
    # fail-closed rc mapping and every message string are unchanged.
    # Review R-003-3/R-003-7: verify the COMPLETE policy with semantic
    # ORDER preserved: the shared v6-deny chain (type, priority, policy,
    # exact rule order) and the profile chain (hook, priority, exact
    # ordered ruleset). nft first-match semantics mean a reordered
    # accept/drop is a different policy, so nothing is sorted.
    # EGL-481-D2: the chain-set walk runs LAST so a content mismatch
    # keeps today's message precedence (a table tampered in both
    # classes names the rule mismatch on this run; the unexpected
    # chain is named once the content is repaired).
    local profile="$1"
    verify_policy_preflight "$profile" || return 1
    verify_v6deny_chain "$profile" || return 1
    verify_profile_chain "$profile" || return 1
    verify_chain_set "$profile" || return 1
}

canonicalize() {
    # Normalize an nft chain listing to its semantic content, PRESERVING
    # rule order: real output indents rules (R-003-4: filter AFTER
    # de-indenting), expands counters, and renders priorities as named
    # aliases ('mangle' = -150; -160 renders as 'mangle - 10'). Order
    # matters (R-003-7 finding 2): first-match semantics mean a
    # reordered accept/drop changes the policy, so NO sorting here.
    # EGL-481-D1: compare EVERY rule, not a fixed leading-token list. The
    # old keep-filter (`^(type filter|ip saddr|meta nfproto|iifname)`)
    # silently dropped a live rule whose first token was anything else —
    # `ip daddr`, `ip6`, `tcp dport`, `meta mark`, `ct state`, `ether`,
    # `oifname`, … — and the expected side never carries such a rule, so
    # verify stayed green under a whole tamper class (X-34, live-miss).
    # Drop ONLY the listing's structure: the `table`/`chain` wrapper
    # lines, closing braces, and blank lines. Every rule line is kept in
    # order, so first-match semantics are compared unchanged (R-003-7).
    # Healthy chains emit only rule lines, so the success-path canonical
    # stream is byte-identical for every consumer. `^oifname` is no
    # longer a named blind spot: EGL-48's exclusion is retired (nothing
    # in the engine emits it, and it is a tamper class).
    sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//
        s/counter packets [0-9]+ bytes [0-9]+/counter/
        s/priority mangle - 10/priority -160/
        s/priority mangle;/priority -150;/' \
        | grep -vE '^(table |chain |\}|$)'
}

#
# ARC-52-D3: numeric value of an nft `priority <spec>` rendering, as
# `nft list ruleset` prints it — bare numbers ('-150'), named aliases
# ('filter' = 0, 'mangle' = -150, 'mangle - 10' = -160, plus the other
# standard names), or empty/unknown (return 1: the spec cannot be
# judged, so callers skip it instead of guessing).
#
nft_priority_value() {
    local spec="$1" base num=0
    spec="${spec#"${spec%%[![:space:]]*}"}"
    spec="${spec%"${spec##*[![:space:]]}"}"
    if [[ "$spec" =~ ^-?[0-9]+$ ]]; then
        echo "$spec"
        return 0
    fi
    base="$spec"
    if [[ "$spec" =~ ^([a-z]+)[[:space:]]+([+-])[[:space:]]*([0-9]+)$ ]]; then
        base="${BASH_REMATCH[1]}"
        if [[ "${BASH_REMATCH[2]}" == "-" ]]; then
            num=$(( -BASH_REMATCH[3] ))
        else
            num=$(( BASH_REMATCH[3] ))
        fi
    fi
    case "$base" in
        raw)      echo $(( -300 + num )) ;;
        mangle)   echo $(( -150 + num )) ;;
        dstnat)   echo $(( -100 + num )) ;;
        filter)   echo $(( num )) ;;
        srcnat)   echo $(( 100 + num )) ;;
        security) echo $(( 225 + num )) ;;
        *) return 1 ;;
    esac
}

#
# ARC-52-D3: fail closed on early foreign FORWARD hooks. nft accept is
# NOT terminal across base chains: a second forward-hook chain at the
# same or earlier priority terminal-drops everything the profile chain
# accepts (on-host: a stale policy table silently killed all workload
# egress while verify inspected only its own table). Fail when any OTHER
# table declares a `type filter hook forward` base chain at priority
# <= -150; the message names table and chain.
# Exempt (D3 check 3): later-priority hooks (Netavark's FORWARD at 0)
# and this kit's own table. An unreadable/unparseable listing degrades
# to no-op; the per-chain checks below still verify this kit's policy.
#
verify_no_early_foreign_hooks() {
    local ruleset hits rc=0
    ruleset="$(netns_nft list ruleset 2>/dev/null || true)"
    [[ -n "$ruleset" ]] || return 0
    # Emit one <family<TAB>table<TAB>chain<TAB>priority> per filter/forward
    # base chain found in any table of the ruleset.
    hits="$(awk '
        /^[[:space:]]*table[[:space:]]/ {
            fam=$2; tbl=$3; sub(/[[:space:]]*\{[[:space:]]*$/, "", tbl); next
        }
        /^[[:space:]]*chain[[:space:]]/ {
            ch=$2; sub(/[[:space:]]*\{[[:space:]]*$/, "", ch)
            inchain=1; infwd=0; prio=""; next
        }
        inchain && /type[[:space:]]+filter[[:space:]]+hook[[:space:]]+forward/ {
            infwd=1
            if (match($0, /priority[[:space:]]+[^;]+/)) {
                prio=substr($0, RSTART+8, RLENGTH-8)
                gsub(/[[:space:]]+/, " ", prio)
                sub(/^[[:space:]]+/, "", prio)
                sub(/[[:space:]]+$/, "", prio)
            }
            next
        }
        /^[[:space:]]*\}/ {
            if (inchain && infwd) print fam "\t" tbl "\t" ch "\t" prio
            inchain=0; next
        }
    ' <<<"$ruleset")"
    while IFS=$'\t' read -r fam tbl ch prio; do
        [[ -n "$fam" ]] || continue
        [[ "$fam" == inet && "$tbl" == "$TABLE" ]] && continue
        [[ -n "$prio" ]] || continue
        local val
        val="$(nft_priority_value "$prio")" || continue
        (( val > -150 )) && continue
        echo "verify: foreign forward-hook chain '${ch}' in table '${fam} ${tbl}' (priority ${prio}) runs at or before the profile chains (-150) — its drop would silently override this kit's accepts. Not managed by this kit: remove it or move it later in the hook." >&2
        rc=1
    done <<<"$hits"
    return "$rc"
}

gw_image() {
    if kit_test_mode && [[ -n "${EGRESSLOCK_GW_IMAGE:-}" ]]; then
        # ARC-59-D1: a non-empty value that starts with '-' is a
        # flag-shaped token in the `podman run ... "$(gw_image)"`.
        [[ "$EGRESSLOCK_GW_IMAGE" == -* ]] \
            && die "EGRESSLOCK_GW_IMAGE value must not start with '-' (got '$EGRESSLOCK_GW_IMAGE')"
        echo "$EGRESSLOCK_GW_IMAGE"
    else
        echo "localhost/egresslock-gateway:latest"
    fi
}

# EGL-226: image-state probe shared by cmd_doctor and cmd_build_gateway.
# Reads the first sha256 digest of <containerfile> as the deployed pin and
# the image's base-digest label + created stamp via the rt_* seam. Writes
# globals, never stdout; never call this (or gw_image) in a command
# substitution — a die() at the call site must propagate under set -e.
gw_probe_state() { # gw_probe_state <image> <containerfile>
    GW_PROBE_STATE=missing
    GW_PROBE_BASE=""; GW_PROBE_CREATED=""; GW_PROBE_PIN=""; GW_PROBE_INS=""
    if [[ -f "$2" ]]; then
        # `|| true`: a digest-less Containerfile is pin="" (EGL-222)
        GW_PROBE_PIN="$(grep -oE 'sha256:[0-9a-f]{64}' "$2" | head -1 || true)"
    fi
    rt_image_exists "$1" 2>/dev/null || return 0
    GW_PROBE_STATE=present
    local ins=""
    if ins="$(rt_image_inspect "$1" '{{index .Config.Labels "org.opencontainers.image.base.digest"}} {{.Created}}' 2>/dev/null)"; then
        # EGL-254: Go template index of a missing key prints the literal
        # "<no value>" — strip it before the split so the pre-label branch
        # fires (mirrors egresslock-setup's kit doctor and build-egl-base).
        [[ "$ins" == "<no value>"* ]] && ins="${ins#"<no value>"}"
        GW_PROBE_INS="$ins"
        if [[ "$ins" == *\ * ]]; then
            GW_PROBE_BASE="${ins%% *}"; GW_PROBE_CREATED="${ins#* }"
        else
            GW_PROBE_BASE="$ins"
        fi
    fi
}

# EGL-487: security rebuild floor — one ISO date in a file beside the
# image's Containerfile, `#` comments allowed. Missing, unreadable or
# unparseable data yields no floor (never a guess).
image_security_floor_date() { # image_security_floor_date <floor-file> -> YYYY-MM-DD or empty
    local f="$1" line="" d=""
    [[ -f "$f" && -r "$f" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        if [[ "$line" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
            && [[ "$(date -u -d "$line" '+%Y-%m-%d' 2>/dev/null || true)" == "$line" ]]; then
            d="$line"
        fi
        break
    done < "$f"
    printf '%s\n' "$d"
}

# EGL-487: image-age backstop (UTC, date precision). rc 0 when the
# image's creation date is strictly more than <days> days ago.
image_older_than_days() { # image_older_than_days <YYYY-MM-DD> <days>
    local d="$1" days="$2" built now
    [[ "$d" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || return 1
    built="$(date -u -d "$d" '+%s' 2>/dev/null)" || return 1
    now="$(date -u '+%s' 2>/dev/null)" || return 1
    (( now - built > days * 86400 ))
}

# EGL-487: the doctor's rc-neutral rebuild advisory. Prints at most one
# indented `rebuild:` line; a recorded floor wins over the 30-day
# backstop so the specific reason stays legible. Called only when the
# image's base label matches the deployed pin (a moved pin already
# invalidates the apt layer and has its own `stale:` line).
image_rebuild_notice() { # image_rebuild_notice <label> <created> <base> <pin> <floor-file> <remedy> <pointer>
    local label="$1" created="$2" base="$3" pin="$4" floorf="$5" remedy="$6" pointer="$7"
    local built="${created:0:10}" floor="" max_age=30
    [[ -n "$base" && -n "$pin" && "$base" == "$pin" ]] || return 0
    [[ "$built" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || return 0
    floor="$(image_security_floor_date "$floorf")"
    if [[ -n "$floor" && "$built" < "$floor" ]]; then
        printf '  rebuild: %s image built %s is older than the kit'\''s security rebuild floor %s — rebuild in the account shell: %s %s\n' \
            "$label" "$built" "$floor" "$remedy" "$pointer"
        return 0
    fi
    if image_older_than_days "$built" "$max_age"; then
        printf '  rebuild: %s image built %s is more than %d days old — refresh it in the account shell: %s, and check for a newer egresslock release %s\n' \
            "$label" "$built" "$max_age" "$remedy" "$pointer"
    fi
}

#
# Squid dstdomain allowlist content generated from the repo source file.
# Lines: comment (#) and blank lines stripped; entries are host[:port] or
# leading-dot domain suffixes (passed through for Squid dstdomain).
#
#
# Parse and validate the repo allowlist into entries: "host" or
# "host:port" (ARC-2-D2 contract). Comments/blanks stripped, malformed
# lines fail closed. Prints one entry per line.
#
# EGL-375-D4: one scanner for both consumers. $2 = "fold" (default)
# emits the Squid-facing entry (an explicit :443 folds to the bare host
# so it stays in the 443 group — required for grouping, ARC-43/EGL-365)
# and is what `gw_allowlist_entries` keeps exposing byte-identically;
# $2 = "stored" emits the stored token as entered (case, leading dot,
# explicit :443, and leading-zero port preserved) for the read view
# (D3). The validation rules are shared — never duplicated — so the
# view cannot look healthier than the apply path.
#
gw_allowlist_scan() { # gw_allowlist_scan <profile> <fold|stored>
    local profile="$1" mode="${2:-fold}" src
    src="$(allowlist_src "$profile")"
    [[ -f "$src" ]] || die "allowlist file missing: $src (check the profile's 'gateway' directive)"
    # EGL-395: the generation subshell captures stderr, so the shell's raw
    # redirection error would otherwise be swallowed and replaced by the
    # generic generation line. Name the unreadable file here so the
    # operator keeps the path and cause (same rc, fail closed).
    [[ -r "$src" ]] || die "allowlist file unreadable: $src (Permission denied) — check the file mode; the account must be able to read it"
    local raw entry host port probe
    while IFS= read -r raw || [[ -n "$raw" ]]; do
        entry="${raw%%#*}"
        entry="$(tr -d '[:space:]' <<<"$entry")"
        [[ -z "$entry" ]] && continue
        # ARC-59-D1: host fields start alnum or '.' (dstdomain suffix) — a
        # leading '-' would read as a flag-like token.
        if [[ "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*:[0-9]+$ ]]; then
            host="${entry%:*}"
            port="${entry##*:}"
            if ! cfg_is_port "$port"; then
                die "invalid port in allowlist entry '$entry'"
            fi
            # EGL-147-D2: same trailing-dot reject as the CLI — a
            # hand-edited (or stale) dead line must fail ensure closed,
            # never deploy (the gateway can never match it; X-6 E7).
            if [[ "$host" == *. ]]; then
                die "allowlist entry '$entry' has a trailing dot — dstdomain entries are bare names; requests with trailing dots are normalized by the gateway"
            fi
            # ARC-51-D1: the allowlist is names only (squid dstdomain).
            # A literal IPv4 in the file is a fail-closed error, not a
            # skipped line — the operator must remove the line from the
            # allowlist and add the destination as a direct pin (running
            # the pin first would re-ensure the same bad line and fail).
            probe="${host#.}"
            if cfg_is_ipv4 "$probe"; then
                die "allowlist entry '$entry' is an IPv4 literal; the proxy path cannot carry it — remove that line from $src, then add the direct pin: egresslock allow $profile $probe:$port --direct"
            fi
            # ARC-32-D2: the file path inherits the DNS length caps —
            # fail closed here rather than persisting a line the
            # gateway can never use (ARC-48 U9).
            arc32_dns_len_ok "$probe" \
                || die "allowlist entry '$entry' exceeds DNS length limits (host <= 253 bytes, labels <= 63)"
            # 443 is the default HTTPS group; keep it there so an
            # explicit :443 does not create a redundant second group.
            # EGL-365-D11: the port token is DECIMAL (cfg_is_port
            # accepts leading zeros) — Bash arithmetic would read
            # :0443 as octal 291 and :0673 as octal 443, authorizing
            # the wrong Squid port group.
            # EGL-375-D3: the read view ("stored") keeps the token as
            # entered — no fold, no normalization.
            if [[ "$mode" == fold ]]; then
                if (( 10#$port == 443 )); then
                    echo "$host"
                else
                    echo "$host:$port"
                fi
            else
                echo "$entry"
            fi
        elif [[ "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
            # EGL-147-D2: trailing-dot bare entry — same reject shape
            # as the host:port branch above (fail closed on both).
            if [[ "$entry" == *. ]]; then
                die "allowlist entry '$entry' has a trailing dot — dstdomain entries are bare names; requests with trailing dots are normalized by the gateway"
            fi
            probe="${entry#.}"
            if cfg_is_ipv4 "$probe"; then
                die "allowlist entry '$entry' is an IPv4 literal; the proxy path cannot carry it — remove that line from $src, then add a direct pin with the service port (e.g. egresslock allow $profile $probe:443 --direct)"
            fi
            # ARC-32-D2: the file path inherits the DNS length caps
            # (see the host:port branch above).
            arc32_dns_len_ok "$probe" \
                || die "allowlist entry '$entry' exceeds DNS length limits (host <= 253 bytes, labels <= 63)"
            echo "$entry"
        else
            die "invalid allowlist entry '$entry' (expected host or host:port)"
        fi
    done < "$src"
}

# ARC-43/EGL-365: the Squid-facing view of the allowlist file — the
# stored entries with an explicit :443 folded into the 443 group. Output
# is unchanged by EGL-375 (ensure/denied depend on it byte-identically).
gw_allowlist_entries() { # gw_allowlist_entries <profile>
    gw_allowlist_scan "$1" fold
}

# EGL-369-D3: the gateway config dir moved from /etc/squid/agent to
# /etc/squid/egresslock. A running gateway carries exactly one layout
# (the new shipped image: real egresslock dir + agent symlink; an
# un-replaced old image: agent dir only), so ONE probe decides which dir
# this container has and the result is threaded through generation, the
# converged compare, and the apply/verify paths — a candidate is never
# generated for one layout and staged/compared against the other. The
# new dir wins when both answer (the shipped new image's agent path is a
# symlink). R-EGL-369-10 F1: an ABSENT new dir (rc 1) selects the old
# layout, but a failed probe (any other rc: runtime/exec error) is not
# evidence of absence — it returns rc 2 so the caller fails closed before
# any mutation. Defaulting a runtime error to the old layout could write
# old-path references through the new image's symlink and leave cleanup
# unable to see them. Temporary: EGL-374 removes the old-layout branch
# with the symlink.
GW_CONFIG_DIR_NEW=/etc/squid/egresslock
GW_CONFIG_DIR_OLD=/etc/squid/agent
# R-EGL-369-10 F1: the detection result is shared through globals as well
# as stdout, so a caller that must name the exec failure can report the
# probe's rc/detail without a second, racy probe. Callers that consume the
# globals invoke the function in this shell (not via `$(...)`).
GW_CONFIG_DIR_DETECTED=""
GW_CONFIG_PROBE_RC=0
GW_CONFIG_PROBE_DETAIL=""
gw_config_dir() { # gw_config_dir <gwname> -> dir; rc 0 detected, rc 2 probe failed
    local rc=0
    GW_CONFIG_PROBE_DETAIL="$(rt_exec "$1" test -d "$GW_CONFIG_DIR_NEW" 2>&1)" || rc=$?
    GW_CONFIG_PROBE_RC="$rc"
    case "$rc" in
        0) GW_CONFIG_DIR_DETECTED="$GW_CONFIG_DIR_NEW" ;;
        1) GW_CONFIG_DIR_DETECTED="$GW_CONFIG_DIR_OLD" ;;
        *) GW_CONFIG_DIR_DETECTED=""; return 2 ;;
    esac
    printf '%s\n' "$GW_CONFIG_DIR_DETECTED"
}

#
# Generate the complete Squid config for the gateway into $1; hostname
# groups' dstdomain files go in the same staging dir. Entries without a
# port are restricted to 443 (TLS); "host:port" entries get their own
# dstdomain group + port ACL. Every rule set ends in a terminal deny all.
# EGL-369-D3: $4 is the detected config dir (the same one the caller
# compares/stages against); its path is embedded in the ACL file refs.
#
gw_generate_config() { # gw_generate_config <profile> <out> <stage> <config-dir>
    local profile="$1" out="$2" stage="$3" cfgdir="$4"
    local entries host port p
    # EGL-393: the body is generated exactly as before (header through
    # `http_access deny all`) into a host stage file; the live-probe block
    # is spliced in afterwards. The token hashes THIS body plus the group
    # manifest, so the pre-393 bytes stay the token's preimage.
    local body="$stage/.gw-body.tmp"
    # EGL-100: explicit rc check — inside an `if !` condition context
    # the function body is exempt from set -e, so the substitution's
    # failure would otherwise be silently swallowed. The inner die
    # already named the cause (the missing file with the gateway-
    # directive hint, or the offending entry) — exit on it without
    # stacking a second, mislabelling line (R9).
    entries="$(gw_allowlist_entries "$profile")" || exit 1

    # Squid resolves allowlisted destinations itself. Bypass Aardvark
    # (its forwarding fails on some CDN CNAME chains; on-host:
    # api.openrouter.ai unresolvable while the apex worked) and use the
    # pasta DNS forwarder, which reaches the host resolver. Squid's own
    # queries are exempted in p_llm_cloud (EGL-123-D2 / EGL-141-D1).
    # R-005-5: validate the override — it is interpolated into the Squid
    # config, so reject anything that could inject directives.
    # ARC-56-D1: the sink consumes a LIST OF IPv4 ADDRESSES, so a charset
    # allowlist is not enough: single-space-separated non-whitespace
    # tokens only, then each token must pass cfg_is_ipv4.
    local gw_dns="${GW_DNS_NAMESERVERS:-169.254.1.1}"
    if [[ ! "$gw_dns" =~ ^[^[:space:]]+( [^[:space:]]+)*$ ]]; then
        die "GW_DNS_NAMESERVERS must be a single-space-separated list of IPv4 addresses"
    fi
    local -a gw_dns_tokens=() tok
    read -r -a gw_dns_tokens <<< "$gw_dns"
    for tok in "${gw_dns_tokens[@]}"; do
        cfg_is_ipv4 "$tok" || die "GW_DNS_NAMESERVERS entry '$tok' is not a valid IPv4 address"
    done
    gw_dns="${gw_dns_tokens[*]}"
    cat > "$body" <<EOF
# Generated by egresslock from $(allowlist_src "$profile") — do not edit.
http_port ${GW_PORT[$profile]}
# Explicit (never silent stock inherit): the idle origin-response timer
# that closes long silent non-streaming requests.
read_timeout ${PROFILE_READ_TIMEOUT[$profile]} seconds
pid_filename /tmp/squid.pid
dns_nameservers $gw_dns
shutdown_lifetime 2 seconds
coredump_dir /var/spool/squid
access_log stdio:/var/log/squid/access.log
cache_log /var/log/squid/cache.log
cache deny all

acl profile_subnet src ${PROFILE_SUBNET[$profile]}
EOF

    # EGL-395-D1: every non-empty group is published under a name that
    # carries the SHA-256 of its exact bytes (allowlist.domains.<sha> /
    # allowlist.p<port>.<sha>). The generated config references that
    # immutable name, so a later apply never overwrites bytes the old
    # deployed config still reads. Hash the bytes BEFORE publishing the
    # name, then rename the host-stage temp: the ref in $out names the
    # exact file that the apply path copies and links.
    local gtmp ghash gname
    # Group 1: hosts without an explicit port -> default HTTPS port.
    local noport=0
    gtmp="$stage/.allowlist.domains.tmp"
    : > "$gtmp"
    while IFS= read -r entry; do
        # Empty entries (e.g. the heredoc newline from an EMPTY allowlist
        # file) must not mint a phantom no-port ACL group — that would
        # quietly turn a fail-closed empty allowlist into an allow rule.
        [[ -z "$entry" ]] && continue
        [[ "$entry" != *:* ]] || continue
        echo "$entry" >> "$gtmp"
        noport=1
    done <<<"$entries"
    if [[ "$noport" == 1 ]]; then
        ghash="$(sha256sum "$gtmp" | cut -d' ' -f1)"
        gname="allowlist.domains.$ghash"
        mv -f "$gtmp" "$stage/$gname"
        {
            # EGL-146-D1: `-n` on EVERY generated dstdomain ACL — Squid
            # must not adopt rDNS for IP-literal CONNECTs (X-6 E8);
            # numeric hosts fail the name match outright.
            echo "acl allowlist dstdomain -n \"$cfgdir/$gname\""
            echo 'acl port_443 port 443'
            echo 'http_access allow profile_subnet allowlist port_443'
        } >> "$body"
    else
        rm -f "$gtmp"
    fi

    # Group 2+: hosts with an explicit destination port. EGL-365-D11:
    # group by the DECIMAL port value (cfg_is_port accepts leading
    # zeros; the allowlist keeps the operator's spelling, but the Squid
    # ACL must name the real port — :0673 is port 673, never octal 443).
    local seen="" pport
    while IFS= read -r entry; do
        [[ "$entry" == *:* ]] || continue
        pport=$(( 10#${entry##*:} ))
        [[ " $seen " == *" $pport "* ]] && continue
        seen="$seen $pport"
    done <<<"$entries"
    # Intentional word-split of the port set (space-joined ports extracted
    # from already-validated host:port entries — digits only).
    for p in $seen; do
        gtmp="$stage/.allowlist.p$p.tmp"
        : > "$gtmp"
        while IFS= read -r entry; do
            [[ "$entry" == *:* ]] || continue
            (( 10#${entry##*:} == p )) || continue
            echo "${entry%:*}" >> "$gtmp"
        done <<<"$entries"
        ghash="$(sha256sum "$gtmp" | cut -d' ' -f1)"
        gname="allowlist.p$p.$ghash"
        mv -f "$gtmp" "$stage/$gname"
        {
            # EGL-146-D1: same `-n` flag as the no-port group (see
            # above); per-port groups must not diverge.
            echo "acl allowlist_p$p dstdomain -n \"$cfgdir/$gname\""
            echo "acl port_p$p port $p"
            echo "http_access allow profile_subnet allowlist_p$p port_p$p"
        } >> "$body"
    done

    echo "http_access deny all" >> "$body"

    # EGL-393-D1: token = sha256("EGL-393 live-probe v1\n" + body +
    # "manifest\n" + manifest) where body is exactly the config above
    # (one trailing newline) and manifest is one line per referenced
    # group, LC_ALL=C sorted by basename: "<sha256(file bytes)>  <basename>\n".
    # Group names already carry their hashes (EGL-395); the explicit hash
    # binds the token if a name is ever edited in place.
    local ref name ghash manifest="$stage/.gw-live-manifest.tmp" token_input="$stage/.gw-live-token.tmp" token
    : > "$manifest"
    while IFS= read -r ref; do
        [[ -n "$ref" ]] || continue
        name="${ref##*/}"
        if ! ghash="$(gw_sha256_file "$stage/$name")"; then
            rm -f "$body" "$manifest" "$token_input"
            die "allowlist generation failed: the generated group '$name' could not be hashed (fail closed)"
        fi
        printf '%s  %s\n' "$ghash" "$name" >> "$manifest"
    done < <(grep -oE "\"$cfgdir/allowlist\.[A-Za-z0-9._-]+\"" "$body" \
                 | tr -d '"' | sed 's|.*/||' | LC_ALL=C sort -u)
    {
        printf 'EGL-393 live-probe v1\n'
        cat "$body"
        printf 'manifest\n'
        cat "$manifest"
    } > "$token_input"
    if ! token="$(gw_sha256_file "$token_input")"; then
        rm -f "$body" "$manifest" "$token_input"
        die "allowlist generation failed: the live-probe token could not be computed (fail closed)"
    fi

    # Splice the canonical dest-only block immediately after `cache deny
    # all` (before `acl profile_subnet`). Dest-only: an allowlist entry
    # for the reserved name must never match a profile-subnet client.
    awk -v domain="$GW_LIVE_PROBE_DOMAIN" -v token="$token" '
        done != 1 && $0 == "cache deny all" {
            print
            print "# EGL-393-LIVE-PROBE BEGIN v1"
            print "acl egl393_probe_dst dstdomain -n " domain
            print "deny_info 302:http://" domain "/live/" token " egl393_probe_dst"
            print "http_access deny egl393_probe_dst"
            print "# EGL-393-LIVE-PROBE END"
            done = 1
            next
        }
        { print }
    ' "$body" > "$out"
    rm -f "$body" "$manifest" "$token_input"
}

# EGL-395: generated group basename contract. The name must be one of the
# two content-addressed shapes and its 64-hex suffix must equal the
# SHA-256 of the exact staged bytes; a mismatch is a pre-mutation die.
gw_group_name_ok() { # gw_group_name_ok <name> <file>
    local name="$1" file="$2" hash
    [[ "$name" =~ ^allowlist\.(domains|p[1-9][0-9]{0,4})\.[0-9a-f]{64}$ ]] || return 1
    hash="$(sha256sum "$file" | cut -d' ' -f1)" || return 1
    [[ "${name##*.}" == "$hash" ]]
}

gw_sha256_file() { # gw_sha256_file <host-file> -> 64-hex
    local hash
    hash="$(sha256sum "$1" | cut -d' ' -f1)" || return 1
    [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || return 1
    echo "$hash"
}

# EGL-515: one batched read-only probe window. The container-side script
# runs every requested probe and prints one record per line:
#   <key>\t<rc>\t<payload>
# rc 0 present/read, 1 negative answer, 2 probe error. A failed exec, a
# missing requested key, a malformed/duplicate record, or an rc outside
# 0–2 makes the whole batch untrusted: every requested key is then rc 2
# (never "absent"). Payloads are single-line, TAB-free. The batch never
# decides anything: callers map records to their existing named errors.
# Ops: e/f/L test, h sha256, i/s/m stat, P loopback TCP probe, C the
# live CapEff/NoNewPrivs pair, A PID 1 argv on the given cfgdir.
IFS= read -r -d '' GW_BATCH_SCRIPT <<'EGL515_BATCH' || true
# EGL-515 batch v1
set -o pipefail
while (( $# )); do
    key="$1"; op="$2"; path="$3"; shift 3
    out=""; rc=0
    case "$op" in
        e) test -e "$path" || rc=$? ;;
        L) test -L "$path" || rc=$? ;;
        f) test -f "$path" || rc=$? ;;
        h) out="$(sha256sum -- "$path" 2>/dev/null)" || rc=$?
           out="${out%%[[:space:]]*}" ;;
        i) out="$(stat -c "%d:%i %s %z" -- "$path" 2>/dev/null)" || rc=$? ;;
        s) out="$(stat -c "%d:%i %s" -- "$path" 2>/dev/null)" || rc=$? ;;
        m) out="$(stat -c %Y -- "$path" 2>/dev/null)" || rc=$? ;;
        B) out="$(stat -c "%d:%i %s" -- "$path" 2>/dev/null)" || rc=$?
           if (( rc == 0 )); then
               bsz="${out##* }"
               bhash=""
               if [[ ! "$bsz" =~ ^[0-9]+$ ]]; then
                   rc=2
               elif (( bsz > 0 )); then
                   bplen=$bsz
                   (( bplen > 4096 )) && bplen=4096
                   bhash="$(head -c "$bplen" -- "$path" | sha256sum)" || rc=$?
                   bhash="${bhash%%[[:space:]]*}"
                   if (( rc != 0 )) || [[ ! "$bhash" =~ ^[0-9a-f]{64}$ ]]; then
                       rc=2
                   fi
               fi
               if (( rc == 0 )); then
                   out="$out $bhash"
               fi
           fi ;;
        P) if (exec 3<>"/dev/tcp/127.0.0.1/$path") 2>/dev/null; then rc=0; else rc=1; fi ;;
        G) gport="${path%%|*}"; grest="${path#*|}"
           gurl="${grest%%|*}"; ghost="${grest#*|}"
           if [[ "$gport" =~ ^[0-9]+$ && -n "$gurl" && -n "$ghost" ]]; then
               gout=""
               if gout="$( ( exec 3<>"/dev/tcp/127.0.0.1/$gport"
                              printf 'GET %s HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n\r\n' "$gurl" "$ghost" >&3
                              timeout 5 cat <&3 ) 2>/dev/null )"; then
                   out="$(printf '%s' "$gout" | base64 -w0)" || { rc=2; out=""; }
               else
                   rc=2
               fi
           else
               rc=2
           fi ;;
        C) st="$(cat -- "$path" 2>/dev/null)" || rc=$?
           if (( rc != 0 )) || [[ -z "$st" ]]; then
               rc=2; out=""
           else
               caps="$(awk '/^CapEff:/{print $2; exit}' <<<"$st")"
               nnp="$(awk '/^NoNewPrivs:/{print $2; exit}' <<<"$st")"
               if [[ -z "$caps" || -z "$nnp" ]]; then
                   rc=1; out=""
               else
                   out="$caps $nnp"
               fi
           fi ;;
        A) argv="$(tr "\0" "\n" < /proc/1/cmdline 2>/dev/null)" || rc=2
           if (( rc == 0 )); then
               mapfile -t av <<<"$argv"
               an=${#av[@]}; has_n=0; pair=0
               [[ "${av[0]:-}" == "squid" ]] || rc=1
               for ((ai = 0; ai < an; ai++)); do
                   [[ "${av[ai]}" == "-N" ]] && has_n=1
               done
               for ((ai = 0; ai + 1 < an; ai++)); do
                   if [[ "${av[ai]}" == "-f" && "${av[ai+1]}" == "$path/squid.conf" ]]; then
                       pair=1
                   fi
               done
               if (( rc == 0 )); then
                   if (( has_n == 1 && pair == 1 )); then rc=0; else rc=1; fi
               fi
           fi ;;
        *) rc=2 ;;
    esac
    case "$rc" in 0|1) ;; *) rc=2 ;; esac
    out="${out//$'\t'/ }"
    out="${out//$'\n'/ }"
    printf "%s\t%s\t%s\n" "$key" "$rc" "$out"
done
EGL515_BATCH
# EGL-515: purpose-built reload read. One exec returns the full
# post-signal proof window — stat, prefix, tail witness, re-stat — in one
# script so the H2 identity re-check and the witness bytes cannot be
# split by a separate exec (D2). The pre-signal baseline is batch op `B`
# in the warm-gate window; only `post` is reachable here. Records use the
# batch protocol above.
IFS= read -r -d '' GW_RELOAD_SCRIPT <<'EGL515_RELOAD' || true
# EGL-515 reload-read v1
set -o pipefail
mode="$1"; shift
log=/var/log/squid/cache.log
emit() { printf '%s\t%s\t%s\n' "$1" "$2" "$3"; }
case "$mode" in
    post)
        prev_ident="$1"; before="$2"; plen="$3"; phash="$4"; cfgdir="$5"
        st=""; rc=0
        st="$(stat -c '%d:%i %s' -- "$log" 2>/dev/null)" || rc=$?
        if (( rc != 0 )); then
            emit s1 2 ""
            emit p 2 ""
            emit t 2 ""
            emit w1 2 ""
            emit w2 2 ""
            emit s2 2 ""
            exit 0
        fi
        emit s1 0 "$st"
        if (( plen > 0 )); then
            h=""; rc=0
            h="$(head -c "$plen" -- "$log" | sha256sum)" || rc=$?
            h="${h%%[[:space:]]*}"
            if (( rc != 0 )) || [[ ! "$h" =~ ^[0-9a-f]{64}$ ]]; then
                emit p 2 ""
            else
                emit p 0 "$h"
            fi
        else
            emit p 1 ""
        fi
        new=""; rc=0
        new="$(tail -c "+$((before + 1))" -- "$log" 2>/dev/null)" || rc=$?
        if (( rc != 0 )); then
            emit t 2 ""
            emit w1 2 ""
            emit w2 2 ""
        else
            emit t 0 ""
            if [[ "$new" == *"Reconfiguring Squid Cache"* ]]; then
                emit w1 0 ""
            else
                emit w1 1 ""
            fi
            if [[ "$new" == *"Processing Configuration File: $cfgdir/squid.conf (depth 0)"* ]]; then
                emit w2 0 ""
            else
                emit w2 1 ""
            fi
        fi
        st=""; rc=0
        st="$(stat -c '%d:%i %s' -- "$log" 2>/dev/null)" || rc=$?
        if (( rc != 0 )); then
            emit s2 2 ""
        else
            emit s2 0 "$st"
        fi
        ;;
    *)
        exit 2
        ;;
esac
EGL515_RELOAD

# EGL-515: purpose-built publication script. The best-effort activation
# witness removal (nothing reads it; only stale-proof hygiene) and the
# single same-filesystem `mv -T` are one container-side mutation window,
# and a completed rename immediately sweeps the private stage so the
# host's success path needs no second podman exec. A failed/lost rename
# leaves the stage in place: the host still performs the explicit
# quiescence sweep and re-read. The script never reads anything back, so
# no result can be misread as publication proof; the exit status is the
# rename's.
IFS= read -r -d '' GW_PUBLISH_SCRIPT <<'EGL515_PUBLISH' || true
# EGL-515 publish v1
set -o pipefail
witness="$1"; src="$2"; dst="$3"; stage="$4"
rm -f -- "$witness" >/dev/null 2>&1 || true
mv_rc=0
mv -T -- "$src" "$dst" || mv_rc=$?
if (( mv_rc == 0 )); then
    rm -rf -- "$stage" >/dev/null 2>&1 || true
fi
exit "$mv_rc"
EGL515_PUBLISH

# EGL-515: cleanup's read window. The best-effort witness removal, the
# deployed-config read and the single `find -printf` listing are one
# exec: nothing on the host consumes a result between them. The config
# bytes ride base64 (exact bytes, single line); the listing keeps its
# own rc so a directory read failure still takes the existing skip.
IFS= read -r -d '' GW_CLEANUP_SCRIPT <<'EGL515_CLEANUP' || true
# EGL-515 cleanup-read v2
set -o pipefail
witness="$1"; conf="$2"; dir="$3"
rm -f -- "$witness" >/dev/null 2>&1 || true
crc=0; cdata=""
cdata="$(cat -- "$conf" 2>/dev/null | base64 -w0)" || crc=$?
printf 'cfg %s %s\n' "$crc" "$cdata"
frc=0; fdata=""
fdata="$(find "$dir" -maxdepth 1 -mindepth 1 -printf '%y %T@ %f\n' 2>/dev/null | base64 -w0)" || frc=$?
printf 'find %s %s\n' "$frc" "$fdata"
exit 0
EGL515_CLEANUP

declare -A GW_BATCH_RC=()
declare -A GW_BATCH_PAYLOAD=()
GW_BATCH_KEYS=()

gw_batch_invalidate_all() {
    local k
    for k in "${GW_BATCH_KEYS[@]}"; do
        GW_BATCH_RC[$k]=2
        GW_BATCH_PAYLOAD[$k]=""
    done
}

# EGL-515: validate one batch payload into GW_BATCH_* (keys are seeded by
# the caller). A malformed/duplicate/unknown record invalidates every
# requested key: a missing record is a probe error, never "absent".
gw_batch_parse() { # <payload>
    local out="$1" line f1 f2 f3 rest
    local -A seen=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        # A blank line between records is a malformed record (D1): it must
        # invalidate the whole batch, never be skipped. Pure end-of-stream
        # is not a body iteration, so the natural terminator still works.
        if [[ "$line" != *$'\t'* ]]; then
            gw_batch_invalidate_all
            return 0
        fi
        f1="${line%%$'\t'*}"
        rest="${line#*$'\t'}"
        if [[ "$rest" != *$'\t'* ]]; then
            gw_batch_invalidate_all
            return 0
        fi
        f2="${rest%%$'\t'*}"
        f3="${rest#*$'\t'}"
        if [[ ! "$f1" =~ ^[a-z0-9._]+$ ]] \
            || [[ ! "$f2" =~ ^[012]$ ]] \
            || [[ "$f3" == *$'\t'* ]] \
            || [[ -n "${seen[$f1]:-}" ]]; then
            gw_batch_invalidate_all
            return 0
        fi
        case " ${GW_BATCH_KEYS[*]} " in
            *" $f1 "*) ;;
            *) gw_batch_invalidate_all; return 0 ;;
        esac
        seen[$f1]=1
        GW_BATCH_RC[$f1]="$f2"
        GW_BATCH_PAYLOAD[$f1]="$f3"
    done <<<"$out"
    return 0
}

gw_ctr_batch() { # gw_ctr_batch <gwname> <key op path>... -> records in GW_BATCH_*
    local gwname="$1"; shift
    local -a specs=("$@")
    local out="" k
    local i
    GW_BATCH_RC=(); GW_BATCH_PAYLOAD=(); GW_BATCH_KEYS=()
    for ((i = 0; i < ${#specs[@]}; i += 3)); do
        k="${specs[i]}"
        GW_BATCH_KEYS+=("$k")
        GW_BATCH_RC[$k]=2
        GW_BATCH_PAYLOAD[$k]=""
    done
    if ! out="$(rt_exec "$gwname" bash -c "$GW_BATCH_SCRIPT" egl515-batch "${specs[@]}" 2>/dev/null)"; then
        return 0
    fi
    gw_batch_parse "$out"
    return 0
}

# EGL-515: map a generation probe (h + the two absence probes e/L) from a
# batch already in GW_BATCH_*. Prints hash|absent; rc 1 on an unproved read.
gw_batch_generation_value() { # <key>
    local k="$1" kh="${1}.h" ke="${1}.e" kl="${1}.l"
    if (( ${GW_BATCH_RC[$kh]:-2} == 0 )); then
        [[ "${GW_BATCH_PAYLOAD[$kh]:-}" =~ ^[0-9a-f]{64}$ ]] || return 1
        printf '%s\n' "${GW_BATCH_PAYLOAD[$kh]}"
        return 0
    fi
    if (( ${GW_BATCH_RC[$ke]:-2} == 1 && ${GW_BATCH_RC[$kl]:-2} == 1 )); then
        printf 'absent\n'
        return 0
    fi
    return 1
}

# EGL-515: map a batch `C` record to kit_caps_state's token. rc 2 is a
# failed read (never "ok"); a present read with a missing line keeps the
# existing unreadable detail.
gw_batch_caps_state() { # <key>
    local k="$1" caps nnp
    if (( ${GW_BATCH_RC[$k]:-2} == 2 )); then
        echo "unreadable:podman exec cat /proc/1/status failed or returned no output"
        return 0
    fi
    if (( ${GW_BATCH_RC[$k]:-2} != 0 )); then
        echo "unreadable:CapEff/NoNewPrivs lines missing from /proc/1/status"
        return 0
    fi
    caps=""; nnp=""
    read -r caps nnp <<<"${GW_BATCH_PAYLOAD[$k]:-}" || true
    if [[ -z "$caps" || -z "$nnp" ]]; then
        echo "unreadable:CapEff/NoNewPrivs lines missing from /proc/1/status"
        return 0
    fi
    if [[ ! "$caps" =~ ^0+$ ]]; then
        echo "caps:$caps"
        return 0
    fi
    if [[ "$nnp" != "1" ]]; then
        echo "nnp:$nnp"
        return 0
    fi
    echo "ok"
}

# EGL-515: one post-mutation read window for a published config. rc 0
# when the generation is proved; then GW_READ_GEN is `<hash>` or
# `absent`, and GW_READ_IDENT_OK/GW_READ_IDENT describe the identity read
# from the same window (used only after publication is proven). rc 1
# means the generation is unproved — never "absent".
GW_READ_GEN=""
GW_READ_IDENT=""
GW_READ_IDENT_OK=0
gw_publish_read() { # <gwname> <path> [<key> <op> <path>]...
    local gwname="$1" path="$2"
    shift 2
    GW_READ_GEN=""
    GW_READ_IDENT=""
    GW_READ_IDENT_OK=0
    gw_ctr_batch "$gwname" "$@" post.h h "$path" post.e e "$path" post.l L "$path" post.i i "$path"
    if ! GW_READ_GEN="$(gw_batch_generation_value post)"; then
        GW_READ_GEN=""
        return 1
    fi
    if [[ "$GW_READ_GEN" != absent ]] && (( ${GW_BATCH_RC[post.i]:-2} == 0 )); then
        GW_READ_IDENT="${GW_BATCH_PAYLOAD[post.i]}"
        if [[ "$GW_READ_IDENT" =~ ^[0-9]+:[0-9]+[[:space:]][0-9]+[[:space:]].+$ ]]; then
            GW_READ_IDENT_OK=1
        fi
    fi
    return 0
}

# EGL-515: parse the pre-signal cache.log baseline from a batch `B`
# record (identity+size plus the fixed-prefix hash). rc 1 sets
# GW_RELOAD_PROBLEM. A failed read is never an empty/matching prefix
# (R-EGL-394-13 F1: the container script runs the prefix pipeline under
# pipefail).
GW_RELOAD_BEFORE_IDENT=""
GW_RELOAD_BEFORE_SIZE=""
GW_RELOAD_BEFORE_PLEN=0
GW_RELOAD_BEFORE_PREFIX=""
gw_reload_pre_parse() { # <batch-key> -> 0 read; 1 problem in GW_RELOAD_PROBLEM
    local k="$1" st ident size hash plen
    GW_RELOAD_BEFORE_IDENT=""
    GW_RELOAD_BEFORE_SIZE=""
    GW_RELOAD_BEFORE_PLEN=0
    GW_RELOAD_BEFORE_PREFIX=""
    GW_RELOAD_PROBLEM="the gateway cache log could not be read before the reload"
    (( ${GW_BATCH_RC[$k]:-2} == 0 )) || return 1
    st="${GW_BATCH_PAYLOAD[$k]:-}"
    ident=""; size=""; hash=""
    read -r ident size hash <<<"$st" || true
    [[ "$ident" =~ ^[0-9]+:[0-9]+$ && "$size" =~ ^[0-9]+$ ]] || return 1
    if (( size < 4096 )); then plen=$size; else plen=4096; fi
    if (( plen > 0 )); then
        [[ "$hash" =~ ^[0-9a-f]{64}$ ]] || return 1
    else
        hash=""
    fi
    GW_RELOAD_BEFORE_IDENT="$ident"
    GW_RELOAD_BEFORE_SIZE="$size"
    GW_RELOAD_BEFORE_PLEN="$plen"
    GW_RELOAD_BEFORE_PREFIX="$hash"
    GW_RELOAD_PROBLEM=""
    return 0
}

# EGL-395: positive-absence probes. A probe is negative only when it ran
# and returned exactly 1 ("not found"). Any other rc is a runtime/exec
# error (e.g. rc 125 from a container that is not running) and is never
# read as absent / not-a-symlink / not-a-directory.
gw_ctr_test() { # gw_ctr_test <gwname> <test-op> <path> -> 0 present, 1 absent, 2 probe error
    local gwname="$1" op="$2" path="$3" rc
    if rt_exec "$gwname" test "$op" "$path" >/dev/null 2>&1; then
        return 0
    else
        rc=$?
        if (( rc == 1 )); then
            return 1
        fi
        return 2
    fi
}

gw_ctr_absent() { # gw_ctr_absent <gwname> <path> -> 0 only when both probes ran and answered 1
    local gwname="$1" path="$2" rc
    if gw_ctr_test "$gwname" -e "$path"; then
        return 1
    else
        rc=$?
        (( rc == 1 )) || return 1
    fi
    if gw_ctr_test "$gwname" -L "$path"; then
        return 1
    else
        rc=$?
        (( rc == 1 )) || return 1
    fi
    return 0
}

# EGL-395: sha256 of a file inside the gateway, or `absent` when the path
# is provably missing. rc 1 means the path exists but cannot be read (or
# is an unsupported shape) or a probe errored: the caller must not treat
# that as absent.
gw_ctr_generation() { # gw_ctr_generation <gwname> <path> -> hash|absent
    local gwname="$1" path="$2" out
    if out="$(rt_exec "$gwname" sha256sum "$path" 2>/dev/null)"; then
        out="${out%%[[:space:]]*}"
        [[ "$out" =~ ^[0-9a-f]{64}$ ]] || return 1
        echo "$out"
        return 0
    fi
    # Absence is proved, not assumed: both probes must have run and
    # returned exactly 1. A failed probe is a failed read, never absent.
    gw_ctr_absent "$gwname" "$path" || return 1
    echo absent
}

# EGL-394 F1: stat identity of a file inside the gateway, as one opaque
# string: `<device>:<inode> <size> <ctime>` (GNU stat %z keeps
# nanoseconds). A replacement changes the device/inode; an in-place write
# changes the size and the ctime; and ctime cannot be rewound from user
# space, so restoring the previous bytes after the running instance
# loaded them is still visible. rc 1 when the path cannot be read.
gw_ctr_ident() { # gw_ctr_ident <gwname> <path> -> identity
    local out
    out="$(rt_exec "$1" stat -c '%d:%i %s %z' "$2" 2>/dev/null)" || return 1
    [[ "$out" =~ ^[0-9]+:[0-9]+[[:space:]][0-9]+[[:space:]].+$ ]] || return 1
    printf '%s\n' "$out"
}

# EGL-393-D2: recompute the live-config token from the DEPLOYED bytes in
# the running gateway. The deployed config must carry exactly one canonical
# probe block before the first http_access line; strip it, validate every
# referenced content-addressed group (layout/name shape, readable bytes,
# name suffix == SHA-256), rebuild the manifest, and require the embedded
# token to equal the recomputed one. Every failure is a named rc 1 — a
# missing/unreadable/malformed piece is never a skip. Prints the token.
gw_live_token() { # gw_live_token <profile> <gwname> <cfgdir> <port> -> token
    local profile="$1" gwname="$2" cfgdir="$3" port="$4"
    local tmpdir
    if ! tmpdir="$(mktemp -d)"; then
        echo "verify: could not create a host temporary directory for the deployed gateway configuration check; re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
        return 1
    fi
    local conf="$tmpdir/conf" body="$tmpdir/body" manifest="$tmpdir/manifest"
    local token_input="$tmpdir/token-input"
    if ! rt_exec "$gwname" cat "$cfgdir/squid.conf" > "$conf" 2>/dev/null; then
        rm -rf "$tmpdir"
        echo "verify: gateway container '$gwname' could not read the deployed configuration $cfgdir/squid.conf (stopped or mid-restart — e.g. a concurrent ensure); re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
        return 1
    fi
    local begin_count end_count begin_line end_line first_access
    begin_count="$(grep -c '^# EGL-393-LIVE-PROBE BEGIN v1$' "$conf" 2>/dev/null || true)"
    end_count="$(grep -c '^# EGL-393-LIVE-PROBE END$' "$conf" 2>/dev/null || true)"
    begin_line="$(grep -n '^# EGL-393-LIVE-PROBE BEGIN v1$' "$conf" | head -n1 | cut -d: -f1)"
    end_line="$(grep -n '^# EGL-393-LIVE-PROBE END$' "$conf" | head -n1 | cut -d: -f1)"
    first_access="$(grep -n '^http_access ' "$conf" | head -n1 | cut -d: -f1)"
    local l1="" l2="" l3="" l4="" l5="" embedded="" token_re
    if [[ "$begin_count" == 1 && "$end_count" == 1 ]] \
        && [[ "$begin_line" =~ ^[0-9]+$ && "$end_line" =~ ^[0-9]+$ ]] \
        && (( end_line == begin_line + 4 )) \
        && [[ "$first_access" =~ ^[0-9]+$ ]] && (( begin_line < first_access )); then
        l1="$(sed -n "${begin_line}p" "$conf")"
        l2="$(sed -n "$((begin_line + 1))p" "$conf")"
        l3="$(sed -n "$((begin_line + 2))p" "$conf")"
        l4="$(sed -n "$((begin_line + 3))p" "$conf")"
        l5="$(sed -n "$((begin_line + 4))p" "$conf")"
    fi
    token_re="^deny_info 302:http://${GW_LIVE_PROBE_DOMAIN}/live/([0-9a-f]{64}) egl393_probe_dst$"
    if [[ "$l1" == '# EGL-393-LIVE-PROBE BEGIN v1' ]] \
        && [[ "$l2" == "acl egl393_probe_dst dstdomain -n $GW_LIVE_PROBE_DOMAIN" ]] \
        && [[ "$l3" =~ $token_re ]] \
        && [[ "$l4" == 'http_access deny egl393_probe_dst' ]] \
        && [[ "$l5" == '# EGL-393-LIVE-PROBE END' ]]; then
        embedded="${BASH_REMATCH[1]}"
    fi
    if [[ -z "$embedded" ]]; then
        rm -rf "$tmpdir"
        echo "verify: the deployed gateway configuration has no live configuration check (it was generated by an older egresslock); re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
        return 1
    fi
    sed "${begin_line},${end_line}d" "$conf" > "$body"
    : > "$manifest"
    # EGL-515: every referenced group hash comes from one batch; only the
    # hash is needed, so no group bytes cross the exec boundary. The live
    # GET and the PID 1 hardening pair ride the SAME exec: the probe
    # result and the caps proof belong to the instance that served the
    # token, and the host parses them only after the deployed-token
    # checks, so every named error keeps its old order.
    local -a refs=() ref_names=() ref_spec=()
    local ref name hash i
    while IFS= read -r ref; do
        [[ -n "$ref" ]] || continue
        name="${ref##*/}"
        if [[ "$ref" != "$cfgdir/$name" ]] \
            || ! [[ "$name" =~ ^allowlist\.(domains|p[1-9][0-9]{0,4})\.[0-9a-f]{64}$ ]]; then
            rm -rf "$tmpdir"
            echo "verify: the deployed gateway configuration does not match the token embedded in it (it was edited after generation); re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
            return 1
        fi
        i=${#refs[@]}
        refs+=("$ref")
        ref_names+=("$name")
        ref_spec+=("g$i.h" h "$ref")
    done < <(grep -oE "\"$cfgdir/allowlist\.[A-Za-z0-9._-]+\"" "$body" \
                 | tr -d '"' | LC_ALL=C sort -u)
    ref_spec+=(
        live.g G "$port|http://$GW_LIVE_PROBE_DOMAIN/|$GW_LIVE_PROBE_DOMAIN"
        live.c C /proc/1/status
    )
    gw_ctr_batch "$gwname" "${ref_spec[@]}"
    for i in "${!refs[@]}"; do
        name="${ref_names[$i]}"
        if (( ${GW_BATCH_RC[g$i.h]:-2} != 0 )); then
            rm -rf "$tmpdir"
            echo "verify: the deployed gateway allowlist file '$name' could not be read; re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
            return 1
        fi
        hash="${GW_BATCH_PAYLOAD[g$i.h]:-}"
        if [[ ! "$hash" =~ ^[0-9a-f]{64}$ ]]; then
            rm -rf "$tmpdir"
            echo "verify: the deployed gateway allowlist file '$name' could not be read; re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
            return 1
        fi
        if [[ "${name##*.}" != "$hash" ]]; then
            rm -rf "$tmpdir"
            echo "verify: the deployed gateway allowlist file '$name' no longer matches the checksum in its name (it was edited or corrupted in place); re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
            return 1
        fi
        printf '%s  %s\n' "$hash" "$name" >> "$manifest"
    done
    {
        printf 'EGL-393 live-probe v1\n'
        cat "$body"
        printf 'manifest\n'
        cat "$manifest"
    } > "$token_input"
    local expected
    if ! expected="$(gw_sha256_file "$token_input")"; then
        rm -rf "$tmpdir"
        echo "verify: the deployed gateway configuration could not be checksummed; re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
        return 1
    fi
    rm -rf "$tmpdir"
    if [[ "$embedded" != "$expected" ]]; then
        echo "verify: the deployed gateway configuration does not match the token embedded in it (it was edited after generation); re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
        return 1
    fi
    # The batch ran before the deployed-token checks, but its live-probe
    # record is parsed only now: every deployed-config error above keeps
    # its old precedence, and a probe failure still names the running
    # instance. Prints token, live token, caps state (one line each).
    local ltok caps_state
    ltok="$(gw_live_probe_parse live.g "$profile")" || return 1
    caps_state="$(gw_batch_caps_state live.c)"
    printf '%s\n%s\n%s\n' "$embedded" "$ltok" "$caps_state"
}

# EGL-393-D2: one bounded loopback GET to the running Squid. The container
# side is I/O only (so the mock can return raw HTTP); the host parses the
# status and the exact Location. One attempt — no retry loop, no
# restart/reload. EGL-515: the GET and the PID 1 hardening pair ride the
# same group-hash batch as gw_live_token, so the caps proof belongs to the
# instance that answered; the raw HTTP rides base64 so the record stays
# single-line.
# EGL-515: parse the raw HTTP response carried (base64) by one batch `G`
# record. Same status/Location rules and named error as the single-exec
# probe; an unreadable/absent record is never a passing token.
gw_live_probe_parse() { # <batch-key> <profile> -> token
    local k="$1" profile="$2" raw="" line status=0 loc="" token="" first=1 bad=0
    if (( ${GW_BATCH_RC[$k]:-2} == 0 )); then
        raw="$(printf '%s' "${GW_BATCH_PAYLOAD[$k]:-}" | base64 -d 2>/dev/null)" || raw=""
    fi
    while IFS= read -r line; do
        line="${line%$'\r'}"
        if (( first )); then
            first=0
            [[ "$line" =~ ^HTTP/1\.[01][[:space:]]302([[:space:]]|$) ]] && status=1
            continue
        fi
        [[ -z "$line" ]] && break
        if [[ "${line,,}" == location:* ]]; then
            loc="${line#*:}"
            loc="${loc#"${loc%%[![:space:]]*}"}"
            loc="${loc%"${loc##*[![:space:]]}"}"
        fi
    done <<<"$raw"
    (( status == 1 )) || bad=1
    if [[ "$loc" != "http://$GW_LIVE_PROBE_DOMAIN/live/"* ]]; then
        bad=1
    else
        token="${loc#http://$GW_LIVE_PROBE_DOMAIN/live/}"
        [[ "$token" =~ ^[0-9a-f]{64}$ ]] || bad=1
    fi
    if (( bad )); then
        echo "verify: the running gateway did not return the live configuration check redirect (it may be serving an earlier configuration or be mid-reload, e.g. a concurrent ensure); re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
        return 1
    fi
    printf '%s\n' "$token"
}

# EGL-394 R-EGL-394-16 F1: restore a moved stdio log with an atomic
# no-clobber link. A "test absent, then mv" pair is a TOCTOU race: Squid's
# rotation runs asynchronously (rotate_logs sets a flag processed later),
# so the daemon can reopen the live path between the test and the move.
# The old generation would then replace the reopened pathname while the
# daemon keeps writing to its now-unlinked inode — fresh denials vanish
# from `denied` and the detached log grows outside the pathname-based cap.
# `ln -T` is one link(2) and fails with EEXIST on any live path (including
# a dangling symlink); only a link that actually succeeded is followed by
# removing the moved name. Both names then point at the same inode, so
# there is no byte copy step that could lose a concurrent write.
gw_log_restore() { # gw_log_restore <gwname> <moved> <live> -> 0 restored
    local gwname="$1" moved="$2" live="$3"
    rt_exec "$gwname" ln -T "$moved" "$live" >/dev/null 2>&1 || return 1
    rt_exec "$gwname" rm -f "$moved" >/dev/null 2>&1 || true
    return 0
}

#
# Apply the generated allowlist config to the running gateway: stage
# everything, validate the candidate with `squid -k parse`, swap it in,
# and activate it. EGL-394: a warm instance started on the deployed
# config is reloaded in place by signalling the daemon (SIGHUP to the
# container's PID 1, which the entrypoint `exec`s as `squid -N`); the first
# apply (bootstrap-started), a forced restart (`disallow`), an unhealthy
# gateway, or an instance whose argv is not the deployed `-f` path takes
# the legacy container restart. The reload is only claimed after the
# gateway's own log names the deployed file, StartedAt is unchanged, and
# the probe answers.
#
# EGL-389: the apply's commit boundary. 1 only once the config swap has
# landed; a pre-activation disallow may restore the source only while
# this is 0.
GW_APPLY_COMMITTED=0
# EGL-369: the config dir this apply probed (R-EGL-369-10 F1: bind it for
# the final verify/cleanup so a second probe cannot disagree mid-run).
GW_APPLY_CFGDIR=""
# EGL-395: publication outcome unresolved (lost rename result that could
# not be resolved to a quiescent proof). Never restored/claimed as old.
GW_APPLY_UNKNOWN=0
# EGL-394: this run activated the published configuration (confirmed
# reload or healthy restart). S-P5 names a committed-but-unactivated
# apply.
GW_APPLY_ACTIVE=0
# EGL-395: sha256 of the candidate/deployed squid.conf generation.
GW_APPLY_GENERATION=""
# EGL-394 F1: the deployed squid.conf stat identity (device:inode, size,
# ctime) captured at the publication proof. Activation and the final
# verify re-check it: a file changed after the running instance loaded it
# is never reported as activation, even when the bytes were restored
# (ctime cannot be rewound by a byte restore). Empty outside an apply.
GW_APPLY_CONF_IDENT=""
# EGL-394: `disallow` sets this process-local flag before cmd_ensure so
# revocation still severs established tunnels. gw_apply_allowlist reads
# and clears it; a plain `ensure`/`allow` never sets it.
GW_FORCE_RESTART=0
# EGL-394: why an attempted warm reload was not confirmed (names the
# fallback warning's cause).
GW_RELOAD_PROBLEM=""
# EGL-394: set when the cache-log proof can never succeed for this
# attempt (the log shrank, was replaced, or the instance changed). The
# poll must stop claiming the same attempt can still confirm — a later
# stream that grows past the old offset must not be accepted (F2).
GW_RELOAD_TERMINAL=0
# EGL-217 (M2): ownership registry for the cmd_ensure EXIT-trap cleanup
# (ensure_cleanup). File-scope plain string — names never contain spaces
# and it is set-`u`-safe; cmd_ensure resets it and arms the trap. Marked
# by ensure_own at exactly three sites: ensure_anchor (before its run),
# ensure_gateway (after its replace rt_rm) and gw_apply_allowlist (before
# the config-apply restart, R2).
ENSURE_OWNED=""
# EGL-318: names this run's cleanup successfully removed (S1T consumes
# it; reset per ensure next to ENSURE_OWNED).
ENSURE_REMOVED=""
ensure_own() { # ensure_own <name> — unique-by-name ownership marker (EGL-217 M2)
    case " $ENSURE_OWNED " in
        *" $1 "*) ;;
        *) ENSURE_OWNED="$ENSURE_OWNED${ENSURE_OWNED:+ }$1" ;;
    esac
}
# EGL-394: true when the live PID 1 is Squid started with the deployed
# `-f` path. Reads /proc/1/cmdline as NUL-separated argv tokens (never a
# flattened string), converted to one token per line inside the container
# so the client transport cannot drop NULs. This is the warm-path gate:
# a bootstrap-started or otherwise shaped instance is not a reload
# candidate and takes the legacy restart.
gw_reload_argv_ok() { # gw_reload_argv_ok <gwname> <cfgdir>
    local gwname="$1" cfgdir="$2" out i has_n=0 pair=0
    if ! out="$(rt_exec "$gwname" bash -c 'exec tr "\0" "\n" < /proc/1/cmdline' 2>/dev/null)"; then
        return 1
    fi
    local -a argv=()
    mapfile -t argv <<<"$out"
    (( ${#argv[@]} >= 1 )) || argv=("")
    [[ "${argv[0]}" == "squid" ]] || return 1
    for ((i = 0; i < ${#argv[@]}; i++)); do
        [[ "${argv[i]}" == "-N" ]] && has_n=1
    done
    for ((i = 0; i + 1 < ${#argv[@]}; i++)); do
        if [[ "${argv[i]}" == "-f" && "${argv[i+1]}" == "$cfgdir/squid.conf" ]]; then
            pair=1
        fi
    done
    (( has_n == 1 && pair == 1 ))
}

# EGL-394: signal the running gateway daemon. The daemon is PID 1 (the
# entrypoint `exec`s `squid -N`), so signal that pid directly instead of
# using `squid -k`. `squid -k` resolves the daemon through
# `pid_filename`, but the shipped entrypoint's `squid -z` daemonizes: its
# background master can remove the pidfile after the `-N` instance has
# written it (live finding R-EGL-394-2 F2), so `squid -k` FATALs with
# "failed to open /tmp/squid.pid" and never reaches the daemon. The
# caller has already verified PID 1 is the `-N` instance on the deployed
# config (gw_reload_argv_ok); SIGHUP = reconfigure, SIGUSR1 = rotate.
gw_signal() { # gw_signal <gwname> <signal> — rc 0 when the signal was sent
    rt_exec "$1" bash -c "kill -$2 1" >/dev/null 2>&1
}

# EGL-394: the running instance must be Squid started on the deployed
# `-f` path, and when <generation> is non-empty the deployed squid.conf
# must still be that candidate. F3: a same-name replacement (healthy but
# bootstrap-started) or a config changed under us is never activation.
# F1: when <conf-ident> is non-empty, the deployed file's stat identity
# (device/inode, size, ctime) must still be the one captured at the
# publication proof — proving the bytes the running instance loaded are
# the bytes being claimed, not a file swapped out and back.
GW_ACTIVE_PROBLEM=""
gw_active_deployed_ok() { # gw_active_deployed_ok <gwname> <cfgdir> <generation> [<conf-ident>] [<port>]
    local got ident port="${5:-}"
    GW_ACTIVE_PROBLEM=""
    # EGL-515: with a port the liveness probe rides the same read batch
    # (the caller already proved the container running in this loop
    # iteration). A failed probe is a retryable answer (rc 2), distinct
    # from a terminal deployed-state mismatch; without a port the
    # existing "not running" gate stays.
    if [[ -z "$port" ]]; then
        gw_running "$1" || {
            GW_ACTIVE_PROBLEM="the gateway container is not running"
            return 1
        }
    fi
    # EGL-515: the argv, generation and identity proof is one read window.
    # A failed/malformed record is rc 2 and keeps every existing named
    # error; it is never read as a matching value.
    local -a active_spec=(argv A "$2"
        active.h h "$2/squid.conf" active.e e "$2/squid.conf"
        active.l L "$2/squid.conf" active.i i "$2/squid.conf")
    [[ -n "$port" ]] && active_spec+=(active.probe P "$port")
    gw_ctr_batch "$1" "${active_spec[@]}"
    if [[ -n "$port" ]] && (( ${GW_BATCH_RC[active.probe]:-2} != 0 )); then
        return 2
    fi
    if (( ${GW_BATCH_RC[argv]:-2} != 0 )); then
        GW_ACTIVE_PROBLEM="PID 1 is not Squid started on $2/squid.conf"
        return 1
    fi
    if [[ -n "$3" ]]; then
        if ! got="$(gw_batch_generation_value active)"; then
            GW_ACTIVE_PROBLEM="the deployed $2/squid.conf could not be read"
            return 1
        fi
        if [[ "$got" != "$3" ]]; then
            GW_ACTIVE_PROBLEM="the deployed $2/squid.conf is not the candidate this run published"
            return 1
        fi
    fi
    if [[ -n "${4:-}" ]]; then
        ident="${GW_BATCH_PAYLOAD[active.i]:-}"
        if (( ${GW_BATCH_RC[active.i]:-2} != 0 )) \
            || [[ ! "$ident" =~ ^[0-9]+:[0-9]+[[:space:]][0-9]+[[:space:]].+$ ]]; then
            GW_ACTIVE_PROBLEM="the deployed $2/squid.conf could not be inspected"
            return 1
        fi
        if [[ "$ident" != "$4" ]]; then
            GW_ACTIVE_PROBLEM="the deployed $2/squid.conf changed after the running gateway loaded it"
            return 1
        fi
    fi
    return 0
}

# EGL-394: true when the gateway's own cache.log gained the reload
# witness after the recorded offset AND is still the same stream.
# $3 is the pre-signal `dev:inode`, $4 the pre-signal size, $5/$6 the
# fixed prefix length/hash, $7 the pre-signal StartedAt. Prints the
# failure reason in GW_RELOAD_PROBLEM (never dies). A shrunken,
# replaced, or prefix-changing log is TERMINAL for the attempt
# (GW_RELOAD_TERMINAL=1): Squid rotates by rename+reopen, and accepting
# a later regrown file would attribute unrelated witness bytes to this
# apply (R-EGL-394-5 F2).
gw_reload_log_ok() { # gw_reload_log_ok <gwname> <cfgdir> <prev-ident> <prev-size> <prev-prefix-len> <prev-prefix> <prev-started>
    local gwname="$1" cfgdir="$2" prev_ident="$3" before="$4"
    local plen="$5" phash="$6" started="$7"
    local out stat_line ident after now_started now_prefix
    local post_ident post_size
    GW_RELOAD_PROBLEM=""
    if ! [[ "$before" =~ ^[0-9]+$ && "$plen" =~ ^[0-9]+$ ]] \
        || ! [[ "$prev_ident" =~ ^[0-9]+:[0-9]+$ ]]; then
        GW_RELOAD_PROBLEM="the gateway cache log could not be read before the reload"
        return 1
    fi
    # EGL-515: the stat, prefix hash, witness tail and re-stat are one
    # container-side script (D2). The H2 identity re-check below still
    # runs after the witness read, inside that same read window.
    GW_BATCH_RC=(); GW_BATCH_PAYLOAD=(); GW_BATCH_KEYS=(s1 p t w1 w2 s2)
    local k
    for k in "${GW_BATCH_KEYS[@]}"; do
        GW_BATCH_RC[$k]=2
        GW_BATCH_PAYLOAD[$k]=""
    done
    if ! out="$(rt_exec "$gwname" bash -c "$GW_RELOAD_SCRIPT" egl515-reload post \
        "$prev_ident" "$before" "$plen" "$phash" "$cfgdir" 2>/dev/null)"; then
        GW_RELOAD_PROBLEM="the gateway cache log could not be read after the reload"
        return 1
    fi
    gw_batch_parse "$out"
    (( ${GW_BATCH_RC[s1]:-2} == 0 )) || {
        GW_RELOAD_PROBLEM="the gateway cache log could not be read after the reload"
        return 1
    }
    stat_line="${GW_BATCH_PAYLOAD[s1]:-}"
    ident=""; after=""
    read -r ident after <<<"$stat_line" || true
    if ! [[ "$ident" =~ ^[0-9]+:[0-9]+$ && "$after" =~ ^[0-9]+$ ]]; then
        GW_RELOAD_PROBLEM="the gateway cache log could not be read after the reload"
        return 1
    fi
    if [[ "$ident" != "$prev_ident" ]]; then
        GW_RELOAD_PROBLEM="the gateway cache log was replaced during the reload"
        GW_RELOAD_TERMINAL=1
        return 1
    fi
    if (( after < before )); then
        GW_RELOAD_PROBLEM="the gateway cache log was rotated during the reload"
        GW_RELOAD_TERMINAL=1
        return 1
    fi
    if (( plen > 0 )); then
        now_prefix="${GW_BATCH_PAYLOAD[p]:-}"
        if (( ${GW_BATCH_RC[p]:-2} != 0 )) \
            || [[ ! "$now_prefix" =~ ^[0-9a-f]{64}$ ]]; then
            GW_RELOAD_PROBLEM="the gateway cache log could not be read after the reload"
            return 1
        fi
        if [[ "$now_prefix" != "$phash" ]]; then
            GW_RELOAD_PROBLEM="the gateway cache log changed during the reload"
            GW_RELOAD_TERMINAL=1
            return 1
        fi
    fi
    if (( ${GW_BATCH_RC[t]:-2} != 0 )); then
        GW_RELOAD_PROBLEM="the gateway cache log could not be read after the reload"
        return 1
    fi
    # EGL-394 H2: re-assert the stream identity after the witness read.
    # The witness just read must belong to the inode seen before it; a
    # shrink below the recorded offset is the same rotation fault. This
    # check is evaluated after the tail record even though both come from
    # the same script, so a stream swapped mid-window is still caught.
    (( ${GW_BATCH_RC[s2]:-2} == 0 )) || {
        GW_RELOAD_PROBLEM="the gateway cache log could not be read after the reload"
        return 1
    }
    post_ident=""; post_size=""
    read -r post_ident post_size <<<"${GW_BATCH_PAYLOAD[s2]:-}" || true
    if ! [[ "$post_ident" =~ ^[0-9]+:[0-9]+$ && "$post_size" =~ ^[0-9]+$ ]]; then
        GW_RELOAD_PROBLEM="the gateway cache log could not be read after the reload"
        return 1
    fi
    if [[ "$post_ident" != "$ident" ]]; then
        GW_RELOAD_PROBLEM="the gateway cache log was replaced during the reload"
        GW_RELOAD_TERMINAL=1
        return 1
    fi
    if (( post_size < before )); then
        GW_RELOAD_PROBLEM="the gateway cache log was rotated during the reload"
        GW_RELOAD_TERMINAL=1
        return 1
    fi
    if (( ${GW_BATCH_RC[w1]:-2} == 2 || ${GW_BATCH_RC[w2]:-2} == 2 )); then
        GW_RELOAD_PROBLEM="the gateway cache log could not be read after the reload"
        return 1
    fi
    if (( ${GW_BATCH_RC[w1]:-2} != 0 || ${GW_BATCH_RC[w2]:-2} != 0 )); then
        GW_RELOAD_PROBLEM="the gateway log did not name $cfgdir/squid.conf after the reload"
        return 1
    fi
    now_started="$(rt_inspect "$gwname" '{{.State.StartedAt}}' 2>/dev/null)" || now_started=""
    if [[ -z "$now_started" || "$now_started" != "$started" ]]; then
        GW_RELOAD_PROBLEM="the gateway restarted while the reload was being checked"
        return 1
    fi
    return 0
}

# EGL-389-D2: put the deployed allowlist.* set back from the pre-staging
# snapshot. Existing files are copied back from $stage/prev; a file that
# did not exist before is removed. The per-run container stage (staged
# groups + the candidate config) is always removed. Runs on every
# pre-publication failure path BEFORE the host stage is deleted — the
# caller owns the final rm -rf. Never dies (rc only): a failed rollback
# marks nothing and leaves the deployed set out of step (accepted
# residual, `## Follow-ups`), while D1's source restore/disclosure
# carries the truth. Content-addressed names published by an earlier
# failed run are the only files this can remove; a reused identical name
# is restored from its identical snapshot.
gw_apply_allowlist_rollback() { # gw_apply_allowlist_rollback <gwname> <cfgdir> <stage> <cstage> -> rc
    local gwname="$1" cfgdir="$2" stage="$3" cstage="$4" f base rc=0
    for f in "$stage"/pub/allowlist.*; do
        [[ -f "$f" ]] || continue
        base="$(basename "$f")"
        # Restore exactly what this run found: a name captured in the
        # pre-publication snapshot is copied back; a name absent from
        # that snapshot was published (or reused) by this run and is
        # removed. The name itself is content-addressed, so hash equality
        # does not prove the file predates this run.
        if [[ -e "$stage/prev/$base" ]]; then
            rt_cp "$stage/prev/$base" "$gwname:$cfgdir/$base" || rc=1
        else
            rt_exec "$gwname" rm -f "$cfgdir/$base" || rc=1
        fi
    done
    if [[ -n "$cstage" ]]; then
        rt_exec "$gwname" rm -rf "$cstage" || rc=1
    fi
    return "$rc"
}

gw_apply_allowlist() {
    local profile="$1" gwname force_restart="${GW_FORCE_RESTART:-0}"
    gwname="$(gw_name "$profile")"
    GW_FORCE_RESTART=0
    GW_APPLY_COMMITTED=0
    GW_APPLY_UNKNOWN=0
    GW_APPLY_ACTIVE=0
    GW_APPLY_GENERATION=""
    GW_APPLY_CONF_IDENT=""
    GW_APPLY_CFGDIR=""
    local stage cfgdir
    if ! gw_config_dir "$gwname" >/dev/null; then
        die "gateway config-directory probe failed (runtime exec test -d returned rc $GW_CONFIG_PROBE_RC; fail closed)"
    fi
    cfgdir="$GW_CONFIG_DIR_DETECTED"
    GW_APPLY_CFGDIR="$cfgdir"
    stage="$(mktemp -d /tmp/egresslock-allowlist.XXXXXX)"
    local candidate="$stage/squid-gw.conf"
    local pub="$stage/pub"
    chmod 700 "$stage"
    mkdir -p "$pub" || { rm -rf "$stage"; die "cannot create the allowlist staging dir (fail closed)"; }
    # Generate in a subshell: every generation failure path `die`s with
    # its own named message, and the subshell keeps that exit local so
    # this run's private host stage is removed before the process exits.
    # Capture its stderr so a named `die` is replayed exactly once: the
    # failed subshell must not stack the generic line on top of it. Only
    # a generation failure that did not name itself reaches the generic
    # line.
    local gen_err="$stage/.generation.err" gen_rc=0
    ( gw_generate_config "$profile" "$candidate" "$pub" "$cfgdir" ) 2>"$gen_err" || gen_rc=$?
    if (( gen_rc != 0 )); then
        if grep -q '^Error:' "$gen_err" 2>/dev/null; then
            cat "$gen_err" >&2 || true
            rm -rf "$stage"
            exit 1
        fi
        rm -rf "$stage"
        die "allowlist generation failed (fail closed)"
    fi
    if [[ -s "$gen_err" ]]; then
        cat "$gen_err" >&2 || true
    fi
    rm -f "$gen_err"
    chmod 644 "$candidate" "$pub"/allowlist.* 2>/dev/null || true

    local generation
    if ! generation="$(gw_sha256_file "$candidate")"; then
        rm -rf "$stage"
        die "allowlist generation failed: the generated config could not be hashed (fail closed)"
    fi
    GW_APPLY_GENERATION="$generation"

    # EGL-395: validate every generated basename and the candidate ref
    # set before any mutation: the parsed config must reference exactly
    # the group files this run generated, all under the detected cfgdir.
    local f name refs expected
    expected=""
    for f in "$pub"/allowlist.*; do
        [[ -f "$f" ]] || continue
        name="$(basename "$f")"
        if ! gw_group_name_ok "$name" "$f"; then
            rm -rf "$stage"
            die "allowlist generation failed: refusing unsafe group name '$name' (expected allowlist.domains.<sha256> or allowlist.p<port>.<sha256>)"
        fi
        expected="${expected}${expected:+$'\n'}$cfgdir/$name"
    done
    refs="$(grep -oE "\"$cfgdir/allowlist\.[A-Za-z0-9._-]+\"" "$candidate" | tr -d '"' | sort -u || true)"
    if [[ "$(sort -u <<<"$refs")" != "$(sort -u <<<"$expected")" ]]; then
        rm -rf "$stage"
        die "allowlist generation failed: the generated config references a different group set than was generated (fail closed)"
    fi
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        name="${f##*/}"
        if [[ "$f" != "$cfgdir/$name" ]] || ! [[ "$name" =~ ^allowlist\.(domains|p[1-9][0-9]{0,4})\.[0-9a-f]{64}$ ]]; then
            rm -rf "$stage"
            die "allowlist generation failed: refusing unsafe config reference '$f' (fail closed)"
        fi
    done <<<"$refs"

    # EGL-394: every healthy apply publishes. There is no byte-identity
    # skip and no activation oracle: identical content-addressed names
    # are reused, then the published config is activated (reload on a
    # warm deployed-path instance, restart otherwise).

    # EGL-389-D2: snapshot the deployed allowlist.* set before the first
    # publication. `test -e` distinguishes absent (nothing to snapshot;
    # the rollback removes a later published name) from a probe error
    # (dies named before any mutation — no rollback needed, D1 still
    # restores the source).
    local prev="$stage/prev" probe_rc si
    local -a snap_files=() snap_names=() snap_spec=()
    mkdir -p "$prev" || { rm -rf "$stage"; die "cannot create the gateway snapshot dir (fail closed)"; }
    for f in "$pub"/allowlist.*; do
        [[ -f "$f" ]] || continue
        name="$(basename "$f")"
        si=${#snap_files[@]}
        snap_files+=("$f")
        snap_names+=("$name")
        snap_spec+=("s$si.e" e "$cfgdir/$name")
    done
    if (( ${#snap_files[@]} > 0 )); then
        gw_ctr_batch "$gwname" "${snap_spec[@]}"
        local snap_any=0
        for si in "${!snap_files[@]}"; do
            name="${snap_names[$si]}"
            probe_rc="${GW_BATCH_RC[s$si.e]:-2}"
            if (( probe_rc == 0 )); then
                snap_any=1
            elif (( probe_rc != 1 )); then
                rm -rf "$stage"
                die "gateway deployed-config probe failed (podman exec test -e; fail closed; detected layout '$cfgdir')"
            fi
        done
        # EGL-515: one copy snapshots the deployed config tree. The
        # rollback only restores this run's staged group names, so
        # extra deployed files are inert; podman cp accepts exactly one
        # source and one destination (podman 5.4).
        if (( snap_any == 1 )) \
            && ! rt_cp "$gwname:$cfgdir/." "$prev/"; then
            rm -rf "$stage"
            die "gateway allowlist snapshot failed (podman cp; fail closed; detected layout '$cfgdir')"
        fi
    fi

    # EGL-395: private same-filesystem container stage. Copies target an
    # explicit file path; a directory copy or a basename collision is a
    # named fail before publication.
    local cstage
    if ! cstage="$(rt_exec "$gwname" mktemp -d "$cfgdir/.egresslock-stage.XXXXXX" 2>/dev/null)"; then
        rm -rf "$stage"
        die "gateway allowlist staging failed (podman exec mktemp; fail closed; detected layout '$cfgdir')"
    fi
    if [[ "$cstage" != "$cfgdir/.egresslock-stage."* || "$cstage" == *[[:space:]]* ]]; then
        rm -rf "$stage"
        die "gateway allowlist staging failed (unexpected stage path; fail closed; detected layout '$cfgdir')"
    fi
    # EGL-395: publish groups under their content-addressed names. An
    # existing name is reused only when it is a regular, non-symlink file
    # with identical bytes; a different shape or different bytes fails
    # closed without touching the existing path. Publication is a
    # no-clobber hard link from this run's private stage.
    # EGL-515: staged verification and the pre-publication shape checks
    # are consecutive read-only probes with no mutation between them, so
    # one window answers both; the staged checks are interpreted first so
    # every named error keeps its order.
    local got
    local path
    local -a stg_files=() stg_names=() stg_spec=()
    local -a pub_files=() pub_names=() pub_spec=() new_names=() new_spec=()
    local pi ni
    for f in "$pub"/allowlist.*; do
        [[ -f "$f" ]] || continue
        name="$(basename "$f")"
        si=${#stg_files[@]}
        stg_files+=("$f")
        stg_names+=("$name")
        stg_spec+=("v$si.l" L "$cstage/$name" "v$si.f" f "$cstage/$name" "v$si.h" h "$cstage/$name")
        path="$cfgdir/$name"
        pi=${#pub_files[@]}
        pub_files+=("$f")
        pub_names+=("$name")
        pub_spec+=("p$pi.l" L "$path" "p$pi.e" e "$path" "p$pi.f" f "$path" "p$pi.h" h "$path")
    done
    # EGL-515: one copy carries the whole generated group set into the
    # private stage. `podman cp` accepts exactly one source and one
    # destination (podman 5.4 rejects a third argument), so the set is
    # copied as a directory's contents ($pub/.) rather than as multiple
    # sources. A failure still reaches the same rollback and named die;
    # files copied before the failing source are swept by it.
    if (( ${#stg_files[@]} > 0 )) \
        && ! rt_cp "$pub/." "${gwname}:$cstage/"; then
        gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
        rm -rf "$stage"
        die "gateway allowlist staging failed (podman cp; fail closed; detected layout '$cfgdir')"
    fi
    if (( ${#stg_files[@]} > 0 )); then
        gw_ctr_batch "$gwname" "${stg_spec[@]}" "${pub_spec[@]}"
        for si in "${!stg_files[@]}"; do
            name="${stg_names[$si]}"
            if (( ${GW_BATCH_RC[v$si.l]:-2} != 1 )) \
                || (( ${GW_BATCH_RC[v$si.f]:-2} != 0 )) \
                || (( ${GW_BATCH_RC[v$si.h]:-2} != 0 )) \
                || [[ "${GW_BATCH_PAYLOAD[v$si.h]:-}" != "${name##*.}" ]]; then
                gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
                rm -rf "$stage"
                die "gateway allowlist staging failed (staged file verification; fail closed; detected layout '$cfgdir')"
            fi
        done
    fi
    for pi in "${!pub_files[@]}"; do
        name="${pub_names[$pi]}"
        path="$cfgdir/$name"
        if (( ${GW_BATCH_RC[p$pi.l]:-2} == 0 )); then
            gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
            rm -rf "$stage"
            die "gateway: refusing to publish allowlist group '$name': '$path' exists but is not a regular file (symbolic link, directory, or other type); nothing was replaced — next action: inspect the path; do not delete the live config dir wholesale."
        elif (( ${GW_BATCH_RC[p$pi.l]:-2} != 1 )); then
            gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
            rm -rf "$stage"
            die "gateway deployed-config probe failed (podman exec test -L; fail closed; detected layout '$cfgdir')"
        fi
        if (( ${GW_BATCH_RC[p$pi.e]:-2} == 0 )); then
            if (( ${GW_BATCH_RC[p$pi.f]:-2} == 1 )); then
                gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
                rm -rf "$stage"
                die "gateway: refusing to publish allowlist group '$name': '$path' exists but is not a regular file (symbolic link, directory, or other type); nothing was replaced — next action: inspect the path; do not delete the live config dir wholesale."
            elif (( ${GW_BATCH_RC[p$pi.f]:-2} != 0 )); then
                gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
                rm -rf "$stage"
                die "gateway deployed-config probe failed (podman exec test -f; fail closed; detected layout '$cfgdir')"
            fi
            if (( ${GW_BATCH_RC[p$pi.h]:-2} != 0 )) \
                || [[ "${GW_BATCH_PAYLOAD[p$pi.h]:-}" != "${name##*.}" ]]; then
                gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
                rm -rf "$stage"
                die "gateway: refusing to publish allowlist group '$name': an existing content-addressed file has different bytes; nothing was replaced — next action: inspect the gateway configuration."
            fi
        elif (( ${GW_BATCH_RC[p$pi.e]:-2} == 1 )); then
            ni=${#new_names[@]}
            new_names+=("$name")
            new_spec+=("q$ni.l" L "$path" "q$ni.f" f "$path" "q$ni.h" h "$path")
            if ! rt_exec "$gwname" ln -T "$cstage/$name" "$path"; then
                gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
                rm -rf "$stage"
                die "gateway allowlist publication failed (no-clobber link; fail closed; detected layout '$cfgdir')"
            fi
        else
            gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
            rm -rf "$stage"
            die "gateway deployed-config probe failed (podman exec test -e; fail closed; detected layout '$cfgdir')"
        fi
    done
    if (( ${#new_names[@]} > 0 )); then
        gw_ctr_batch "$gwname" "${new_spec[@]}"
        for ni in "${!new_names[@]}"; do
            name="${new_names[$ni]}"
            if (( ${GW_BATCH_RC[q$ni.l]:-2} != 1 )) \
                || (( ${GW_BATCH_RC[q$ni.f]:-2} != 0 )) \
                || (( ${GW_BATCH_RC[q$ni.h]:-2} != 0 )) \
                || [[ "${GW_BATCH_PAYLOAD[q$ni.h]:-}" != "${name##*.}" ]]; then
                gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
                rm -rf "$stage"
                die "gateway allowlist publication failed (published file verification; fail closed; detected layout '$cfgdir')"
            fi
        done
    fi

    # EGL-395: stage the candidate in the private stage and parse exactly
    # those bytes. The referenced groups are already published at their
    # final names, so the parse proves the installed set.
    if ! rt_cp "$candidate" "${gwname}:$cstage/squid.conf"; then
        gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
        rm -rf "$stage"
        die "gateway config staging failed (podman cp; fail closed; detected layout '$cfgdir')"
    fi
    # EGL-515: one read window before the parse re-proves the staged
    # candidate bytes against the host generation and shape-checks the
    # publication target (parent order: prove the staged bytes first).
    # The target's absence still needs both -e and -L to answer exactly
    # 1; an rc 2 is a failed probe, never absent.
    local old_generation
    gw_ctr_batch "$gwname" \
        cand.l L "$cstage/squid.conf" cand.f f "$cstage/squid.conf" cand.h h "$cstage/squid.conf" \
        tgt.l L "$cfgdir/squid.conf" tgt.e e "$cfgdir/squid.conf" tgt.f f "$cfgdir/squid.conf" tgt.h h "$cfgdir/squid.conf"
    if (( ${GW_BATCH_RC[cand.l]:-2} != 1 )) \
        || (( ${GW_BATCH_RC[cand.f]:-2} != 0 )) \
        || (( ${GW_BATCH_RC[cand.h]:-2} != 0 )) \
        || [[ "${GW_BATCH_PAYLOAD[cand.h]:-}" != "$generation" ]]; then
        gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
        rm -rf "$stage"
        die "gateway config staging failed (staged candidate verification; fail closed; detected layout '$cfgdir')"
    fi
    if (( ${GW_BATCH_RC[tgt.l]:-2} == 0 )); then
        gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
        rm -rf "$stage"
        die "gateway: refusing to publish the allowlist: '$cfgdir/squid.conf' is a symbolic link; nothing was replaced — next action: inspect the path; do not delete the live config dir wholesale."
    elif (( ${GW_BATCH_RC[tgt.l]:-2} != 1 )); then
        gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
        rm -rf "$stage"
        die "gateway deployed-config probe failed (podman exec test -L; fail closed; detected layout '$cfgdir')"
    fi
    if (( ${GW_BATCH_RC[tgt.e]:-2} == 0 )); then
        if (( ${GW_BATCH_RC[tgt.f]:-2} == 1 )); then
            gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
            rm -rf "$stage"
            die "gateway: refusing to publish the allowlist: '$cfgdir/squid.conf' exists but is not a regular file; nothing was replaced — next action: inspect the path; do not delete the live config dir wholesale."
        elif (( ${GW_BATCH_RC[tgt.f]:-2} != 0 )); then
            gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
            rm -rf "$stage"
            die "gateway deployed-config probe failed (podman exec test -f; fail closed; detected layout '$cfgdir')"
        fi
        if ! old_generation="$(gw_batch_generation_value tgt)"; then
            gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
            rm -rf "$stage"
            die "gateway: refusing to publish the allowlist: the deployed '$cfgdir/squid.conf' could not be read; nothing was replaced — next action: inspect the gateway configuration."
        fi
    elif (( ${GW_BATCH_RC[tgt.e]:-2} == 1 )); then
        old_generation=absent
    else
        gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
        rm -rf "$stage"
        die "gateway deployed-config probe failed (podman exec test -e; fail closed; detected layout '$cfgdir')"
    fi

    # -k parse validates the config WITHOUT a running instance or PID
    # file; -k check demands the instance PID file, which `squid -N`
    # does not reliably leave behind (ARC-5). EGL-515/D1: multi-line
    # output stays its own direct exec — never a batch record and never
    # retried after a failure (EGL-283 keeps this exec's stderr detail).
    local check_out=""
    if ! check_out="$(rt_exec "$gwname" squid -k parse -f "$cstage/squid.conf" 2>&1)"; then
        gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "$cstage" || true
        rm -rf "$stage"
        die "gateway rejected the generated config (fail closed; detected layout '$cfgdir'): $check_out"
    fi

    # EGL-515: the best-effort witness removal and the rename are one
    # mutation script. On a completed rename it also sweeps the private
    # stage; a failed/lost result leaves the stage for the quiescence
    # sweep below. The exit status is the rename's, so a lost client
    # result still takes the unknown-outcome path.
    local mv_rc=0 published=0 cur=""
    if rt_exec "$gwname" bash -c "$GW_PUBLISH_SCRIPT" egl515-publish \
        "$cfgdir/.egresslock-activated" "$cstage/squid.conf" "$cfgdir/squid.conf" "$cstage"; then
        mv_rc=0
    else
        mv_rc=$?
    fi
    if (( mv_rc == 0 )); then
        if gw_publish_read "$gwname" "$cfgdir/squid.conf" \
            && [[ "$GW_READ_GEN" == "$generation" ]]; then
            published=1
        fi
    else
        local ri
        for ri in 1 2 3 4 5; do
            if gw_publish_read "$gwname" "$cfgdir/squid.conf" \
                && [[ "$GW_READ_GEN" == "$generation" ]]; then
                published=1
                break
            fi
            sleep 0.2
        done
    fi
    if (( mv_rc != 0 && published == 0 )); then
        # Quiescence: a rename that has not reached the kernel loses its
        # source when this run's stage is removed; one that completed is
        # visible in squid.conf. Then re-read. "Gone" is positive proof
        # of absence (both probes ran and answered 1). EGL-515: the
        # stage-absence probes and the config re-read share one window.
        if rt_exec "$gwname" rm -rf "$cstage" >/dev/null 2>&1; then
            if gw_publish_read "$gwname" "$cfgdir/squid.conf" \
                    stage.e e "$cstage" stage.l L "$cstage" \
                && (( ${GW_BATCH_RC[stage.e]:-2} == 1 )) \
                && (( ${GW_BATCH_RC[stage.l]:-2} == 1 )); then
                cur="$GW_READ_GEN"
                if [[ "$cur" == "$generation" ]]; then
                    published=1
                elif [[ "$old_generation" == absent ]]; then
                    if [[ "$cur" == absent ]]; then
                        # Proven pre-publication: the old config was absent
                        # and the candidate did not land (a non-zero rename
                        # result whose sweep is quiescent).
                        gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "" || true
                        rm -rf "$stage"
                        die "gateway config swap failed (fail closed; detected layout '$cfgdir')"
                    fi
                elif [[ "$cur" == "$old_generation" ]]; then
                    gw_apply_allowlist_rollback "$gwname" "$cfgdir" "$stage" "" || true
                    rm -rf "$stage"
                    die "gateway config swap failed (fail closed; detected layout '$cfgdir')"
                fi
            fi
        fi
    fi
    local lost_note=0
    if (( published == 1 )); then
        # EGL-394 F1: capture the deployed file's stat identity together
        # with the publication proof. Activation (reload or restart) and
        # the final verify re-check it, so a config swapped after the
        # running instance loaded it — even restored to the same bytes —
        # is never reported as activation. Publication is already proven
        # here, so a failed capture is a committed-but-unactivated apply.
        if (( GW_READ_IDENT_OK != 1 )); then
            GW_APPLY_CONF_IDENT=""
            GW_APPLY_COMMITTED=1
            ensure_own "$gwname"
            rt_exec "$gwname" rm -rf "$cstage" >/dev/null 2>&1 || true
            rm -rf "$stage"
            die "gateway configuration publication was confirmed, but the deployed $cfgdir/squid.conf could not be inspected (fail closed); the running gateway was not activated — next action: run: egresslock ensure $profile"
        fi
        GW_APPLY_CONF_IDENT="$GW_READ_IDENT"
        if (( mv_rc != 0 )); then
            lost_note=1
        fi
        GW_APPLY_COMMITTED=1
        ensure_own "$gwname"
        # EGL-515: the publish script already swept the stage when the
        # rename reported success; a lost result may have left it.
        if (( mv_rc != 0 )); then
            rt_exec "$gwname" rm -rf "$cstage" >/dev/null 2>&1 || true
        fi
        rm -rf "$stage"
    else
        # Unknown outcome: never restore the source or claim the old
        # config. Mark committed+unknown so the disclosure names the
        # uncertainty; the EGL-389 source restore must not run. The
        # config rename did not reach activation, so a pre-existing
        # gateway is NOT owned by this run (EGL-217 cleanup must leave it
        # serving; only a replacement this run already started is owned).
        # Best-effort stage removal cannot reopen the classification.
        GW_APPLY_UNKNOWN=1
        GW_APPLY_COMMITTED=1
        rt_exec "$gwname" rm -rf "$cstage" >/dev/null 2>&1 || true
        rm -rf "$stage"
        die "gateway config publication could not be confirmed (the rename outcome or the deployed configuration could not be proven); the deployed configuration may or may not have been replaced — next action: run: egresslock ensure $profile to converge it."
    fi
    # EGL-394: activate the published config. Take the reload path only
    # when the running instance is healthy and its argv shows it was
    # started on the deployed `-f` path; bootstrap/other-shaped instances
    # take the legacy restart (the normal first apply). `disallow` forces
    # the restart so revocation still severs established tunnels.
    local port="${GW_PORT[$profile]}" i reload_attempted=0 reload_wait=0
    local restarted_during=0 reloaded=0
    local started_before="" log_ident="" log_size="" log_prefix_len=0 log_prefix=""
    local gate_ok=0
    GW_RELOAD_TERMINAL=0
    if (( force_restart == 0 )); then
        # EGL-515: the warm gate (liveness probe + PID 1 argv) and the
        # pre-signal cache.log baseline are consecutive read-only probes
        # with no mutation between them, so one batch answers all three.
        # A failed gate (probe/argv rc != 0) keeps the old silent
        # restart; a failed baseline read below keeps its named warning.
        gw_ctr_batch "$gwname" \
            gate.probe P "$port" gate.argv A "$cfgdir" \
            pre.b B /var/log/squid/cache.log
        if (( ${GW_BATCH_RC[gate.probe]:-2} == 0 )) \
            && (( ${GW_BATCH_RC[gate.argv]:-2} == 0 )); then
            gate_ok=1
        fi
    fi
    if (( gate_ok == 1 )); then
        # EGL-394 F2: this is the warm path. A healthy instance on the
        # deployed `-f` path takes an unexpected restart when the
        # pre-signal reads fail, and that can drop proxied sessions; it
        # must carry the same fallback warning as a signal that was sent
        # but not confirmed. Bootstrap/other-argv instances and the
        # forced `disallow` restart stay silent.
        started_before="$(rt_inspect "$gwname" '{{.State.StartedAt}}' 2>/dev/null)" || started_before=""
        if [[ -n "$started_before" ]]; then
            # EGL-515: the batch above read the cache.log identity, size
            # and fixed prefix before the signal; parse that window.
            if gw_reload_pre_parse pre.b; then
                log_ident="$GW_RELOAD_BEFORE_IDENT"
                log_size="$GW_RELOAD_BEFORE_SIZE"
                log_prefix_len="$GW_RELOAD_BEFORE_PLEN"
                log_prefix="$GW_RELOAD_BEFORE_PREFIX"
                reload_attempted=1
                GW_RELOAD_PROBLEM=""
                if ! gw_signal "$gwname" HUP; then
                    GW_RELOAD_PROBLEM="the reload signal failed"
                else
                    reload_wait=1
                fi
            else
                reload_attempted=1
            fi
        else
            GW_RELOAD_PROBLEM="the gateway start time could not be read"
        fi
        if (( reload_wait == 0 )); then
            # No signal was sent because a pre-signal read failed: the
            # restart that follows is unexpected on the warm path.
            reload_attempted=1
        fi
    fi
    if (( reload_wait == 1 )); then
        for i in $(seq 1 120); do
            if ! gw_running "$gwname"; then
                break
            fi
            local now_started
            now_started="$(rt_inspect "$gwname" '{{.State.StartedAt}}' 2>/dev/null)" || now_started=""
            if [[ -n "$now_started" && "$now_started" != "$started_before" ]]; then
                restarted_during=1
                GW_RELOAD_PROBLEM="the gateway restarted while the reload was being checked"
                break
            fi
            if gw_reload_log_ok "$gwname" "$cfgdir" "$log_ident" "$log_size" \
                "$log_prefix_len" "$log_prefix" "$started_before"; then
                local active_rc=0
                if gw_active_deployed_ok "$gwname" "$cfgdir" "$generation" "$GW_APPLY_CONF_IDENT" "$port"; then
                    reloaded=1
                    break
                else
                    active_rc=$?
                fi
                if (( active_rc == 2 )); then
                    GW_RELOAD_PROBLEM="the gateway did not answer on port $port after the reload"
                else
                    GW_RELOAD_PROBLEM="${GW_ACTIVE_PROBLEM:-the running gateway was replaced while the reload was being checked}"
                    GW_RELOAD_TERMINAL=1
                fi
            fi
            (( GW_RELOAD_TERMINAL == 1 )) && break
            sleep 0.5
        done
        if (( reloaded == 1 )); then
            GW_APPLY_ACTIVE=1
        elif (( restarted_during == 1 )); then
            # The container restarted under us (the reload did not
            # complete). Wait for the new instance to answer; do not
            # claim a reload unless the new instance itself is Squid on
            # the deployed config holding the candidate (F3).
            for i in $(seq 1 120); do
                gw_running "$gwname" && gw_probe "$gwname" "$port" && break
                sleep 0.5
            done
            if ! gw_running "$gwname" || ! gw_probe "$gwname" "$port"; then
                die "gateway did not come back healthy after config application (fail closed)"
            fi
            if gw_active_deployed_ok "$gwname" "$cfgdir" "$generation" "$GW_APPLY_CONF_IDENT"; then
                GW_APPLY_ACTIVE=1
                echo "warn: the gateway restarted while applying the config — proxied connections through it may have dropped; the new config is active and verified." >&2
            fi
        fi
    fi
    if (( GW_APPLY_ACTIVE != 1 )); then
        rt_restart "$gwname" 5 >/dev/null
        for i in $(seq 1 120); do
            gw_running "$gwname" && gw_probe "$gwname" "$port" && break
            sleep 0.5
        done
        if ! gw_running "$gwname" || ! gw_probe "$gwname" "$port"; then
            die "gateway did not come back healthy after config application (fail closed)"
        fi
        if ! gw_active_deployed_ok "$gwname" "$cfgdir" "$generation" "$GW_APPLY_CONF_IDENT"; then
            die "gateway did not activate the published configuration (${GW_ACTIVE_PROBLEM:-the running instance is not the deployed configuration}; fail closed)"
        fi
        GW_APPLY_ACTIVE=1
        if (( reload_attempted == 1 )); then
            echo "warn: could not confirm the gateway reloaded $cfgdir/squid.conf (${GW_RELOAD_PROBLEM:-the reload could not be confirmed}); restarting the gateway to apply the config — proxied connections through it may drop." >&2
        fi
    fi
    # EGL-395 S-P6: a lost rename result that landed. Report the
    # activation that actually ran.
    if (( lost_note == 1 )); then
        if (( reloaded == 1 )); then
            echo "gateway: note: podman reported an error while publishing the configuration, but the deployed configuration matches the new bytes; the apply continued and reloaded the running gateway to activate it." >&2
        else
            echo "gateway: note: podman reported an error while publishing the configuration, but the deployed configuration matches the new bytes; the apply continued and restarted the gateway to activate it." >&2
        fi
    fi
    return 0
}

# EGL-395: reference-driven cleanup. Runs only after verify_gateway
# succeeded. Reads and hashes the deployed config first; an unreadable
# set is never treated as empty. Keeps squid.conf, allowlist.conf and
# every deployed ref, and removes only unreferenced regular
# allowlist.*/check.conf files and private stage dirs older than the
# grace window. Host-side /tmp/egresslock-allowlist.* staging dirs keep
# the grace window plus a 10 s age margin (EGL-451). This is a narrow
# age mitigation, not liveness detection: a stage older than the margin
# is still eligible while an apply in a distinct lock domain under the
# same uid may be using it (pre-existing residual, see the ticket).
# EGL-394: a leftover
# `.egresslock-activated` witness is removed without grace (nothing
# reads it any more). Never dies, never changes the rc.
gw_cleanup_config() { # gw_cleanup_config <gwname> <cfgdir> <expected-generation>
    local gwname="$1" cfgdir="$2" gen="$3"
    local grace cur conf refs ref base now age err
    local young=0 failed=0 detail="" hfailed=0 hdetail=""
    local -a files=() dirs=() links=() rm_files=() rm_dirs=()
    local -A fmtime=() dmtime=()
    grace="${EGRESSLOCK_GW_CLEANUP_GRACE:-3600}"
    if [[ ! "$grace" =~ ^(0|[1-9][0-9]*)$ ]]; then
        echo "cleanup: warning: EGRESSLOCK_GW_CLEANUP_GRACE must be a non-negative integer (seconds); using 3600." >&2
        grace=3600
    fi
    now="$(date +%s)"
    # EGL-515: the witness removal, the deployed-config read and the
    # directory listing are one exec (GW_CLEANUP_SCRIPT). The config
    # record is consumed here and the listing after reference validation,
    # so every named skip keeps its old order. The hash is over the exact
    # bytes decoded from the record, not the shell-stripped string.
    local tmpf cout cline fline ckey crc cdata fkey frc fdata listing
    if ! tmpf="$(mktemp)"; then
        echo "cleanup: skipped removing old gateway configuration files — the deployed configuration could not be read, so no file was treated as unused; all files were kept; the next ensure retries." >&2
        return 0
    fi
    if ! cout="$(rt_exec "$gwname" bash -c "$GW_CLEANUP_SCRIPT" egl515-cleanup \
        "$cfgdir/.egresslock-activated" "$cfgdir/squid.conf" "$cfgdir" 2>/dev/null)"; then
        rm -f "$tmpf"
        echo "cleanup: skipped removing old gateway configuration files — the deployed configuration could not be read, so no file was treated as unused; all files were kept; the next ensure retries." >&2
        return 0
    fi
    cline="${cout%%$'\n'*}"
    fline="${cout#*$'\n'}"
    read -r ckey crc cdata <<<"$cline"
    if [[ "$ckey" != cfg || "$crc" != 0 ]] \
        || ! printf '%s' "$cdata" | base64 -d > "$tmpf" 2>/dev/null; then
        rm -f "$tmpf"
        echo "cleanup: skipped removing old gateway configuration files — the deployed configuration could not be read, so no file was treated as unused; all files were kept; the next ensure retries." >&2
        return 0
    fi
    if ! cur="$(gw_sha256_file "$tmpf")" || [[ "$cur" != "$gen" ]]; then
        rm -f "$tmpf"
        echo "cleanup: skipped removing old gateway configuration files — the deployed configuration could not be read, so no file was treated as unused; all files were kept; the next ensure retries." >&2
        return 0
    fi
    conf="$(cat "$tmpf")"
    rm -f "$tmpf"
    # R-EGL-369-10 F1: read EVERY quoted absolute reference, not just the
    # ones already in the detected spelling. A deployed config that names
    # another layout (e.g. the old path through the new image's symlink)
    # must make cleanup keep all files, never treat its references as
    # unused.
    refs="$(grep -oE '"[^"]+"' <<<"$conf" | tr -d '"' | grep '^/' | sort -u || true)"
    local -A keep=()
    keep[squid.conf]=1
    keep[allowlist.conf]=1
    while IFS= read -r ref; do
        [[ -n "$ref" ]] || continue
        base="${ref##*/}"
        if [[ "$ref" != "$cfgdir/$base" ]] \
            || ! [[ "$base" =~ ^allowlist\.(domains|p[1-9][0-9]{0,4})\.[0-9a-f]{64}$ ]]; then
            echo "cleanup: skipped removing old gateway configuration files — the deployed configuration referenced an unexpected path, so no file was treated as unused; all files were kept; the next ensure retries." >&2
            return 0
        fi
        keep[$base]=1
    done <<<"$refs"
    # EGL-515: one GNU find listing replaces the three type-scoped finds
    # and every per-file stat. Type, mtime and name come from the same
    # read; %T@ is truncated to integer seconds so the grace compare
    # matches the old `stat -c %Y`. A failed listing skips cleanup. The
    # retired EGL-395 activation witness (nothing reads it; not a Squid
    # dependency) is removed in the same exec, ahead of the listing, so a
    # leftover never waits for the grace window.
    local listing line typ rest mt path
    read -r fkey frc fdata <<<"$fline"
    if [[ "$fkey" != find || "$frc" != 0 ]] \
        || ! listing="$(printf '%s' "$fdata" | base64 -d 2>/dev/null)"; then
        echo "cleanup: skipped removing old gateway configuration files — the deployed configuration directory could not be read, so no file was treated as unused; all files were kept; the next ensure retries." >&2
        return 0
    fi
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        typ="${line%% *}"
        rest="${line#* }"
        [[ "$rest" != "$line" ]] || continue
        mt="${rest%% *}"
        base="${rest#* }"
        [[ "$mt" != "$rest" ]] || continue
        mt="${mt%%.*}"
        case "$typ" in
            f) files+=("$base"); fmtime[$base]="$mt" ;;
            d) dirs+=("$base"); dmtime[$base]="$mt" ;;
            l) links+=("$base") ;;
        esac
    done <<<"$listing"
    for base in "${links[@]:-}"; do
        [[ -n "$base" ]] || continue
        echo "cleanup: warning: kept '$cfgdir/$base': it is a symbolic link or unexpected type; it was not treated as an unused file." >&2
    done
    for base in "${files[@]:-}"; do
        [[ -n "$base" ]] || continue
        [[ -n "${keep[$base]:-}" ]] && continue
        if [[ "$base" != "check.conf" && "$base" != allowlist.* ]]; then
            continue
        fi
        age="${fmtime[$base]:-}"
        if ! [[ "$age" =~ ^[0-9]+$ ]]; then
            failed=$((failed + 1))
            [[ -n "$detail" ]] || detail="modification time of '$cfgdir/$base' could not be read"
            continue
        fi
        if (( now - age < grace )); then
            young=$((young + 1))
            continue
        fi
        rm_files+=("$cfgdir/$base")
    done
    for base in "${dirs[@]:-}"; do
        [[ -n "$base" ]] || continue
        [[ "$base" == .egresslock-stage.* ]] || continue
        age="${dmtime[$base]:-}"
        if ! [[ "$age" =~ ^[0-9]+$ ]]; then
            failed=$((failed + 1))
            [[ -n "$detail" ]] || detail="modification time of '$cfgdir/$base' could not be read"
            continue
        fi
        if (( now - age < grace )); then
            young=$((young + 1))
            continue
        fi
        rm_dirs+=("$cfgdir/$base")
    done
    # One batched removal per kind. A failed batch is followed by a
    # per-path existence re-probe: only a path proven absent may be
    # treated as removed, so `failed`/`detail` keep their semantics.
    if (( ${#rm_files[@]} > 0 )); then
        if ! err="$(rt_exec "$gwname" rm -f -- "${rm_files[@]}" 2>&1)"; then
            for path in "${rm_files[@]}"; do
                if gw_ctr_test "$gwname" -e "$path"; then
                    prc=0
                else
                    prc=$?
                fi
                if (( prc != 1 )); then
                    failed=$((failed + 1))
                    [[ -n "$detail" ]] || detail="'$path' could not be removed${err:+: $err}"
                fi
            done
        fi
    fi
    if (( ${#rm_dirs[@]} > 0 )); then
        if ! err="$(rt_exec "$gwname" rm -rf -- "${rm_dirs[@]}" 2>&1)"; then
            for path in "${rm_dirs[@]}"; do
                if gw_ctr_test "$gwname" -e "$path"; then
                    prc=0
                else
                    prc=$?
                fi
                if (( prc != 1 )); then
                    failed=$((failed + 1))
                    [[ -n "$detail" ]] || detail="'$path' could not be removed${err:+: $err}"
                fi
            done
        fi
    fi
    # Host stages from a killed run follow the same grace rule. Scoped to
    # this UID and the engine's own /tmp prefix; never another directory.
    local hf hage hlist
    if hlist="$(find /tmp -maxdepth 1 -type d -name 'egresslock-allowlist.*' -user "$(id -u)" -print 2>/dev/null)"; then
        while IFS= read -r hf; do
            [[ -n "$hf" ]] || continue
            [[ "$hf" == /tmp/egresslock-allowlist.* ]] || continue
            if ! hage="$(stat -c %Y "$hf" 2>/dev/null)" || ! [[ "$hage" =~ ^[0-9]+$ ]]; then
                hfailed=$((hfailed + 1))
                [[ -n "$hdetail" ]] || hdetail="'$hf' could not be inspected"
                continue
            fi
            # Age margin only: distinct lock domains (the sharded test
            # harness) can run concurrently under one uid and each keeps
            # its host stage only for the duration of an apply. A stage
            # younger than grace + 10 is left alone, but this does not
            # prove liveness; an older stage is still eligible (EGL-451
            # residual). A killed run's scratch is still removed by a
            # later ensure.
            if (( now - hage < grace + 10 )); then
                # Kept until it ages; a crashed run's private scratch is
                # not a deployed dependency. Removal failures still warn.
                continue
            fi
            if ! rm -rf -- "$hf" 2>/dev/null; then
                hfailed=$((hfailed + 1))
                [[ -n "$hdetail" ]] || hdetail="'$hf' could not be removed"
            fi
        done <<<"$hlist"
    fi
    if (( failed > 0 )); then
        echo "cleanup: could not remove $failed unreferenced gateway configuration file(s) in $cfgdir ($detail); they are not referenced by the deployed configuration but still use space; the next ensure retries." >&2
        if [[ "$detail" == *"No space left on device"* || "$detail" == *"space"* ]]; then
            echo "cleanup: free space in $cfgdir (or the gateway stage path) and re-run: egresslock ensure" >&2
        fi
    fi
    if (( young > 0 )); then
        echo "cleanup: kept $young unreferenced gateway configuration file(s) in $cfgdir newer than ${grace}s; they are not referenced by the deployed configuration but still use space; the next ensure retries after they age." >&2
    fi
    if (( hfailed > 0 )); then
        echo "cleanup: could not remove $hfailed old gateway stage director(ies) in /tmp ($hdetail); they still use space; the next ensure retries." >&2
    fi
    return 0
}

gw_running() {
    local names
    names="$(rt_ps 2>/dev/null || true)"
    grep -qx "$1" <<<"$names"
}

gw_probe() {
    # Direct liveness probe: the proxy must answer a TCP connect on its
    # port. Not the image HEALTHCHECK state — absent for OCI-built
    # images (ARC-5) and therefore unreliable.
    local gwname="$1" port="$2"
    rt_exec "$gwname" bash -c "exec 3<>/dev/tcp/127.0.0.1/$port" >/dev/null 2>&1
}

# EGL-515: the converged-gateway predicate's liveness and live-hardening
# reads in one window. The TCP probe is also the running oracle: a stopped
# container fails the exec, so a separate `podman ps` adds nothing and its
# two possible failures already fall through to replacement. The caps
# state keeps kit_caps_state's exact vocabulary.
gw_gateway_health_ok() { # <gwname> <port>
    local gwname="$1" port="$2" state
    gw_ctr_batch "$gwname" probe P "$port" caps C /proc/1/status
    (( ${GW_BATCH_RC[probe]:-2} == 0 )) || return 1
    state="$(gw_batch_caps_state caps)"
    [[ "$state" == "ok" ]]
}

# ARC-32-D1: overlay log cap. squid.conf logs to
# `stdio:/var/log/squid/access.log` with no rotate, so a workload CONNECT
# flood (plus cache.log) grows the gateway overlay until it fills and
# `denied` OOMs on the read (ARC-42 caps the detect loop's time window,
# ARC-32-D1 its transfer; this caps the disk). Run on `verify` and on
# `ensure` once the gateway runs: access.log/cache.log over
# EGRESSLOCK_GW_LOG_MAX_BYTES (default 32 MiB; 0 = no cap) is rotated —
# mv aside, rotate signal to the daemon, confirm the daemon reopened the
# live path, then drop every numbered generation both stdio logs gained.
# Squid 6.13 `logfile_rotate 10` shifts `.0`..`.9` up by one before it
# moves the live file to `.0` and reopens, and SIGUSR1 rotates BOTH
# access.log and cache.log; deleting only `.1` left older generations
# behind (R-EGL-394-5 F4). This is NOT the ARC-31 reset, and `denied`
# still never deletes or rotates the file.
gw_log_cap() { # gw_log_cap <profile>
    local profile="$1" gwname max access cache a_size c_size
    local ident sib_ident live_ident sib_live reopened i
    gwname="$(gw_name "$profile")"
    max="${EGRESSLOCK_GW_LOG_MAX_BYTES:-33554432}"
    [[ "$max" =~ ^(0|[1-9][0-9]*)$ ]] || {
        echo "Error: EGRESSLOCK_GW_LOG_MAX_BYTES must be a non-negative integer (bytes; 0 = no cap)." >&2
        return 1
    }
    (( max == 0 )) && return 0
    # EGL-515: no separate liveness probe. On a stopped container the
    # exec itself fails, so both size reads answer rc 2/empty and the cap
    # is skipped exactly as the old "not running" return did (D3).
    access=/var/log/squid/access.log
    cache=/var/log/squid/cache.log
    # EGL-515: one read window for both sizes and their stream
    # identities; the identity read is reused as the pre-rotation pin.
    gw_ctr_batch "$gwname" access.s s "$access" cache.s s "$cache"
    a_size=0; c_size=0; ident=""; sib_ident=""
    if (( ${GW_BATCH_RC[access.s]:-2} == 0 )); then
        a_size="${GW_BATCH_PAYLOAD[access.s]##* }"
        ident="${GW_BATCH_PAYLOAD[access.s]%% *}"
    fi
    if (( ${GW_BATCH_RC[cache.s]:-2} == 0 )); then
        c_size="${GW_BATCH_PAYLOAD[cache.s]##* }"
        sib_ident="${GW_BATCH_PAYLOAD[cache.s]%% *}"
    fi
    [[ "$a_size" =~ ^[0-9]+$ ]] || a_size=0
    [[ "$c_size" =~ ^[0-9]+$ ]] || c_size=0
    (( a_size <= max && c_size <= max )) && return 0
    if (( a_size > max )); then
        echo "rotating: $access is $a_size bytes (over the ${max}-byte cap) on $gwname" >&2
    fi
    if (( c_size > max )); then
        echo "rotating: $cache is $c_size bytes (over the ${max}-byte cap) on $gwname" >&2
    fi
    if ! [[ "$ident" =~ ^[0-9]+:[0-9]+$ && "$sib_ident" =~ ^[0-9]+:[0-9]+$ ]]; then
        echo "warn: could not read the live squid logs before rotating them on $gwname; skipping rotation" >&2
        return 0
    fi
    # One rotation decision for the pair (F4): SIGUSR1 reopens both
    # stdio logs, and Squid may finish one log's rename sequence after
    # the other's. Move BOTH live paths aside, signal once, and wait for
    # BOTH new inodes before deleting generations. Moving only the
    # oversize log leaves the sibling's reopen unprovable (live: no
    # reopen at all), so the pair is rotated together.
    if ! rt_exec "$gwname" mv "$access" "$access.1"; then
        echo "warn: could not move $access aside on $gwname; skipping rotation" >&2
        return 0
    fi
    if ! rt_exec "$gwname" mv "$cache" "$cache.1"; then
        echo "warn: could not move $cache aside on $gwname; restoring $access" >&2
        gw_log_restore "$gwname" "$access.1" "$access" >/dev/null 2>&1 || true
        return 0
    fi
    if ! gw_signal "$gwname" USR1; then
        # Reopen failed: put both live files back so squid keeps logging
        # to the paths it holds open. The oversize log stays until the
        # operator intervenes — this fails open for the LOG (never for
        # policy), the same trade `denied`'s rc-0 truncation makes.
        # EGL-394 F3 / R-EGL-394-16 F1: the signal can land after a
        # partial reopen, and the live path then belongs to squid's new
        # fd. Restore through the atomic no-clobber link: a path that
        # exists (reopened) is left alone, and a failed probe/exec can no
        # longer be read as "absent" before a clobbering move.
        echo "warn: the log-rotation signal failed on $gwname; restoring the live squid logs that are still absent" >&2
        if ! gw_log_restore "$gwname" "$cache.1" "$cache"; then
            echo "warn: $cache was already reopened (or could not be relinked); the moved generation $cache.1 was left in place" >&2
        fi
        if ! gw_log_restore "$gwname" "$access.1" "$access"; then
            echo "warn: $access was already reopened (or could not be relinked); the moved generation $access.1 was left in place" >&2
        fi
        return 0
    fi
    # Confirm the daemon reopened both live paths before deleting any
    # generation: the signal alone does not prove it handled the
    # rotation. A new inode is the reopen (the moved files keep the old
    # identities).
    reopened=0
    for i in $(seq 1 20); do
        gw_ctr_batch "$gwname" access.l s "$access" cache.l s "$cache"
        live_ident=""; sib_live=""
        if (( ${GW_BATCH_RC[access.l]:-2} == 0 )); then
            live_ident="${GW_BATCH_PAYLOAD[access.l]%% *}"
        fi
        if (( ${GW_BATCH_RC[cache.l]:-2} == 0 )); then
            sib_live="${GW_BATCH_PAYLOAD[cache.l]%% *}"
        fi
        if [[ "$live_ident" =~ ^[0-9]+:[0-9]+$ && "$live_ident" != "$ident" \
              && "$sib_live" =~ ^[0-9]+:[0-9]+$ && "$sib_live" != "$sib_ident" ]]; then
            reopened=1
            break
        fi
        sleep 0.25
    done
    if (( reopened == 1 )); then
        # Remove every numbered generation both logs gained (the single
        # cap decision, no retention).
        rt_exec "$gwname" bash -c \
            'rm -f /var/log/squid/access.log.[0-9]* /var/log/squid/cache.log.[0-9]*' \
            >/dev/null 2>&1 || true
    else
        # Restore only paths the daemon did not reopen. R-EGL-394-16 F1:
        # use the atomic no-clobber link rather than a probe followed by a
        # clobbering move — the rotation can finish after the timeout and
        # reopen the live path at any point before the restore.
        if ! gw_log_restore "$gwname" "$access.1" "$access"; then
            echo "warn: $access was already reopened (or could not be relinked); the moved generation $access.1 was left in place" >&2
        fi
        if ! gw_log_restore "$gwname" "$cache.1" "$cache"; then
            echo "warn: $cache was already reopened (or could not be relinked); the moved generation $cache.1 was left in place" >&2
        fi
        echo "warn: the log-rotation signal did not reopen the stdio logs on $gwname; any moved generation that could not be restored is left in place" >&2
    fi
}

gw_start() {
    # A failed start (e.g. an IPAM conflict) leaves container storage
    # holding the name in real Podman (ARC-5): the name is registered
    # before the IP allocation fails. Always clear it so a retry can
    # reuse the name.
    local profile="$1" gwname net ip img
    gwname="$(gw_name "$profile")"
    net="$(network_of "$profile")"
    ip="${GW_IP[$profile]}"
    # Plain assignment so a die() inside gw_image (ARC-59 env guard)
    # propagates under set -e (command-substitution footgun).
    # EGL-491: warn in this shell; gw_image() runs in a subshell.
    egl491_warn_ignored_hook EGRESSLOCK_GW_IMAGE "${EGRESSLOCK_GW_IMAGE:-}"
    img="$(gw_image)"
    # EGL-206-D2a: refuse a checkpoint-annotated image before the run
    # (CVE-2026-94603). ensure_gateway's rt_image_exists check ran
    # first (exist-check THEN inspect THEN rt_run).
    refuse_checkpoint_image "$img" "gateway image"
    rt_rm_retry "$gwname" >/dev/null 2>&1 || true
    # EGL-123-D3: the gateway carries the kit-derived pinned MAC — the
    # same identity the compiled exemption is keyed on (saddr+MAC).
    rt_run "$gwname" \
        --network "$net" \
        --ip "$ip" \
        --mac-address "$(gw_mac "$profile")" \
        --restart=always \
        --cap-drop=all \
        --security-opt=no-new-privileges \
        "$img" >/dev/null
}

# EGL-123-D3: live MAC of a container on its class network (empty when
# inspect fails). Mirrors the IPAddress template used by verify_gateway.
gw_live_mac() { # gw_live_mac <gwname> <net>
    rt_inspect "$1" "{{(index .NetworkSettings.Networks \"$2\").MacAddress}}" 2>/dev/null || true
}

# EGL-123-D3: MAC identity check. A gateway whose live MAC differs from
# the kit-derived pin is identity drift, NOT a converged profile:
# ensure treats it as not-healthy (replace), verify fails closed.
gw_mac_ok() { # gw_mac_ok <profile> <gwname>
    local net live want
    net="$(network_of "$1")"
    live="$(gw_live_mac "$2" "$net")"
    want="$(gw_mac "$1")"
    [[ "$live" == "$want" ]]
}

ensure_gateway() {
    # EGL-223: arg2 = replace_gw (default 0). 1 forces the replace path
    # even when the converged predicate below is true (the operator asked
    # for it: `build-gateway` then `ensure --replace-gateway`). Plain
    # ensure (0) is byte-identical to before.
    local profile="$1" replace_gw="${2:-0}" gwname port img
    gwname="$(gw_name "$profile")"
    port="${GW_PORT[$profile]}"
    # EGL-123-D3: running + probe is not sufficient — the live MAC must
    # match the kit-derived pin. A mismatch is identity drift (e.g. a
    # pre-upgrade gateway with a random MAC): fall through to replace
    # (one-time on first ensure after upgrade; the pin is stable after).
    # EGL-206-D2b: the converged short-circuit is caps-aware (see
    # ensure_anchor) — a healthy-looking gateway with wrong or
    # unreadable live hardening falls through to replacement, never a
    # blessing.
    if (( replace_gw == 0 )) \
        && gw_gateway_health_ok "$gwname" "$port" \
        && gw_mac_ok "$profile" "$gwname"; then
        return 0
    fi
    # Plain assignment so a die() inside gw_image (ARC-59 env guard)
    # propagates under set -e (command-substitution footgun).
    # EGL-491: warn in this shell; gw_image() runs in a subshell.
    egl491_warn_ignored_hook EGRESSLOCK_GW_IMAGE "${EGRESSLOCK_GW_IMAGE:-}"
    img="$(gw_image)"
    # EGL-223-D3: on the flag path, preflight the target image BEFORE any
    # removal — a missing or checkpoint-annotated tag dies named with the
    # running gateway intact. The recovery path keeps rm-then-exists.
    if (( replace_gw )); then
        rt_image_exists "$img" 2>/dev/null \
            || die "gateway image $img not found; build it: egresslock build-gateway"
        refuse_checkpoint_image "$img" "gateway image"
        echo "gateway '$gwname' --replace-gateway — replacing the running container (profile sessions will drop)" >&2
    fi
    rt_rm_retry "$gwname" >/dev/null 2>&1 || true
    # EGL-217 (M2, R1): the old gateway is gone and any new one is this
    # run's — mark it for the EXIT-trap cleanup. A die at the
    # image-exists check below finds nothing registered to remove.
    ensure_own "$gwname"
    if (( replace_gw == 0 )); then
        rt_image_exists "$img" 2>/dev/null \
            || die "gateway image $img not found; build it: egresslock build-gateway"
    fi
    # The gateway joins the same class network with a FIXED ip so the
    # nftables rule and the proxy env vars stay stable.
    # EGL-223-D9 (S2): on gw_start failure, KEEP the anchor holder and
    # die named. Recycling the anchor (rt_rm + one retry) leaves no
    # netns holder, so the policy can disappear before the retry
    # (EGL-91/ARC-1). The fix is a full re-run of cmd_ensure (holder ->
    # policy -> gateway), never an in-function retry. Both paths.
    gw_start "$profile" \
        || die "gateway start failed (static IP ${GW_IP[$profile]} conflict?)"
    local i
    # 60s budget: container start + squid -z + port bind. EGL-206-D2b:
    # wait-until-healthy, then assert live hardening on the success
    # path — never skipped by a return from inside the wait loop.
    for i in $(seq 1 120); do
        gw_running "$gwname" && gw_probe "$gwname" "$port" && break
        sleep 0.5
    done
    gw_running "$gwname" && gw_probe "$gwname" "$port" \
        || die "gateway container '$gwname' did not become healthy (proxy not answering on $port)"
    assert_kit_caps "$gwname" "gateway"
}

verify_gateway() {
    local profile="$1" gwname net ip cfgdir vgen vident port dtok ltok
    gwname="$(gw_name "$profile")"
    port="${GW_PORT[$profile]}"
    net="$(network_of "$profile")"
    ip="${GW_IP[$profile]}"
    gw_running "$gwname" \
        || { echo "verify: gateway $gwname not running" >&2; return 1; }
    # Gateway must be attached to the class network with its static IP.
    # EGL-515 D3: one inspect template answers attachment, IP and MAC in
    # the same read window; a missing row keeps the existing attachment
    # error, and the later checks keep their exact strings and order.
    local netinfo net_ip="" net_mac="" row_name row_ip row_mac found_net=0
    netinfo="$(rt_inspect "$gwname" '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}|{{$v.IPAddress}}|{{$v.MacAddress}}{{println}}{{end}}' 2>/dev/null || true)"
    while IFS='|' read -r row_name row_ip row_mac; do
        [[ -n "$row_name" ]] || continue
        if [[ "$row_name" == "$net" ]]; then
            found_net=1
            net_ip="$row_ip"
            net_mac="$row_mac"
            break
        fi
    done <<<"$netinfo"
    (( found_net == 1 )) \
        || { echo "verify: gateway not attached to $net" >&2; return 1; }
    [[ "$net_ip" == "$ip" ]] \
        || { echo "verify: gateway IP is '$net_ip', expected $ip" >&2; return 1; }
    # EGL-123-D3: the live MAC must equal the kit-derived pin — the
    # compiled exemption is keyed on saddr+MAC, so a drifted MAC means
    # the gateway's own egress would fall to the terminal drop. Timer
    # notices a drifted MAC through this check.
    [[ "$net_mac" == "$(gw_mac "$profile")" ]] \
        || { echo "verify: gateway MAC is '${net_mac}', expected '$(gw_mac "$profile")'" >&2; return 1; }
    # Config sanity: parse the deployed config. `-k parse` needs no
    # running-instance PID file (unlike `-k check`, ARC-5); liveness is
    # gw_probe's job. EGL-283: a nonzero rc is NOT proof of an invalid
    # config — a concurrent ensure restarting/replacing the container
    # fails the exec itself (podman rc 125/126/127). Only rc 1 against a
    # still-running container is a squid parse rejection; anything else
    # names the container/exec failure.
    local parse_rc=0 parse_out
    # EGL-369-D3: parse the deployed config in the layout this running
    # container actually carries (old image vs new image). R-EGL-369-10
    # F1: an ensure already detected and bound it; a standalone verify
    # probes once. A probe error fails closed — never a guessed layout.
    if [[ -n "${GW_APPLY_CFGDIR:-}" ]]; then
        cfgdir="$GW_APPLY_CFGDIR"
    elif gw_config_dir "$gwname" >/dev/null; then
        cfgdir="$GW_CONFIG_DIR_DETECTED"
    else
        echo "verify: gateway container '$gwname' not exec-able (config-directory probe rc=$GW_CONFIG_PROBE_RC; stopped or mid-restart — e.g. a concurrent ensure); re-run: egresslock ensure $profile$(ensure_scope_suffix) — detail: $GW_CONFIG_PROBE_DETAIL" >&2
        return 1
    fi
    parse_out="$(rt_exec "$gwname" squid -k parse -f "$cfgdir/squid.conf" 2>&1)" || parse_rc=$?
    if (( parse_rc != 0 )); then
        if (( parse_rc == 1 )) && gw_running "$gwname"; then
            echo "verify: gateway squid config invalid: $parse_out" >&2
        else
            echo "verify: gateway container '$gwname' not exec-able (rc=$parse_rc; stopped or mid-restart — e.g. a concurrent ensure); re-run: egresslock ensure $profile$(ensure_scope_suffix) — detail: $parse_out" >&2
        fi
        return 1
    fi
    # EGL-394 F3: the parse above proves the DEPLOYED file is valid, not
    # that the live instance loaded it. A same-name replacement (healthy,
    # bootstrap argv) or a config changed under us must never be blessed
    # as this run's activation. EGL-515: argv, generation and identity
    # come from one read window; every check keeps its named error and
    # order.
    gw_ctr_batch "$gwname" \
        argv A "$cfgdir" \
        verify.h h "$cfgdir/squid.conf" verify.e e "$cfgdir/squid.conf" \
        verify.l L "$cfgdir/squid.conf" verify.i i "$cfgdir/squid.conf"
    if (( ${GW_BATCH_RC[argv]:-2} != 0 )); then
        echo "verify: gateway PID 1 is not Squid started on $cfgdir/squid.conf (the instance was replaced or started on a different configuration); re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
        return 1
    fi
    if [[ -n "${GW_APPLY_GENERATION:-}" ]]; then
        if ! vgen="$(gw_batch_generation_value verify)" \
            || [[ "$vgen" != "$GW_APPLY_GENERATION" ]]; then
            echo "verify: the deployed gateway configuration is not the candidate this run published (the gateway or its configuration changed during the apply); re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
            return 1
        fi
    fi
    # EGL-394 F1: when this run published the deployed configuration, its
    # stat identity (device/inode, size, ctime) must still be the one
    # captured at the publication proof. Generation/hash equality alone
    # cannot tell a file that was swapped out after the running instance
    # loaded it and then restored to the same bytes.
    if [[ -n "${GW_APPLY_CONF_IDENT:-}" ]]; then
        vident="${GW_BATCH_PAYLOAD[verify.i]:-}"
        if (( ${GW_BATCH_RC[verify.i]:-2} != 0 )) \
            || [[ ! "$vident" =~ ^[0-9]+:[0-9]+[[:space:]][0-9]+[[:space:]].+$ ]] \
            || [[ "$vident" != "$GW_APPLY_CONF_IDENT" ]]; then
            echo "verify: the deployed gateway configuration changed after the running gateway loaded it (it was replaced or rewritten during the apply); re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
            return 1
        fi
    fi
    # EGL-393-D2: deployed-versus-live. The deployed files must carry a
    # valid probe token (recomputed from their exact bytes), and the
    # running Squid must serve that same token. A deployed config the
    # instance never loaded — the post-publish SIGKILL/unknown residual —
    # fails here instead of passing on a parse-only check. Read-only: one
    # loopback GET; verify never repairs or reloads.
    local live_out caps_state
    live_out="$(gw_live_token "$profile" "$gwname" "$cfgdir" "$port")" || return 1
    dtok="${live_out%%$'\n'*}"
    local live_rest="${live_out#*$'\n'}"
    ltok="${live_rest%%$'\n'*}"
    caps_state="${live_rest#*$'\n'}"
    if [[ "$ltok" != "$dtok" ]]; then
        echo "verify: the running gateway is serving a different configuration than the deployed $cfgdir/squid.conf (the running Squid did not load the deployed configuration); re-run: egresslock ensure $profile$(ensure_scope_suffix)" >&2
        return 1
    fi
    # EGL-206-D2b: the launch-time hardening pair must be LIVE, read
    # from the container's own PID 1 — not `podman inspect` HostConfig,
    # the unverified oracle this CVE invalidates. Same named-error
    # style as the IP/MAC checks above. EGL-515: the PID 1 status read
    # rides the SAME exec as the live probe, so the hardening belongs to
    # the instance that served the token (the vocabulary is
    # kit_caps_state's).
    [[ "$caps_state" == "ok" ]] \
        || { echo "verify: $(kit_caps_problem_msg "gateway" "$gwname" "$caps_state")" >&2; return 1; }
}

# EGL-178-D1: cmd_ensure step helpers. cmd_ensure stays the public entry
# point; the aggregator below is the order document (a91 pins anchor ->
# combined nft install -> gateway). ensure_snapshot_pins fills
# ENSURE_BEFORE_PINS (file-scope, D2); ensure_announce_refreshed consumes
# it. No new runtime calls: every step invokes existing wrappers only.
ensure_snapshot_pins() { # EGL-178-D1: pre-refresh pin snapshot for the announce step
    # ARC-12-D2: snapshot the pre-refresh allow-host pins so a DNS
    # change the refresh just healed is announced (refreshed: lines).
    # No chain yet (first ensure) = nothing to announce.
    ENSURE_BEFORE_PINS=()
    if netns_nft list chain inet "$TABLE" "$(chain_of "$1")" >/dev/null 2>&1; then
        VERIFY_PINS=()
        verify_expected_rules "$1" >/dev/null 2>&1 || true
        local k
        for k in "${!VERIFY_PINS[@]}"; do
            ENSURE_BEFORE_PINS[$k]="${VERIFY_PINS[$k]}"
        done
    fi
}

ensure_converge_gateway() { # EGL-178-D1: gateway start + allowlist + log rotation
    # The policy is live (D4); now start the gateway. The static IP was
    # never at risk: the anchor pinned the LAST usable address, not a
    # dynamic one (ARC-5/ARC-11-D3).
    # EGL-223: arg2 is the --replace-gateway flag (0/1), threaded to
    # ensure_gateway. Sole caller: cmd_ensure (grep-pinned).
    ensure_gateway "$1" "${2:-0}"
    gw_apply_allowlist "$1"
    # ARC-32-D1: the gateway is confirmed healthy here — rotate any
    # oversize overlay logs before the policy work continues.
    gw_log_cap "$1"
}

ensure_announce_refreshed() { # EGL-178-D1: healed-drift announcement, A-set per host
    # D2: announce healed drift, exactly ONE line per HOST (before is
    # keyed host|port, so dedupe by host). EGL-219-D3/D6: the announced
    # value is the INSTALLED set from the per-ensure cache — no second
    # resolve, which could reorder mid-ensure; announce only when the
    # effective set changed. D6: comma-joined, a 1-element set bare.
    if (( ${#ENSURE_BEFORE_PINS[@]} > 0 )); then
        local key host old now
        local -A announced=()
        for key in "${!ENSURE_BEFORE_PINS[@]}"; do
            host="${key%%|*}"
            [[ -n "${announced[$host]:-}" ]] && continue
            announced[$host]=1
            old="${ENSURE_BEFORE_PINS[$key]}"
            now="${RESOLVED_SETS[$host]:-}"
            if [[ -n "$now" && "$now" != "$old" ]]; then
                echo "refreshed: host $host ${old// /,} to ${now// /,} (policy re-installed with the new address)"
            fi
        done
    fi
}

ensure_finalize() { # EGL-178-D1: gateway verification + ready lines (closing line included)
    verify_gateway "$1" || die "gateway verification failed for profile '$1' (fail closed)"
    # EGL-460-F5: the gateway half of the run's proof. The EXIT-trap D3
    # disclosure reads this so a failure after this point states
    # "gateway verified" instead of claiming the run never verified it.
    ENSURE_GATEWAY_VERIFIED=1
    # EGL-395: reference-driven cleanup only after verification proved
    # the deployed set. Never changes the command's rc.
    if [[ -n "${GW_APPLY_GENERATION:-}" ]]; then
        local gwname cfgdir
        gwname="$(gw_name "$1")"
        # R-EGL-369-10 F1: reuse the apply's detected layout (one
        # probe per ensure) instead of re-probing after a transient
        # error could answer a different dir.
        if [[ -n "${GW_APPLY_CFGDIR:-}" ]]; then
            cfgdir="$GW_APPLY_CFGDIR"
        elif gw_config_dir "$gwname" >/dev/null; then
            cfgdir="$GW_CONFIG_DIR_DETECTED"
        else
            die "gateway config-directory probe failed during cleanup (runtime exec rc $GW_CONFIG_PROBE_RC; fail closed)"
        fi
        gw_cleanup_config "$gwname" "$cfgdir" "$GW_APPLY_GENERATION" || true
    fi
    # EGL-394: every healthy apply publishes and activates, so the
    # ready line is always the apply line.
    echo "gateway '$(gw_name "$1")' ready (allowlist applied, health verified)"
    echo "profile '$1' ready (network $(network_of "$1"), policy verified)"
}

# EGL-502-D1: the shared revoked-member flush leg behind the four
# revocation wrappers — the accepted-set read, the per-member
# skip/flush loop (EGL-219/307), and the EGL-295 port reconcile — in
# one place, so the next accepted-set-guard semantic fix lands once
# instead of four times. The basis word names where the accepted set
# comes from: `live` reads the post-swap chain (the EGL-307 guard);
# `canon` derives it from the canonical listing verify_profile_chain
# already proved (EGL-460-D6 — never a fresh read). Wrapper-local
# ladder flags, entry clearing, and skip keys stay with the wrappers.
flush_revoked_members() { # flush_revoked_members <profile> <port> <pin_ips> <basis: live|canon>
    local profile="$1" port="$2" pin_ips="$3" basis="$4"
    local pin_ip acc_rc=0
    local -a accepted=()
    local accepted_list=" "
    # Basis prep: where the accepted set comes from. `live` reads the
    # post-swap chain under the pin_ips guard, exactly as the direct
    # wrapper did; `canon` derives the set from the canonical listing
    # verify_profile_chain already proved (EGL-460-D6 — never a fresh
    # read), with the mapfile unconditional (outside the pin_ips guard) —
    # a guard-scope change there is a behavior delta, not a refactor.
    case "$basis" in
        live)
            # Plain call, no command substitution — same frame, same
            # list. On any unusable accepted-set read every member is
            # flushed (doubt severs; the EGL-139 backstop), and the
            # reconcile's own read then dies named (EGL-311).
            if [[ -n "$pin_ips" ]]; then
                conntrack_accepted_set "$profile" "$port" || acc_rc=$?
                accepted_list=" ${CT_ACCEPTED_LIST[*]} "
            fi
            ;;
        canon)
            # An empty/unset canon admits no member as accepted, so every
            # captured member flushes (doubt severs, fail closed).
            mapfile -t accepted < <(chain_accepted_daddrs "$profile" "$port" <<<"$VERIFY_PROFILE_CHAIN_CANON")
            accepted_list=" ${accepted[*]} "
            ;;
        *)
            # Unknown basis is an internal contract violation; never fall
            # through to `live` (EGL-460-D6: the proved lane must not take
            # a fresh chain read).
            die "internal: flush_revoked_members got unknown basis '$basis' (expected 'live' or 'canon')" ;;
    esac
    # EGL-219/307: ONE skip/flush loop for both bases — a member whose
    # daddr:dport the accepted set still carries through another
    # remaining grant (a sibling rule, gateway-hop, or DNS-to-bridge
    # accept on the same port) is skipped silently; on an unusable live
    # read (acc_rc != 0) every member flushes. This shared loop is the
    # single place the next accepted-set-guard semantic fix lands (F1).
    if [[ -n "$pin_ips" ]]; then
        for pin_ip in $pin_ips; do
            if (( acc_rc == 0 )) && [[ "$accepted_list" == *" $pin_ip "* ]]; then
                continue
            fi
            conntrack_flush_and_assert "$profile" "$pin_ip" "$port"
        done
    fi
    # EGL-295: the member loop keyed the rule's current pin members only;
    # a rotated name's earlier address keeps its established entry (its
    # flow rides the base ct-state accept, X20a). Basis-specific post-swap
    # port reconcile, UNCONDITIONAL in every lane (including the
    # empty-capture drifted path and the empty-pin_ips direct path): live
    # re-reads the post-swap chain; proved derives both passes from the
    # listing verify_profile_chain proved (no live conntrack_accepted_set
    # read, none of its named dies). The member leg applies the same
    # accepted-set test, so both legs agree.
    case "$basis" in
        live) reconcile_port_live "$profile" "$port" "$pin_ips" ;;
        canon) reconcile_port_proved "$profile" "$port" "$pin_ips" ;;
    esac
    return 0
}

# EGL-460-D2: the direct-lane revocation kill, run from cmd_ensure after
# the nft swap + pin write and before the gateway converge. The allowlist
# did not change; the revoked flow would otherwise ride the base
# `ct state established,related accept` for the whole gateway publish /
# reload-confirmation window. EGL-139 constraint: the flush runs after
# the atomic -f swap (never before — in-flight packets would re-mint
# under the still-matching pin). The step is a no-op outside the direct
# disallow lane; the other cmd_ensure callers leave DISALLOW_HOST_CTX
# empty. The scope (`pin_ips`) was captured by the caller BEFORE the conf
# delete; it cannot be recomputed here (the revoked rule is gone from the
# chain and the pin record was just rewritten).
disallow_flush_revoked_flows() { # disallow_flush_revoked_flows <profile> — direct-disallow flush step; no-op unless the context is armed
    local profile="$1" pin_ips port
    [[ -n "$DISALLOW_HOST_CTX" ]] || return 0
    pin_ips="$DISALLOW_HOST_PIN_IPS"
    port="$DISALLOW_HOST_PORT"
    # EGL-460-D5: from here until the reconcile proves clean, a failure
    # is disclose-only (ensure_cleanup skips). A failed member flush or
    # reconcile exits through set -e before FLUSH_PROVEN is set, so the
    # trap still reads the (f1-ii) state.
    DISALLOW_HOST_FLUSH_STEP=1
    # EGL-502-D1: the EGL-219/307 member leg and the EGL-295 port
    # reconcile live in flush_revoked_members (live basis: the post-swap
    # chain is the authority).
    flush_revoked_members "$profile" "$port" "$pin_ips" live
    # Proven: the member flush(es) and the reconcile returned clean. The
    # trap may now disclose the D3 post-proof state; the step flag is
    # cleared so a later converge/verify failure keeps today's cleanup.
    DISALLOW_HOST_FLUSH_STEP=0
    DISALLOW_HOST_FLUSH_PROVEN=1
}

# EGL-480-D3: finish any recorded revocation whose entry this run does
# not own. Runs after the armed early flush (and after a plain ensure's
# swap+pin write), per entry: the EGL-307 live-chain accepted-set guard,
# the member flush, and the EGL-460 port reconcile — the early-flush
# body reused through flush_revoked_members (EGL-502-D1). The entry is
# NOT cleared here: only the post-verify confirmation may claim clean.
# When a direct disallow is armed, its own `host|port` is skipped (that
# run's flush/confirmation owns the unioned set, so the post-swap
# chain-read ordinal stays 7); other entries are still healed. No
# record -> no nft/conntrack calls.
ensure_heal_pending_revocations() { # ensure_heal_pending_revocations <profile>
    local profile="$1" path line key port ips skip=""
    if [[ -n "$DISALLOW_HOST_CTX" ]]; then
        skip="$DISALLOW_HOST_HOST|$DISALLOW_HOST_PORT"
    fi
    path="$(revoke_pending_path "$profile")"
    local scan_rc=0
    revoke_pending_scan "$path" || scan_rc=$?
    (( scan_rc == 0 )) || return 0
    for line in "${REVOKE_PENDING_LINES[@]}"; do
        key="${line%% *}"
        [[ -n "$skip" && "$key" == "$skip" ]] && continue
        port="${key##*|}"
        ips="${line#* }"
        flush_revoked_members "$profile" "$port" "$ips" live
    done
    return 0
}

# EGL-460-D6: the post-verification confirmation — the proof the kill
# claim and `removed:` rest on. The early step's accepted-set read
# precedes verify_policy, so a chain that accepted the revoked tuple
# during that window could make it skip the row (R-EGL-460-6 F2/F6).
# This step consumes the canonical listing verify_profile_chain already
# compared and proved (no fresh chain read — a second read would be
# another unproved input and would move the post-swap ordinal pin) and
# re-flushes members/port rows that the verified ruleset no longer
# accepts. Only its clean return sets DISALLOW_HOST_KILL_PROVEN; a
# failure exits through set -e/die before that, so `removed:` cannot
# print and the trap discloses the verified-but-unconfirmed state (B).
# It does NOT set DISALLOW_HOST_FLUSH_STEP: D5's cleanup skip stays
# early-step-only, so a confirmation failure keeps today's ensure-trap
# cleanup.
disallow_confirm_revoked_flows() { # disallow_confirm_revoked_flows <profile> — post-verify confirmation; no-op unless the direct context is armed
    local profile="$1" pin_ips port
    [[ -n "$DISALLOW_HOST_CTX" ]] || return 0
    pin_ips="$DISALLOW_HOST_PIN_IPS"
    port="$DISALLOW_HOST_PORT"
    # EGL-502-D1: the canon basis re-derives the accepted set from the
    # listing the verify_profile_chain compare proved and derives both
    # reconcile passes' accepted map from it (no live
    # conntrack_accepted_set read, none of its named dies).
    flush_revoked_members "$profile" "$port" "$pin_ips" canon
    # EGL-480-D3: the revocation is proven. Set the ladder flag FIRST so
    # a clear failure dies with `removed:` still gated and the D3
    # disclosure still truthful (it names the confirmed state); the
    # record entry then stays for the next ensure to retry.
    DISALLOW_HOST_KILL_PROVEN=1
    revoke_pending_clear_entry "$profile" "$DISALLOW_HOST_HOST" "$DISALLOW_HOST_PORT"
}

# EGL-480-D3: clear the non-armed entries only after the canon-based
# confirmation (the listing verify_profile_chain proved) returned clean
# for each: accepted members are kept (EGL-307), the rest are flushed,
# the port is reconciled, and only then is the entry cleared. A failure
# dies named and leaves the entry; no fresh chain read is taken (the
# proved basis is used), so the armed run's ordinal pin is untouched.
ensure_confirm_pending_revocations() { # ensure_confirm_pending_revocations <profile>
    local profile="$1" path line key port ips skip=""
    if [[ -n "$DISALLOW_HOST_CTX" ]]; then
        skip="$DISALLOW_HOST_HOST|$DISALLOW_HOST_PORT"
    fi
    path="$(revoke_pending_path "$profile")"
    local scan_rc=0
    revoke_pending_scan "$path" || scan_rc=$?
    (( scan_rc == 0 )) || return 0
    for line in "${REVOKE_PENDING_LINES[@]}"; do
        key="${line%% *}"
        [[ -n "$skip" && "$key" == "$skip" ]] && continue
        port="${key##*|}"
        ips="${line#* }"
        flush_revoked_members "$profile" "$port" "$ips" canon
        revoke_pending_clear_entry "$profile" "${key%|*}" "$port"
    done
    return 0
}

cmd_ensure() {
    # EGL-217 (M1): arm the family-wide failure cleanup — the EXIT trap
    # removes only containers this run started/replaced/restarted, so no
    # --restart=always container is left behind. Disarm after
    # ensure_finalize protects the re-ensure callers' post-ensure steps
    # (a failure there must not touch a converged kit); a die inside
    # ensure_finalize still fires the trap.
    ENSURE_OWNED=""
    ENSURE_REMOVED=""
    ENSURE_POLICY_SWAPPED=0 # EGL-305: reset per ensure; set inside install_policy after the atomic -f
    ENSURE_PIN_PROFILE=""   # EGL-391: the run's profile for the post-apply disclosure
    ENSURE_PIN_COMMITTED=0  # EGL-391: set only when write_pin_record returns 0
    ENSURE_GATEWAY_VERIFIED=0 # EGL-460-F5: set only after verify_gateway returns 0
    DISALLOW_HOST_FLUSH_STEP=0   # EGL-460-D5: reset per ensure (direct-lane flush-step window)
    DISALLOW_HOST_FLUSH_PROVEN=0 # EGL-460-D3: reset per ensure (set only by the flush step)
    DISALLOW_HOST_POLICY_VERIFIED=0 # EGL-460-D6: reset per ensure (set only after verify_policy returns 0)
    DISALLOW_HOST_KILL_PROVEN=0     # EGL-460-D6: reset per ensure (set only by the confirmation)
    VERIFY_PROFILE_CHAIN_CANON=""   # EGL-460-D6: reset per ensure (filled by verify_profile_chain)
    GW_APPLY_COMMITTED=0 # EGL-389: reset per ensure (apply state is per run)
    # EGL-395/EGL-394: publication/activation state is per run too (the
    # EXIT disclosure reads it after the apply).
    GW_APPLY_UNKNOWN=0
    GW_APPLY_ACTIVE=0
    GW_APPLY_GENERATION=""
    GW_APPLY_CFGDIR=""
    trap 'ensure_exit_trap "$?"' EXIT
    # EGL-223-D2: optional --replace-gateway, both positions legal
    # (`ensure --replace-gateway <p>` and `ensure <p> --replace-gateway`).
    # One profile name; unknown flags are usage errors (rc 2). Plain
    # ensure parses identically to before: profile only.
    local replace_gw=0 profile=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --replace-gateway)
                # EGL-223-D8 / EGL-228-D1: a duplicate flag is an
                # argv-contract error (rc 2). argv_shape_check rejects
                # it before resolve/load, so a missing/malformed/
                # unreadable conf cannot mask this diagnostic. The
                # handler parser stays as the second filter.
                if (( replace_gw )); then
                    echo "Error: ensure takes --replace-gateway only once." >&2
                    echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                    exit 2
                fi
                replace_gw=1; shift ;;
            "")  # R-EGL-223-3 F2 fold: an empty-string argument is never a
                 # profile name — usage rc 2, same bar as pre-flag grammar
                 # (require_profile "${1:-}" rc 2).
                echo "Error: ensure takes one profile name." >&2
                echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                exit 2 ;;
            -*) echo "Error: ensure takes --replace-gateway only." >&2
                echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                exit 2 ;;
            *)  [[ -z "$profile" ]] || {
                    echo "Error: ensure takes one profile name." >&2
                    echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                    exit 2
                }
                profile="$1"; shift ;;
        esac
    done
    require_profile "${profile:-}" ensure
    ENSURE_PIN_PROFILE="$profile" # EGL-391: names the profile for the post-apply disclosure
    # EGL-178-D1: aggregator. The policy-verify die stays at aggregator
    # scope: a helper that returned rc instead of dying would invite a
    # swallowed verify failure (never claim success on an unverified
    # policy). One require_profile here (R-EGL-223-2 F1).
    netns_probe || exit 1
    ensure_network "$profile"
    # EGL-91-D4 (EGL-93, amends D1): the anchor is the rootless-netns
    # HOLDER — start it before any nft write. A pre-container
    # `podman unshare --rootless-netns nft` lands in a netns nothing
    # holds: pasta exits and the first `podman run` creates a FRESH netns
    # without those rules, so verification fails and the G-06 window is
    # open. The anchor takes the LAST usable host address (ARC-11-D3),
    # not dynamic IPAM, so ARC-5 gateway-first IPAM still holds. EGL-98:
    # the post-reboot shape is named by profile_stale_unpolicied.
    ensure_anchor "$profile"
    ensure_snapshot_pins "$profile"
    # EGL-91-D1/D2 (G-06/I-06): install the nft policy BEFORE the gateway
    # start. Until the profile chain exists, the bridge (and any
    # concurrent `podman run --network <profile>`) forwards under
    # Netavark's default accept during the up-to-60s health loop. Rules
    # come from PROFILE_SUBNET / GW_IP in the conf, not a live inspect,
    # so nft can go first; the saddr+MAC exemption (EGL-123-D2) is inert
    # until that identity speaks. First create is ONE create-with-rules
    # transaction; refreshes flush+re-add atomically.
    # EGL-391-D5: refuse a directory/symlink pin-record target BEFORE
    # the atomic apply — the firewall must be untouched when the record
    # cannot be committed.
    ensure_pin_target_check "$profile"
    # EGL-480-D2: a corrupt/unreadable pending-revocation record refuses
    # this run named, before the atomic apply (a direct revocation may be
    # unfinished; fail closed). Absent/empty is the ordinary shape.
    revoke_pending_check "$profile"
    install_policy "$profile"
    # EGL-481-D3 (2026-11-07 rework): drop leftover/foreign chains the
    # confdir no longer defines (named, not silent) before the rest of
    # this run. verify stays read-only; this is the heal path so a
    # deleted conf's leftover does not fail every remaining profile.
    ensure_remove_unexpected_chains "$profile" || exit 1
    # EGL-140-D1: the pin record is the second witness for the allow-host
    # daddr axis — written from WHAT WAS JUST INSTALLED (the live chain's
    # pin accepts), atomically beside the conf. A failed write fails the
    # ensure closed; zero-allow-host profiles remove any stale record.
    # The pre-refresh snapshot may read the PREVIOUS record (ARC-12-D2).
    write_pin_record "$profile"
    # EGL-460-D2: the direct-lane revocation kill runs here — after the
    # nft swap and pin write, before the gateway apply. The allowlist did
    # not change; this keeps the revoked flows' termination off the
    # gateway publish/reload window. No-op for every other caller.
    disallow_flush_revoked_flows "$profile"
    # EGL-480-D3: finish any recorded revocation this run does not own
    # (the armed context's own entry is skipped; its flush above covered
    # the unioned set).
    ensure_heal_pending_revocations "$profile"
    ensure_converge_gateway "$profile" "$replace_gw"
    verify_policy "$profile" || die "policy verification failed for profile '$profile' (fail closed)"
    # EGL-460-D6: the policy is verified — record the ladder state, then
    # run the confirmation against the listing verify_profile_chain
    # proved. Only its clean return permits the kill claim/`removed:`.
    DISALLOW_HOST_POLICY_VERIFIED=1
    disallow_confirm_revoked_flows "$profile"
    # EGL-480-D3: clear the remaining recorded revocations only after
    # their canon-based confirmation also returned clean.
    ensure_confirm_pending_revocations "$profile"
    ensure_announce_refreshed "$profile"
    ensure_finalize "$profile"
    trap - EXIT # EGL-217 (M1): disarm — a later failure owns no cleanup
}

#
# ARC-12: drift check. Called from cmd_verify ONLY, after policy (and
# gateway) verification succeeded. Warn-only: DNS drift is an operator
# signal, never an exit-code change (D1/D3). One line per drifted host
# (D5 first-A semantics; two ports of one host share a warn).
# EGL-140-D1/D2: the pinned source is the ensure-time pin record, so the
# warn compares record vs fresh resolve; chain-vs-record is the
# exit-code axis.
#
check_dns_drift() {
    local profile="$1" hp host pinned fresh
    local -A warned=()
    while IFS= read -r hp; do
        [[ -n "$hp" ]] || continue
        host="${hp%:*}"
        [[ -n "${warned[$host]:-}" ]] && continue
        # VERIFY_PINS keys are host|port; bash assoc lookup has no glob,
        # so scan (cheap: a handful of entries).
        local k pinned=""
        for k in "${!VERIFY_PINS[@]}"; do
            if [[ "${k%%|*}" == "$host" ]]; then
                pinned="${VERIFY_PINS[$k]}"
                break
            fi
        done
        [[ -n "$pinned" ]] || continue
        warned[$host]=1
        # EGL-219-D8: resolve_set is rc 0 always, so the bare capture
        # stays set -e-safe and an unresolvable host keeps the warn+
        # rc-0 contract (ARC-12-D1). D4: both sides are canonically
        # sorted+deduped+space-joined, so plain string equality IS set
        # equality — a resolver reorder is not drift.
        fresh="$(resolve_set "$host")"
        # D4: values rendered comma-joined; singletons byte-identical.
        if [[ -z "$fresh" ]]; then
            echo "drift: host $host no longer resolves; policy still pins ${pinned// /,} — re-run ensure to update" >&2
        elif [[ "$fresh" != "$pinned" ]]; then
            echo "drift: host $host resolved to ${fresh// /,} but the policy pins ${pinned// /,} — re-run ensure to update" >&2
        fi
    done < <(profile_allow_hosts "$profile")
}

# EGL-480-D4: read-only witness — after verify_policy succeeds, report
# every recorded revocation whose conf line is gone (committed but not
# proven) as unfinished; rc 1. A still-present conf line is not reported
# (the failed-unwind shape; the next ensure clears it via the
# accepted-set path). A corrupt/unreadable/non-regular record is a named
# verification failure (fail closed). Missing and empty files are not
# reported. Never flushes, clears, repairs, or takes a write lock.
verify_revoke_pending() { # verify_revoke_pending <profile> — rc 1 on unfinished/corrupt
    local profile="$1" path line key host port conf
    conf="${PROFILE_CONF[$profile]:-${ENGINE_CONF:-}}"
    path="$(revoke_pending_path "$profile")"
    local scan_rc=0
    revoke_pending_scan "$path" || scan_rc=$?
    (( scan_rc == 1 )) && return 0
    if (( scan_rc == 2 )); then
        echo "verify: the pending-revocation record ($path) for profile '$profile' is unreadable or corrupt — refusing to continue (fail closed): a direct revocation may be unfinished; inspect the record, finish or rule out the listed revocations (egresslock drop-unauthorized $profile <port>), then fix or remove the record and retry: egresslock ensure $profile" >&2
        return 1
    fi
    local rc=0
    for line in "${REVOKE_PENDING_LINES[@]}"; do
        key="${line%% *}"
        host="${key%|*}"
        port="${key##*|}"
        # Only a committed revocation (conf line gone) is unfinished
        # work; a present line is the failed-unwind shape and must not
        # red the timer forever.
        if conf_has_allow_host "$conf" "$profile" "$host" "$port"; then
            continue
        fi
        echo "verify: unfinished revocation for profile '$profile' — rule $host:$port is out of the config, but the revocation did not prove its connections ended (state: conf line removed, ruleset swapped, conntrack unproven); finish it: egresslock ensure $profile$(ensure_scope_suffix); if a connection the policy no longer allows is believed to have survived, end it after that ensure with: egresslock drop-unauthorized $profile $port" >&2
        rc=1
    done
    return "$rc"
}

cmd_verify() {
     require_profile "${1:-}" verify
     netns_probe || exit 1
     verify_policy "$1" || exit 1
    # EGL-480-D4: the read-only revocation witness runs after the policy
    # proof and before the success echo (never mutates; rc 1).
    verify_revoke_pending "$1" || exit 1
    # EGL-206-D2b: anchor hardening on the plain verify verb too —
    # asserted only when the anchor is running (liveness semantics
    # unchanged); the gateway check is inside verify_gateway below.
    local anchor caps_state
    anchor="$(anchor_of "$1")"
    if anchor_running "$anchor"; then
        caps_state="$(kit_caps_state "$anchor")"
        [[ "$caps_state" == "ok" ]] \
            || { echo "verify: $(kit_caps_problem_msg "anchor" "$anchor" "$caps_state")" >&2; exit 1; }
    fi
    verify_gateway "$1" || exit 1
    # ARC-32-D1: gateway confirmed up — rotate oversize overlay logs.
    gw_log_cap "$1"
    echo "profile '$1' policy and gateway verified"
    # ARC-12-D1/D3: warn-only, never changes the exit code.
    check_dns_drift "$1"
}

# ARC-16-D3 (amended by EGL-98-D2): verify every profile that is
# ensured (its anchor is running); profiles without a live
# anchor are skipped as not installed — EXCEPT a conf profile whose
# network object survives while its policy chain is absent (the
# post-reboot window), which is a named failure. No ensured profiles and
# no stale leftovers: exit 0 silently; the timer signals drift for
# installed policy, not never-used profiles. Any verification failure
# exits 1 (the oneshot unit fails -> journal signal).
cmd_verify_ensured() {
     netns_probe || exit 1
     local p failed=0 anchor caps_state
    for p in "${PROFILES[@]}"; do
        if anchor_running "$(anchor_of "$p")"; then
            if ! verify_policy "$p"; then
                echo "verify: profile '$p' FAILED policy verification" >&2
                failed=1
                continue
            fi
            # EGL-480-D4: read-only; the named line comes from the
            # witness, the sweep grammar adds the FAILED line and moves
            # on to the next profile.
            if ! verify_revoke_pending "$p"; then
                echo "verify: profile '$p' FAILED revocation verification" >&2
                failed=1
                continue
            fi
            if ! verify_gateway "$p"; then
                echo "verify: profile '$p' FAILED gateway verification" >&2
                failed=1
                continue
            fi
            # EGL-206-D2b: anchor hardening on the ensured sweep too —
            # the anchor is running in this branch (checked above).
            anchor="$(anchor_of "$p")"
            caps_state="$(kit_caps_state "$anchor")"
            if [[ "$caps_state" != "ok" ]]; then
                kit_caps_problem_msg "anchor" "$anchor" "$caps_state" >&2
                echo "verify: profile '$p' FAILED anchor hardening verification" >&2
                failed=1
                continue
            fi
            echo "profile '$p' verified (ensured)"
            check_dns_drift "$p"
            continue
        fi
        # EGL-98-D2 stale exception: anchor dead, but the network object
        # survives without its chain (post-reboot) — a named failure, the
        # sweep timer's only post-reboot drift signal, not the ARC-16-D3
        # skip. A hard probe failure is already named; both set failed=1.
        # Never-ensured/teardown'd profiles (no network object) skip.
        local stale=0
        profile_stale_unpolicied "$p" || stale=$?
        if (( stale == 2 )); then
            failed=1
            continue
        fi
        if (( stale == 0 )); then
            echo "verify: network exists but policy does not — run: egresslock ensure $p$(ensure_scope_suffix)" >&2
            failed=1
            continue
        fi
    done
    return "$failed"
}

# ARC-44-D2: emit exactly one validated token on stdout, fail closed.
# $1 = value, $2 = kind (ipv4 | port | noproxy | netname). Conf
# validation is the first gate; this emission re-check is the belt for
# command-substitution consumers. Reject, never sanitize.
emit_token() {
    local v="$1" kind="$2"
    case "$kind" in
        ipv4)    cfg_is_ipv4 "$v" || die "internal: invalid gateway IP '$v'" ;;
        port)    cfg_is_port "$v" \
                     || die "internal: invalid gateway port '$v'" ;;
        noproxy) [[ "$v" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*(,\.?[A-Za-z0-9][A-Za-z0-9._-]*)*$ ]] \
                     || die "internal: invalid NO_PROXY value '$v'" ;;
        netname) [[ "$v" =~ ^egresslock-[a-z0-9-]+$ ]] \
                     || die "internal: invalid network name '$v'" ;;
        *) die "internal: unknown token kind '$kind'" ;;
    esac
    printf '%s\n' "$v"
}

no_proxy_value() {
    local np="localhost,127.0.0.1"
    [[ -n "${PROFILE_NO_PROXY_EXTRA[$1]:-}" ]] \
        && np="${np},${PROFILE_NO_PROXY_EXTRA[$1]}"
    # EGL-18-D3 (partial ARC-38-D4 overturn, IPv4 literals ONLY): a
    # literal has no Squid path (ARC-51-D1), so an HTTP client can honor
    # its nft pin only by bypassing the proxy. Union at emission: unique
    # IPv4 hosts from the profile's allow-host pins, conf order. Hostname
    # pins stay out (ARC-38-D4: same-name HTTP vs SSH is an operator
    # choice). `disallow-host` stays consistent — the union rebuilds.
    local e host
    while IFS= read -r e; do
        [[ -n "$e" ]] || continue
        host="${e%:*}"
        cfg_is_ipv4 "$host" || continue
        [[ ",$np," == *",${host},"* ]] && continue
        np="${np},${host}"
    done < <(profile_allow_hosts "$1")
    echo "$np"
}

proxy_env_assignments() { # proxy_env_assignments <profile> — the six NAME=value lines
    # Single printer for the assignment content so the stdout form and
    # the --out file form cannot drift (EGL-246-D4). Assumes the
    # profile's gateway variables are loaded; byte-identical to the
    # original six echoes (arc44 regression probe).
    local ip="${GW_IP[$1]}" port="${GW_PORT[$1]}"
    local proxy="http://${ip}:${port}"
    # EGL-246 R-EGL-246-3 F1: ONE checked printf emits all six
    # assignments, so no echo can fail after its predecessors landed
    # (errexit is disabled inside `if ! cmd`; a late failure must not
    # leave a truncated file behind as a false success — the bare
    # stdout path shares this producer and is equally atomic).
    local no_proxy
    no_proxy="$(no_proxy_value "$1")" || return 1
    # shellcheck disable=SC2059  # the format is a literal in this file
    printf 'HTTP_PROXY=%s\nHTTPS_PROXY=%s\nhttp_proxy=%s\nhttps_proxy=%s\nNO_PROXY=%s\nno_proxy=%s\n' \
        "$proxy" "$proxy" "$proxy" "$proxy" "$no_proxy" "$no_proxy"
}

cmd_proxy_env() {
    # Print proxy env assignments for a profile's workloads (ARC-6-D3).
    # ARC-44-D1: an optional machine token emits exactly one validated
    # value for command substitution: proxyip | proxyport | noproxy.
    # Unknown token / extra args exit 2 — never fall through to the
    # assignment form (that would inject NAME=value into $(...)).
    # EGL-246: `--out[=<path>]` writes the assignments atomically with
    # mode 0600 and prints the real path of the file written (EGL-387-D6:
    # canonical parent plus the final filename, so a consumer opening the
    # printed path lands where the mode check ran; a symlinked parent
    # still works and stdout names the referent). Bare `--out` targets
    # ${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/egresslock-proxy-<profile>.env
    # (D2). An explicit path need not be in the runtime dir, but its
    # parent must exist, be a directory, and be owned and writable by the
    # invoking account (D11); group- or world-writable is refused
    # (EGL-387); any unusable shape fails closed rc 1, nothing written
    # (D3/D6). mktemp beside the target + mv, temp removed on failure —
    # no partial file (D4/D5).
    require_profile "${1:-}" proxy-env
    local profile="$1" token="${2:-}" out_path=""
    # EGL-246 R-EGL-246-3 F3: an argument's PRESENCE, not emptiness, is
    # the count. A quoted empty `""` is a real positional and falls to
    # the token ladder below (the named `unknown token` arm); any THIRD
    # argument is the at-most-one usage error (rc 2, pre-conf). Emptiness
    # checks alone let `--out=<path> ""` and `"" --out` slip through.
    if (( $# > 2 )); then
        echo "Error: proxy-env takes at most one argument (a token or an --out form)." >&2
        echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
        exit 2
    fi
    if [[ "$token" == "--out" && $# -ge 3 ]]; then
        echo "Error: --out takes no separate argument (use --out=<path>)." >&2
        echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
        exit 2
    fi
    # F3 continuation: a non-empty token plus any further argument
    # (present-but-empty included) is the at-most-one error — the
    # count, not the value, is the contract.
    if [[ -n "$token" && $# -ge 3 && "$token" != --out* ]]; then
        echo "Error: proxy-env takes at most one argument (a token or an --out form)." >&2
        echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
        exit 2
    fi
    if [[ -n "$token" ]]; then
        # EGL-246 R-EGL-246-3 F3: count-based second layer (the arm —
        # `$# -le 2`, not the `-z` value test, so any third argument,
        # empty or not, is the at-most-one usage error).
        case "$token" in
            proxyip|proxyport|noproxy)
                case "$token" in
                    proxyip)   emit_token "${GW_IP[$profile]}" ipv4 ;;
                    proxyport) emit_token "${GW_PORT[$profile]}" port ;;
                    *)         emit_token "$(no_proxy_value "$profile")" noproxy ;;
                esac
                return 0
                ;;
            --out)
                out_path="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/egresslock-proxy-${profile}.env"
                ;;
            --out=*)
                out_path="${token#--out=}"
                [[ -n "$out_path" ]] || {
                    echo "Error: --out= requires a path." >&2
                    echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
                    exit 2
                }
                ;;
            *)
                echo "Error: unknown proxy-env token '$token' (expected: proxyip, proxyport, noproxy)." >&2
                exit 2
                ;;
        esac
        proxy_env_write_out "$profile" "$out_path"
        return 0
    fi
    proxy_env_assignments "$profile"
}

proxy_env_write_out() { # proxy_env_write_out <profile> <path> — 0600 atomic write, path on stdout
    local profile="$1" target="$2" raw_dir dir dir_mode
    # EGL-387 R-EGL-387-6 F2: a path containing a newline is unsupported —
    # command substitution (here and in a consumer's `--env-file="$(…)"`)
    # strips a trailing newline, so the canonicalized or printed path could
    # name a different file. Refuse before any directory work, fail closed.
    if [[ "$target" == *$'\n'* ]]; then
        die "proxy-env --out: target path contains a newline (unsupported path — fail closed)"
    fi
    # EGL-246-D11/D19 (operator Q4 refinement): a target with no `/`
    # component is relative to the cwd — its parent is `.`; a
    # root-level target's parent is `/`. All parent checks run on the
    # CANONICAL parent (`realpath`), so `./`, `..` and
    # symlinked-parent spellings cannot dodge them.
    if [[ "$target" == */* ]]; then raw_dir="${target%/*}"; else raw_dir="."; fi
    [[ -n "$raw_dir" ]] || raw_dir="/"
    # EGL-387 R-EGL-387-6 F1 / EGL-424: canonicalize the TYPED parent for
    # the D6 write/print path with plain `realpath`, not `-m` — `-m`
    # normalizes a missing or non-directory component before `..`
    # (`<dir>/missing/../victim` -> `<dir>/victim`), so the D6 rewrite
    # would print/write a path the typed parent cannot reach. This step is
    # canonicalization, not the security check: a conforming `realpath`
    # also rejects `afile/..` with ENOTDIR, but that is an implementation
    # property, not a kernel guarantee (uutils coreutils 0.10.0
    # `canonicalize` pops it lexically). The kernel decides where the path
    # leads — the `-ef` identity check below refuses before any write, a
    # `realpath` failure keeps its named refusal, and a missing final
    # component is named by `-d` on the canonical path.
    # The `printf x` sentinel stops `$(…)` from stripping a trailing
    # newline in the canonical path (the F2 class, via a symlink referent);
    # the one newline stripped after it is `realpath`'s record terminator.
    dir="$({ realpath -- "$raw_dir" && printf x; } 2>/dev/null)" \
        || die "proxy-env --out: cannot resolve target directory '$raw_dir' (fail closed)"
    dir="${dir%x}"
    dir="${dir%$'\n'}"
    if [[ "$dir" == *$'\n'* ]]; then
        die "proxy-env --out: target path contains a newline (unsupported path — fail closed)"
    fi
    if [[ ! -d "$dir" ]]; then
        die "proxy-env --out: target directory '$dir' is missing or not a directory (no implicit mkdir — fail closed)"
    fi
    # EGL-424: fail closed unless the kernel confirms the TYPED parent IS
    # the canonical parent — a kernel identity check, not a directory
    # test. `-d "$raw_dir"` would still accept a `realpath` that returned
    # another existing directory, and the D6 rewrite would then replace a
    # file outside the typed parent (the R-EGL-387-6 F1 wrong-destination
    # class). `-ef` stats BOTH paths (device+inode), so `afile/..`
    # (ENOTDIR), a missing component and a wrong directory all refuse
    # here, before any write, independent of which `realpath` is
    # installed. A missing final component was already refused by the
    # `-d "$dir"` check above and keeps its own message.
    if [[ ! "$raw_dir" -ef "$dir" ]]; then
        die "proxy-env --out: cannot resolve target directory '$raw_dir' (fail closed)"
    fi
    [[ -O "$dir" && -w "$dir" ]] || {
        die "proxy-env --out: target directory '$dir' is not owned or writable by this account (fail closed)"
    }
    # EGL-246-D19 (operator Q4) / EGL-387-D2: refuse a parent another
    # account can write to — a group member or other user could replace
    # the temp between its creation and the rename and redirect the
    # proxied traffic. World write (002) is checked first so the stable
    # `world-writable` symptom key keeps precedence, then group write
    # (020). Both run before mktemp — a refusal writes nothing.
    dir_mode="$(stat -c %a -- "$dir" 2>/dev/null)" \
        || die "proxy-env --out: cannot inspect target directory '$dir' (fail closed)"
    if (( 0$dir_mode & 002 )); then
        die "proxy-env --out: target directory '$dir' is world-writable (pass a directory only this account can write to — fail closed)"
    fi
    if (( 0$dir_mode & 020 )); then
        die "proxy-env --out: target directory '$dir' is group-writable (pass a directory only this account can write to — fail closed)"
    fi
    if [[ -d "$target" ]]; then
        die "proxy-env --out: target '$target' is a directory (pass a file path)"
    fi
    # EGL-387-D6: rewrite the target to the path we actually checked —
    # the canonical parent plus the final filename — and use it for the
    # temp, the rename, and stdout. The typed spelling may traverse a
    # mutable symlink (e.g. one in a sticky shared directory) that can
    # be repointed after this command returns; a consumer opening the
    # printed path must land in the directory whose mode was checked.
    # Symlink parents still work; stdout names the referent. A basename
    # that is empty or `.`/`..` was already refused by the directory
    # check above.
    target="${dir%/}/${target##*/}"
    # EGL-246 R-EGL-246-3 F2: re-verify the target's shape AFTER the
    # producer, immediately before the rename — a late symlink-to-dir
    # lets GNU mv move the temp INTO the directory (or a referent) and
    # still exit 0, a false success at the wrong path. Use a plain
    # rename(2) (`mv -T --`), never move-into-directory; check the late
    # symlink leg below. Mode lands on the temp BEFORE the rename.
    local tmp
    tmp="$(mktemp "$target.XXXXXX")" || die "proxy-env --out: cannot create temp beside '$target' (fail closed)"
    chmod 600 "$tmp" || { rm -f "$tmp"; die "proxy-env --out: cannot set 0600 on the temp beside '$target' (fail closed)"; }
    if ! proxy_env_assignments "$profile" > "$tmp"; then
        rm -f "$tmp"
        die "proxy-env --out: cannot write '$target' (fail closed)"
    fi
    # Late-arriving target shapes (scheduling changes between the
    # pre-write checks and the rename): a directory is never replaced
    # and a symlink is never followed — the temp is removed and the
    # write fails closed named (F2).
    if [[ -d "$target" ]]; then
        rm -f "$tmp"
        die "proxy-env --out: target '$target' is a directory (pass a file path)"
    fi
    if [[ -L "$target" ]]; then
        rm -f "$tmp"
        die "proxy-env --out: target '$target' is a symlink (pass a plain file path — fail closed)"
    fi
    if mv -T -- "$tmp" "$target"; then
        echo "$target"
    else
        rm -f "$tmp"
        die "proxy-env --out: cannot write '$target' (fail closed)"
    fi
}

cmd_network() {
    # ARC-44-D2: single-token output (network names are embedded in
    # command substitutions); extra args exit 2.
    require_profile "${1:-}" network
    [[ -z "${2:-}" ]] || {
        echo "Error: network takes no extra arguments." >&2
        echo "usage: egresslock network <profile>" >&2
        exit 2
    }
    emit_token "$(network_of "$1")" netname
}

cmd_rules() {
    # Print the policy rules for a profile (the same code path install
    # and verify use). Used by the golden equivalence tests (ARC-8) and
    # for debugging.
    require_profile "${1:-}" rules
    policy_rules "$1"
}

#
# ARC-7-D1 detect-and-allow workflow. Both commands operate on per-profile
# config data.
#
require_engine() {
    [[ -n "$ENGINE_CONF" ]] || die "this command requires a loaded profile config"
}

denied_parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all)  all=1; shift ;;
            --days) [[ $# -ge 2 ]] || { echo "Error: --days requires a value." >&2; exit 2; }
                    days="$2"; shift 2 ;;
            *)      echo "Error: denied takes --all and/or --days N." >&2
                    echo "usage: egresslock denied <profile> [--all] [--days N]" >&2
                    exit 2 ;;
        esac
    done
    [[ "$days" =~ ^(0|[1-9][0-9]*)$ ]] || {
        echo "Error: --days must be a non-negative integer (0 = no time limit)." >&2
        exit 2
    }
    # ARC-32-D1 (EGL-252): byte cap for the streamed read. Validated
    # like --days: non-negative integer; 0 disables the cap (operator's
    # explicit choice — the default 32 MiB cap, equal to the rotation
    # default, is what protects the naive path). EGL-252: the read is
    # tail-biased — the newest bytes are the ones kept, so the cap
    # never hides the destinations the detect-and-allow loop needs.
    max_bytes="${EGRESSLOCK_DENIED_MAX_BYTES:-33554432}"
    [[ "$max_bytes" =~ ^(0|[1-9][0-9]*)$ ]] || {
        echo "Error: EGRESSLOCK_DENIED_MAX_BYTES must be a non-negative integer (bytes; 0 = uncapped)." >&2
        exit 2
    }
    # ARC-42-D1: window is epoch seconds; `now` from the host clock
    # (rootless Podman shares it; do not exec date in the gateway).
    local now
    now="$(date +%s)"
    cutoff=0
    (( days > 0 )) && cutoff=$(( now - days * 86400 ))
    # EGL-186-D2: with --days 0 the && above short-circuits false (rc 1);
    # the helper must return 0 on the success path or errexit kills the
    # aggregator before denied_collect runs.
    return 0
}

denied_collect() {
    # Squid native access.log fields: ts, elapsed, client,
    # code/HTTP_status, bytes, method, url — method=$6, url=$7. CONNECT
    # url is "host:port"; other methods carry an absolute URL. Dedupe by
    # emitted string, first-seen order (ARC-41-D1/D2); malformed URLs,
    # userinfo, and IPv6 literals are best-effort skips.
    # ARC-32-D1/EGL-252: one streaming pass; LC_ALL=C counts BYTES. The
    # read is TAIL-biased — the producer sizes the log (`stat -c %s`)
    # and, over max_bytes, reads the newest max_bytes + 1 (`tail -c`,
    # which seeks, so the host never buffers it). The +1 is a boundary
    # probe: an empty first record means the window starts on a line
    # boundary (kept); a non-empty one is a partial line and is dropped.
    # Within the cap (or stat fails — container down), cat the whole
    # file. --days applies to the bytes read. Candidates stream into the
    # ARC-57 emit filter; the trailing @ARC32META@ line carries
    # had_denied (ARC-42-D3), truncated, and bytes read (0 = container
    # down/empty). '@' is outside the allow charset, so no collision.
    local gwname size="" trunc_flag=0
    gwname="$(gw_name "$profile")"
    if (( max_bytes > 0 )); then
        size="$(rt_exec "$gwname" stat -c %s /var/log/squid/access.log 2>/dev/null || true)"
        if [[ "$size" =~ ^[0-9]+$ ]] && (( size > max_bytes )); then
            trunc_flag=1
        fi
    fi
    while IFS= read -r cand; do
        if [[ "$cand" == "@ARC32META@ "* ]]; then
            read -r had_denied truncated read_bytes _ <<<"${cand#'@ARC32META@ '}"
            continue
        fi
        [[ -n "$cand" ]] || continue
        # ARC-57-D1: the emit side is the filter. `denied` feeds the next
        # `allow`; a malformed log line must not print a string the allow
        # grammar rejects (a confusing exit-2 in the paste loop). Skip
        # silently — rc stays 0, no "invalid allowlist entry" stderr.
        # EGL-18-D1 widening: a well-formed IPv4 host[:port] is also
        # emitted (a real destination; hiding it left the EGL-17 shape
        # undiagnosable). The branch flips `ipv4_seen`, printing the
        # one-time denied_ipv4_note after the list.
        if allow_entry_ok "$cand"; then
            ok_entries+=("$cand")
        elif denied_entry_ok "$cand"; then
            ok_entries+=("$cand")
            ipv4_seen=1
        fi
    done < <(
        if (( trunc_flag == 1 )); then
            rt_exec "$gwname" tail -c "$(( max_bytes + 1 ))" /var/log/squid/access.log 2>/dev/null
        else
            rt_exec "$gwname" cat /var/log/squid/access.log 2>/dev/null
        fi |
        LC_ALL=C awk -v cutoff="$cutoff" -v truncated="$trunc_flag" \
            -v probedomain="$GW_LIVE_PROBE_DOMAIN" '
            function emit(s) { if (!seen[s]++) print s }

            # EGL-252: the producer already bounded the read (tail -c on
            # a stat-derived size; cat when the file fits the cap), so
            # the parser no longer aborts mid-stream — it only drops the
            # partial first record a mid-line tail offset can produce
            # (the probe byte above makes an empty first record the
            # keep-path).
            {
                read += length($0) + 1
                if (NR == 1 && truncated == 1 && length($0)) next
            }

            # EGL-259: squid may log a client-close-race deny as
            # TCP_DENIED_ABORTED/403 (EGL-211 R-EGL-211-2).
            # EGL-393-D4: the reserved live-probe host is the engine own
            # 302 request, never a workload denial. Identify that exact
            # host (any method/port) before `had` is touched and drop only
            # it; every other record — including a malformed one or one
            # older than the window — keeps the old had_denied behavior.
            $4 ~ /^TCP_DENIED(_ABORTED)?\// {
                h = ""; host = ""; rest = ""; port = ""; http = 0; probe = 0
                if ($6 == "CONNECT") {
                    h = $7
                    sub(/:[0-9]+$/, "", h)
                    probe = (tolower(h) == probedomain)
                } else {
                    u = tolower($7)
                    http = (u ~ /^https?:\/\//)
                    if (http) {
                        rest = $7
                        sub(/^https?:\/\//, "", rest)
                        if (match(rest, /[/?#]/)) rest = substr(rest, 1, RSTART - 1)
                        if (rest !~ /@/ && rest !~ /^\[/) {  # userinfo / IPv6
                            host = rest
                            port = (u ~ /^http:\/\//) ? "80" : "443"
                            if (match(rest, /:[0-9]+$/)) {
                                host = substr(rest, 1, RSTART - 1)
                                port = substr(rest, RSTART + 1)
                            }
                            if (host != "") probe = (tolower(host) == probedomain)
                        }
                    }
                }
                if (probe) next
                had = 1
                if (cutoff != 0 && $1+0 < cutoff) next
                if ($6 == "CONNECT") { emit(h); next }
                if (!http) next
                if (rest ~ /@/ || rest ~ /^\[/ || host == "") next
                if (port == "443") emit(host); else emit(host ":" port)
            }

            END { printf "@ARC32META@ %d %d %d\n", (had ? 1 : 0), (truncated == 1 ? 1 : 0), read + 0 }
        '
    )
}

denied_omit_covered() {
    # ARC-31 filter, port-aware (ARC-41-D3): omit an entry only when the
    # allowlist covers that host on that port. Bare host means the 443
    # no-port group; host:80 needs an explicit :80 entry (or a
    # leading-dot suffix on :80) — a 443 entry must NOT hide a :80
    # denial. R-031-1: leading-dot dstdomain suffixes cover the bare host
    # AND every subdomain, per port.
    local -A exact=() suf=()
    local e h port
    while IFS= read -r e; do
        [[ -n "$e" ]] || continue
        if [[ "$e" == *:* ]]; then
            h="${e%:*}"; port="${e##*:}"
        else
            h="$e"; port="443"
        fi
        if [[ "$h" == .* && "${#h}" -gt 1 ]]; then
            suf[$port]+=" ${h#.}"
        else
            exact[$port]+=" $h"
        fi
    done < <(gw_allowlist_entries "$profile")
    local d dhost dport hh ss covered
    while IFS= read -r d; do
        [[ -n "$d" ]] || continue
        if [[ "$d" == *:* ]]; then
            dhost="${d%:*}"; dport="${d##*:}"
        else
            dhost="$d"; dport="443"
        fi
        covered=0
        for hh in ${exact[$dport]:-}; do
            [[ "$hh" == "$dhost" ]] && { covered=1; break; }
        done
        if [[ "$covered" != 1 ]]; then
            for ss in ${suf[$dport]:-}; do
                [[ "$dhost" == "$ss" || "$dhost" == *".$ss" ]] && { covered=1; break; }
            done
        fi
        [[ "$covered" == 1 ]] && continue
        echo "$d"
    done <<<"$denied_entries"
}

cmd_denied() {
    # Print de-duplicated entries the profile's gateway DENIED (Squid
    # TCP_DENIED(_ABORTED) from the access log), most recent last, to
    # drive the detect-and-allow loop. ARC-41: CONNECT entries stay
    # hostname-only ('host'; :443 is the no-port group); plain-HTTP
    # entries become allow-grammar host[:port] (http -> :80, explicit
    # port preserved, :443 collapses) so `allow` consumes them verbatim.
    # ARC-42: a time window (default 14 days, --days N, 0 = full log)
    # applies to BOTH views on the host; the log is never truncated.
    # ARC-31: omit entries already covered ON THE SAME PORT; --all prints
    # the raw union. ARC-32-D1: stream into the parser, never slurp; cap
    # the read at EGRESSLOCK_DENIED_MAX_BYTES (default 32 MiB, 0 =
    # uncapped) so a flood cannot OOM. EGL-252: over the cap the read is
    # tail-biased (newest bytes, partial first line dropped) and a
    # stderr note names the remedy. `denied` never deletes or rotates.
    require_profile "${1:-}" denied
    require_engine
    local profile="$1"
    shift
    local all=0 days=14
    local max_bytes=0 cutoff=0
    denied_parse_args "$@"
    local -a ok_entries=()
    local cand had_denied=0 truncated=0 read_bytes=0 ipv4_seen=0
    denied_collect
    # ARC-32-D1: keep the ARC-42-era empty-log contract. bytes=0 means
    # the container was down or the log is empty — the same message for
    # both cases.
    (( read_bytes > 0 )) || { echo "no gateway log (container down or no denials yet)"; return 0; }
    if (( truncated == 1 )); then
        echo "note: only the newest ${max_bytes} bytes of the gateway log were read (EGRESSLOCK_DENIED_MAX_BYTES); older entries were not listed — set EGRESSLOCK_DENIED_MAX_BYTES=0 for the full log" >&2
    fi
    local denied_entries=""
    if (( ${#ok_entries[@]} > 0 )); then
        denied_entries="$(printf '%s\n' "${ok_entries[@]}")"
    fi
    if [[ -z "$denied_entries" ]]; then
        # ARC-42-D3: windowed parse produced nothing but the log HAS
        # denied lines — tell the operator the window is the reason
        # (the silent-empty trap from ARC-41). stdout stays empty.
        if [[ "$had_denied" == 1 && "$days" != 0 ]]; then
            echo "note: no denials in the last $days days (older entries exist; denied <profile> --days 0)" >&2
        fi
        return 0
    fi
    if [[ "$all" == 1 ]]; then
        echo "$denied_entries"
        if (( ipv4_seen == 1 )); then denied_ipv4_note; fi
        return 0
    fi
    denied_omit_covered
    # EGL-18-D1: the note fires when an IPv4 was EMITTED. An IPv4 can
    # never be covered by the ARC-31 filter below (the allowlist cannot
    # contain literals — ARC-51), so "in ok_entries" == "printed". An
    # explicit if, not `&&`, so the command's rc stays 0 when no IPv4
    # was seen (the function must not inherit a false arithmetic).
    if (( ipv4_seen == 1 )); then denied_ipv4_note; fi
}

# EGL-310-D2: the read view's argv — one profile, with --direct accepted
# before or after it, at most once. --all is deliberately not
# implemented (there is no merged two-lane view), so it is an unknown
# option (rc 2), not a hidden mode.
allowlist_usage() { # allowlist_usage [direct]
    if [[ "${1:-0}" == 1 ]]; then
        echo "usage: egresslock allowlist <profile> --direct" >&2
    else
        echo "usage: egresslock allowlist [--direct] <profile>" >&2
    fi
}

allowlist_parse() { # allowlist_parse <args...>; sets ALLOWLIST_DIRECT/PROFILE
    ALLOWLIST_DIRECT=0
    ALLOWLIST_PROFILE=""
    local arg
    for arg in "$@"; do
        case "$arg" in
            --direct)
                if (( ALLOWLIST_DIRECT )); then
                    echo "Error: allowlist takes --direct only once." >&2
                    allowlist_usage
                    exit 2
                fi
                ALLOWLIST_DIRECT=1 ;;
            --all)
                echo "Error: unknown allowlist option '--all' (only --direct is accepted)." >&2
                allowlist_usage
                exit 2 ;;
            -*)
                echo "Error: unknown allowlist option '$arg' (only --direct is accepted)." >&2
                allowlist_usage
                exit 2 ;;
            "")
                echo "Error: allowlist takes one profile name." >&2
                allowlist_usage
                exit 2 ;;
            *)
                if [[ -z "$ALLOWLIST_PROFILE" ]]; then
                    ALLOWLIST_PROFILE="$arg"
                else
                    echo "Error: allowlist takes one profile name." >&2
                    allowlist_usage
                    exit 2
                fi ;;
        esac
    done
    if [[ -z "$ALLOWLIST_PROFILE" ]]; then
        echo "Error: allowlist requires a profile name." >&2
        allowlist_usage
        exit 2
    fi
}

# EGL-375-D2/D5: the shared read-view header for both lanes. The count
# is the number of rows, so an empty lane is explicit ("0 … entries")
# and prints the one header line with no rows. Rows print verbatim in
# the order collected — no sort, dedupe, or fold (D3).
allowlist_render() { # allowlist_render <profile> <lane> <source noun> <resolution clause> <entries>
    local profile="$1" lane="$2" source="$3" resolution="$4" entries="$5"
    local -a rows=()
    local row
    if [[ -n "$entries" ]]; then
        while IFS= read -r row; do rows+=("$row"); done <<<"$entries"
    fi
    echo "profile '$profile' — ${#rows[@]} $lane entries from the $source ($resolution):"
    if (( ${#rows[@]} > 0 )); then
        printf '%s\n' "${rows[@]}"
    fi
}

cmd_allowlist() {
    # EGL-375: the bare form is the proxy lane's CONFIGURED-ENTRY view,
    # not a file dump: comments/blank lines are stripped, one stored
    # entry per line in file order (case, leading dot, explicit :443,
    # and leading-zero port preserved — D3), under a header naming the
    # lane, count, source, and resolution (D2). An invalid line fails
    # closed through the shared validator (D4) with nothing on stdout; a
    # missing or unreadable file keeps its named fail-closed error.
    # Still strictly read-only (D6).
    #
    # EGL-310: with --direct, print the STORED direct-lane entries from
    # the parsed profile conf instead (`profile_allow_hosts` — the same
    # accessor ensure/verify use): one host:port per `rule allow-host`
    # line, conf order. EGL-375-D5 moves its
    # header and empty-lane line to the shared template. Strictly
    # read-only: no DNS resolve, no pin record, no chain read, no lock,
    # no ensure. A name that no longer resolves still prints (rc 0); a
    # malformed conf still fails closed during the normal load.
    allowlist_parse "$@"
    local profile="$ALLOWLIST_PROFILE"
    require_profile "$profile" allowlist
    require_engine
    local entries
    if (( ALLOWLIST_DIRECT )); then
        entries="$(profile_allow_hosts "$profile")"
        allowlist_render "$profile" direct "profile conf" \
            "pinned to addresses at ensure; traffic is not proxied" "$entries"
        return 0
    fi
    # D4: the validator runs in a command substitution, so its die()
    # exits only that subshell — propagate the failure or the view would
    # print a header for an invalid/missing/unreadable file.
    entries="$(gw_allowlist_scan "$profile" stored)" || exit 1
    allowlist_render "$profile" proxy "allowlist file" \
        "the proxy resolves each entry per request" "$entries"
}

# EGL-310-D2: hidden shortcut (mirrors allow-direct): exactly one
# profile, no flags. It is a full dispatch citizen (root guard, argv
# shape, conf resolution) but its errors name the canonical
# `allowlist <profile> --direct` form.
cmd_allowlist_direct() {
    local arg profile="" n=0
    for arg in "$@"; do
        case "$arg" in
            --direct)
                echo "Error: the direct view is already selected; drop --direct." >&2
                allowlist_usage 1
                exit 2 ;;
            -*)
                echo "Error: unknown allowlist-direct option '$arg' (the direct view takes no flags)." >&2
                allowlist_usage 1
                exit 2 ;;
            "")
                echo "Error: allowlist-direct takes one profile name." >&2
                allowlist_usage 1
                exit 2 ;;
            *)
                n=$(( n + 1 ))
                profile="$arg" ;;
        esac
    done
    if (( n == 0 )); then
        echo "Error: allowlist-direct requires a profile name." >&2
        allowlist_usage 1
        exit 2
    fi
    if (( n > 1 )); then
        echo "Error: allowlist-direct takes one profile name." >&2
        allowlist_usage 1
        exit 2
    fi
    cmd_allowlist "$profile" --direct
}

# ARC-32-D2: DNS length bounds for a host token (the port is split off
# by callers, and a leading-dot suffix is stripped): full host <= 253
# bytes, each dot-separated label 1..63 (RFC 1035). Charset is enforced
# by the callers' grammars (ARC-50-D6); this is the size gate, so an
# oversize "hostname" is rejected here instead of persisting until
# `squid -k parse` fails at the next ensure (ARC-48 U9). A MID-NAME empty
# label ('a..b') fails the label rule; a TRAILING dot does NOT fail this
# split (the empty trailing label is dropped) — trailing-dot rejection
# lives in the host-field parsers (EGL-147-D2, ARC-32 finding 1).
arc32_dns_len_ok() { # arc32_dns_len_ok <host>
    local host="$1" label
    (( ${#host} <= 253 )) || return 1
    local IFS=.
    for label in $host; do
        (( ${#label} >= 1 && ${#label} <= 63 )) || return 1
    done
    return 0
}

# ARC-57-D1: silent shared predicate — the ONE grammar the allow path
# enforces (host/host:port, first char alnum or '.', port 1-65535, and
# ARC-51's IPv4-literal rejection). No stderr. Returns 0 valid, 1
# invalid. `validate_allow_entry` wraps it with the user-facing error
# for argv; `denied` calls it silently to skip emit (rc stays 0).
# ARC-32-D2: the DNS length caps live here too, so `allow`,
# `gw_allowlist_entries`, and the `denied` emit filter all inherit the
# one predicate.
# EGL-147-D2: a trailing dot on the HOST part is invalid — squid's
# matchDomainName compares from the string ends with no trailing-dot
# tolerance for the ENTRY, so `name.` can never match (X-6 E7); reject,
# do not normalize, do not warn. The check is on the
# host part BEFORE stripping a leading dot, so `.name.` is trailing-dot
# (rejected) while `.name` stays a valid suffix (ARC-31 / X-6 E4).
allow_entry_ok() { # allow_entry_ok <entry>
    local entry="$1"
    if [[ "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*:[0-9]+$ ]]; then
        local port="${entry##*:}"
        cfg_is_port "$port" || return 1
    elif [[ ! "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        return 1
    fi
    local probe="${entry%:*}"
    [[ "$probe" == *. ]] && return 1
    probe="${probe#.}"
    cfg_is_ipv4 "$probe" && return 1
    arc32_dns_len_ok "$probe" || return 1
    return 0
}

# EGL-18-D1: the deny-log twin of allow_entry_ok — keep a candidate
# that is a valid allowlist entry (ARC-57-D1) OR a well-formed IPv4
# literal host[:port]. IPv4 stays OUT of the allow grammar (ARC-51-D1);
# hiding IPv4 403s made the EGL-17 incident undiagnosable. Injection
# payloads (`foo;rm`, backticks, leading-dash hosts) fail BOTH branches:
# the port check is numeric 1-65535 and the host check is `cfg_is_ipv4`.
# Silent — rc 0 emit, 1 skip.
denied_entry_ok() { # denied_entry_ok <candidate>
    allow_entry_ok "$1" && return 0
    local host="$1" port
    if [[ "$host" == *:* ]]; then
        port="${host##*:}"
        host="${host%:*}"
        cfg_is_port "$port" || return 1
    fi
    cfg_is_ipv4 "$host"
}

# EGL-18-D1: the ONE-TIME stderr note for a `denied` invocation that
# emitted at least one IPv4 (verbatim per the approved design; never
# on stdout — the destination list stays a paste-safe feed).
denied_ipv4_note() {
    echo "note: IPv4 destinations are not allowlist hostnames — use --direct: egresslock allow <profile> <ip:port> --direct. Proxied clients 403 unless the IP is in NO_PROXY (proxy-env includes direct IPv4 pins; recreate the workload)." >&2
}

# ARC-46-D2: validate an allowlist entry's grammar; argument errors are
# usage-class (exit 2 via caller). Returns 0 valid, 1 invalid (message
# already printed). Grammar lives in allow_entry_ok (ARC-57-D1); this
# wrapper only turns the silent result into the specific argv error.
# EGL-365: an optional <command> <profile> context makes an IPv4-literal
# refusal print the exact canonical direct-lane retry.
validate_allow_entry() { # validate_allow_entry <entry> [<cmd> <profile>]
    local entry="$1" cmd="${2:-}" profile="${3:-<profile>}"
    allow_entry_ok "$entry" && return 0
    # EGL-147-D2: the trailing-dot case is named BEFORE the IPv4 /
    # DNS-length branches so a trailing-dot IPv4-shaped token
    # (`1.2.3.4.`) is named for the shape the operator typed (it is
    # not a cfg_is_ipv4 hit with the trailing dot anyway).
    if [[ "${entry%:*}" == *. && "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*(:[0-9]+)?$ ]]; then
        echo "Error: allowlist entry '$entry' has a trailing dot — dstdomain entries are bare names; requests with trailing dots are normalized by the gateway" >&2
        return 1
    fi
    if [[ "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*:[0-9]+$ ]]; then
        local port="${entry##*:}" probe="${entry%:*}"
        probe="${probe#.}"
        if ! cfg_is_port "$port"; then
            echo "Error: invalid port in entry '$entry'" >&2
        elif ! arc32_dns_len_ok "$probe"; then
            echo "Error: allowlist entry '$entry' exceeds DNS length limits (host <= 253 bytes, labels <= 63)" >&2
        elif [[ -n "$cmd" ]]; then
            echo "Error: allowlist entry '$entry' is an IPv4 literal; the proxy path cannot carry it — retry with --direct: egresslock $cmd $profile $probe:$port --direct" >&2
        else
            echo "Error: allowlist entry '$entry' is an IPv4 literal; the proxy path cannot carry it — use --direct: egresslock allow <profile> $probe:$port --direct" >&2
        fi
    elif [[ "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        local probe="${entry%:*}"
        probe="${probe#.}"
        if ! arc32_dns_len_ok "$probe"; then
            echo "Error: allowlist entry '$entry' exceeds DNS length limits (host <= 253 bytes, labels <= 63)" >&2
        elif [[ -n "$cmd" ]]; then
            echo "Error: allowlist entry '$entry' is an IPv4 literal; the proxy path cannot carry it — the direct path requires a port, e.g. retry with: egresslock $cmd $profile $probe:443 --direct" >&2
        else
            echo "Error: allowlist entry '$entry' is an IPv4 literal; the proxy path cannot carry it — the direct path requires a port, e.g. use: egresslock allow <profile> $probe:443 --direct" >&2
        fi
    else
        echo "Error: invalid allowlist entry '$entry' (expected host or host:port)" >&2
    fi
    return 1
}

# ARC-46-D1: one stderr line before a mutator's re-ensure so the ~3s
# gateway restart is not a silent gap. Stdout stays the data channel.
re_ensuring() { echo "re-ensuring profile '$1' ..." >&2; }

# EGL-365-D7: one honest disclosure line per successful mutation.
lane_disclose_proxy() { # lane_disclose_proxy <allowlist-path>
    echo "path: proxy — gateway allowlist $1"
}
lane_disclose_direct() { # lane_disclose_direct <conf-path>
    echo "path: direct — firewall rule in $1 (does not change client proxy settings)"
}

# EGL-365-D8/D11: advice only — a proxy-lane allow on a port other than
# 80/443 offers an ADDITIONAL direct pin, two lines (the note and the
# runnable command) per offending entry. It never changes the lane or
# the port, never chains a removal with `;`, and never implies the proxy
# grant is gone (it stays). A leading-dot suffix cannot convert to one
# direct pin, so it is silent. Every port this prints is the canonical
# decimal value (cfg_port_canon): a stored `:0673` prints `port 673` and
# the copyable command names `:673`, so nft cannot read it as octal.
lane_port_hint() { # lane_port_hint <profile> <entry>
    local profile="$1" entry="$2" port host
    [[ "$entry" == .* ]] && return 0
    [[ "$entry" == *:* ]] || return 0
    port="${entry##*:}"
    [[ "$port" =~ ^[0-9]+$ ]] || return 0
    port="$(cfg_port_canon "$port")" || return 0
    # Numeric compare: leading-zero spellings (e.g. :0443) are the same
    # port as their decimal form and must not be called non-standard.
    (( port == 80 || port == 443 )) && return 0
    host="${entry%:*}"
    echo "note: port $port is not the usual HTTP(S) port. If $entry is a non-HTTP service, add a direct rule as well (this does not remove the allowlist entry):" >&2
    echo "  egresslock allow $profile $host:$port --direct" >&2
}

# EGL-365 shared argv parser: one verb, command-level --direct (accepted
# before or after the profile, at most once). Proxy takes N destinations;
# --direct takes exactly one host:port. Sets LANE_CMD_DIRECT,
# LANE_CMD_PROFILE, LANE_CMD_DESTS; usage errors exit 2.
lane_cmd_usage() { # lane_cmd_usage <cmd> [direct]
    if [[ "${2:-}" == 1 ]]; then
        echo "usage: egresslock $1 --direct <profile> <host:port>" >&2
    else
        echo "usage: egresslock $1 [--direct] <profile> <host[:port]> [host[:port] ...]" >&2
    fi
}

lane_cmd_parse() { # lane_cmd_parse <allow|disallow> <args...>
    local cmd="$1"; shift
    LANE_CMD_DIRECT=0
    LANE_CMD_PROFILE=""
    LANE_CMD_DESTS=()
    local arg
    for arg in "$@"; do
        case "$arg" in
            --direct)
                if (( LANE_CMD_DIRECT )); then
                    echo "Error: $cmd takes --direct only once." >&2
                    lane_cmd_usage "$cmd"
                    exit 2
                fi
                LANE_CMD_DIRECT=1 ;;
            --http|--https|--proxy)
                echo "Error: $arg is not a $cmd option — protocol flags (--http/--https/--proxy) are not accepted; a port stays in the destination (e.g. egresslock $cmd <profile> example.com:8443) and --direct selects the direct path." >&2
                exit 2 ;;
            -*)
                echo "Error: unknown $cmd option '$arg' (only --direct is accepted)." >&2
                lane_cmd_usage "$cmd"
                exit 2 ;;
            *)
                if [[ -z "$LANE_CMD_PROFILE" ]]; then
                    LANE_CMD_PROFILE="$arg"
                else
                    LANE_CMD_DESTS+=("$arg")
                fi ;;
        esac
    done
    if [[ -z "$LANE_CMD_PROFILE" ]]; then
        echo "Error: $cmd requires a profile name." >&2
        lane_cmd_usage "$cmd" "$LANE_CMD_DIRECT"
        exit 2
    fi
    if (( ${#LANE_CMD_DESTS[@]} == 0 )); then
        echo "Error: $cmd requires a destination." >&2
        lane_cmd_usage "$cmd" "$LANE_CMD_DIRECT"
        exit 2
    fi
    if (( LANE_CMD_DIRECT )); then
        if (( ${#LANE_CMD_DESTS[@]} > 1 )); then
            echo "Error: --direct takes exactly one host:port." >&2
            lane_cmd_usage "$cmd" 1
            exit 2
        fi
        validate_host_port "${LANE_CMD_DESTS[0]}"
    else
        local e
        for e in "${LANE_CMD_DESTS[@]}"; do
            validate_allow_entry "$e" "$cmd" "$LANE_CMD_PROFILE" || exit 2
        done
    fi
}

# EGL-365: the shortcut/alias shape — no flags, exactly one host:port.
lane_direct_parse() { # lane_direct_parse <allow|disallow> <args...>
    local cmd="$1"; shift
    LANE_CMD_DIRECT=1
    LANE_CMD_PROFILE=""
    LANE_CMD_DESTS=()
    local arg
    for arg in "$@"; do
        case "$arg" in
            --direct)
                echo "Error: the direct path is already selected; drop --direct." >&2
                lane_cmd_usage "$cmd" 1
                exit 2 ;;
            --http|--https|--proxy)
                echo "Error: $arg is not a $cmd option — protocol flags (--http/--https/--proxy) are not accepted; a port stays in the destination (e.g. egresslock $cmd <profile> example.com:8443) and --direct selects the direct path." >&2
                exit 2 ;;
            -*)
                echo "Error: unknown $cmd option '$arg' (the direct path takes no flags)." >&2
                lane_cmd_usage "$cmd" 1
                exit 2 ;;
            *)
                if [[ -z "$LANE_CMD_PROFILE" ]]; then
                    LANE_CMD_PROFILE="$arg"
                else
                    LANE_CMD_DESTS+=("$arg")
                fi ;;
        esac
    done
    if [[ -z "$LANE_CMD_PROFILE" ]]; then
        echo "Error: $cmd requires a profile name." >&2
        lane_cmd_usage "$cmd" 1
        exit 2
    fi
    if (( ${#LANE_CMD_DESTS[@]} == 0 )); then
        echo "Error: $cmd requires a destination." >&2
        lane_cmd_usage "$cmd" 1
        exit 2
    fi
    if (( ${#LANE_CMD_DESTS[@]} > 1 )); then
        echo "Error: $cmd takes exactly one host:port." >&2
        lane_cmd_usage "$cmd" 1
        exit 2
    fi
    validate_host_port "${LANE_CMD_DESTS[0]}"
}

# EGL-365: the direct-lane allow mutation (shared by `allow --direct`,
# `allow-direct`, and the `allow-host` compatibility alias).
direct_allow_mutation() { # direct_allow_mutation <profile> <host:port>
    require_profile "${1:-}" allow
    require_engine
    local profile="$1" entry="${2:-}" conf
    [[ -n "$entry" ]] || {
        echo "Error: the direct path requires a destination." >&2
        lane_cmd_usage allow 1
        exit 2
    }
    validate_host_port "$entry"
    conf="$ENGINE_CONF"
    [[ -f "$conf" ]] || die "direct path: config file missing: $conf"
    lane_disclose_direct "$conf"
    if ! conf_insert_allow_host "$conf" "$profile" "$HOST_ARG" "$PORT_ARG"; then
        echo "entry already present: $HOST_ARG:$PORT_ARG"
    else
        echo "added: rule allow-host $HOST_ARG:$PORT_ARG to $conf"
    fi
    # EGL-18-D2: mutation-time hint, IPv4 only. The
    # remaining footgun after the D3 NO_PROXY union is BAKED env: the
    # pin is in the conf and already in proxy-env output, but a running
    # workload started before the pin does not have it and will still
    # 403 through the proxy path. Hostname pins get no hint (ssh
    # ignores HTTP(S)_PROXY — the ARC-38 case). A duplicate (already
    # present) still hints: the operator may have missed the recreate.
    if cfg_is_ipv4 "$HOST_ARG"; then
        echo "note: IPv4 direct pins are included in proxy-env NO_PROXY; recreate running workloads to pick up the new env." >&2
    fi
    re_ensuring "$profile"
    cmd_ensure "$profile"
}

# EGL-365: the direct-lane disallow mutation (shared by `disallow
# --direct`, `disallow-direct`, and the `disallow-host` compatibility
# alias). Keeps the EGL-139/EGL-305 fail-closed revocation path intact.
direct_disallow_mutation() { # direct_disallow_mutation <profile> <host:port>
    require_profile "${1:-}" disallow
    require_engine
    local profile="$1" entry="${2:-}" conf
    [[ -n "$entry" ]] || {
        echo "Error: the direct path requires a destination." >&2
        lane_cmd_usage disallow 1
        exit 2
    }
    validate_host_port "$entry"
    conf="$ENGINE_CONF"
    [[ -f "$conf" ]] || die "direct path: config file missing: $conf"
    # EGL-139-D2: the post-condition is provable flow severance, so the
    # whole mutation is gated fail-closed:
    #   1. absent rule -> the named no-op (rc 1, nothing touched);
    #   2. conntrack probe BEFORE the conf mutation — missing/failing
    #      tooling aborts with nothing changed (R9);
    #   3. the revoked pin's live daddr is captured from the chain
    #      BEFORE the conf line is gone.
    if ! conf_has_allow_host "$conf" "$profile" "$HOST_ARG" "$PORT_ARG"; then
        echo "Error: rule not present in profile '$profile': rule allow-host $HOST_ARG:$PORT_ARG (direct path)" >&2
        exit 1
    fi
    conntrack_probe || exit 1
    # EGL-219-D1/D9: the revoked pin's whole live daddr SET (the pin record
    # sizes the positional zip; an unreadable/missing record dies named
    # BEFORE the conf mutation).
    local pin_ips
    pin_ips="$(live_pin_daddr "$profile" "$HOST_ARG" "$PORT_ARG")"
    # EGL-296: live_pin_daddr already refuses when the chain disagrees
    # with the record, so the guard below is defense-in-depth (EGL-139-D2
    # step 3). EGL-295: the reconcile below reads the post-swap chain
    # directly, so it still severs the rule's earlier-address entries.
    # EGL-305: arm the partial-failure profile BEFORE the conf delete
    # (EGL-305-D6) plus this command's own EXIT trap — the
    # delete/reload/re_ensuring window is closed. The trap stays silent
    # until CONF_DELETED_COMMITTED=1 and then restores the rule or names
    # the partial state; cmd_ensure replaces the trap at entry. Only
    # shell statements between the arm and the delete, plus the EGL-480
    # pending-revocation record write (die-or-succeed; it never replaces
    # the EXIT trap and never calls cmd_ensure).
    DISALLOW_HOST_CTX="$profile"
    DISALLOW_HOST_HOST="$HOST_ARG"
    DISALLOW_HOST_PORT="$PORT_ARG"
    DISALLOW_HOST_CONF="$conf"
    # EGL-460: carry the pre-delete witness into cmd_ensure's flush step.
    # After the swap the revoked rule is gone from the chain and the pin
    # record has been rewritten, so this scope cannot be recomputed there.
    DISALLOW_HOST_PIN_IPS="$pin_ips"
    trap 'disallow_host_failure_disclose "$?"' EXIT
    # EGL-480-D2: record the pending revocation BEFORE the conf delete
    # so an interruption anywhere after this point is recoverable (the
    # scope cannot be recomputed once the rule/record are rewritten).
    # Same-key writes union; DISALLOW_HOST_PIN_IPS becomes the union so
    # this run's flush/confirmation cover earlier members too. A write
    # failure dies named with nothing mutated (the trap unwinds).
    revoke_pending_write "$profile" "$HOST_ARG" "$PORT_ARG" "$pin_ips"
    if ! conf_delete_allow_host "$conf" "$profile" "$HOST_ARG" "$PORT_ARG"; then
        echo "Error: rule not present in profile '$profile': rule allow-host $HOST_ARG:$PORT_ARG (direct path)" >&2
        exit 1
    fi
    lane_disclose_direct "$conf"
    re_ensuring "$profile"
    # EGL-460-D2: cmd_ensure now runs the member flush + post-swap port
    # reconcile itself, between the nft/pin commit and the gateway
    # converge. The revocation's severance therefore no longer waits for
    # (or can be blocked by) the gateway apply. The success line stays
    # last, after cmd_ensure returned with every member proven or kept
    # and the reconcile proved clean.
    cmd_ensure "$profile"
    # EGL-460-D6: cmd_ensure returning 0 already implies the
    # post-verification confirmation returned clean; assert the route
    # before the tail's clears so a future edit cannot print `removed:`
    # from an unconfirmed run (a flag test is not fallible work).
    (( DISALLOW_HOST_KILL_PROVEN )) \
        || die "internal: direct-lane revocation returned without the post-verification confirmation (the kill is not proven)"
    # EGL-460: no fallible work remains between cmd_ensure's success and
    # `removed:`; the ensure trap already disarmed on success.
    trap - EXIT
    DISALLOW_HOST_CTX="" # success continuation: every member proven or kept and the post-swap reconcile proved (EGL-307/EGL-354)
    DISALLOW_HOST_PIN_IPS=""
    DISALLOW_HOST_FLUSH_PROVEN=0
    DISALLOW_HOST_POLICY_VERIFIED=0
    DISALLOW_HOST_KILL_PROVEN=0
    conf_deleted_preimage_cleanup
    echo "removed: rule allow-host $HOST_ARG:$PORT_ARG from $conf"
}

# EGL-392: proxy allow source-transaction helpers. The source bytes are
# copied to a private 0700 stage under the source parent, checked and
# extended there, then committed with a same-filesystem `mv -T`. A
# pre-commit failure leaves the source alone; a successful rename is the
# commit point (the later apply is a separate operation).
allow_stage_cleanup() { # remove ALLOW_STAGE_DIR; rc 0 when absent/removed
    [[ -n "$ALLOW_STAGE_DIR" ]] || return 0
    if rm -rf -- "$ALLOW_STAGE_DIR" 2>/dev/null; then
        ALLOW_STAGE_DIR=""
        return 0
    fi
    return 1
}

allow_stage_warn_cleanup() { # <pre-commit|committed|ambiguous> — honest cleanup warning
    case "$1" in
        committed)
            echo "warning: the allowlist was replaced, but the private staging directory $ALLOW_STAGE_DIR could not be removed (it holds no policy state; delete it by hand)" >&2 ;;
        pre-commit)
            echo "warning: the allowlist was not changed, but the private staging directory $ALLOW_STAGE_DIR could not be removed (it holds no policy state; delete it by hand)" >&2 ;;
        *)
            echo "warning: the private staging directory $ALLOW_STAGE_DIR could not be removed; the source may or may not have been replaced — inspect it before retrying (it holds no policy state; delete it by hand)" >&2 ;;
    esac
}

allow_stage_exit() { # EXIT trap — best-effort cleanup keeps the original rc
    local rc=$?
    if ! allow_stage_cleanup; then
        # A failure after the rename but before the traps clear must not
        # claim the source is unchanged.
        if (( ${ALLOW_STAGE_COMMITTED:-0} )); then
            allow_stage_warn_cleanup committed
        else
            allow_stage_warn_cleanup pre-commit
        fi
    fi
    exit "$rc"
}

allow_stage_signal() { # <exit-code> — TERM/HUP/INT during staging
    local rc="$1"
    trap - EXIT INT HUP TERM XFSZ
    if ! allow_stage_cleanup; then
        # A signal can land after the rename; do not claim the source is
        # unchanged when the commit outcome is ambiguous.
        if (( ${ALLOW_STAGE_COMMITTED:-0} )); then
            allow_stage_warn_cleanup committed
        else
            allow_stage_warn_cleanup ambiguous
        fi
    fi
    exit "$rc"
}

allow_entry_present() { # <file> <entry> — 0 present, 1 absent, 2 read/match error
    local rc=0
    grep -qxF -- "$2" "$1" 2>/dev/null || rc=$?
    case "$rc" in
        0) return 0 ;;
        1) return 1 ;;
        *) return 2 ;;
    esac
}

allow_last_byte_newline() { # <file> — 0 final byte is LF, 1 not, 2 read error
    local hex rc=0
    hex="$(tail -c 1 -- "$1" | od -An -tx1)" || rc=$?
    (( rc == 0 )) || return 2
    hex="${hex//[[:space:]]/}"
    [[ "$hex" == "0a" ]]
}

cmd_allow() {
    # EGL-365: one verb; the default lane for a NAME is the proxy,
    # independent of port. --direct selects the direct firewall lane.
    lane_cmd_parse allow "$@"
    require_profile "$LANE_CMD_PROFILE" allow
    require_engine
    if (( LANE_CMD_DIRECT )); then
        direct_allow_mutation "$LANE_CMD_PROFILE" "${LANE_CMD_DESTS[0]}"
        return 0
    fi
    local profile="$LANE_CMD_PROFILE" e src
    src="$(allowlist_src "$profile")"
    # R-007-1 finding 5: never silently create the allowlist file. A
    # typo'd gateway path in the config would fail ensure closed; `allow`
    # must not heal that by inventing the file.
    [[ -f "$src" ]] || die "proxy path: allowlist file missing: $src (check the profile's 'gateway' directive)"
    lane_disclose_proxy "$src"
    # EGL-392-D2: decide whether a rewrite is needed from the source.
    # A clean no-op performs the full read check below and does NOT write
    # (or need source/parent write permission). When a rewrite is needed
    # the decision is repeated against the checked staged copy.
    local rc=0 need_rewrite=0
    if [[ -s "$src" ]]; then
        allow_last_byte_newline "$src" || rc=$?
        case "$rc" in
            0) ;;
            1) need_rewrite=1 ;;
            *) die "cannot read the last byte of $src (the allowlist was not changed)" ;;
        esac
    fi
    for e in "${LANE_CMD_DESTS[@]}"; do
        rc=0
        allow_entry_present "$src" "$e" || rc=$?
        case "$rc" in
            0) ;;
            1) need_rewrite=1 ;;
            *) die "cannot read $src (the allowlist was not changed)" ;;
        esac
    done

    if (( ! need_rewrite )); then
        # D2: a quiet exact-line match can stop before a later read
        # error, so a clean no-op still proves a complete source read.
        cat -- "$src" > /dev/null || die "cannot read $src (the allowlist was not changed)"
        for e in "${LANE_CMD_DESTS[@]}"; do
            echo "entry already present: $e"
        done
        # EGL-365-D8: advice after the entry lines, before re_ensuring.
        for e in "${LANE_CMD_DESTS[@]}"; do
            lane_port_hint "$profile" "$e"
        done
        re_ensuring "$profile"
        cmd_ensure "$profile"
        return 0
    fi

    # EGL-392-D4: only a regular 0600 source is rewritten. Refuse every
    # other mode and every symlink BEFORE staging; the source bytes,
    # mode, owner and ACLs stay untouched. No chmod of the operator's
    # existing file.
    [[ -L "$src" ]] && die "cannot rewrite $src: it is a symbolic link, and proxy allow replaces a regular 0600 allowlist only; edit the file it points to by hand while no egresslock command is running, then run: egresslock ensure $profile"
    local src_mode src_uid src_gid
    src_mode="$(stat -c %a -- "$src" 2>/dev/null)" || die "cannot inspect the mode of $src (the allowlist was not changed)"
    if [[ "$src_mode" != "600" ]]; then
        die "cannot rewrite $src: its mode is $src_mode, not 0600, and proxy allow replaces a regular 0600 allowlist only; run: chmod 600 -- $src
then retry the same egresslock allow command"
    fi
    [[ -w "$src" ]] || die "cannot write $src (the allowlist is not writable by this account)"
    src_uid="$(stat -c %u -- "$src" 2>/dev/null)" || die "cannot inspect the owner of $src (the allowlist was not changed)"
    src_gid="$(stat -c %g -- "$src" 2>/dev/null)" || die "cannot inspect the group of $src (the allowlist was not changed)"

    # D2: a securely created, verified operator-owned 0700 directory
    # under the source parent keeps even an inherited/default-ACL-bearing
    # candidate away from other users while it is staged.
    local stage_dir candidate st_meta
    stage_dir="$(mktemp -d -- "${src}.egresslock-stage.XXXXXX")" \
        || die "cannot create temp staging directory next to $src (the allowlist was not changed)"
    ALLOW_STAGE_DIR="$stage_dir"
    ALLOW_STAGE_COMMITTED=0
    trap 'allow_stage_exit' EXIT
    trap 'allow_stage_signal 130' INT
    trap 'allow_stage_signal 129' HUP
    trap 'allow_stage_signal 143' TERM
    st_meta="$(stat -c '%a|%u' -- "$stage_dir" 2>/dev/null)" \
        || die "cannot inspect the private staging directory $stage_dir (the allowlist was not changed)"
    if [[ "$st_meta" != "700|$(id -u)" ]]; then
        die "private staging directory $stage_dir is not an owner-only 0700 directory (found $st_meta; the allowlist was not changed)"
    fi
    candidate="$stage_dir/candidate"
    (umask 077; : > "$candidate") \
        || die "cannot create the staged allowlist in $stage_dir (the allowlist was not changed)"
    # A parent default ACL can make the new file's group class carry the
    # inherited mask even under umask 077; the private 0700 stage already
    # blocks traversal, and this immediate chmod 600 clears the group and
    # other classes for the whole staging lifetime.
    chmod 600 -- "$candidate" 2>/dev/null \
        || die "cannot set 0600 on the staged allowlist (the allowlist was not changed)"
    [[ "$(stat -c %a -- "$candidate" 2>/dev/null)" == "600" ]] \
        || die "cannot keep the staged allowlist at 0600 (the allowlist was not changed)"

    # D2: a copy larger than RLIMIT_FSIZE, or an added line/heal that
    # crosses it, must fail through the checked path rather than kill the
    # shell. Ignoring SIGXFSZ turns cat/shell-builtin writes into EFBIG
    # (rc 1); the trap is removed before any later command.
    trap '' XFSZ
    if ! cat -- "$src" > "$candidate"; then
        trap - XFSZ
        die "cannot copy $src into the private staging directory (the allowlist was not changed)"
    fi
    # BUG-002: a file not ending in a newline (a starter shipped without
    # one, or a truncated file) would glue the first entry onto the last
    # line, silently dropping it (gw_allowlist_entries strips from the
    # first '#'); `allow` would report added but it would never apply.
    # Write exactly ONE newline, in this same transaction. This heals
    # truncation but does NOT un-glue an entry already fused to a comment
    # line (BUG-002-D1). The probe is byte-safe: command substitution
    # would drop a final NUL byte.
    if [[ -s "$candidate" ]]; then
        rc=0
        allow_last_byte_newline "$candidate" || rc=$?
        case "$rc" in
            0) ;;
            1) if ! printf '\n' >> "$candidate"; then
                   trap - XFSZ
                   die "cannot write the staged allowlist for $src (the allowlist was not changed)"
               fi ;;
            *) trap - XFSZ
               die "cannot read the staged copy of $src (the allowlist was not changed)" ;;
        esac
    fi
    # D3: buffer entry lines until the source commit; match against the
    # checked copy so a duplicate detects the source and earlier argv.
    local -a result_lines=()
    for e in "${LANE_CMD_DESTS[@]}"; do
        rc=0
        allow_entry_present "$candidate" "$e" || rc=$?
        case "$rc" in
            0) result_lines+=("entry already present: $e") ;;
            1) if ! printf '%s\n' "$e" >> "$candidate"; then
                   trap - XFSZ
                   die "cannot write the staged allowlist for $src (the allowlist was not changed)"
               fi
               result_lines+=("added: $e to $src") ;;
            *) trap - XFSZ
               die "cannot read the staged copy of $src (the allowlist was not changed)" ;;
        esac
    done
    trap - XFSZ

    # D4: preserve the source uid/gid and exact numeric mode 0600, then
    # verify all three on the candidate immediately before the rename.
    chown -- "$src_uid:$src_gid" "$candidate" 2>/dev/null \
        || die "cannot preserve the owner and group of $src on the staged copy (the allowlist was not changed)"
    chmod 600 -- "$candidate" 2>/dev/null \
        || die "cannot set 0600 on the staged copy of $src (the allowlist was not changed)"
    st_meta="$(stat -c '%a|%u|%g' -- "$candidate" 2>/dev/null)" \
        || die "cannot inspect the staged copy of $src (the allowlist was not changed)"
    if [[ "$st_meta" != "600|$src_uid|$src_gid" ]]; then
        die "cannot verify the staged copy's metadata for $src (found $st_meta; the allowlist was not changed)"
    fi

    # D2: never move into a directory and never follow a late symlink.
    if [[ -L "$src" || -d "$src" || ! -e "$src" ]]; then
        die "cannot replace $src: it changed shape before the commit (the allowlist was not changed)"
    fi
    if ! mv -T -- "$candidate" "$src"; then
        die "cannot replace $src with the staged allowlist (the rename failed or was interrupted; inspect the file before retrying)"
    fi
    ALLOW_STAGE_COMMITTED=1

    # The rename is the source commit. A stage-directory cleanup failure
    # is a warning, not a claim that the source is unchanged; the entry
    # lines and the ordinary apply tail still follow.
    if ! allow_stage_cleanup; then
        allow_stage_warn_cleanup committed
    fi
    ALLOW_STAGE_DIR=""
    trap - EXIT INT HUP TERM XFSZ

    local line
    for line in "${result_lines[@]}"; do
        echo "$line"
    done
    # EGL-365-D8: advice after the entry lines, before re_ensuring.
    for e in "${LANE_CMD_DESTS[@]}"; do
        lane_port_hint "$profile" "$e"
    done
    re_ensuring "$profile"
    cmd_ensure "$profile"
}

# EGL-402: proxy disallow staging-window helpers (design D3/D4). The
# stage is a verified owner-only 0700 directory beside the source; its
# cleanup is part of the staging window, and the composed EXIT trap then
# hands off to the EGL-389 source/apply disclosure (which owns every
# claim about whether the source was replaced).
disallow_stage_cleanup() { # remove DISALLOW_STAGE_DIR; rc 0 when absent/removed
    [[ -n "$DISALLOW_STAGE_DIR" ]] || return 0
    if rm -rf -- "$DISALLOW_STAGE_DIR" 2>/dev/null; then
        DISALLOW_STAGE_DIR=""
        return 0
    fi
    return 1
}

disallow_stage_warn() { # S3 — neutral; the exit code is unchanged
    echo "warning: the private staging directory $DISALLOW_STAGE_DIR could not be removed (it holds no policy state; delete it by hand once no egresslock command is running); inspect the allowlist before retrying" >&2
}

disallow_stage_exit() { # EXIT trap — stage cleanup, then the EGL-389 disclosure
    local rc=$?
    set +e
    if ! disallow_stage_cleanup; then
        disallow_stage_warn
    fi
    disallow_proxy_failure_disclose "$rc"
    exit "$rc"
}

cmd_disallow() {
    # EGL-365: lane-scoped removal. Same --direct flag; no cross-lane
    # search. Proxy removal is ARC-30/ARC-46 exact-match, atomic rewrite.
    lane_cmd_parse disallow "$@"
    require_profile "$LANE_CMD_PROFILE" disallow
    require_engine
    if (( LANE_CMD_DIRECT )); then
        direct_disallow_mutation "$LANE_CMD_PROFILE" "${LANE_CMD_DESTS[0]}"
        return 0
    fi
    local profile="$LANE_CMD_PROFILE" e src
    src="$(allowlist_src "$profile")"
    [[ -f "$src" ]] || die "proxy path: allowlist file missing: $src (check the profile's 'gateway' directive)"
    for e in "${LANE_CMD_DESTS[@]}"; do
        if ! grep -qxF "$e" "$src"; then
            echo "Error: entry not present: $e (proxy path)" >&2
            exit 1
        fi
    done
    # EGL-402-D1: a rewrite replaces only a regular allowlist. Refuse a
    # symlink BEFORE the mode stat, stage, backup or rename; the link,
    # its referent and the profile stay untouched. The missing-file and
    # entry-not-present refusals above are read-only and stay first (an
    # absent entry through a link still errors as before; a dangling
    # link still takes the missing-file refusal).
    if [[ -L "$src" ]]; then
        die "cannot rewrite $src: it is a symbolic link; proxy disallow rewrites a regular allowlist file only. Nothing was changed.
  fix: edit the file the link points to by hand while no egresslock command is running, then run: egresslock ensure $profile"
    fi
    # EGL-402-D2: preserve the exact numeric mode only when the group
    # class is no wider than the other class. `chmod` sets the POSIX ACL
    # mask to the group class, so a wider group class can activate a named
    # entry inherited from the parent directory's default ACL. Read all
    # three metadata values up front (a stat failure is named, never
    # defaulted) and do not normalize the mode.
    local src_mode src_uid src_gid
    src_mode="$(stat -c %a -- "$src" 2>/dev/null)" \
        || die "cannot inspect the mode of $src (the allowlist was not changed)"
    src_uid="$(stat -c %u -- "$src" 2>/dev/null)" \
        || die "cannot inspect the owner of $src (the allowlist was not changed)"
    src_gid="$(stat -c %g -- "$src" 2>/dev/null)" \
        || die "cannot inspect the group of $src (the allowlist was not changed)"
    if (( (8#$src_mode >> 3 & 7) != (8#$src_mode & 7) )); then
        die "cannot rewrite $src: its mode is $src_mode, and proxy disallow rewrites only a regular allowlist whose group permissions are no wider than its other permissions (for example 0600, 0644, 0400 or 0444). A wider group permission can activate an access entry inherited from the parent directory's default ACL (an extra access list that new files there inherit), which would give another account access the allowlist does not allow; this command does not read ACLs and cannot rule that out. Nothing was changed.
  fix: chmod 600 -- $src
then retry the same egresslock disallow command"
    fi
    # EGL-402-D3: refuse before staging when this account could not have
    # written the source (the allow guard class). An owned read-only
    # source is still replaceable by the same-directory rename, so
    # ownership counts here; a foreign read-only file is refused named.
    if [[ ! -w "$src" && ! -O "$src" ]]; then
        die "cannot write $src (the allowlist is not writable by this account)"
    fi

    # EGL-402-D3: build the replacement in a private 0700 stage beside the
    # source. The candidate (and the snapshot it is filtered from) stays
    # 0600 for the whole content window; only the file that will be
    # renamed gets the source metadata, immediately before `mv -T`.
    local stage_dir snapshot candidate st_meta backup keep=() line a skip
    stage_dir="$(mktemp -d -- "${src}.egresslock-stage.XXXXXX")" \
        || die "cannot create temp staging directory next to $src (the allowlist was not changed)"
    DISALLOW_STAGE_DIR="$stage_dir"
    trap 'disallow_stage_exit' EXIT
    st_meta="$(stat -c '%a|%u' -- "$stage_dir" 2>/dev/null)" \
        || die "cannot inspect the private staging directory $stage_dir (the allowlist was not changed)"
    if [[ "$st_meta" != "700|$(id -u)" ]]; then
        die "private staging directory $stage_dir is not an owner-only 0700 directory (found $st_meta; the allowlist was not changed)"
    fi
    snapshot="$stage_dir/snapshot"
    candidate="$stage_dir/candidate"
    (umask 077; : > "$snapshot") \
        || die "cannot create the staged allowlist in $stage_dir (the allowlist was not changed)"
    chmod 600 -- "$snapshot" 2>/dev/null \
        || die "cannot set 0600 on the staged allowlist (the allowlist was not changed)"
    [[ "$(stat -c %a -- "$snapshot" 2>/dev/null)" == "600" ]] \
        || die "cannot keep the staged allowlist at 0600 (the allowlist was not changed)"
    (umask 077; : > "$candidate") \
        || die "cannot create the staged allowlist in $stage_dir (the allowlist was not changed)"
    chmod 600 -- "$candidate" 2>/dev/null \
        || die "cannot set 0600 on the staged allowlist (the allowlist was not changed)"
    [[ "$(stat -c %a -- "$candidate" 2>/dev/null)" == "600" ]] \
        || die "cannot keep the staged allowlist at 0600 (the allowlist was not changed)"
    if ! cat -- "$src" > "$snapshot"; then
        die "cannot copy $src into the private staging directory (the allowlist was not changed)"
    fi
    # ARC-30-D2: filter from the private snapshot (never re-read the live
    # source for the rewrite bytes).
    while IFS= read -r line || [[ -n "$line" ]]; do
        skip=0
        for a in "${LANE_CMD_DESTS[@]}"; do
            [[ "$line" == "$a" ]] && { skip=1; break; }
        done
        [[ "$skip" == 0 ]] && keep+=("$line")
    done < "$snapshot"
    if (( ${#keep[@]} > 0 )); then
        printf '%s\n' "${keep[@]}" > "$candidate" \
            || die "cannot write the staged allowlist for $src (the allowlist was not changed)"
    else
        : > "$candidate" \
            || die "cannot write the staged allowlist for $src (the allowlist was not changed)"
    fi

    # EGL-402-D2/D3: preserve the exact numeric source mode and uid/gid,
    # then verify all three on the candidate before the rename.
    chown -- "$src_uid:$src_gid" "$candidate" 2>/dev/null \
        || die "cannot preserve the owner and group of $src on the staged copy (the allowlist was not changed)"
    chmod "$src_mode" -- "$candidate" 2>/dev/null \
        || die "cannot set the mode of $src on the staged copy (the allowlist was not changed)"
    st_meta="$(stat -c '%a|%u|%g' -- "$candidate" 2>/dev/null)" \
        || die "cannot inspect the staged copy of $src (the allowlist was not changed)"
    if [[ "$st_meta" != "$src_mode|$src_uid|$src_gid" ]]; then
        die "cannot verify the staged copy's metadata for $src (found $st_meta; the allowlist was not changed)"
    fi

    # EGL-389-D1: freeze the pre-image before the atomic rewrite. A hard
    # link needs no space and keeps the exact inode; the same-directory
    # rename restore is what makes an ordinary failed apply retryable. The
    # trap is armed from the stage on, but the EGL-389 disclosure stays
    # silent until DISALLOW_PROXY_COMMITTED=1.
    backup="${src}.egresslock-disallow-backup.$$"
    [[ -e "$backup" || -L "$backup" ]] && backup="${backup}.${RANDOM}"
    ln "$src" "$backup" || die "cannot back up $src before the rewrite"
    DISALLOW_PROXY_CTX="$profile"
    DISALLOW_PROXY_SRC="$src"
    DISALLOW_PROXY_BACKUP="$backup"
    DISALLOW_PROXY_ENTRIES="${LANE_CMD_DESTS[*]}"
    DISALLOW_PROXY_COMMITTED=0
    # EGL-402-D3: re-check the source shape after the hard-link backup and
    # immediately before the rename, so a late symlink (or directory) is
    # never replaced. The source is unchanged, so the backup is removed
    # and the commit gate stays 0.
    if [[ -L "$src" || -d "$src" || ! -f "$src" ]]; then
        rm -f -- "$backup" 2>/dev/null || true
        DISALLOW_PROXY_CTX=""
        DISALLOW_PROXY_SRC=""
        DISALLOW_PROXY_BACKUP=""
        DISALLOW_PROXY_ENTRIES=""
        die "cannot replace $src: it changed shape before the commit (the allowlist was not changed)"
    fi
    if ! mv -T -- "$candidate" "$src"; then
        die "cannot rewrite $src: the rename failed; the allowlist may be unchanged or already replaced. The previous file is kept at $backup; inspect $src:
  if the revoked entry is still there, retry this command;
  if it is gone, apply the removal by replacing the gateway (this drops every proxied session on the profile): egresslock ensure --replace-gateway $profile
  A plain \"egresslock ensure $profile\" only reloads the running gateway, so established proxied sessions to those destinations may keep running until they close.
  delete $backup when you no longer need it."
    fi
    DISALLOW_PROXY_COMMITTED=1
    # EGL-402-D4: the rename is the source commit. The stage is removed
    # immediately; a cleanup failure is the neutral S3 warning, not a
    # claim about the source, and the apply tail still follows.
    if ! disallow_stage_cleanup; then
        disallow_stage_warn
    fi
    lane_disclose_proxy "$src"
    # EGL-394: revocation must still sever established tunnels, so force
    # the apply's container-restart path; a plain allow/ensure reloads.
    GW_FORCE_RESTART=1
    re_ensuring "$profile"
    cmd_ensure "$profile"
    # EGL-389-D6: success only — clear the recovery context before the
    # success lines. cmd_ensure disarmed its trap on success; no source
    # restore happens after the apply committed.
    DISALLOW_PROXY_CTX=""
    DISALLOW_PROXY_SRC=""
    DISALLOW_PROXY_BACKUP=""
    DISALLOW_PROXY_ENTRIES=""
    DISALLOW_PROXY_COMMITTED=0
    rm -f "$backup" 2>/dev/null || true
    for e in "${LANE_CMD_DESTS[@]}"; do echo "removed: $e from $src"; done
    trap - EXIT
}

cmd_direct_allow() {
    # EGL-365: allow-direct / allow-host (compat) = allow <dest> --direct.
    lane_direct_parse allow "$@"
    direct_allow_mutation "$LANE_CMD_PROFILE" "${LANE_CMD_DESTS[0]}"
}

cmd_direct_disallow() {
    # EGL-365: disallow-direct / disallow-host (compat) =
    # disallow <dest> --direct.
    lane_direct_parse disallow "$@"
    direct_disallow_mutation "$LANE_CMD_PROFILE" "${LANE_CMD_DESTS[0]}"
}

# Same grammar the conf parser enforces for `rule allow-host`: host
# [A-Za-z0-9._-]*, port 1-65535, colon-required, first char alnum or '.'
# (ARC-59-D1). EGL-365: the direct lane has no default port, so a bare
# name is named before the grammar check. Sets HOST_ARG/PORT_ARG;
# argument errors are usage-class (exit 2).
validate_host_port() { # validate_host_port <host:port>
    local entry="$1"
    if [[ "$entry" != *:* ]]; then
        echo "Error: the direct path requires host:port — there is no default port (got '$entry')." >&2
        exit 2
    fi
    # ARC-59-D1: host part starts alnum or '.' — never '-'.
    if [[ ! "$entry" =~ ^\.?[A-Za-z0-9][A-Za-z0-9._-]*:[0-9]+$ ]]; then
        echo "Error: invalid direct entry '$entry' (expected host:port)" >&2
        exit 2
    fi
    HOST_ARG="${entry%:*}"
    PORT_ARG="${entry##*:}"
    # EGL-147-D2: a trailing-dot host in a pin is the same dead-or-
    # surprising shape as in the allowlist — name it (CLI twins the
    # conf parser; the conf must never mint what the CLI rejects).
    if [[ "$HOST_ARG" == *. ]]; then
        echo "Error: host '$HOST_ARG' has a trailing dot — direct entries are bare names" >&2
        exit 2
    fi
    if ! cfg_is_port "$PORT_ARG"; then
        echo "Error: invalid port in direct entry '$entry' (expected 1-65535)" >&2
        exit 2
    fi
    # R-EGL-310-16 F2/F3: accepted spelling, canonical value — every
    # nft/pin/chain/conntrack comparison downstream uses decimal.
    PORT_ARG="$(cfg_port_canon "$PORT_ARG")"
    # ARC-32-D2: same DNS length caps as the conf parser — an
    # allow/disallow --direct must not mint a conf the parser then
    # rejects (that would fail closed at the next load).
    if ! arc32_dns_len_ok "${HOST_ARG#.}"; then
        echo "Error: host '$HOST_ARG' exceeds DNS length limits (host <= 253 bytes, labels <= 63)" >&2
        exit 2
    fi
}

# Escape regex metacharacters for a literal match inside [[ =~ ]].
# R-038-1 finding 2: $host is interpolated into a block-match pattern;
# without escaping, each '.' matches any char, so a near-collision
# host (gitXexample.test vs git.example.test) could falsely match —
# making allow-host a silent no-op or disallow-host delete the wrong
# line. Hosts are [A-Za-z0-9._-]* (start alnum or '.'), so only '.'
# and '-' need escaping.
host_re() { printf '%s' "${1//./\\.}"; }

# EGL-397-D1: a direct rule's identity is the line as the conf parser
# reads it — everything from the first '#' is a comment (load_config's
# `cfg_trim "${raw%%#*}"`), so an inline comment cannot hide an active
# rule from the direct matchers. Comparison-only: callers keep the
# original line bytes for write-back.
#
# R-EGL-397-5 F7: the parsed view is computed IN-PROCESS (parameter
# expansion, no command substitution). The old `$(conf_line_parsed ...)`
# form created a subprocess whose failure was indistinguishable from
# "not a rule" at every caller; a killed parser could then let a partial
# delete report success. There is no comparison subprocess left to fail.
# CONF_LINE_PARSED is the one result slot; the return value is reserved
# for a hard parse error (0 ok), so callers can still fail closed if a
# future parser grows a failure mode.
CONF_LINE_PARSED=""
conf_line_parsed() { # conf_line_parsed <line> — sets CONF_LINE_PARSED
    local s="$1"
    s="${s%%#*}"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    CONF_LINE_PARSED="$s"
    return 0
}

# EGL-397-D1: the one allow-host identity predicate shared by the direct
# insert, delete, and presence matchers so they cannot drift. The parsed
# view is matched against the same block-scoped host spelling and
# decimal-equal (0*) port regex as before; a fully commented-out line
# parses to empty and never matches. rc: 0 match, 1 no match, 2 parse
# failure — callers must treat 2 as a named abort, never as absent.
conf_line_is_allow_host() { # conf_line_is_allow_host <line> <host_port_r>
    conf_line_parsed "$1" || return 2
    [[ "$CONF_LINE_PARSED" =~ ^rule[[:space:]]+allow-host[[:space:]]+$2$ ]]
}

# ARC-38-D3: write a same-dir temp, insert the rule as the LAST line of
# the NAMED profile's block (not EOF — a multi-block conf must not get
# the rule attached to the last block), validate the temp with
# load_config (fail closed -> delete temp, original untouched), then mv
# over the original and reload. Return 0 ok (rule written); 1 already
# present (nothing written).
conf_insert_allow_host() { # conf_insert_allow_host <conf> <profile> <host> <port>
    local conf="$1" profile="$2" host="$3" port="$4"
    local host_r host_port_r
    host_r="$(host_re "$host")"
    host_port_r="${host_r//-/\\-}:0*${port}"
    local rule="    rule allow-host $host:$port"
    local line in_block=0 found_block=0 present=0
    local -a out=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*profile[[:space:]]+([a-z0-9][a-z0-9-]*)[[:space:]]+ ]]; then
            if [[ "$in_block" == 1 && "$found_block" == 1 && "$present" == 0 ]]; then
                out+=("$rule")
            fi
            in_block=0
            if [[ "${BASH_REMATCH[1]}" == "$profile" ]]; then
                in_block=1
                found_block=1
            fi
        elif [[ "$in_block" == 1 ]]; then
            local match_rc=0
            conf_line_is_allow_host "$line" "$host_port_r" || match_rc=$?
            case "$match_rc" in
                0) present=1 ;;
                1) ;;
                *) die "cannot compare the config lines in $conf with the direct rule identity (parser failure); nothing was written — inspect the file, then retry the same command" ;;
            esac
        fi
        out+=("$line")
    done < "$conf"
    if [[ "$in_block" == 1 && "$found_block" == 1 && "$present" == 0 ]]; then
        out+=("$rule")
    fi
    if [[ "$present" == 1 ]]; then
        return 1
    fi
    [[ "$found_block" == 1 ]] || die "internal: profile block '$profile' not found in $conf"
    local tmp
    tmp="$(mktemp "$conf.XXXXXX")" || die "cannot create temp next to $conf"
    chmod "$(stat -c %a "$conf" 2>/dev/null || echo 600)" "$tmp" 2>/dev/null || true
    # EGL-391-D4: this writer runs inside an `if !` caller, so errexit
    # is suppressed; a failed write must die named (never fall through
    # to load_config / the false "invalid config" line / mv). Do not
    # return 1 — that rc already means already-present.
    if ! printf '%s\n' "${out[@]}" > "$tmp"; then
        rm -f "$tmp" 2>/dev/null || true
        die "cannot write the new config next to $conf: the temporary file could not be written; the config was not replaced by this run"
    fi
    if ! ( load_config "$tmp" ) 2>/dev/null; then
        rm -f "$tmp"
        die "direct rule would produce an invalid config; nothing written"
    fi
    mv "$tmp" "$conf" || { rm -f "$tmp"; die "cannot rewrite $conf"; }
    load_config "$conf"
    return 0
}

# ARC-38-D2/D3: delete the exact `rule allow-host <host>:<port>` line
# (optional leading whitespace) inside the named block only. Same
# temp+validate+mv. Return 0 deleted; 1 not present (conf unchanged).
#
# R-EGL-397-5 F3/F4: the delete is a LINE-ADDRESS filter, not a shell
# line-array reserialization. The old `printf '%s\n' "${out[@]}"`
# rewrite added a final newline to an unterminated last line and could
# not carry embedded NULs (Bash strings drop them) — unrelated bytes
# changed on the newly enabled commented-rule path. sed deletes only
# the matched line numbers and copies every other byte through. The
# pre-delete copy is a FILE (`cp`), not a command-substitution string:
# the restore path must return the exact original bytes, NULs included.
conf_delete_allow_host() { # conf_delete_allow_host <conf> <profile> <host> <port>
    local conf="$1" profile="$2" host="$3" port="$4"
    local host_r host_port_r
    host_r="$(host_re "$host")"
    host_port_r="${host_r//-/\\-}:0*${port}"
    local line in_block=0 found=0 lineno=0
    local -a delete_lines=()
    if [[ ! -r "$conf" ]]; then
        die "cannot read config $conf for the direct-rule removal"
    fi
    # EGL-305 / R-EGL-310-19 F2: capture the COMPLETE pre-delete conf for
    # conf_restore_allow_host. Every equivalent spelling is removed, so
    # restoring only the first line would silently lose the others on a
    # pre-swap failure while the disclosure claimed the rule was put
    # back. R-EGL-310-21 F1: a failed capture is a named refusal BEFORE
    # the delete. R-EGL-397-5 F4: the capture is a FILE (redirected
    # `cat`, status checked), not a shell variable — byte-complete,
    # NULs and a missing final newline included.
    local preimage
    preimage="$(mktemp "$conf.XXXXXX")" || die "cannot create temp next to $conf"
    chmod "$(stat -c %a "$conf" 2>/dev/null || echo 600)" "$preimage" 2>/dev/null || true
    if ! cat -- "$conf" > "$preimage" 2>/dev/null; then
        rm -f "$preimage" 2>/dev/null || true
        die "cannot read config $conf completely for the direct-rule removal; nothing was changed — check the file is readable, then retry the same command"
    fi
    # The first pass runs against the captured bytes, so the line
    # numbers used by the delete and the preimage describe one snapshot.
    while IFS= read -r line || [[ -n "$line" ]]; do
        lineno=$((lineno + 1))
        if [[ "$line" =~ ^[[:space:]]*profile[[:space:]]+([a-z0-9][a-z0-9-]*)[[:space:]]+ ]]; then
            in_block=0
            [[ "${BASH_REMATCH[1]}" == "$profile" ]] && in_block=1
        elif [[ "$in_block" == 1 ]]; then
            local match_rc=0
            conf_line_is_allow_host "$line" "$host_port_r" || match_rc=$?
            case "$match_rc" in
                0) found=1; delete_lines+=("$lineno") ;;
                1) ;;
                *) rm -f "$preimage" 2>/dev/null || true
                   die "cannot compare the config lines in $conf with the direct rule identity (parser failure); nothing was changed — inspect the file, then retry the same command" ;;
            esac
        fi
    done < "$preimage"
    CONF_DELETED_COMMITTED=0
    if [[ "$found" != 1 ]]; then
        rm -f "$preimage" 2>/dev/null || true
        return 1
    fi
    local tmp
    tmp="$(mktemp "$conf.XXXXXX")" || { rm -f "$preimage" 2>/dev/null || true; die "cannot create temp next to $conf"; }
    chmod "$(stat -c %a "$conf" 2>/dev/null || echo 600)" "$tmp" 2>/dev/null || true
    local -a sed_args=()
    local n
    for n in "${delete_lines[@]}"; do sed_args+=(-e "${n}d"); done
    # EGL-391-D4: die named on a failed write (never return 1 — that rc
    # already means not-present and the caller would treat it as a no-op).
    if ! sed "${sed_args[@]}" -- "$preimage" > "$tmp"; then
        rm -f "$tmp" "$preimage" 2>/dev/null || true
        die "cannot write the new config next to $conf: the temporary file could not be written; the config was not replaced by this run"
    fi
    if ! ( load_config "$tmp" ) 2>/dev/null; then
        rm -f "$tmp" "$preimage" 2>/dev/null || true
        die "direct-rule removal would produce an invalid config; nothing written"
    fi
    mv "$tmp" "$conf" || { rm -f "$tmp" "$preimage" 2>/dev/null || true; die "cannot rewrite $conf"; }
    # EGL-305: the delete is committed — the cmd_disallow_host EXIT
    # trap now owns the window until cmd_ensure arms its own trap.
    CONF_DELETED_PREIMAGE_FILE="$preimage"
    CONF_DELETED_COMMITTED=1
    load_config "$conf"
    return 0
}

# R-EGL-397-5 F4: drop the pre-delete copy once it can no longer be
# needed (successful revocation, or after the trap restored/disclosed).
# Die-free: it runs from EXIT-trap context.
conf_deleted_preimage_cleanup() {
    if [[ -n "$CONF_DELETED_PREIMAGE_FILE" ]]; then
        rm -f -- "$CONF_DELETED_PREIMAGE_FILE" 2>/dev/null || true
        CONF_DELETED_PREIMAGE_FILE=""
    fi
    return 0
}

# EGL-305 / R-EGL-310-19 F2: restore the COMPLETE pre-delete conf so the
# pre-command state comes back byte-for-byte — including every equivalent
# spelling line the canonical-port matcher removed. Never dies (it runs
# from the ensure EXIT trap): every failure returns 1. Same conf-RMW
# temp+validate+mv pattern as conf_delete_allow_host, die-free.
conf_restore_allow_host() { # conf_restore_allow_host <conf> -> rc
    local conf="$1" tmp
    [[ -f "$conf" ]] || return 1
    [[ -n "$CONF_DELETED_PREIMAGE_FILE" && -f "$CONF_DELETED_PREIMAGE_FILE" ]] || return 1
    tmp="$(mktemp "$conf.XXXXXX" 2>/dev/null)" || return 1
    chmod "$(stat -c %a "$conf" 2>/dev/null || echo 600)" "$tmp" 2>/dev/null || true
    if ! cp -- "$CONF_DELETED_PREIMAGE_FILE" "$tmp" 2>/dev/null; then
        rm -f "$tmp"; return 1
    fi
    if ! ( load_config "$tmp" ) 2>/dev/null; then
        rm -f "$tmp"
        return 1
    fi
    mv "$tmp" "$conf" 2>/dev/null || { rm -f "$tmp"; return 1; }
    return 0
}

# EGL-139-D2: presence pre-check with the SAME block-scoped regex
# conf_delete_allow_host matches (no mutation). Keeps the absent-rule
# rejection (rc 1, "rule not present", no ensure) independent of the
# conntrack probe: absent rules keep the exact no-op semantics, present
# rules fail closed at the probe.
conf_has_allow_host() { # conf_has_allow_host <conf> <profile> <host> <port>
    local conf="$1" profile="$2" host="$3" port="$4"
    local host_r host_port_r
    host_r="$(host_re "$host")"
    host_port_r="${host_r//-/\\-}:0*${port}"
    local line in_block=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*profile[[:space:]]+([a-z0-9][a-z0-9-]*)[[:space:]]+ ]]; then
            in_block=0
            [[ "${BASH_REMATCH[1]}" == "$profile" ]] && in_block=1
        elif [[ "$in_block" == 1 ]]; then
            local match_rc=0
            conf_line_is_allow_host "$line" "$host_port_r" || match_rc=$?
            case "$match_rc" in
                0) return 0 ;;
                1) ;;
                *) die "cannot compare the config lines in $conf with the direct rule identity (parser failure); nothing was changed — inspect the file, then retry the same command" ;;
            esac
        fi
    done < "$conf"
    return 1
}

# EGL-317 (ER-EGL-305-3 F1): operator recovery for a disallow-host that
# failed after the ruleset swap. Ends leftover connections on the revoked
# port that the live policy no longer allows — the success path's
# selection model, shared through reconcile_port_live (earlier DNS
# addresses, accepted destinations, gateway-source rows, peer direction)
# — and prints the completion line only after a fresh witness pass finds
# no targeted residue. Safe to repeat; conntrack only; account-locked.
cmd_drop_unauthorized() {
    require_profile "${1:-}" drop-unauthorized
    require_engine
    local profile="$1" port="${2:-}"
    [[ -n "$port" ]] || {
        echo "Error: drop-unauthorized requires a port." >&2
        echo "usage: egresslock drop-unauthorized <profile> <port>" >&2
        exit 2
    }
    if [[ $# -gt 2 ]]; then
        echo "Error: drop-unauthorized takes exactly one port." >&2
        echo "usage: egresslock drop-unauthorized <profile> <port>" >&2
        exit 2
    fi
    if ! cfg_is_port "$port"; then
        echo "Error: invalid port '$port' (expected 1-65535)." >&2
        exit 2
    fi
    # R-EGL-310-16 F3: conntrack/nft text is canonical decimal; normalize
    # the accepted leading-zero spelling so the readback, deletes, and
    # survivor witness all name the same port.
    port="$(cfg_port_canon "$port")"
    reconcile_port_live "$profile" "$port" "" 1 "egresslock drop-unauthorized $profile $port"
    echo "drop-unauthorized: no leftover connection on port $port remains that profile '$profile' does not allow"
}

# ARC-35-D3: is a CIDR taken by (a) a `profile <name> <cidr>` line in a
# sibling *.conf in $dest or (b) a Podman network this user can see?
# Scans are tolerant (cidr_parse_any) so a foreign subnet that the
# profile policy would reject is still treated as a collision.
init_cidr_taken() { # init_cidr_taken <cidr> <dest> <podman-network-names>
    local cidr="$1" dest="$2" names="${3-}" f line scidr name info sub
    cidr_parse "$cidr" || return 1
    local wfirst=$CIDR_FIRST wlast=$CIDR_LAST
    for f in "$dest"/*.conf; do
        [[ -f "$f" ]] || continue
        while IFS= read -r line; do
            if [[ "$line" =~ ^[[:space:]]*profile[[:space:]]+([a-z0-9][a-z0-9-]*)[[:space:]]+([0-9.]+/[0-9]+) ]]; then
                scidr="${BASH_REMATCH[2]}"
                if cidr_parse_any "$scidr" \
                   && cidr_overlaps "$wfirst" "$wlast" "$CIDR_FIRST" "$CIDR_LAST"; then
                    return 0
                fi
            fi
        done < "$f"
    done
    # EGL-383: the caller lists Podman networks once (cmd_init refuses on
    # a failed list) and passes the names in, so this scan never claims an
    # unchecked CIDR and auto-pick no longer walks 256 failing lists.
    for name in $names; do
        info="$(rt_network_inspect "$name" 2>/dev/null || true)"
        while IFS= read -r sub; do
            [[ -n "$sub" ]] || continue
            if cidr_parse_any "$sub" \
               && cidr_overlaps "$wfirst" "$wlast" "$CIDR_FIRST" "$CIDR_LAST"; then
                return 0
            fi
        done < <(grep -oE '"subnet": *"[^"]+"' <<<"$info" | sed -E 's/"subnet": *"([^"]+)"/\1/')
    done
    return 1
}

# ARC-35-D3: next free /24 in 10.199.0.0/16 (the example range), starting
# at 10.199.0.0/24, skipping any CIDR init_cidr_taken reports.
init_pick_subnet() { # init_pick_subnet <dest> <podman-network-names> -> cidr or non-zero
    local dest="$1" names="${2-}" i cidr
    for (( i=0; i<=255; i++ )); do
        cidr="10.199.$i.0/24"
        if ! init_cidr_taken "$cidr" "$dest" "$names"; then
            echo "$cidr"
            return 0
        fi
    done
    return 1
}

# ARC-35: `init <name> [--subnet <cidr>]` — write a starter conf+allowlist
# pair for a NEW profile, as the account. NOT a load_config subcommand
# (it is a file-writer, not a profile operation). Subject to the ARC-25
# root guard (enforced in main). Never overwrites; never ensures.
cmd_init() {
    local name="" subnet="" arg
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --subnet) [[ $# -ge 2 ]] || { echo "Error: --subnet requires a CIDR." >&2; exit 2; }
                       subnet="$2"; shift 2 ;;
            --subnet=*) subnet="${1#--subnet=}"; shift ;;
            --*)       echo "Error: unknown init option '$1'." >&2; exit 2 ;;
            *)         if [[ -z "$name" ]]; then name="$1"; else
                           echo "Error: init takes one profile name." >&2; exit 2
                       fi
                       shift ;;
        esac
    done
    [[ -n "$name" ]] || {
        echo "Error: init requires a profile name." >&2
        echo "usage: egresslock init <name> [--subnet <cidr>]" >&2
        exit 2
    }
    [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || {
        echo "Error: invalid profile name '$name' (expected [a-z0-9][a-z0-9-]*, must not start with '-')." >&2
        exit 2
    }
    # EGL-380: 'all' is the teardown keyword — refuse before the dest
    # exists check so no conf/allowlist pair can be minted for it.
    [[ "$name" != "all" ]] || {
        echo "Error: profile name 'all' is reserved ('teardown all' names the main profile); choose another name." >&2
        exit 2
    }

    # Dest dir: the account confdir (EGL-325) — init is a writer and
    # works even when no config exists yet.
    local dest
    dest="$(confdir_default)" || exit 1
    mkdir -p -m 700 "$dest" || die "cannot create $dest"
    local conf_path="$dest/$name.conf" al_path="$dest/$name-allowlist"
    if [[ -e "$conf_path" || -e "$al_path" ]]; then
        echo "Error: '$name' already exists ($conf_path or $al_path); init never overwrites." >&2
        echo "  to replace it, teardown + archive the pair first (see the policy reference's profile lifecycle)." >&2
        exit 1
    fi

    # Subnet: explicit --subnet (validated strict + overlap) or auto-pick.
    local cidr=""
    if [[ -n "$subnet" ]]; then
        cidr_parse "$subnet" || {
            echo "Error: invalid --subnet '$subnet' (expected IPv4 CIDR, prefixlen 8-29, canonical network address)." >&2
            exit 2
        }
        cidr="$subnet"
    fi

    # EGL-383 / ARC-67-D3: list Podman networks ONCE here. A failed list
    # must refuse with the same diagnosis `ensure` gives (never "taken"
    # silently, never "no free /24" or "overlap") before any CIDR
    # selection and before either file is written.
    local net_names
    if ! net_names="$(podman_network_names 2>&1)"; then
        die "cannot list Podman networks; the subnet-overlap pre-check cannot run (fail closed): $net_names"
    fi

    if [[ -n "$subnet" ]]; then
        if init_cidr_taken "$cidr" "$dest" "$net_names"; then
            echo "Error: --subnet $subnet overlaps an existing profile/network." >&2
            exit 1
        fi
    else
        cidr="$(init_pick_subnet "$dest" "$net_names")" || {
            echo "Error: no free /24 in 10.199.0.0/16; pass --subnet explicitly." >&2
            exit 1
        }
    fi

    cidr_parse "$cidr" || die "internal: picked subnet invalid"
    local gw
    gw="$(cidr_ip "$(( CIDR_FIRST + 1 ))")"   # .2 on a /24

    # Write under a restrictive umask so the pair is never observable as
    # 0644 before the chmod lands (R-035-1 note 3 follow-up); chmod 600
    # remains the authoritative mode.
    ( umask 077
      {
        echo "# $name.conf — starter for profile '$name' (egresslock init)."
        echo "# Fail-closed: empty allowlist, gateway-only."
        echo "# Grow with: egresslock allow $name <host[:port]>"
        echo "profile $name $cidr"
        echo "    rule gateway-only"
        echo "    gateway $gw 3128 $name-allowlist"
      } > "$conf_path"
      : > "$al_path" )
    chmod 600 "$conf_path" "$al_path" 2>/dev/null || true
    echo "init: wrote $conf_path"
    echo "init: wrote $al_path (empty allowlist — deny all)"
    echo "init: next: egresslock ensure $name"
}

cmd_list() {
    # ARC-11-D5: name, network, subnet. No creds= column — that was site
    # credential policy, not engine network state (removed ARC-11).
    # Headers keep bare `list` output self-describing.
    printf '%-14s %-22s %-16s\n' "NAME" "NETWORK" "SUBNET"
    local p
    for p in "${PROFILES[@]}"; do
        printf '%-14s %-22s %-16s\n' \
            "$p" "$(network_of "$p")" "${PROFILE_SUBNET[$p]}"
    done
}

# ARC-60-D1: `teardown --runtime` — the no-conf runtime sweep. The
# dispatcher skips resolution for this form. As the account, name-scan
# THIS store and remove kit-owned objects (ARC-68-D1: egresslock-only):
#   container: ^egresslock-(gateway|anchor)-[a-z0-9-]+$
#   network:   ^egresslock-[a-z0-9-]+$
# Never non-kit names or images. Containers first (so networks can go),
# then networks, then the `inet egresslock` nft table (ARC-66-D4).
# EGL-438-D1/D2: every listing is observed. A complete sweep of an empty
# store is rc 0 and one `no kit runtime` line; a failed listing sets the
# aggregator's `listings_ok=0`, prints one `incomplete sweep` line, and
# exits 1 — only a complete sweep may claim `no kit runtime`.
# Sweep 1 of cmd_teardown_runtime (EGL-182-D1): kit-named containers.
# Callers share the aggregator's `found` and `listings_ok` via dynamic
# scope; ARC-69-D1: `removed` only after a successful rm (closes the
# R-060-1 O2 blind echo); a failed rm is one honest note (rc 0).
teardown_runtime_containers() {
    if ! names="$(rt_ps all 2>/dev/null)"; then
        echo "note: could not list Podman containers; kit-named containers were NOT swept (remove them manually: podman ps -a, then podman rm -f <name>)"
        listings_ok=0
    else
        for name in $names; do
            [[ "$name" =~ ^egresslock-(gateway|anchor)-[a-z0-9-]+$ ]] || continue
            if rt_rm "$name" >/dev/null 2>&1; then
                echo "removed container $name"
                found=1
            else
                echo "note: could not remove container $name"
            fi
        done
    fi
    return 0
}

# Sweep 2 (EGL-182-D1): kit-named networks — a failed list is one note
# and the sweep continues (nft tables still go). It sets the
# aggregator's `listings_ok=0`, so the run reports an incomplete sweep
# and never `no kit runtime` (ARC-67-D3, EGL-438-D1/D2).
# EGL-479-D1/D3: a kept network is recorded in the caller's
# `kept_network_names` (dynamic scope, same shape as `found`), so sweep 3
# can keep the firewall table that still polices it.
teardown_runtime_networks() {
    if ! names="$(podman_network_names 2>/dev/null)"; then
        echo "note: could not list Podman networks; kit-named networks were NOT swept (remove them manually: podman network rm <name>)"
        listings_ok=0
    else
        for name in $names; do
            [[ "$name" =~ ^egresslock-[a-z0-9-]+$ ]] || continue
            # ARC-69-D1: same vocabulary as conf-scoped teardown — a
            # network that exists but won't rm is `kept (in use)`; the
            # count includes only real removals, never failed rms.
            if rt_network_rm "$name" >/dev/null 2>&1; then
                echo "removed network $name"
                found=1
            else
                echo "kept network $name (in use)"
                kept_network_names+=("$name")
            fi
        done
    fi
    return 0
}

# Sweep 3 (EGL-182-D1): ARC-66-D4 — the kit's nft table is kit POLICY in
# the shared rootless netns (filter hooks apply netns-wide, not just to
# kit bridges), so the sweep deletes it too — amends ARC-60-D1's
# hands-off rule. EGL-438-D3: one bare `list tables` read is both the
# readability and presence oracle — rule/set/comment bytes are never
# read, so a foreign large set or a multiline comment cannot delay the
# sweep or fake a declaration. Any nonzero rc is blind (one note,
# `listings_ok=0`); a successful read without the exact whole line
# `table inet egresslock` (including empty output) is a confirmed
# absence (skip). Only that exact brace-less declaration is deleted; a
# failed read's stdout is discarded. A failing delete is one note and
# rc 0 — this is the recovery command. Never run from uninstall/postrm
# (ARC-7-D5). EGL-479-D1/D4: when sweep 2 kept a kit network in use, the
# table is kept too — one kept-table line names the surviving network(s)
# and the re-run — because deleting it would unpolic the workload that
# blocked the rm; the delete path below is unchanged when none was kept.
teardown_runtime_nft() {
    local tbl="$TABLE" tables line present=0
    local kept_names="" n
    if ! tables="$(netns_nft list tables 2>/dev/null)"; then
        echo "note: could not list nft tables in the rootless netns; the kit firewall table was NOT swept (check it: podman unshare --rootless-netns nft list tables; remove the kit table if listed: podman unshare --rootless-netns nft delete table inet egresslock)"
        listings_ok=0
        return 0
    fi
    while IFS= read -r line; do
        if [[ "$line" == "table inet $tbl" ]]; then
            present=1
            break
        fi
    done <<<"$tables"
    if [[ "$present" == 1 ]]; then
        if (( ${#kept_network_names[@]} > 0 )); then
            for n in "${kept_network_names[@]}"; do
                kept_names="${kept_names:+$kept_names, }$n"
            done
            if (( ${#kept_network_names[@]} == 1 )); then
                echo "kept nft table inet $tbl (network $kept_names is still in use; remove the workload and re-run: egresslock teardown --runtime)"
            else
                echo "kept nft table inet $tbl (networks $kept_names are still in use; remove the workloads and re-run: egresslock teardown --runtime)"
            fi
        elif netns_nft delete table inet "$tbl" >/dev/null 2>&1; then
            echo "removed nft table inet $tbl"
            found=1
        else
            echo "note: could not delete nft table inet $tbl; remove it manually: podman unshare --rootless-netns nft delete table inet $tbl"
        fi
    fi
    return 0
}

cmd_teardown_runtime() {
    if [[ $# -gt 1 ]]; then
        echo "Error: teardown --runtime takes no other arguments." >&2
        echo "usage: egresslock teardown --runtime" >&2
        exit 2
    fi
    local names name found=0 listings_ok=1
    # EGL-479-D3: the kept network(s) ride the dynamic scope into sweep 3,
    # same shape as `found`/`listings_ok` (EGL-438-D2).
    local -a kept_network_names=()
    # ARC-69-D1 rides the container helper; sweep order is frozen:
    # containers -> networks -> nft -> summary. EGL-438-D2: one shared
    # outcome, one summary line, one place that returns 1; the summary
    # stays inline (ARC-67-D3).
    teardown_runtime_containers
    teardown_runtime_networks
    teardown_runtime_nft
    if [[ "$listings_ok" == 0 ]]; then
        echo "incomplete sweep: could not list every kit container, network, or firewall table; the runtime may not be clean (see the notes above)"
        return 1
    fi
    # EGL-479-D4: a kept network is runtime that remains, so the clean
    # line would be false; the kept-table line above names it instead.
    if [[ "$found" == 0 && ${#kept_network_names[@]} -eq 0 ]]; then
        echo "no kit runtime"
    fi
    return 0
}

cmd_teardown() {
    local target="${1:-}" p
    if [[ -z "$target" ]]; then
        # ARC-69-D4: bare teardown is a usage error naming every form,
        # not a require_profile "" misfire.
        echo "Error: teardown requires an argument." >&2
        echo "usage: egresslock teardown <profile> | egresslock teardown all | egresslock teardown --runtime" >&2
        exit 2
    fi
    # ARC-71-D1: `--runtime` dispatches BEFORE the netns probe. The
    # recovery sweep installs no policy; blocking it on a pasta EPERM
    # made it unusable exactly when uninstall needed it (dogfood host,
    # 2026-09-07). Amends ARC-26-D1: --runtime is not in the probe set.
    if [[ "$target" == "--runtime" ]]; then
        cmd_teardown_runtime "$@"
        return
    fi
    # ARC-71-D2: conf-scoped teardown keeps the probe — day-to-day
    # commands fail loud on a wedged netns with the ARC-26 guidance.
    netns_probe || exit 1
    local listed nets removed_total=0 nothing_total=1
    # ARC-69-D1: existence is checked BEFORE rm (membership in the
    # current listings), so repeat teardown reports the three real
    # states instead of guessing from rm's rc.
    listed="$(rt_ps all 2>/dev/null || true)"
    nets="$(podman_network_names 2>/dev/null || true)"
    case "$target" in
        all) set -- "${PROFILES[@]}" ;;
        *)   require_profile "$target" teardown; set -- "$target" ;;
    esac
    for p in "$@"; do
        teardown_profile_objects "$p" "$listed" "$nets"
        if (( TD_REMOVED )); then
            removed_total=1
        fi
        (( TD_NOTPRESENT )) || nothing_total=0
    done
    if (( nothing_total == 1 && removed_total == 0 )); then
        # ARC-69-D2: every object was already gone — no nft note (it
        # would be a lie: a no-op run proves nothing about the table).
        # EGL-325 A7: `all` is the main.conf-only form (D6) — it never
        # scans sibling confs, so the sentence must name that one profile
        # instead of claiming every profile is clean.
        if [[ "$target" == "all" ]]; then
            echo "nothing left for profile '${PROFILES[0]:-main}' (teardown all reads main.conf only)"
        else
            echo "nothing left for profile '$target'"
        fi
    else
        # ARC-69-D2: something was removed (or something is stuck, so
        # the table genuinely persists) — point at --runtime, which
        # deletes the table; pasta may keep it alive past this run.
        echo "note: nft table inet $TABLE is unchanged; 'egresslock teardown --runtime' deletes it"
    fi
}

# ARC-69-D1: per-profile object teardown, existence first (membership
# in the caller's listings) then rm; rm's rc decides removed vs kept.
# TD_REMOVED=1 when removed; TD_NOTPRESENT=1 when every object was gone.
teardown_profile_objects() { # <profile> <container-list> <network-list>
    local p="$1" listed="$2" nets="$3"
    local gwname aname netname
    TD_REMOVED=0
    TD_NOTPRESENT=1
    gwname="$(gw_name "$p")"
    aname="$(anchor_of "$p")"
    netname="$(network_of "$p")"
    if has_runtime_name "$gwname" "$listed"; then
        if rt_rm "$gwname" >/dev/null 2>&1; then
            echo "removed gateway $gwname"
            TD_REMOVED=1
            TD_NOTPRESENT=0
        else
            echo "note: could not remove gateway $gwname"
            TD_NOTPRESENT=0
        fi
    else
        echo "not present gateway $gwname"
    fi
    if has_runtime_name "$aname" "$listed"; then
        if rt_rm "$aname" >/dev/null 2>&1; then
            echo "removed anchor $aname"
            TD_REMOVED=1
            TD_NOTPRESENT=0
        else
            echo "note: could not remove anchor $aname"
            TD_NOTPRESENT=0
        fi
    else
        echo "not present anchor $aname"
    fi
    if has_runtime_name "$netname" "$nets"; then
        if rt_network_rm "$netname" >/dev/null 2>&1; then
            echo "removed $netname"
            TD_REMOVED=1
            TD_NOTPRESENT=0
        else
            echo "kept $netname (in use)"
            TD_NOTPRESENT=0
        fi
    else
        echo "not present $netname"
    fi
}

# ARC-69-D1 helper: membership of $1 in the whitespace-separated list $2.
has_runtime_name() {
    local n
    for n in $2; do
        [[ "$n" == "$1" ]] && return 0
    done
    return 1
}

#
# EGL-325 config resolution. One unix account = one confdir, always
# <passwd-home>/.config/egresslock (never $HOME). Peek the profile
# argument before load_config ($1 = command, $2 = first arg after it).
#
#   named commands: $CONFDIR/<profile>.conf only (no main.conf fallback).
#   bare list: aggregate every $CONFDIR/*.conf (ARC-37-D3).
#   bare verify --ensured: same aggregate glob (a check, not a delete).
#   bare teardown all: main.conf only, never scans (ARC-37-D4).
#
# Every loaded file must be named after the profile it defines (EGL-323).
#
confdir_default() {
    local home
    home="$(getent passwd "$(id -u)" | cut -d: -f6)" || true
    [[ -n "$home" ]] \
        || die "cannot resolve the account home for the config directory (getent passwd $(id -u) returned nothing); refusing to guess a config directory"
    printf '%s\n' "$home/.config/egresslock"
}

conf_basename() { # conf_basename <path> -> basename without the .conf suffix
    local b="${1##*/}"
    printf '%s' "${b%.conf}"
}

conf_require_basename() { # conf_require_basename <conf> <defined-profile>
    local conf="$1" profile="$2" base
    base="$(conf_basename "$conf")"
    [[ "$base" == "$profile" ]] || {
        echo "Error: config name/profile mismatch: '$conf' defines profile '$profile' but the file must be named '$profile.conf' (one profile per file; basename = profile)" >&2
        exit 2
    }
}

# EGL-117-D1: resolution disclosure. Every conf-resolving invocation
# prints EXACTLY ONE stderr line naming the resolved config — every
# time, TTY-independent. Stdout contracts stay byte-stable.
disclose_resolution() { # disclose_resolution <mode> <path> <count>
    local mode="$1" path="$2" extra="${3:-}"
    case "$mode" in
        named)     echo "using config $path" >&2 ;;
        aggregate) echo "using configs in $path ($extra profiles)" >&2 ;;
        *) echo "internal: unknown resolution mode $mode" >&2; return 1 ;;
    esac
}

probe_named_conf() { # probe_named_conf <confdir> <profile>
    local confdir="$1" profile="$2"
    local candidate
    # EGL-325 n4: validate the profile token BEFORE it is joined to the
    # confdir. Without this, `network ../other/secret` built a candidate
    # outside the confdir and disclosed a readable `*.conf` there before
    # require_profile refused; a profile name is exactly the grammar the
    # loader accepts ([a-z0-9][a-z0-9-]*).
    [[ "$profile" =~ ^[a-z0-9][a-z0-9-]*$ ]] || {
        echo "Error: invalid profile name '$profile' (expected [a-z0-9][a-z0-9-]*, must not start with '-')." >&2
        exit 2
    }
    # EGL-380: refuse before the confdir join/probe — 'all' is the
    # teardown keyword, never a profile name.
    [[ "$profile" != "all" ]] || {
        echo "Error: profile name 'all' is reserved ('teardown all' names the main profile); rename this profile and its conf file." >&2
        exit 2
    }
    candidate="$confdir/$profile.conf"
    if [[ ! -f "$candidate" ]]; then
        echo "Error: no profile config: '$candidate' not found" >&2
        echo "Each profile lives in the account config directory as <profile>.conf (this account's config directory is '$confdir'). If you expected a config to be found, make sure you are running as the dedicated account (not root) and that the profile file is in place — 'egresslock init <name>' or 'egresslock-setup init --init-conf' creates them." >&2
        exit 2
    fi
    disclose_resolution named "$candidate"
    ENGINE_CONF="$candidate"
    load_config "$ENGINE_CONF"
    conf_require_basename "$ENGINE_CONF" "${PROFILES[0]}"
}

# ARC-37-D3/D4: load every CONFDIR/*.conf (non-recursive; not .bak/,
# not allowlists). Fail closed on a load_config failure, a profile name
# in two files, or a basename that is not the profile it defines. No
# *.conf -> exit 2. stderr: one 'using configs in <CONFDIR>' line.
aggregate_configs() { # aggregate_configs <confdir>
    local confdir="$1"
    local -a confs=()
    local f
    for f in "$confdir"/*.conf; do
        [[ -f "$f" ]] && confs+=("$f")
    done
    if (( ${#confs[@]} == 0 )); then
        echo "Error: no profile config: no *.conf in '$confdir'" >&2
        echo "Checked '$confdir' for *.conf (this account's config directory). If you expected a config to be found, make sure you are running as the dedicated account (not root) and that the profile file is in place — 'egresslock init <name>' or 'egresslock-setup init --init-conf' creates them." >&2
        exit 2
    fi
    # EGL-117-D1: disclose the aggregate scope (one line, every time).
    # N = the number of *.conf files the glob resolved (same glob as the
    # loads that follow; a load that fails aborts the command fail-closed).
    disclose_resolution aggregate "$confdir" "${#confs[@]}"
    local first=1 c idx
    for c in "${confs[@]}"; do
        if [[ "$first" == 1 ]]; then
            load_config "$c"
            first=0
        else
            load_config "$c" 1
        fi
        idx=$(( ${#PROFILES[@]} - 1 ))
        conf_require_basename "$c" "${PROFILES[$idx]}"
    done
}

# EGL-228-D2: conf-independent argv-shape check. Called after
# require_nonroot and before resolve/load so a usage rc 2 is stable
# whether the conf is missing, malformed, or unreadable. Handlers
# keep their parsers (this is an early filter). Conf-dependent
# checks (unknown profile, engine-required) stay in
# the handler after the load.
argv_shape_check() { # argv_shape_check <command> <args-after-command...>
    local cmd="${1:-}"; shift
    case "$cmd" in
        ensure)
            local replace_gw=0 profile=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --replace-gateway)
                        if (( replace_gw )); then
                            echo "Error: ensure takes --replace-gateway only once." >&2
                            echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                            exit 2
                        fi
                        replace_gw=1; shift ;;
                    "")
                        echo "Error: ensure takes one profile name." >&2
                        echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                        exit 2 ;;
                    -*) echo "Error: ensure takes --replace-gateway only." >&2
                        echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                        exit 2 ;;
                    *)  [[ -z "$profile" ]] || {
                            echo "Error: ensure takes one profile name." >&2
                            echo "usage: egresslock ensure [--replace-gateway] <profile>" >&2
                            exit 2
                        }
                        profile="$1"; shift ;;
                esac
            done
            if [[ -z "$profile" ]]; then
                echo "Error: ensure requires a profile name." >&2
                echo "usage: egresslock ensure <profile>" >&2
                exit 2
            fi
            ;;
        verify)
            if [[ "${1:-}" == "--ensured" ]]; then
                [[ $# -eq 1 ]] || {
                    usage_error_command "verify --ensured takes no profile argument." \
                        "egresslock verify --ensured" "verify"
                    exit 2
                }
            else
                if [[ $# -lt 1 || -z "$1" ]]; then
                    echo "Error: verify requires a profile name." >&2
                    echo "usage: egresslock verify <profile>" >&2
                    echo "       egresslock verify --ensured   (every ensured profile)" >&2
                    exit 2
                fi
                if [[ "$1" == -* ]]; then
                    echo "Error: unknown verify option '$1' (only --ensured is accepted)." >&2
                    echo "usage: egresslock verify <profile> | egresslock verify --ensured" >&2
                    exit 2
                fi
                if (( $# > 1 )); then
                    echo "Error: verify takes no extra arguments." >&2
                    echo "usage: egresslock verify <profile> | egresslock verify --ensured" >&2
                    exit 2
                fi
            fi
            ;;
        network)
            if [[ $# -lt 1 || -z "$1" ]]; then
                echo "Error: network requires a profile name." >&2
                echo "usage: egresslock network <profile>" >&2
                exit 2
            fi
            [[ -z "${2:-}" ]] || {
                echo "Error: network takes no extra arguments." >&2
                echo "usage: egresslock network <profile>" >&2
                exit 2
            }
            ;;
        proxy-env)
            if [[ $# -lt 1 || -z "$1" ]]; then
                echo "Error: proxy-env requires a profile name." >&2
                echo "usage: egresslock proxy-env <profile>" >&2
                exit 2
            fi
            # EGL-246 R-EGL-246-3 F3: count/presence checks, not
            # non-empty-value checks — a quoted empty argument `""` is
            # a real positional, so every shape here is judged by argc
            # alone and any extra argument (including `""`) exits 2
            # BEFORE any conf read. The specific `--out` space-form
            # error outranks the generic at-most-one error (D14's
            # shepherding message for the common mis-spelling).
            if [[ "${2:-}" == "--out" && $# -ge 3 ]]; then
                echo "Error: --out takes no separate argument (use --out=<path>)." >&2
                echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
                exit 2
            fi
            if (( $# > 2 )); then
                echo "Error: proxy-env takes at most one argument (a token or an --out form)." >&2
                echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
                exit 2
            fi
            if (( $# == 2 )); then
                case "$2" in
                    proxyip|proxyport|noproxy|--out) ;;
                    --out=*)
                        [[ -n "${2#--out=}" ]] || {
                            echo "Error: --out= requires a path." >&2
                            echo "usage: egresslock proxy-env <profile> [proxyip|proxyport|noproxy|--out[=<path>]]" >&2
                            exit 2
                        } ;;
                    *) echo "Error: unknown proxy-env token '$2' (expected: proxyip, proxyport, noproxy)." >&2; exit 2 ;;
                esac
            fi
            ;;
        rules)
            if [[ $# -lt 1 || -z "$1" ]]; then
                echo "Error: rules requires a profile name." >&2
                echo "usage: egresslock rules <profile>" >&2
                exit 2
            fi
            if (( $# > 1 )); then
                echo "Error: rules takes no extra arguments." >&2
                echo "usage: egresslock rules <profile>" >&2
                exit 2
            fi
            ;;
        allowlist)
            # EGL-310: --direct is accepted before or after the profile,
            # at most once; --all is deliberately not implemented.
            local allowlist_direct=0 allowlist_profile=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --direct)
                        if (( allowlist_direct )); then
                            echo "Error: allowlist takes --direct only once." >&2
                            echo "usage: egresslock allowlist [--direct] <profile>" >&2
                            exit 2
                        fi
                        allowlist_direct=1; shift ;;
                    --all)
                        echo "Error: unknown allowlist option '--all' (only --direct is accepted)." >&2
                        echo "usage: egresslock allowlist [--direct] <profile>" >&2
                        exit 2 ;;
                    -*)
                        echo "Error: unknown allowlist option '$1' (only --direct is accepted)." >&2
                        echo "usage: egresslock allowlist [--direct] <profile>" >&2
                        exit 2 ;;
                    "")
                        echo "Error: allowlist takes one profile name." >&2
                        echo "usage: egresslock allowlist [--direct] <profile>" >&2
                        exit 2 ;;
                    *)
                        [[ -z "$allowlist_profile" ]] || {
                            echo "Error: allowlist takes one profile name." >&2
                            echo "usage: egresslock allowlist [--direct] <profile>" >&2
                            exit 2
                        }
                        allowlist_profile="$1"; shift ;;
                esac
            done
            if [[ -z "$allowlist_profile" ]]; then
                echo "Error: allowlist requires a profile name." >&2
                echo "usage: egresslock allowlist [--direct] <profile>" >&2
                exit 2
            fi
            ;;
        allowlist-direct)
            # EGL-310-D2: the hidden shortcut takes exactly one profile
            # and no flags; its errors name the canonical form.
            local allowlist_direct_profile="" allowlist_direct_n=0 allowlist_direct_arg
            for allowlist_direct_arg in "$@"; do
                case "$allowlist_direct_arg" in
                    --direct)
                        echo "Error: the direct view is already selected; drop --direct." >&2
                        echo "usage: egresslock allowlist <profile> --direct" >&2
                        exit 2 ;;
                    -*)
                        echo "Error: unknown allowlist-direct option '$allowlist_direct_arg' (the direct view takes no flags)." >&2
                        echo "usage: egresslock allowlist <profile> --direct" >&2
                        exit 2 ;;
                    "")
                        echo "Error: allowlist-direct takes one profile name." >&2
                        echo "usage: egresslock allowlist <profile> --direct" >&2
                        exit 2 ;;
                    *)
                        allowlist_direct_n=$(( allowlist_direct_n + 1 ))
                        allowlist_direct_profile="$allowlist_direct_arg" ;;
                esac
            done
            if (( allowlist_direct_n == 0 )); then
                echo "Error: allowlist-direct requires a profile name." >&2
                echo "usage: egresslock allowlist <profile> --direct" >&2
                exit 2
            fi
            if (( allowlist_direct_n > 1 )); then
                echo "Error: allowlist-direct takes one profile name." >&2
                echo "usage: egresslock allowlist <profile> --direct" >&2
                exit 2
            fi
            ;;
        denied)
            if [[ $# -lt 1 || -z "$1" ]]; then
                echo "Error: denied requires a profile name." >&2
                echo "usage: egresslock denied <profile>" >&2
                exit 2
            fi
            shift
            local days=14
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --all)  shift ;;
                    --days) [[ $# -ge 2 ]] || { echo "Error: --days requires a value." >&2; exit 2; }
                            days="$2"; shift 2 ;;
                    *)      echo "Error: denied takes --all and/or --days N." >&2
                            echo "usage: egresslock denied <profile> [--all] [--days N]" >&2
                            exit 2 ;;
                esac
            done
            [[ "$days" =~ ^(0|[1-9][0-9]*)$ ]] || {
                echo "Error: --days must be a non-negative integer (0 = no time limit)." >&2
                exit 2
            }
            ;;
        allow|disallow)
            # EGL-365: the lane parser owns the flag shape (both flag
            # positions, duplicate/unknown-flag refusal) and the entry
            # grammar for the selected lane. The handler re-parses; the
            # pre-dispatch pass keeps argv errors ahead of conf reads.
            lane_cmd_parse "$cmd" "$@" ;;
        allow-direct|disallow-direct|allow-host|disallow-host)
            # EGL-365-D9: shortcuts and compat aliases keep the full
            # argv/root/lock/conf gate; their messages use the canonical
            # verb and lane.
            if [[ "$cmd" == allow-* ]]; then
                lane_direct_parse allow "$@"
            else
                lane_direct_parse disallow "$@"
            fi ;;
        drop-unauthorized)
            if [[ $# -lt 1 || -z "$1" ]]; then
                echo "Error: drop-unauthorized requires a profile name." >&2
                echo "usage: egresslock drop-unauthorized <profile> <port>" >&2
                exit 2
            fi
            if [[ -z "${2:-}" ]]; then
                echo "Error: drop-unauthorized requires a port." >&2
                echo "usage: egresslock drop-unauthorized <profile> <port>" >&2
                exit 2
            fi
            if [[ $# -gt 2 ]]; then
                echo "Error: drop-unauthorized takes exactly one port." >&2
                echo "usage: egresslock drop-unauthorized <profile> <port>" >&2
                exit 2
            fi
            if ! cfg_is_port "$2"; then
                echo "Error: invalid port '$2' (expected 1-65535)." >&2
                exit 2
            fi
            ;;
        teardown)
            if [[ -z "${1:-}" ]]; then
                echo "Error: teardown requires an argument." >&2
                echo "usage: egresslock teardown <profile> | egresslock teardown all | egresslock teardown --runtime" >&2
                exit 2
            fi
            if [[ "$1" == "--runtime" && $# -gt 1 ]]; then
                echo "Error: teardown --runtime takes no other arguments." >&2
                echo "usage: egresslock teardown --runtime" >&2
                exit 2
            fi
            if (( $# > 1 )); then
                echo "Error: teardown takes no extra arguments." >&2
                echo "usage: egresslock teardown <profile> | egresslock teardown all | egresslock teardown --runtime" >&2
                exit 2
            fi
            ;;
        list)
            if (( $# > 0 )); then
                echo "Error: list takes no extra arguments." >&2
                echo "usage: egresslock list" >&2
                exit 2
            fi
            ;;
        *) ;;
    esac
}

resolve_conf_for() { # resolve_conf_for <command> <arg2>
    local cmd="${1:-}" arg2="${2:-}"
    local confdir
    confdir="$(confdir_default)"
    case "$cmd" in
        list)
            aggregate_configs "$confdir"
            ;;
        verify)
            if [[ "$arg2" == "--ensured" ]]; then
                aggregate_configs "$confdir"
            else
                probe_named_conf "$confdir" "$arg2"
            fi
            ;;
        teardown)
            if [[ "$arg2" == "all" ]]; then
                # EGL-380: a legacy all.conf is not addressable and must
                # never make `teardown all` read (and destroy) main.conf.
                if [[ -e "$confdir/all.conf" ]]; then
                    echo "Error: refusing 'teardown all': $confdir/all.conf exists, but 'teardown all' targets $confdir/main.conf; profile name 'all' is reserved ('teardown all' names the main profile) — rename this profile and its conf file." >&2
                    exit 2
                fi
                probe_named_conf "$confdir" "main"
            else
                probe_named_conf "$confdir" "$arg2"
            fi
            ;;
        *)
            probe_named_conf "$confdir" "$arg2"
            ;;
    esac
}

# EGL-227: account-wide advisory lock. One kernel flock per account makes
# the ensure/mutator/teardown critical section atomic (source read ->
# candidate generation -> apply -> restart/teardown), so an older ensure
# cannot copy a stale candidate over a newer mutation (EGL-223 S3) or race
# the gateway lifecycle (X-9). Identity is the ACCOUNT home from getent
# passwd — never $HOME, which an alternate environment could bypass
# (R-EGL-227-5 F1); not confdir either, because `teardown --runtime` is
# the conf-less recovery path and must serialize. Writers take it
# exclusive; verify takes it shared and degrades to lock-free rather than
# wedge the 15-minute timer. Kernel-released on death, so no stale-lock
# cleanup. Held on fd 9; rt_run/rt_restart close fd 9 in the child (D10).
engine_lock_path() {
    local home
    home="$(getent passwd "$(id -u)" | cut -d: -f6)" || true
    [[ -n "$home" ]] \
        || die "cannot resolve the account home for the account lock (getent passwd $(id -u) returned nothing); refusing to run unserialized"
    printf '%s\n' "$home/.local/state/egresslock/engine.lock"
}

acquire_engine_lock() { # acquire_engine_lock <command>
    local cmd="${1:-}" mode wait_s lockf holder
    case "$cmd" in
        ensure|allow|disallow|allow-direct|disallow-direct|allow-host|disallow-host|drop-unauthorized|teardown|init)
            mode=write; wait_s="${EGRESSLOCK_LOCK_WAIT:-30}" ;;
        verify)
            mode=read; wait_s="${EGRESSLOCK_LOCK_WAIT:-5}" ;;
        *) return 0 ;;  # list/network/proxy-env/rules/allowlist/allowlist-direct/denied/doctor/build-gateway
    esac
    [[ "$wait_s" =~ ^[0-9]+$ ]] \
        || die "EGRESSLOCK_LOCK_WAIT must be a non-negative integer number of seconds (got '$wait_s')"
    command -v flock >/dev/null 2>&1 \
        || die "flock(1) (util-linux) is required to serialize egresslock commands and was not found in PATH; refusing to run unserialized"
    lockf="$(engine_lock_path)" || exit 1   # S1 already printed by the die
    ( umask 077; mkdir -p "$(dirname "$lockf")" ) \
        || die "cannot create the account lock directory $(dirname "$lockf") (fail closed)"
    exec 9>>"$lockf" || die "cannot open the account lock $lockf (fail closed)"
    if [[ "$mode" == read ]]; then
        # A writer in flight is not worth wedging the timer behind: on
        # timeout proceed lock-free (pre-EGL-227 behavior; EGL-283 keeps
        # the raced verify message honest).
        flock -s -w "$wait_s" 9 || { exec 9>&-; return 0; }
    else
        if ! flock -x -w "$wait_s" 9; then
            holder="$(tail -n 1 "$lockf" 2>/dev/null || true)"
            die "another egresslock command is running for this account (waited ${wait_s}s for the account lock; $lockf; holder: ${holder:-unknown}); re-run when it finishes"
        fi
        # EGL-227 D11: the exclusive holder owns the record — truncate it
        # so the diagnostics file stays one line per holder instead of
        # growing ~1.4 MB/year/account. Shared readers never truncate
        # (concurrent sharers); with O_APPEND (fd 9) the write below
        # lands at offset 0 of the fresh file.
        : > "$lockf" || die "cannot truncate the account lock record $lockf (fail closed)"
    fi
    # EGL-391-D2: the holder record is DIAGNOSTIC. The exclusive lock is
    # already held; a full filesystem must not kill even read-only
    # verify. Keep fd 9 and the flock (do not close/release); name the
    # lost diagnostic S1. A failed stderr write is ignored.
    if ! printf 'pid=%s mode=%s started=%s\n' "$$" "$mode" "$(date -Is)" >&9 2>/dev/null; then
        echo "warning: the account lock could not record who holds it ($lockf): the lock is held for this run; a later \"another egresslock command is running\" message may show \"holder: unknown\" or a stale record" >&2 || true
    fi
}

# --- EGL-45: engine doctor — host environment probe --------------------------
# ARC-4 piece 6 / EGL-10: runtime evidence for the version-compat question.
# Docs claim support only for what the host actually provides, never "any
# rootless Podman".
#
# NOT `egresslock-setup apparmor check` (pasta AppArmor) and NOT
# `egresslock-setup doctor` (kit/account install state) — see each
# binary's help. D45-3: no connectivity experiment — no policy install,
# networks, gateway, or curls, and no verdict beyond the required-tools
# rc.
#
# Output (D45-2): one `key: value` line per check on stdout (stable,
# greppable keys); errors/hints on stderr. A missing REQUIRED check ->
# rc 1; all required present -> rc 0 even when advisories fail.
cmd_doctor() {
    local rc=0
    local podman_ok=1 backend=""

    # Required: podman on PATH.
    if rt_have_runtime; then
        echo "podman: $(rt_version 2>/dev/null || echo 'present')"
    else
        echo "podman: MISSING"
        podman_ok=0
        rc=1
    fi

    # One podman info roundtrip feeds both the netavark fallback and the
    # bridge_driver advisory. Missing/failed podman info -> empty.
    if (( podman_ok )); then
        backend="$(rt_info 2>/dev/null || true)"
    fi

    # Required: netavark — on PATH, or the backend podman reports.
    if command -v netavark >/dev/null 2>&1; then
        echo "netavark: $(command -v netavark)"
    elif [[ -n "$backend" ]]; then
        echo "netavark: present (podman NetworkBackend: $backend)"
    else
        echo "netavark: MISSING"
        rc=1
    fi

    # Required: nft — NFT_BIN, then /usr/sbin/nft, then PATH (the engine's
    # own resolution order; resolved WITHOUT dying — a miss is a MISSING
    # line, not an abort).
    local nft_resolved=""
    if [[ -n "${NFT_BIN:-}" ]]; then
        nft_resolved="$NFT_BIN"
    elif command -v nft >/dev/null 2>&1; then
        nft_resolved="$(command -v nft)"
    elif [[ -x /usr/sbin/nft ]]; then
        nft_resolved=/usr/sbin/nft
    fi
    if [[ -n "$nft_resolved" && -e "$nft_resolved" ]]; then
        echo "nft: $("$nft_resolved" --version 2>/dev/null || echo "present ($nft_resolved)")"
    else
        echo "nft: MISSING"
        rc=1
    fi

    # Required: conntrack — CONNTRACK_BIN, then /usr/sbin/conntrack, then
    # PATH (the engine's own resolution order; EGL-139-D2: required by
    # disallow-host's revocation flush). Resolved WITHOUT dying — a miss
    # is a MISSING line, not an abort. Adjacent-layer row (EGL-139-D5):
    # the walked egresslock-setup doctor card does not change.
    local ct_resolved=""
    if [[ -n "${CONNTRACK_BIN:-}" ]]; then
        ct_resolved="$CONNTRACK_BIN"
    elif command -v conntrack >/dev/null 2>&1; then
        ct_resolved="$(command -v conntrack)"
    elif [[ -x /usr/sbin/conntrack ]]; then
        ct_resolved=/usr/sbin/conntrack
    fi
    if [[ -n "$ct_resolved" && -e "$ct_resolved" ]]; then
        echo "conntrack: $("$ct_resolved" --version 2>/dev/null || echo "present ($ct_resolved)")"
    else
        echo "conntrack: MISSING"
        rc=1
    fi

    # Required: unprivileged user namespaces (file is 1; kernels without
    # the sysctl always allow). EGRESSLOCK_USERNS_SYSCTL is a harness
    # override (tests pin the row to fixture files; honored only when
    # EGRESSLOCK_KIT_ALLOW_NON_ROOT=1); unset or ignored = the real
    # kernel sysctl path.
    local userns_sysctl="/proc/sys/kernel/unprivileged_userns_clone"
    if [[ "${EGRESSLOCK_KIT_ALLOW_NON_ROOT:-0}" == 1 ]]; then
        userns_sysctl="${EGRESSLOCK_USERNS_SYSCTL:-$userns_sysctl}"
    else
        egl491_warn_ignored_hook EGRESSLOCK_USERNS_SYSCTL "${EGRESSLOCK_USERNS_SYSCTL:-}"
    fi
    if [[ -r $userns_sysctl ]]; then
        if [[ "$(cat "$userns_sysctl")" == "1" ]]; then
            echo "userns: enabled"
        else
            echo "userns: disabled"
            rc=1
        fi
    else
        echo "userns: enabled (kernel has no unprivileged_userns_clone gate)"
    fi

    # --- advisory lines: never affect the rc --------------------------------
    if command -v pasta >/dev/null 2>&1; then
        echo "network_backend: pasta"
    elif command -v slirp4netns >/dev/null 2>&1; then
        echo "network_backend: slirp"
    else
        echo "network_backend: unknown"
    fi

    if (( ! podman_ok )); then
        echo "rootless_netns: skipped (podman MISSING)"
    else
        local nerr="" nrc=0
        # EGL-78-D1/D3: bound the doctor's probe the same way the engine's
        # netns_probe is bounded. Advisory only — doctor's other rc policy
        # is unchanged.
        if ! command -v timeout >/dev/null 2>&1; then
            nerr="timeout(1) (coreutils) not found in PATH"
            nrc=1
        else
            nerr="$(rt_unshare -t 5 true 2>&1)" && nrc=0 || nrc=$?
        fi
        if (( nrc == 0 )); then
            echo "rootless_netns: ok"
        elif (( nrc == 124 )); then
            echo "rootless_netns: fail: probe timed out after 5s ('timeout 5 podman unshare --rootless-netns true'); the rootless netns is not answering"
            echo "Hint: run as the dedicated account; see docs/troubleshooting/netns-inspection.md." >&2
        else
            # EGL-45-D2 / EGL-347-D1: the AppArmor pointer is scoped to
            # the AppArmor-shaped failure (rc 126 / permission denied)
            # with the `cannot chdir to` exclusion; any other netns
            # failure — including a stray inherited-CWD line — gets the
            # generic pointer instead. Do not misroute a non-AppArmor
            # problem to apparmor check.
            echo "rootless_netns: fail:$(printf '%s' "$nerr" | head -1)"
            if { (( nrc == 126 )) || grep -qi 'permission denied' <<<"$nerr"; } \
                && ! grep -qi 'cannot chdir to' <<<"$nerr"; then
                echo "Hint: run 'egresslock-setup apparmor check' for the pasta AppArmor slice." >&2
            else
                echo "Hint: run as the dedicated account; see docs/troubleshooting/netns-inspection.md." >&2
            fi
        fi
    fi

    if [[ "$backend" == "netavark" ]]; then
        echo "bridge_driver: bridge"
    else
        echo "bridge_driver: unknown"
    fi

    # EGL-226/EGL-487: account-side image advisories — the same base /
    # label / floor / staleness peek the kit doctor prints
    # (egresslock-setup kit_check_gateway, kit_check_egl_base), conf-less and
    # read-only. rc-neutral like every line above.
    if (( ! podman_ok )); then
        echo "gateway image: skipped (podman MISSING)"
    else
        local dimg gw_base_short gw_pin_short gw_built
        egl491_warn_ignored_hook EGRESSLOCK_GW_IMAGE "${EGRESSLOCK_GW_IMAGE:-}"
        dimg="$(gw_image)"
        gw_probe_state "$dimg" "$(dirname "${BASH_SOURCE[0]}")/gateway/Containerfile"
        gw_base_short="${GW_PROBE_BASE#sha256:}"; gw_base_short="${gw_base_short:0:12}"
        gw_pin_short="${GW_PROBE_PIN#sha256:}"; gw_pin_short="${gw_pin_short:0:12}"
        gw_built=""
        if [[ -n "$GW_PROBE_CREATED" ]]; then
            gw_built=", built ${GW_PROBE_CREATED:0:10}"
        fi
        if [[ "$GW_PROBE_STATE" == missing ]]; then
            echo "gateway image: missing ($dimg)"
            echo "  build it in the account shell: egresslock build-gateway (see \"The gateway image\" reference page)"
        elif [[ -n "$GW_PROBE_BASE" ]]; then
            echo "gateway image: present ($dimg) — base $gw_base_short${gw_built}"
            if [[ -n "$GW_PROBE_PIN" && "$GW_PROBE_BASE" != "$GW_PROBE_PIN" ]]; then
                echo "  stale: base pin moved (image base $gw_base_short != deployed pin $gw_pin_short) — rebuild in the account shell: egresslock build-gateway && egresslock ensure --replace-gateway <profile> per affected profile (see \"The gateway image\" reference page)"
            else
                image_rebuild_notice gateway "$GW_PROBE_CREATED" "$GW_PROBE_BASE" "$GW_PROBE_PIN" \
                    "$(dirname "${BASH_SOURCE[0]}")/gateway/security-floor" \
                    'egresslock build-gateway --force && egresslock ensure --replace-gateway <profile> per affected profile' \
                    '(see "The gateway image" reference page)'
            fi
        elif [[ -n "$GW_PROBE_INS" ]]; then
            echo "gateway image: present ($dimg) — base unknown (pre-label image)${gw_built}"
            echo "  stale: base unknown (pre-label image) — rebuild in the account shell: egresslock build-gateway && egresslock ensure --replace-gateway <profile> per affected profile (see \"The gateway image\" reference page)"
        else
            echo "gateway image: present ($dimg) — base unknown"
        fi

        # EGL-487-D5: the optional egl-base example image. Skipped when
        # no Containerfile resolves (never fall through from a prefix
        # engine onto a .deb share — version skew) and when the image is
        # absent (not a warning). The pin and the floor come from the
        # same resolved directory. R-EGL-487-2 F1: the /usr/share tree
        # belongs to the .deb layout only — its engine lives in the deb
        # libdir. A prefix/checkout engine that lost its own examples
        # tree fails closed rather than mixing another install's data
        # into this one (ARC-19-D3).
        local edir egl_dir egl_img egl_base_short egl_pin_short egl_built
        edir="$(CDPATH='' cd -- "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd || true)"
        egl_dir=""
        if [[ -n "${EGRESSLOCK_SHARE:-}" ]]; then
            egl_dir="$EGRESSLOCK_SHARE/examples/egl-base"
        elif [[ -n "$edir" && -f "$edir/examples/egl-base/Containerfile" ]]; then
            egl_dir="$edir/examples/egl-base"
        elif [[ "$edir" == "/usr/lib/egresslock" \
                && -f /usr/share/egresslock/examples/egl-base/Containerfile ]]; then
            egl_dir=/usr/share/egresslock/examples/egl-base
        fi
        if [[ -n "$egl_dir" && -f "$egl_dir/Containerfile" ]]; then
            egl_img="localhost/egl-base:latest"
            gw_probe_state "$egl_img" "$egl_dir/Containerfile"
            if [[ "$GW_PROBE_STATE" == present ]]; then
                egl_base_short="${GW_PROBE_BASE#sha256:}"; egl_base_short="${egl_base_short:0:12}"
                egl_pin_short="${GW_PROBE_PIN#sha256:}"; egl_pin_short="${egl_pin_short:0:12}"
                egl_built=""
                if [[ -n "$GW_PROBE_CREATED" ]]; then
                    egl_built=", built ${GW_PROBE_CREATED:0:10}"
                fi
                if [[ -n "$GW_PROBE_BASE" ]]; then
                    echo "egl-base image: present ($egl_img) — base $egl_base_short${egl_built}"
                    if [[ -n "$GW_PROBE_PIN" && "$GW_PROBE_BASE" != "$GW_PROBE_PIN" ]]; then
                        echo "  stale: base pin moved (image base $egl_base_short != deployed pin $egl_pin_short) — rebuild in the account shell: $egl_dir/build-egl-base (see the egl-base README)"
                    else
                        image_rebuild_notice egl-base "$GW_PROBE_CREATED" "$GW_PROBE_BASE" "$GW_PROBE_PIN" \
                            "$egl_dir/security-floor" \
                            "$egl_dir/build-egl-base --force" \
                            '(see the egl-base README)'
                    fi
                elif [[ -n "$GW_PROBE_INS" ]]; then
                    echo "egl-base image: present ($egl_img) — base unknown (pre-label image)${egl_built}"
                    echo "  stale: base unknown (pre-label image) — rebuild in the account shell: $egl_dir/build-egl-base (see the egl-base README)"
                else
                    echo "egl-base image: present ($egl_img) — base unknown"
                fi
            fi
        fi
    fi

    exit "$rc"
}

# EGL-222: build-gateway — rebuild the gateway image into the invoking
# account's rootless store from the gateway/ context NEXT TO THE ENGINE
# (the BASH_SOURCE[0] precedent of --version; on a .deb host the wrapper
# execs the libdir copy, so the neighbor is the real engine's). Loads NO
# conf. Never a silent no-op (D2): a missing image, an empty base-digest
# label, or a label != the deployed pin all build; an equal pin prints
# one up-to-date line (rc 0); --force always builds (squid is unpinned,
# so a same-pin rebuild can take security updates).
cmd_build_gateway() {
    local force=0
    if (( $# > 0 )); then
        if [[ "$1" == "--force" && $# -eq 1 ]]; then
            force=1
        else
            usage_error_command "build-gateway takes no arguments other than --force." \
                "egresslock build-gateway [--force]" "build-gateway"
            exit 2
        fi
    fi

    # User-manager preflight (EGL-51-D1, D6): rootless podman needs the
    # account's systemd user manager (session or linger). Fail closed
    # when systemctl ANSWERS inactive; proceed when systemctl is ABSENT
    # (the engine carries no systemd dependency — cmd_doctor degrades
    # without it too; setup's un-guarded check would wrongly take the
    # inactive branch there).
    local uid lg
    uid="$(id -u)"
    if command -v systemctl >/dev/null 2>&1; then
        if ! systemctl is-active --quiet "user@${uid}.service" 2>/dev/null; then
            echo "egresslock: no systemd user manager for '$(id -un)' (user@${uid}.service inactive). As root: systemctl start user@${uid}.service" >&2
            lg="$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null || true)"
            [[ "$lg" == "yes" ]] || \
                echo "egresslock: ... and: loginctl enable-linger $(id -un)  (or re-run the account bundle setup with --enable)" >&2
            exit 1
        fi
    fi

    # Context: the engine's own neighbor gateway/. EGL-378-D3: absolute
    # at its own basis (the engine's location, not CWD) — the build call
    # now runs from / (D1), and the canonical form keeps ./ out of the
    # recorded build argv. If the engine's own directory cannot be
    # entered, name that cause: the missing-context line below would
    # otherwise describe the wrong thing (R-EGL-378-5 note).
    # R-EGL-378-8: CDPATH= so an exported CDPATH cannot make `cd` print
    # its result and turn $edir into a two-line value.
    local gdir edir edir_src
    edir_src="$(dirname "${BASH_SOURCE[0]}")"
    if ! edir="$(CDPATH='' cd -- "$edir_src" 2>/dev/null && pwd)"; then
        echo "Error: cannot enter the engine's own directory ($edir_src) to find the gateway build context; check that it is accessible" >&2
        exit 1
    fi
    gdir="$edir/gateway"
    if [[ ! -f "$gdir/Containerfile" ]]; then
        echo "Error: no gateway build context at $gdir/Containerfile (the gateway/ directory must sit next to the engine)" >&2
        exit 1
    fi
    # Image + deployed pin via the shared probe (EGL-226): plain
    # assignment so the ARC-59 die() in gw_image propagates under set -e.
    # EGL-491: warn in this shell; gw_image() runs in a subshell.
    local img pin_short
    egl491_warn_ignored_hook EGRESSLOCK_GW_IMAGE "${EGRESSLOCK_GW_IMAGE:-}"
    img="$(gw_image)"
    gw_probe_state "$img" "$gdir/Containerfile"
    pin_short="${GW_PROBE_PIN#sha256:}"; pin_short="${pin_short:0:12}"
    local build=0 below_floor=0 floor_date built_date
    if [[ "$GW_PROBE_STATE" != present || -z "$GW_PROBE_BASE" \
          || -z "$GW_PROBE_PIN" || "$GW_PROBE_BASE" != "$GW_PROBE_PIN" ]]; then
        build=1
    fi
    # EGL-487-D4: a recorded security floor is a real refresh trigger even
    # when the base pin did not move; --no-cache makes apt re-fetch the
    # unpinned packages instead of reusing the old layer. R-EGL-487-2 F2:
    # only an image whose build date is at or after the floor proves the
    # floor is satisfied. A missing image, a pre-label image (no base
    # label), a missing/unparseable .Created, or a below-floor date all
    # get --no-cache — otherwise a surviving pre-floor apt layer would be
    # reused and the rebuilt image would look fresh to the doctor. A
    # moved pin needs no flag (the FROM digest invalidated the layers).
    # Age stays doctor-only (a calendar must not turn build-gateway into
    # a monthly network rebuild).
    floor_date="$(image_security_floor_date "$gdir/security-floor")"
    built_date="${GW_PROBE_CREATED:0:10}"
    if [[ -n "$floor_date" ]]; then
        if [[ "$GW_PROBE_STATE" != present || -z "$GW_PROBE_BASE" \
              || -z "$GW_PROBE_PIN" ]]; then
            build=1
            below_floor=1
        elif [[ "$GW_PROBE_BASE" == "$GW_PROBE_PIN" ]] \
             && { [[ ! "$built_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
                  || [[ "$built_date" < "$floor_date" ]]; }; then
            build=1
            below_floor=1
        fi
    fi

    if (( ! build && ! force )); then
        # D2: never a silent no-op — one explicit up-to-date line.
        echo "already built from deployed pin ${pin_short} — use --force to rebuild"
        return 0
    fi

    if (( below_floor && ! force )) && [[ "$built_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
        && [[ "$built_date" < "$floor_date" ]]; then
        echo "security floor: image built $built_date predates the recorded rebuild floor $floor_date — rebuilding with --no-cache"
    fi

    # Build (D10 leading line; D8 primitive; D5 docker format, -t first).
    echo "Building $img FROM ${pin_short}"
    local -a extra_flags=()
    if (( force || below_floor )); then
        # R-EGL-222-3 F1: a forced rebuild must not reuse cached layers —
        # the unchanged `RUN apt-get ... squid` instruction would
        # otherwise reuse its old layer, and the same-pin squid security
        # refresh that is --force's named purpose (D2) would never
        # happen. The pin-mismatch path needs no flag: the FROM digest
        # moved, which invalidates every layer after it on its own.
        extra_flags+=(--no-cache)
    fi
    if ! rt_image_build "$img" "$gdir/Containerfile" "$gdir" "${extra_flags[@]}"; then
        # R-EGL-222-7 (S-EGL-222-20261008-1): the printed retry must
        # reproduce THIS invocation — the actual engine executable (a
        # path-invoked engine need not have a PATH wrapper) and any
        # explicit EGRESSLOCK_GW_IMAGE (a one-shot assignment does not
        # persist). %q keeps every token shell-safe.
        local retry_cmd retry_engine
        retry_engine="$(CDPATH='' cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
        retry_cmd="$(printf '%q build-gateway' "$retry_engine")"
        if (( force )); then
            retry_cmd="$retry_cmd --force"
        fi
        # EGL-456-D2: only echo the override when this build actually
        # honored it — otherwise the hint advertises a hook the engine
        # ignored (misleading recovery). EGL-456 R-EGL-456-3 F1: a
        # one-shot test-mode invocation also needs the flag in the retry,
        # or the re-run ignores the assignment and builds the production
        # default tag instead. Preserve the effective test-mode context;
        # the override stays inside that context.
        if kit_test_mode; then
            local retry_env="EGRESSLOCK_KIT_ALLOW_NON_ROOT=1"
            if [[ -n "${EGRESSLOCK_GW_IMAGE:-}" ]]; then
                retry_env+=" $(printf 'EGRESSLOCK_GW_IMAGE=%q' "$EGRESSLOCK_GW_IMAGE")"
            fi
            retry_cmd="$retry_env $retry_cmd"
        fi
        echo "Error: gateway image build failed for $img (build output above); fix the cause and re-run: $retry_cmd" >&2
        exit 1
    fi
}

# EGL-325: there is no config file selector. A profile's conf is always
# <passwd-home>/.config/egresslock/<profile>.conf; --config is rejected
# (fail closed, rc 2) and never read. Reject --config in ANY argv
# position, not only as the first token — the parsers silently ignored a
# trailing one, so stale scripts appeared to work. EGL-385: a set
# EGRESSLOCK_CONF (empty included) is retired — warn, never read.
# ARC-16-D5: --version prints the kit VERSION stamp (or 'dev').
# ARC-20-D1: profile subcommands REQUIRE a config — there are no
# compiled-in profiles; --help/-h/no-args and --version never touch
# profile state.
for _egl_arg in "$@"; do
    case "$_egl_arg" in
        --config|--config=*)
            echo "Error: --config has been removed (v0.9.0); a profile's config is always <account-home>/.config/egresslock/<profile>.conf (no file selector, no config-directory option)." >&2
            short_usage >&2
            exit 2
            ;;
    esac
done
# EGL-385: the retired env selector warns but does not fail — presence-based,
# so an empty EGRESSLOCK_CONF= counts as set. Checked after the argv scan
# (so --config keeps precedence) and before --version/dispatch so every
# invocation, the 15-minute verify timer included, sees the warning.
if [[ -n "${EGRESSLOCK_CONF+x}" ]]; then
    echo "Warning: EGRESSLOCK_CONF is retired and is no longer read." >&2
fi
# EGL-491-D4: the test flag's gate is the exact `== 1` predicate. Any other
# set value (including empty) leaves test mode off, so the hooks set
# alongside it are inert — warn once, presence-based, never echo the value.
if [[ -n "${EGRESSLOCK_KIT_ALLOW_NON_ROOT+x}" \
      && "${EGRESSLOCK_KIT_ALLOW_NON_ROOT-}" != 1 ]]; then
    echo "Warning: EGRESSLOCK_KIT_ALLOW_NON_ROOT is set but is not the exact value 1, so test mode is off; test-harness overrides are ignored." >&2
fi
if [[ "${1:-}" == "--version" ]]; then
    vfile="$(dirname "${BASH_SOURCE[0]}")/VERSION"
    if [[ -f "$vfile" ]]; then cat "$vfile"; else echo "dev"; fi
    exit 0
fi
case "${1:-}" in
    init)
        # ARC-35: init writes account-owned profile files; root would
        # write into root's home, so the ARC-25 root guard applies (but
        # init does NOT require a loadable config — it is a writer).
        require_nonroot
        acquire_engine_lock init
        ;;
    doctor)
        # EGL-45-D1: the host environment probe loads NO conf (same
        # class as --help/--version). ARC-25 root guard applies: probe
        # the ACCOUNT's store/netns, never root's.
        require_nonroot
        ;;
    build-gateway)
        # EGL-222: the gateway rebuild verb loads NO conf (same class
        # as doctor/--help/--version). ARC-25 root guard applies: build
        # into the ACCOUNT's rootless store, never root's.
        require_nonroot
        ;;
    *)
        # The profile-class commands: COMMANDS minus the exception arms
        # above. One list keeps this gate and the user-facing names from
        # drifting. Non-commands (bare, --help, unknowns) fall through.
        if in_commands "${1:-}"; then
            # ARC-25: fail closed when run as root — root's Podman store/
            # netns is a separate world from every account's. Accounts
            # execute the engine; root only distributes the kit (ARC-7-D5).
            # Escape hatch for intentional root use (not recommended).
            require_nonroot
            argv_shape_check "${1:-}" "${@:2}"
            acquire_engine_lock "${1:-}"
            if [[ "${1:-}" == "teardown" && "${2:-}" == "--runtime" ]]; then
                # ARC-60-D1: --runtime loads NO conf — it sweeps by name so it
                # works when the conf is already gone.
                :
            else
                # EGL-325/ARC-24/ARC-37: one account confdir. Named
                # commands load <profile>.conf; bare list and verify
                # --ensured aggregate CONFDIR/*.conf; bare teardown all
                # stays main.conf-only. EGL-223-D2/EGL-228-D1: in
                # `ensure --replace-gateway <profile>`, arg2 is the flag,
                # so feed the resolver arg3 (argv_shape_check already
                # rejected duplicate/unknown flags).
                _e223_arg2="${2:-}"
                if [[ "${1:-}" == "ensure" && "$_e223_arg2" == "--replace-gateway" ]]; then
                    _e223_arg2="${3:-}"
                elif [[ "${1:-}" == "allow" || "${1:-}" == "disallow" || "${1:-}" == "allowlist" ]]; then
                    # EGL-365/EGL-310: --direct is accepted before the
                    # profile, so arg2 may be the flag; the profile is
                    # the first positional (argv_shape_check already
                    # proved one).
                    for _e223_a in "${@:2}"; do
                        [[ "$_e223_a" == --* ]] && continue
                        _e223_arg2="$_e223_a"
                        break
                    done
                fi
                resolve_conf_for "${1:-}" "$_e223_arg2"
            fi
        fi
        ;;
esac

case "${1:-}" in
    ensure)      shift; cmd_ensure "$@" ;;
    verify)      shift
                 if [[ "${1:-}" == "--ensured" ]]; then
                     shift
                     [[ $# -eq 0 ]] || {
                         usage_error_command "verify --ensured takes no profile argument." \
                             "egresslock verify --ensured" "verify"
                         exit 2
                     }
                     cmd_verify_ensured
                 else
                     cmd_verify "$@"
                 fi ;;
    network)     shift; cmd_network "$@" ;;
    proxy-env)   shift; cmd_proxy_env "$@" ;;
    rules)       shift; cmd_rules "$@" ;;
    allowlist)   shift; cmd_allowlist "$@" ;;
    allowlist-direct) shift; cmd_allowlist_direct "$@" ;;
    denied)      shift; cmd_denied "$@" ;;
    allow)       shift; cmd_allow "$@" ;;
    disallow)    shift; cmd_disallow "$@" ;;
    allow-direct) shift; cmd_direct_allow "$@" ;;
    disallow-direct) shift; cmd_direct_disallow "$@" ;;
    allow-host)  shift; cmd_direct_allow "$@" ;;
    disallow-host) shift; cmd_direct_disallow "$@" ;;
    drop-unauthorized) shift; cmd_drop_unauthorized "$@" ;;
    init)        shift; cmd_init "$@" ;;
    list)        cmd_list ;;
    doctor)      shift
                 # EGL-45-D1: no profile argument, no extra args.
                 [[ $# -eq 0 ]] || { usage_error_command "doctor takes no arguments." \
                     "egresslock doctor" "doctor"; exit 2; }
                 cmd_doctor ;;
    build-gateway) shift; cmd_build_gateway "$@" ;;
    teardown)    shift; cmd_teardown "$@" ;;
    help)        shift; cmd_help "$@" ;;
    -h|--help) usage ;;
    "")        short_usage ;;
    -*)        echo "Error: unknown option '$1'." >&2; short_usage >&2; exit 2 ;;
    *)         echo "Error: unknown command '$1'." >&2; short_usage >&2; exit 2 ;;
esac
